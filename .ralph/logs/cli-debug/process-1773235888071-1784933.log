  "problem": {
    "statement": "JIRA Issue: DOC-3196\n\nTitle: excludeheadings support in autocomplete plugin\n\nDescription:\n{% toc minHeadingLevel=\"4\" maxHeadingLevel=\"4\" excludeHeadings=\"Create smart folders|Edit smart folders\" %}\n\nautocomplte plugin doesnt know about it, heres the fully ruby tag implementation\n\n```\n# frozen_string_literal: true\n\nmodule Jekyll\n  class InlineTocTag < Core::KenticoLinkTagBase\n    SUPPORTED_PARAMS = %w[maxHeadingLevel minHeadingLevel excludeHeadings].freeze\n\n    DEFAULT_MIN = 2\n    DEFAULT_MAX = 6\n    HEADING_PATTERN = /^#+\\s+.*$/\n    HEADING_TEXT_PATTERN = /#+\\s+/\n    HEADING_CLEANUP_PATTERN = /\\{% anchor .*\\s*%\\}/\n    LEVEL_PATTERN = /^#+/\n\n    def render(context)\n      @used_identifiers = []\n      page = context.registers[:page]\n      max_heading = get_or_default(@params[:maxHeadingLevel], DEFAULT_MAX)\n      min_heading = get_or_default(@params[:minHeadingLevel], DEFAULT_MIN)\n      exclude_match = @params[:excludeHeadings] || nil\n\n      headings = get_page_headings(page['content'])\n      filtered_headings = filter_headings(headings, max_heading, min_heading, exclude_match)\n\n      filtered_headings.length.positive? ? to_markdown(filtered_headings) : ''\n    end\n\n    private\n\n    # gets an array of markdown page headings\n    def get_page_headings(markup)\n      markup.scan(HEADING_PATTERN)\n    end\n\n    def filter_headings(headings, max_heading, min_heading, exclude_match)\n      headings = headings.select do |heading|\n        num_rep = get_heading_height(heading)\n        num_rep.between?(min_heading, max_heading)\n      end\n      if exclude_match\n        to_filter = exclude_match.split('|')\n        headings = headings.reject do |heading|\n          to_filter.include?(get_heading_text(heading))\n        end\n      end\n      headings\n    end\n\n    def get_heading_height(heading_string)\n      sharps = heading_string.scan(LEVEL_PATTERN)\n      # if nil, place the heading at the topmost level\n      sharps[0] ? sharps[0].length : 0\n    end\n\n    def to_markdown(headings)\n      # normalize to indent correctly\n      while get_heading_height(headings[0]).positive?\n        # strip one '#'\n        headings.each_with_index { |value, i| headings[i] = value[1..] }\n      end\n      build_list(headings)\n    end\n\n    def build_list(headings)\n      headings.map do |item|\n        ('    ' * get_heading_height(item)) + \"- [#{escape(get_heading_text(item).strip)}](##{derive_heading_identifier(item)}){.#{INTERNAL_LINK_CLASS}}\\n\" # rubocop:disable Layout/LineLength\n      end\n    end\n\n    def get_heading_text(heading)\n      heading.gsub(HEADING_TEXT_PATTERN, '').gsub(HEADING_CLEANUP_PATTERN, '')\n    end\n\n    def derive_heading_identifier(heading)\n      identifier = Core::AnchorValidator.get_heading_identifier(heading)\n      ensure_unique(identifier)\n    end\n\n    def ensure_unique(identifier)\n      increment = 0\n      affix = ''\n      while @used_identifiers.include?(identifier + affix)\n        increment += 1\n        affix = \"-#{increment}\"\n      end\n      @used_identifiers << (identifier + affix)\n      identifier + affix\n    end\n\n    def get_or_default(heading_level, default_value)\n      return validate_range(heading_level) if heading_level\n\n      default_value\n    end\n\n    def validate_range(heading_level)\n      if !heading_level.is_a?(Integer) || heading_level < DEFAULT_MIN || heading_level > DEFAULT_MAX\n        raise LinkTagError, 'toc: max/min heading level is not an integer in interval <2,6>'\n      end\n\n      heading_level\n    end\n  end\nend\n\nLiquid::Template.register_tag('toc', Jekyll::InlineTocTag)\n\n```\n\nPlease add to plugin\n\nPriority: Not set\n\nWas this page helpful?: Helpful"
