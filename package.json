{
  "name": "ralph-orchestrator",
  "version": "1.0.0",
  "description": "Autonomous orchestrator for Ralph documentation agent — polls JIRA, runs Docker containers, collects results",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "rm -rf dist && esbuild src/index.tsx --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/index.js",
    "start": "npm run validate && npm run build && node --enable-source-maps dist/index.js",
    "validate": "tsx scripts/validate.ts",
    "audit": "better-npm-audit audit",
    "setup": "npm install && npm run validate",
    "lint": "tsc && tsc -p tests/tsconfig.json && eslint . && prettier --check . --log-level warn",
    "format": "prettier --write . --log-level warn && eslint . --fix",
    "test": "npm run lint && npm run build && vitest run",
    "test:watch": "vitest",
    "dashboard": "cd dashboard-local && npx vite",
    "agent": "tsx scripts/run-agent.ts",
    "ralphchives:backup-db": "./ralphchives/scripts/backup-nodebb-db.sh",
    "ralphchives:restore-db": "./ralphchives/scripts/restore-nodebb-db.sh",
    "reset-testenv": "tsx scripts/reset-issue.ts",
    "prompt:vis": "tsx scripts/visualize-agent-graph.ts",
    "reset-testenv:easy": "tsx scripts/reset-issue.ts",
    "reset-testenv:medium": "tsx scripts/reset-issue.ts --medium",
    "reset-testenv:hard": "tsx scripts/reset-issue.ts --hard",
    "reset-testenv:hard-admin": "tsx scripts/reset-issue.ts --hard-admin",
    "reset-testenv:hard-cicd": "tsx scripts/reset-issue.ts --hard-cicd",
    "reset-testenv:very-hard": "tsx scripts/reset-issue.ts --very-hard",
    "reset-testenv:very-hard-admin": "tsx scripts/reset-issue.ts --very-hard-admin"
  },
  "dependencies": {
    "awilix": "^13.0.5",
    "dotenv": "^18.0.6",
    "execa": "^10.1.0",
    "ink": "^8.0.0",
    "liquidjs": "^10.30.0",
    "react": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "better-npm-audit": "^3.11.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "agentCliVersions": {
    "claude": "2.1.292",
    "copilot": "1.0.3"
  }
}
