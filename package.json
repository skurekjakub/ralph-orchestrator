{
  "name": "ralph-orchestrator",
  "version": "1.0.0",
  "description": "Autonomous orchestrator for Ralph documentation agent — polls JIRA, spins up devcontainers, collects results",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.83.0",
    "dotenv": "^17.3.1",
    "execa": "^9.6.1",
    "ink": "^6.7.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
