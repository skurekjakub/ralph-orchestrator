          "initial_wait": {
            "type": "number",
            "description": "(Optional) Time in seconds to wait for initial output when mode is \"sync\". The command continues running in the background after this time. Default is 30 seconds if not provided."
          }
        },
        "required": [
          "command",
          "description"
        ]
      }
    }
  },
  {
    "type": "function",
