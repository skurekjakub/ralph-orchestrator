le\\\", \\\"initialAttempts\\\": 2 },\\n      { \\\"taskId\\\": \\\"T-003\\\", \\\"criteria\\\": 8, \\\"result\\\": \\\"first-attempt\\\", \\\"initialAttempts\\\": 1 },\\n      { \\\"taskId\\\": \\\"T-004\\\", \\\"criteria\\\": 5, \\\"result\\\": \\\"first-attempt\\\", \\\"initialAttempts\\\": 1 },\\n      { \\\"taskId\\\": \\\"T-005\\\", \\\"criteria\\\": 6, \\\"result\\\": \\\"multi-cycle\\\", \\\"initialAttempts\\\": 2 },\\n      { \\\"taskId\\\": \\\"T-006\\\", \\\"criteria\\\": 6, \\\"result\\\": \\\"first-attempt\\\", \\\"initialAttempts\\\": 1 },\\n      { \\\"taskId\\\": \\\"T-007\\\", \\\"criteria\\\": 4, \\\"result\\\": \\\"first-attempt\\\", \\\"initialAttempts\\\": 1 },\\n      { \\\"taskId\\\": \\\"T-008\\\", \\\"criteria\\\": 5, \\\"result\\\": \\\"first-attempt\\\", \\\"initialAttempts\\\": 1 }\\n    ],\\n    \\\"analysis\\\": \\\"Tasks with 8 or fewer acceptance criteria had 80% first-attempt success (4/5). Tasks with more than 8 criteria had 0% (0/2). Exception: T-005 (6 criteria) still required 2 cycles, but only due to the recurring INV-style-132 issue -- all other aspects passed first attempt. The complexity threshold is not the criteria count itself but rather the amount of new prose generated: more prose means more opportunities for 'must'-directed-at-people violations.\\\"\\n  }\\n}\\n\\nwith open('/workspace/.docwriter/synthesis-signals/task-signals.json', 'w') as f:\\n    json.dump(data, f, indent=2)\\n\\nimport os\\nprint(f\\\"Written successfully, {os.path.getsize('/workspace/.docwriter/synthesis-signals/task-signals.json')} bytes\\\")\\nPYEOF\", \"description\": \"Write task signals via Python\", \"initial_wait\": 10}"
