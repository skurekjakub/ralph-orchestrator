              "name": "bash",
              "arguments": "{\"command\": \"cat > /tmp/rebuild_skills.py << 'PYEOF'\\nimport json\\nimport os\\nimport re\\nimport sys\\nfrom datetime import datetime\\n\\nMETA_DIR = \\\"/workspace/.docwriter/meta\\\"\\nREFS_DIR = \\\"/workspace/.github/skills/docwriter-meta/references\\\"\\nSKILL_DIR = \\\"/workspace/.github/skills/docwriter-meta\\\"\\nTIMESTAMP = \\\"2026-03-18T22:33:13Z\\\"\\n\\n# Load index\\nwith open(os.path.join(META_DIR, \\\"index.json\\\")) as f:\\n    index = json.load(f)\\n\\n# Build entry lookup from index\\nentries_by_id = {}\\nfor e in index[\\\"entries\\\"]:\\n    entries_by_id[e[\\\"id\\\"]] = e\\n\\n# Read all .md files\\ndef read_md_file(filepath):\\n    \\\"\\\"\\\"Read a .md entry file and extract frontmatter + body sections.\\\"\\\"\\\"\\n    full_path = os.path.join(\\\"/workspace/.docwriter\\\", filepath)\\n    if not os.path.exists(full_path):\\n        return None\\n    with open(full_path) as f:\\n        content = f.read()\\n    \\n    # Parse frontmatter\\n    parts = content.split(\\\"---\\\", 2)\\n    if len(parts) >= 3:\\n        body = parts[2].strip()\\n    else:\\n        body = content.strip()\\n    \\n    # Extract sections\\n    sections = {}\\n    current_section = None\\n    current_lines = []\\n    for line in body.split(\\\"\\\\n\\\"):\\n        if line.startswith(\\\"## \\\"):\\n            if current_section:\\n                sections[current_section] = \\\"\\\\n\\\".join(current_lines).strip()\\n            current_section = line[3:].strip()\\n            current_lines = []\\n        else:\\n            current_lines.append(line)\\n    if current_section:\\n        sections[current_section] = \\\"\\\\n\\\".join(current_lines).strip()\\n    \\n    return sections\\n\\n# Classify entries properly (some have type=None but category is set)\\ndef get_entry_type(entry):\\n    t = entry.get(\\\"type\\\")\\n    if t:\\n        return t\\n    cat = entry.get(\\\"category\\\", \\\"\\\")\\n    type_map = {\\n        \\\"patterns\\\": \\\"pattern\\\",\\n        \\\"anti-patterns\\\": \\\"anti-pattern\\\",\\n        \\\"domain-insights\\\": \\\"domain-insight\\\",\\n        \\\"source-observations\\\": \\\"source-observation\\\",\\n        \\\"style-evolutions\\\": \\\"style-evolution\\\",\\n    }\\n    return type_map.get(cat, \\\"unknown\\\")\\n\\n# Group entries by type, excluding deprecated\\ngrouped = {\\n    \\\"pattern\\\": [],\\n    \\\"anti-pattern\\\": [],\\n    \\\"domain-insight\\\": [],\\n    \\\"style-evolution\\\": [],\\n    \\\"source-observation\\\": [],\\n}\\n\\nfor e in index[\\\"entries\\\"]:\\n    if e.get(\\\"deprecated\\\", False):\\n        continue\\n    etype = get_entry_type(e)\\n    if etype in grouped:\\n        grouped[etype].append(e)\\n\\n# Sort: confidence high→medium→low, then usage desc\\nconf_order = {\\\"high\\\": 0, \\\"medium\\\": 1, \\\"low\\\": 2}\\nfor etype in grouped:\\n    grouped[etype].sort(key=lambda e: (conf_order.get(e.get(\\\"confidence\\\",\\\"low\\\"), 2), -e.get(\\\"usageCount\\\", 0), e[\\\"id\\\"]))\\n\\ndef format_domains(domains):\\n    if not domains:\\n        return \\\"(none)\\\"\\n    return \\\", \\\".join(domains)\\n\\ndef format_invariants(invs):\\n    if not invs:\\n        return \\\"(none)\\\"\\n    return \\\", \\\".join(invs)\\n\\ndef get_source_tasks(entry, sections=None):\\n    \\\"\\\"\\\"Get source task info from entry.\\\"\\\"\\\"\\n    tasks = entry.get(\\\"sourceTasks\\\", [])\\n    task = entry.get(\\\"sourceTask\\\", \\\"\\\")\\n    if task and not tasks:\\n        tasks = [task]\\n    if not tasks:\\n        signals = entry.get(\\\"sourceSignals\\\", [])\\n        if signals:\\n            return \\\", \\\".join(signals)\\n        return \\\"(none)\\\"\\n    return \\\", \\\".join(tasks)\\n\\ndef get_invariants(entry, sections=None):\\n    \\\"\\\"\\\"Get invariants from entry.\\\"\\\"\\\"\\n    invs = entry.get(\\\"invariantsReferenced\\\", [])\\n    if not invs:\\n        # Check in the .md file frontmatter\\n        return \\\"(none)\\\"\\n    return \\\", \\\".join(invs)\\n\\n# Read all entry files\\nentry_content = {}\\nfor e in index[\\\"entries\\\"]:\\n    if e.get(\\\"deprecated\\\", False):\\n        continue\\n    fp = e.get(\\\"filepath\\\", \\\"\\\")\\n    if fp:\\n        sections = read_md_file(fp)\\n        if sections:\\n            entry_content[e[\\\"id\\\"]] = sections\\n\\n# ============================================================\\n# 1. BUILD patterns.md\\n# ============================================================\\ndef build_patterns():\\n    lines = []\\n    lines.append(\\\"# Documentation Patterns\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Structural and content approaches that consistently produce first-attempt reviewer acceptance.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Patterns\\\")\\n    \\n    high_count = 0\\n    medium_count = 0\\n    low_count = 0\\n    \\n    for e in grouped[\\\"pattern\\\"]:\\n        eid = e[\\\"id\\\"]\\n        conf = e.get(\\\"confidence\\\", \\\"low\\\")\\n        if conf == \\\"high\\\": high_count += 1\\n        elif conf == \\\"medium\\\": medium_count += 1\\n        else: low_count += 1\\n        \\n        sections = entry_content.get(eid, {})\\n        insight_text = sections.get(\\\"Insight\\\", \\\"No insight available.\\\")\\n        # Collapse to single paragraph for the summary\\n        insight_clean = \\\" \\\".join(insight_text.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(f\\\"### {eid}: {e['title']}\\\")\\n        lines.append(f\\\"- **Confidence**: {conf} | **Domains**: {format_domains(e.get('domains', []))} | **Usage**: {e.get('usageCount', 0)}\\\")\\n        lines.append(f\\\"- **Insight**: {insight_clean}\\\")\\n        lines.append(f\\\"- **Source**: {get_source_tasks(e)} | **Invariants**: {get_invariants(e)}\\\")\\n        \\n        # Add evidence summary if available\\n        evidence = sections.get(\\\"Evidence\\\", \\\"\\\")\\n        if evidence:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Evidence:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(evidence)\\n        \\n        # Add recommendation if available\\n        rec = sections.get(\\\"Recommendation\\\", \\\"\\\")\\n        if rec:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Recommendation:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(rec)\\n        \\n        # Add applicability\\n        app = sections.get(\\\"Applicability\\\", \\\"\\\")\\n        if app:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Applicability:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(app)\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(\\\"---\\\")\\n    \\n    total = len(grouped[\\\"pattern\\\"])\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- Total patterns: {total}\\\")\\n    lines.append(f\\\"- High confidence: {high_count} | Medium: {medium_count} | Low: {low_count}\\\")\\n    lines.append(f\\\"- Last updated: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 2. BUILD anti-patterns.md\\n# ============================================================\\ndef build_anti_patterns():\\n    lines = []\\n    lines.append(\\\"# Documentation Anti-Patterns\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Known failure modes that cause reviewer rejections. Each entry includes the failure, its evidence, and the fix that resolved it.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Anti-Patterns\\\")\\n    \\n    high_count = 0\\n    medium_count = 0\\n    low_count = 0\\n    \\n    for e in grouped[\\\"anti-pattern\\\"]:\\n        eid = e[\\\"id\\\"]\\n        conf = e.get(\\\"confidence\\\", \\\"low\\\")\\n        if conf == \\\"high\\\": high_count += 1\\n        elif conf == \\\"medium\\\": medium_count += 1\\n        else: low_count += 1\\n        \\n        sections = entry_content.get(eid, {})\\n        insight_text = sections.get(\\\"Insight\\\", \\\"No insight available.\\\")\\n        insight_clean = \\\" \\\".join(insight_text.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(f\\\"### {eid}: {e['title']}\\\")\\n        lines.append(f\\\"- **Confidence**: {conf} | **Domains**: {format_domains(e.get('domains', []))} | **Usage**: {e.get('usageCount', 0)}\\\")\\n        lines.append(f\\\"- **Failure Mode**: {insight_clean}\\\")\\n        lines.append(f\\\"- **Source**: {get_source_tasks(e)} | **Invariants**: {get_invariants(e)}\\\")\\n        \\n        # Evidence\\n        evidence = sections.get(\\\"Evidence\\\", \\\"\\\")\\n        if evidence:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Evidence:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(evidence)\\n        \\n        # Recommendation / Mitigation (fix)\\n        rec = sections.get(\\\"Recommendation\\\", \\\"\\\")\\n        mitigation = sections.get(\\\"Mitigation\\\", \\\"\\\")\\n        if rec:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Fix/Recommendation:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(rec)\\n        elif mitigation:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Fix/Mitigation:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(mitigation)\\n        \\n        # Applicability\\n        app = sections.get(\\\"Applicability\\\", \\\"\\\")\\n        if app:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Applicability:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(app)\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(\\\"---\\\")\\n    \\n    total = len(grouped[\\\"anti-pattern\\\"])\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- Total anti-patterns: {total}\\\")\\n    lines.append(f\\\"- High confidence: {high_count} | Medium: {medium_count} | Low: {low_count}\\\")\\n    lines.append(f\\\"- Last updated: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 3. BUILD domain-knowledge.md\\n# ============================================================\\ndef build_domain_knowledge():\\n    lines = []\\n    lines.append(\\\"# Domain Knowledge\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Code→doc relationships, non-obvious documentation needs, and codebase conventions discovered across pipeline runs.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Domain Insights\\\")\\n    \\n    high_count = 0\\n    medium_count = 0\\n    low_count = 0\\n    \\n    for e in grouped[\\\"domain-insight\\\"]:\\n        eid = e[\\\"id\\\"]\\n        conf = e.get(\\\"confidence\\\", \\\"low\\\")\\n        if conf == \\\"high\\\": high_count += 1\\n        elif conf == \\\"medium\\\": medium_count += 1\\n        else: low_count += 1\\n        \\n        sections = entry_content.get(eid, {})\\n        insight_text = sections.get(\\\"Insight\\\", sections.get(\\\"Note\\\", \\\"No insight available.\\\"))\\n        insight_clean = \\\" \\\".join(insight_text.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(f\\\"### {eid}: {e['title']}\\\")\\n        lines.append(f\\\"- **Confidence**: {conf} | **Domains**: {format_domains(e.get('domains', []))} | **Usage**: {e.get('usageCount', 0)}\\\")\\n        lines.append(f\\\"- **Insight**: {insight_clean}\\\")\\n        lines.append(f\\\"- **Source**: {get_source_tasks(e)} | **Invariants**: {get_invariants(e)}\\\")\\n        \\n        # Evidence\\n        evidence = sections.get(\\\"Evidence\\\", \\\"\\\")\\n        if evidence:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Evidence:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(evidence)\\n        \\n        # Recommendation\\n        rec = sections.get(\\\"Recommendation\\\", \\\"\\\")\\n        if rec:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Recommendation:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(rec)\\n        \\n        # Applicability\\n        app = sections.get(\\\"Applicability\\\", \\\"\\\")\\n        if app:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Applicability:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(app)\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(\\\"---\\\")\\n    \\n    total = len(grouped[\\\"domain-insight\\\"])\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- Total domain insights: {total}\\\")\\n    lines.append(f\\\"- High confidence: {high_count} | Medium: {medium_count} | Low: {low_count}\\\")\\n    lines.append(f\\\"- Last updated: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 4. BUILD style-decisions.md\\n# ============================================================\\ndef build_style_decisions():\\n    lines = []\\n    lines.append(\\\"# Style Decisions\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Emergent style decisions beyond the invariant system — reviewers' cumulative preferences discovered across pipeline runs.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Style Evolutions\\\")\\n    \\n    high_count = 0\\n    medium_count = 0\\n    low_count = 0\\n    \\n    for e in grouped[\\\"style-evolution\\\"]:\\n        eid = e[\\\"id\\\"]\\n        conf = e.get(\\\"confidence\\\", \\\"low\\\")\\n        if conf == \\\"high\\\": high_count += 1\\n        elif conf == \\\"medium\\\": medium_count += 1\\n        else: low_count += 1\\n        \\n        sections = entry_content.get(eid, {})\\n        insight_text = sections.get(\\\"Insight\\\", \\\"No insight available.\\\")\\n        insight_clean = \\\" \\\".join(insight_text.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(f\\\"### {eid}: {e['title']}\\\")\\n        lines.append(f\\\"- **Confidence**: {conf} | **Domains**: {format_domains(e.get('domains', []))} | **Usage**: {e.get('usageCount', 0)}\\\")\\n        lines.append(f\\\"- **Insight**: {insight_clean}\\\")\\n        lines.append(f\\\"- **Source**: {get_source_tasks(e)} | **Invariants**: {get_invariants(e)}\\\")\\n        \\n        # Evidence\\n        evidence = sections.get(\\\"Evidence\\\", \\\"\\\")\\n        if evidence:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Evidence:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(evidence)\\n        \\n        # Recommendation\\n        rec = sections.get(\\\"Recommendation\\\", \\\"\\\")\\n        if rec:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Recommendation:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(rec)\\n        \\n        # Applicability\\n        app = sections.get(\\\"Applicability\\\", \\\"\\\")\\n        if app:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Applicability:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(app)\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(\\\"---\\\")\\n    \\n    total = len(grouped[\\\"style-evolution\\\"])\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- Total style evolutions: {total}\\\")\\n    lines.append(f\\\"- High confidence: {high_count} | Medium: {medium_count} | Low: {low_count}\\\")\\n    lines.append(f\\\"- Last updated: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 5. BUILD source-observations.md\\n# ============================================================\\ndef build_source_observations():\\n    lines = []\\n    lines.append(\\\"# Source Observations\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Reusable code→documentation predictors — source code characteristics that reliably predict specific documentation needs.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Source Observations\\\")\\n    \\n    high_count = 0\\n    medium_count = 0\\n    low_count = 0\\n    \\n    for e in grouped[\\\"source-observation\\\"]:\\n        eid = e[\\\"id\\\"]\\n        conf = e.get(\\\"confidence\\\", \\\"low\\\")\\n        if conf == \\\"high\\\": high_count += 1\\n        elif conf == \\\"medium\\\": medium_count += 1\\n        else: low_count += 1\\n        \\n        sections = entry_content.get(eid, {})\\n        \\n        code_char = sections.get(\\\"Code Characteristic\\\", \\\"No code characteristic documented.\\\")\\n        code_char_clean = \\\" \\\".join(code_char.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        pred_need = sections.get(\\\"Predicted Documentation Need\\\", \\\"No predicted need documented.\\\")\\n        pred_need_clean = \\\" \\\".join(pred_need.split(\\\"\\\\n\\\\n\\\")[0].split(\\\"\\\\n\\\")).strip()\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(f\\\"### {eid}: {e['title']}\\\")\\n        lines.append(f\\\"- **Confidence**: {conf} | **Domains**: {format_domains(e.get('domains', []))} | **Usage**: {e.get('usageCount', 0)}\\\")\\n        lines.append(f\\\"- **Code Characteristic**: {code_char_clean}\\\")\\n        lines.append(f\\\"- **Predicted Doc Need**: {pred_need_clean}\\\")\\n        lines.append(f\\\"- **Source**: {get_source_tasks(e)} | **Invariants**: {get_invariants(e)}\\\")\\n        \\n        # Evidence\\n        evidence = sections.get(\\\"Evidence\\\", \\\"\\\")\\n        if evidence:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Evidence:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(evidence)\\n        \\n        # Applicability\\n        app = sections.get(\\\"Applicability\\\", \\\"\\\")\\n        if app:\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"**Applicability:**\\\")\\n            lines.append(\\\"\\\")\\n            lines.append(app)\\n        \\n        lines.append(\\\"\\\")\\n        lines.append(\\\"---\\\")\\n    \\n    total = len(grouped[\\\"source-observation\\\"])\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- Total source observations: {total}\\\")\\n    lines.append(f\\\"- High confidence: {high_count} | Medium: {medium_count} | Low: {low_count}\\\")\\n    lines.append(f\\\"- Last updated: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 6. BUILD task-effectiveness.md\\n# ============================================================\\ndef build_task_effectiveness():\\n    lines = []\\n    lines.append(\\\"# Task Effectiveness\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"> Retrospective summaries — first-attempt rates, common failure modes, and improvement trends across pipeline runs.\\\")\\n    lines.append(\\\"\\\")\\n    \\n    # Read all task retros\\n    retro_dir = os.path.join(META_DIR, \\\"task-retros\\\")\\n    retros = []\\n    \\n    for fname in sorted(os.listdir(retro_dir)):\\n        fpath = os.path.join(retro_dir, fname)\\n        with open(fpath) as f:\\n            content = f.read()\\n        \\n        if fname.endswith(\\\".json\\\"):\\n            try:\\n                data = json.loads(content)\\n                retros.append({\\\"file\\\": fname, \\\"type\\\": \\\"json\\\", \\\"data\\\": data, \\\"raw\\\": content})\\n            except json.JSONDecodeError:\\n                retros.append({\\\"file\\\": fname, \\\"type\\\": \\\"raw\\\", \\\"raw\\\": content})\\n        else:\\n            retros.append({\\\"file\\\": fname, \\\"type\\\": \\\"md\\\", \\\"raw\\\": content})\\n    \\n    # Sort by completion date\\n    def get_date(r):\\n        if r[\\\"type\\\"] == \\\"json\\\":\\n            return r[\\\"data\\\"].get(\\\"completedAt\\\", \\\"\\\")\\n        # Try to extract from md\\n        m = re.search(r\\\"Completed.*?(\\\\d{4}-\\\\d{2}-\\\\d{2})\\\", r[\\\"raw\\\"])\\n        if m:\\n            return m.group(1)\\n        return \\\"\\\"\\n    \\n    retros.sort(key=get_date)\\n    \\n    lines.append(\\\"## Pipeline Run Summaries\\\")\\n    lines.append(\\\"\\\")\\n    \\n    for r in retros:\\n        if r[\\\"type\\\"] == \\\"json\\\":\\n            d = r[\\\"data\\\"]\\n            task_id = d.get(\\\"taskId\\\", d.get(\\\"issueKey\\\", r[\\\"file\\\"]))\\n            completed = d.get(\\\"completedAt\\\", \\\"unknown\\\")\\n            total_tasks = d.get(\\\"totalTasks\\\", \\\"?\\\")\\n            far = d.get(\\\"firstAttemptRate\\\", \\\"?\\\")\\n            if isinstance(far, float):\\n                far_pct = f\\\"{far*100:.1f}%\\\"\\n            else:\\n                far_pct = str(far)\\n            review_cycles = d.get(\\\"totalReviewCycles\\\", d.get(\\\"reviewCycles\\\", \\\"?\\\"))\\n            \\n            lines.append(f\\\"### {task_id}\\\")\\n            lines.append(f\\\"- **Completed**: {completed}\\\")\\n            lines.append(f\\\"- **Total tasks**: {total_tasks}\\\")\\n            lines.append(f\\\"- **First-attempt rate**: {far_pct}\\\")\\n            lines.append(f\\\"- **Review cycles**: {review_cycles}\\\")\\n            \\n            if \\\"patternsDiscovered\\\" in d:\\n                lines.append(f\\\"- **Patterns discovered**: {d['patternsDiscovered']}\\\")\\n            if \\\"antiPatternsDiscovered\\\" in d:\\n                lines.append(f\\\"- **Anti-patterns discovered**: {d['antiPatternsDiscovered']}\\\")\\n            if \\\"domainInsightsDiscovered\\\" in d:\\n                lines.append(f\\\"- **Domain insights discovered**: {d['domainInsightsDiscovered']}\\\")\\n            if \\\"sourceObservationsDiscovered\\\" in d:\\n                lines.append(f\\\"- **Source observations discovered**: {d.get('sourceObservationsDiscovered', 0)}\\\")\\n            if \\\"entriesNew\\\" in d or \\\"entriesCreated\\\" in d:\\n                new = d.get(\\\"entriesNew\\\", d.get(\\\"entriesCreated\\\", 0))\\n                lines.append(f\\\"- **New entries**: {new}\\\")\\n            if \\\"entriesUpdated\\\" in d:\\n                lines.append(f\\\"- **Entries updated**: {d['entriesUpdated']}\\\")\\n            \\n            if d.get(\\\"coldStart\\\", False) or (d.get(\\\"runContext\\\", {}).get(\\\"coldStart\\\", False)):\\n                lines.append(f\\\"- **Cold start**: yes\\\")\\n            \\n            # Confidence changes\\n            cc = d.get(\\\"confidenceChanges\\\", {})\\n            if cc:\\n                promos = cc.get(\\\"promotions\\\", [])\\n                demos = cc.get(\\\"demotions\\\", [])\\n                if promos:\\n                    promo_strs = [f\\\"{p['id']} ({p['from']}→{p['to']})\\\" for p in promos]\\n                    lines.append(f\\\"- **Promotions**: {', '.join(promo_strs)}\\\")\\n                if demos:\\n                    demo_strs = [f\\\"{d2['id']} ({d2['from']}→{d2['to']})\\\" for d2 in demos]\\n                    lines.append(f\\\"- **Demotions**: {', '.join(demo_strs)}\\\")\\n            \\n            # Discarded\\n            disc = d.get(\\\"discardedDetails\\\", d.get(\\\"discardedSignals\\\", []))\\n            if disc:\\n                lines.append(f\\\"- **Discarded signals**: {len(disc)}\\\")\\n            \\n            # Knowledge brief effectiveness\\n            kbe = d.get(\\\"knowledgeBriefEffectiveness\\\", d.get(\\\"metaKnowledgeEffectiveness\\\", {}))\\n            if kbe:\\n                lines.append(f\\\"- **Knowledge brief effectiveness**: {json.dumps(kbe)}\\\")\\n            \\n            # Research\\n            rru = d.get(\\\"researchRecommendationsUsed\\\", 0)\\n            rrc = d.get(\\\"researchCitationRate\\\", None)\\n            if rrc is not None:\\n                lines.append(f\\\"- **Research citation rate**: {rrc}\\\")\\n            \\n            lines.append(\\\"\\\")\\n            lines.append(\\\"---\\\")\\n            lines.append(\\\"\\\")\\n        \\n        elif r[\\\"type\\\"] == \\\"md\\\":\\n            # Include the full markdown retro\\n            lines.append(r[\\\"raw\\\"])\\n            lines.append(\\\"\\\")\\n            lines.append(\\\"---\\\")\\n            lines.append(\\\"\\\")\\n    \\n    # Aggregate statistics\\n    total_runs = len(retros)\\n    lines.append(\\\"## Aggregate Statistics\\\")\\n    lines.append(f\\\"- **Total pipeline runs**: {total_runs}\\\")\\n    \\n    # Calculate aggregate first-attempt rate\\n    total_tasks = 0\\n    total_first_attempt = 0\\n    for r in retros:\\n        if r[\\\"type\\\"] == \\\"json\\\":\\n            d = r[\\\"data\\\"]\\n            tt = d.get(\\\"totalTasks\\\", 0)\\n            far = d.get(\\\"firstAttemptRate\\\", 0)\\n            if isinstance(far, (int, float)) and isinstance(tt, int):\\n                total_tasks += tt\\n                total_first_attempt += round(far * tt)\\n    \\n    if total_tasks > 0:\\n        agg_rate = total_first_attempt / total_tasks\\n        lines.append(f\\\"- **Aggregate first-attempt rate**: {agg_rate*100:.1f}% ({total_first_attempt}/{total_tasks} tasks)\\\")\\n    \\n    lines.append(f\\\"- **Last updated**: {TIMESTAMP}\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# ============================================================\\n# 7. BUILD SKILL.md\\n# ============================================================\\ndef build_skill_md():\\n    total = index.get(\\\"activeEntries\\\", 60)\\n    ebt = index.get(\\\"entriesByType\\\", {})\\n    \\n    # Count unique retros\\n    retro_dir = os.path.join(META_DIR, \\\"task-retros\\\")\\n    retro_count = len([f for f in os.listdir(retro_dir) if os.path.isfile(os.path.join(retro_dir, f))])\\n    \\n    lines = []\\n    lines.append(\\\"# Docwriter Meta-Knowledge\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"Accumulated knowledge base for the docwriter agent family.\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Statistics\\\")\\n    lines.append(f\\\"- **Total entries**: {total}\\\")\\n    lines.append(f\\\"- **Patterns**: {ebt.get('patterns', 0)} | **Anti-patterns**: {ebt.get('anti-patterns', 0)}\\\")\\n    lines.append(f\\\"- **Domain insights**: {ebt.get('domain-insights', 0)} | **Style evolutions**: {ebt.get('style-evolutions', 0)}\\\")\\n    lines.append(f\\\"- **Source observations**: {ebt.get('source-observations', 0)}\\\")\\n    lines.append(f\\\"- **Last synthesized**: {index.get('lastSynthesized', TIMESTAMP)}\\\")\\n    lines.append(f\\\"- **Pipeline runs contributing**: {retro_count}\\\")\\n    lines.append(\\\"\\\")\\n    lines.append(\\\"## Reference Files\\\")\\n    lines.append(\\\"- [patterns.md](references/patterns.md) — Proven documentation approaches\\\")\\n    lines.append(\\\"- [anti-patterns.md](references/anti-patterns.md) — Known failure modes to avoid\\\")\\n    lines.append(\\\"- [domain-knowledge.md](references/domain-knowledge.md) — Codebase-specific documentation insights\\\")\\n    lines.append(\\\"- [style-decisions.md](references/style-decisions.md) — Emergent style decisions\\\")\\n    lines.append(\\\"- [task-effectiveness.md](references/task-effectiveness.md) — Pipeline effectiveness trends\\\")\\n    lines.append(\\\"- [source-observations.md](references/source-observations.md) — Source code predictors for documentation needs\\\")\\n    \\n    return \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n# Generate all files\\nfiles = {\\n    os.path.join(REFS_DIR, \\\"patterns.md\\\"): build_patterns(),\\n    os.path.join(REFS_DIR, \\\"anti-patterns.md\\\"): build_anti_patterns(),\\n    os.path.join(REFS_DIR, \\\"domain-knowledge.md\\\"): build_domain_knowledge(),\\n    os.path.join(REFS_DIR, \\\"style-decisions.md\\\"): build_style_decisions(),\\n    os.path.join(REFS_DIR, \\\"source-observations.md\\\"): build_source_observations(),\\n    os.path.join(REFS_DIR, \\\"task-effectiveness.md\\\"): build_task_effectiveness(),\\n    os.path.join(SKILL_DIR, \\\"SKILL.md\\\"): build_skill_md(),\\n}\\n\\nfor path, content in files.items():\\n    with open(path, \\\"w\\\") as f:\\n        f.write(content)\\n    print(f\\\"Wrote: {path} ({len(content)} bytes)\\\")\\n\\n# Print counts for status\\nprint(f\\\"\\\\nCounts:\\\")\\nprint(f\\\"  patterns: {len(grouped['pattern'])}\\\")\\nprint(f\\\"  anti-patterns: {len(grouped['anti-pattern'])}\\\")\\nprint(f\\\"  domain-insights: {len(grouped['domain-insight'])}\\\")\\nprint(f\\\"  style-evolutions: {len(grouped['style-evolution'])}\\\")\\nprint(f\\\"  source-observations: {len(grouped['source-observation'])}\\\")\\nprint(f\\\"  total active: {sum(len(v) for v in grouped.values())}\\\")\\nPYEOF\\n\\npython3 /tmp/rebuild_skills.py\", \"description\": \"Generate all reference files\", \"initial_wait\": 15}"
            }
