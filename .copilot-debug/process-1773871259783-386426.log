              }
            },
            "description": "Filters for workflow jobs. **ONLY** used when method is 'list_workflow_jobs'"
          },
          "workflow_runs_filter": {
            "type": "object",
            "properties": {
              "actor": {
                "type": "string",
                "description": "Filter to a specific GitHub user's workflow runs."
