 include '{expected_redirect}'\\\")\\n        result[\\\"frontMatter\\\"][\\\"valid\\\"] = False\\n\\n    # License\\n    if fm['license'] not in valid_licenses:\\n        result[\\\"frontMatter\\\"][\\\"fields\\\"][\\\"license\\\"][\\\"valid\\\"] = False\\n        result[\\\"frontMatter\\\"][\\\"invalidValues\\\"].append(f\\\"license: {fm['license']} not in {valid_licenses}\\\")\\n        result[\\\"frontMatter\\\"][\\\"valid\\\"] = False\\n\\n    # Order\\n    if not isinstance(fm['order'], int) or fm['order'] < 0:\\n        result[\\\"frontMatter\\\"][\\\"fields\\\"][\\\"order\\\"][\\\"valid\\\"] = False\\n        result[\\\"frontMatter\\\"][\\\"invalidValues\\\"].append(\\\"order: must be a positive integer\\\")\\n        result[\\\"frontMatter\\\"][\\\"valid\\\"] = False\\n\\n    # --- Liquid syntax ---\\n    liquid_issues = []\\n    for open_tag, close_tag in block_tags.items():\\n        opens = len(re.findall(r'\\\\{%[-\\\\s]*' + re.escape(open_tag) + r'(?:\\\\s|%)', body))\\n        closes = len(re.findall(r'\\\\{%[-\\\\s]*' + re.escape(close_tag) + r'(?:\\\\s|%)', body))\\n        if opens != closes:\\n            liquid_issues.append(f\\\"Unbalanced {{% {open_tag} %}}: {opens} opens, {closes} closes\\\")\\n\\n    if body.count('{%') != body.count('%}'):\\n        liquid_issues.append(f\\\"Unbalanced tag delimiters: {body.count('{%')} opens, {body.count('%}')} closes\\\")\\n\\n    if body.count('{{') != body.count('}}'):\\n        liquid_issues.append(f\\\"Unbalanced output tags: {body.count('{{')} opens, {body.count('}}')} closes\\\")\\n\\n    if '{%' in fm_str or '{{' in fm_str:\\n        liquid_issues.append(\\\"Liquid tags found in front matter\\\")\\n\\n    if liquid_issues:\\n        result[\\\"liquid\\\"][\\\"valid\\\"] = False\\n        result[\\\"liquid\\\"][\\\"issues\\\"] = liquid_issues\\n        result[\\\"buildReady\\\"] = False\\n\\n    # --- Build readiness ---\\n    basename = os.path.basename(filepath)\\n    if not re.match(r'^[a-z0-9][a-z0-9\\\\-]*\\\\.md$', basename):\\n        result[\\\"issues\\\"].append(f\\\"Filename '{basename}' does not follow kebab-case convention\\\")\\n\\n    with open(filepath, 'rb') as bf:\\n        if bf.read(3) == b'\\\\xef\\\\xbb\\\\xbf':\\n            result[\\\"issues\\\"].append(\\\"File has UTF-8 BOM\\\")\\n            result[\\\"buildReady\\\"] = False\\n\\n    # Image verification\\n    images = re.findall(r'\\\\{%\\\\s*image\\\\s+(\\\\S+)', body)\\n    if images:\\n        page_basename = os.path.splitext(basename)[0]\\n        collection = 'documentation' if '/_documentation/' in filepath else 'guides'\\n        assets_dir = f\\\"src/_docsassets/{collection}/{page_basename}\\\"\\n        missing_imgs = [img for img in images if not os.path.exists(os.path.join(assets_dir, img))]\\n        if missing_imgs:\\n            result[\\\"issues\\\"].append(f\\\"Missing image files: {missing_imgs}\\\")\\n\\n    results.append(result)\\n\\n# --- Write frontmatter-validation.json ---\\nall_valid = all(r[\\\"frontMatter\\\"][\\\"valid\\\"] and r[\\\"liquid\\\"][\\\"valid\\\"] and r[\\\"buildReady\\\"] for r in results)\\nfm_issues = sum(1 for r in results if not r[\\\"frontMatter\\\"][\\\"valid\\\"])\\nliq_issues = sum(1 for r in results if not r[\\\"liquid\\\"][\\\"valid\\\"])\\nbuild_blockers = sum(1 for r in results if not r[\\\"buildReady\\\"])\\n\\nvalidation_output = {\\n    \\\"version\\\": 1,\\n    \\\"generatedBy\\\": \\\"docwriter-frontmatter-validator\\\",\\n    \\\"timestamp\\\": TIMESTAMP,\\n    \\\"results\\\": results,\\n    \\\"summary\\\": {\\n        \\\"filesChecked\\\": len(results),\\n        \\\"allValid\\\": all_valid,\\n        \\\"frontMatterIssues\\\": fm_issues,\\n        \\\"liquidIssues\\\": liq_issues,\\n        \\\"buildBlockers\\\": build_blockers\\n    }\\n}\\n\\nwith open('.docwriter/frontmatter-validation.json', 'w') as f:\\n    json.dump(validation_output, f, indent=2)\\nprint(\\\"Wrote .docwriter/frontmatter-validation.json\\\")\\n\\n# --- Write status file ---\\nstatus = {\\n    \\\"agent\\\": \\\"docwriter-frontmatter-validator\\\",\\n    \\\"status\\\": \\\"done\\\",\\n    \\\"result\\\": \\\"all-valid\\\" if all_valid else \\\"issues-found\\\",\\n    \\\"filesChecked\\\": len(results),\\n    \\\"issuesFound\\\": fm_issues + liq_issues + build_blockers,\\n    \\\"timestamp\\\": TIMESTAMP\\n}\\n\\nwith open('.docwriter/agents/frontmatter-validator-status.json', 'w') as f:\\n    json.dump(status, f, indent=2)\\nprint(\\\"Wrote .docwriter/agents/frontmatter-validator-status.json\\\")\\n\\n# --- Prepend to manifest.json ---\\nmanifest_entry = {\\n    \\\"agent\\\": \\\"docwriter-frontmatter-validator\\\",\\n    \\\"action\\\": f\\\"validated {len(results)} files — 0 issues found\\\",\\n    \\\"timestamp\\\": TIMESTAMP\\n}\\n\\nwith open('.docwriter/manifest.json', 'r') as f:\\n    manifest = json.load(f)\\n\\nmanifest.insert(0, manifest_entry)\\n\\nwith open('.docwriter/manifest.json', 'w') as f:\\n    json.dump(manifest, f, indent=2)\\nprint(\\\"Updated .docwriter/manifest.json\\\")\\n\\nprint(f\\\"\\\\nSummary: {len(results)} files checked, allValid={all_valid}, FM issues={fm_issues}, Liquid issues={liq_issues}, build blockers={build_blockers}\\\")\\nPYEOF\", \"description\": \"Write all output artifacts\", \"initial_wait\": 10}"
