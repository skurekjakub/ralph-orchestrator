\\\"result\\\": \\\"first-attempt\\\",\\n      \\\"initialAttempts\\\": 1,\\n      \\\"reEntryAttempts\\\": 0,\\n      \\\"totalAttempts\\\": 1,\\n      \\\"structuralApproach\\\": \\\"single-crossref-sentence-addition\\\",\\n      \\\"invariantsApplied\\\": [\\\"INV-crossref-002\\\", \\\"INV-crossref-003\\\", \\\"INV-crossref-005\\\", \\\"INV-crossref-009\\\", \\\"INV-style-132\\\"],\\n      \\\"metaPatternsUsed\\\": [\\\"PAT-009\\\"],\\n      \\\"researchRecommendationsUsed\\\": [\\\"REC-005\\\"],\\n      \\\"acceptanceCriteria\\\": 4,\\n      \\\"gapsFixed\\\": [],\\n      \\\"signal\\\": {\\n        \\\"type\\\": \\\"candidate-pattern\\\",\\n        \\\"strength\\\": \\\"medium\\\",\\n        \\\"description\\\": \\\"Cleanest outcome in the run: single attempt, no re-entry needed, all reviewers approved. Minimal-scope cross-reference addition (one sentence) using PAT-009 + REC-005 + comprehensive cross-reference invariant application (4 INV-crossref-* rules). Explicitly verified anchor existence and identifier against target page before submission. Fewest acceptance criteria (4) of all tasks.\\\"\\n      }\\n    },\\n    {\\n      \\\"taskId\\\": \\\"T-008\\\",\\n      \\\"action\\\": \\\"update-crossrefs\\\",\\n      \\\"result\\\": \\\"first-attempt\\\",\\n      \\\"initialAttempts\\\": 1,\\n      \\\"reEntryAttempts\\\": 1,\\n      \\\"totalAttempts\\\": 2,\\n      \\\"structuralApproach\\\": \\\"single-crossref-note-insertion\\\",\\n      \\\"invariantsApplied\\\": [\\\"INV-style-001\\\", \\\"INV-style-132\\\", \\\"INV-persona-013\\\", \\\"INV-style-096\\\"],\\n      \\\"metaPatternsUsed\\\": [],\\n      \\\"researchRecommendationsUsed\\\": [],\\n      \\\"acceptanceCriteria\\\": 5,\\n      \\\"gapsFixed\\\": [\\\"GAP-003\\\"],\\n      \\\"signal\\\": {\\n        \\\"type\\\": \\\"candidate-pattern\\\",\\n        \\\"strength\\\": \\\"low\\\",\\n        \\\"description\\\": \\\"First-attempt acceptance during initial execution. Business-user cross-reference task. Re-entry (GAP-003 synchronize permission fix) also passed on first attempt.\\\"\\n      }\\n    }\\n  ],\\n  \\\"candidatePatterns\\\": [\\n    {\\n      \\\"id\\\": \\\"CPAT-001\\\",\\n      \\\"name\\\": \\\"narrow-scope-crossref-with-verified-anchors\\\",\\n      \\\"strength\\\": \\\"medium\\\",\\n      \\\"occurrences\\\": 5,\\n      \\\"tasks\\\": [\\\"T-003\\\", \\\"T-004\\\", \\\"T-006\\\", \\\"T-007\\\", \\\"T-008\\\"],\\n      \\\"description\\\": \\\"Cross-reference update tasks with narrow scope (4-8 acceptance criteria) consistently achieved first-attempt acceptance. Tasks that explicitly verified anchor existence and identifier resolution before submission (T-007 documented this in notes) had zero review issues. Pattern: keep changes minimal, mirror existing structural patterns on the page, verify all cross-reference targets.\\\",\\n      \\\"invariantCombination\\\": [\\\"INV-crossref-002\\\", \\\"INV-crossref-003\\\", \\\"INV-crossref-005\\\", \\\"INV-crossref-009\\\", \\\"INV-style-001\\\"],\\n      \\\"patternsCited\\\": [\\\"PAT-009\\\"],\\n      \\\"recommendationsCited\\\": [\\\"REC-005\\\"]\\n    },\\n    {\\n      \\\"id\\\": \\\"CPAT-002\\\",\\n      \\\"name\\\": \\\"mirror-existing-page-structure\\\",\\n      \\\"strength\\\": \\\"low\\\",\\n      \\\"occurrences\\\": 2,\\n      \\\"tasks\\\": [\\\"T-004\\\", \\\"T-008\\\"],\\n      \\\"description\\\": \\\"When inserting a new callout or note, mirroring the exact structure and phrasing of an existing callout on the same page achieved first-attempt acceptance. T-004 explicitly noted it 'matching the exact structural pattern of the existing Create a new page permission note.' This approach reduces reviewer friction because the style is pre-validated by the existing content.\\\"\\n    }\\n  ],\\n  \\\"candidateAntiPatterns\\\": [\\n    {\\n      \\\"id\\\": \\\"CAPAT-001\\\",\\n      \\\"name\\\": \\\"must-directed-at-people-in-permission-docs\\\",\\n      \\\"strength\\\": \\\"high\\\",\\n      \\\"occurrences\\\": 3,\\n      \\\"tasks\\\": [\\\"T-001\\\", \\\"T-002\\\", \\\"T-005\\\"],\\n      \\\"description\\\": \\\"INV-style-132 ('must' directed at people) was the sole or primary rejection cause in all 3 multi-cycle tasks. The writer consistently produced phrases like 'you must have', 'the user must have', 'they must advance' when documenting permission requirements — a context where imperative phrasing feels natural but violates the style guide. All 3 fixes were mechanical: 'must' → 'need to' / 'needs to'. This is a systematic writer tendency specifically triggered by permission-requirement content.\\\",\\n      \\\"rootCause\\\": \\\"style\\\",\\n      \\\"invariant\\\": \\\"INV-style-132\\\",\\n      \\\"fix\\\": \\\"Replace 'must' with 'need to' / 'needs to' when the subject is a person. Alternative: rephrase so the requirement is the subject ('a role assignment is required').\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"CAPAT-002\\\",\\n      \\\"name\\\": \\\"multi-sentence-callout-missing-bold-title\\\",\\n      \\\"strength\\\": \\\"medium\\\",\\n      \\\"occurrences\\\": 2,\\n      \\\"tasks\\\": [\\\"T-001\\\", \\\"T-002\\\"],\\n      \\\"description\\\": \\\"INV-style-139 requires multi-sentence callouts to have a bold title on a separate line. Both T-001 (warning callout) and T-002 (3 note callouts) omitted this title. The writer correctly exempted single-sentence callouts in T-002, showing awareness of the rule but incomplete application when writing multi-sentence content. Both fixes were structural: add '**Title text**' line after the opening Liquid tag.\\\",\\n      \\\"rootCause\\\": \\\"style\\\",\\n      \\\"invariant\\\": \\\"INV-style-139\\\",\\n      \\\"fix\\\": \\\"Always add a bold title on a separate line after {% note/warning/info %} when the callout body has 2+ sentences.\\\"\\n    }\\n  ],\\n  \\\"styleEvolutions\\\": [\\n    {\\n      \\\"observation\\\": \\\"Persona reviewer surfaced 'inherit' as too technical for business users in T-005; writer incorporated rephrasing alongside style fix\\\",\\n      \\\"occurrences\\\": 1,\\n      \\\"strength\\\": \\\"low\\\",\\n      \\\"description\\\": \\\"The persona reviewer flagged 'does not inherit permissions from its parent' as using system-administration vocabulary inappropriate for business users, suggesting 'uses its own permission settings instead of the parent page's'. This was a non-blocking note (approved-with-notes) but the writer adopted it during the style fix rewrite. Only 1 occurrence — not enough to establish a pattern, but signals that permission-domain vocabulary may need a business-user glossary.\\\"\\n    },\\n    {\\n      \\\"observation\\\": \\\"Style reviewer issued 'approved-with-notes' for pre-existing checkbox spelling issue in T-003 (workflows.md)\\\",\\n      \\\"occurrences\\\": 1,\\n      \\\"strength\\\": \\\"low\\\",\\n      \\\"description\\\": \\\"During GAP-002 re-entry review of T-003, the style reviewer noted a pre-existing issue (checkbox spelling) not introduced by the pipeline changes. This did not block approval but signals that the style reviewer catches issues beyond the immediate diff scope. Not actionable as a style evolution — the pre-existing issue predates this pipeline run.\\\"\\n    }\\n  ],\\n  \\\"gapResolutionAnalysis\\\": {\\n    \\\"gapsTotal\\\": 3,\\n    \\\"gapsResolved\\\": 3,\\n    \\\"gapDetails\\\": [\\n      {\\n        \\\"gapId\\\": \\\"GAP-001\\\",\\n        \\\"description\\\": \\\"Clone page permission requirements undocumented\\\",\\n        \\\"affectedTasks\\\": [\\\"T-001\\\", \\\"T-004\\\"],\\n        \\\"resolution\\\": \\\"T-001 added clone permission requirements to 'Page permissions for creating pages' section. T-004 added info callout to 'Clone a page' section with cross-reference.\\\",\\n        \\\"reEntryAttempts\\\": 1,\\n        \\\"reEntryVerdict\\\": \\\"approved\\\"\\n      },\\n      {\\n        \\\"gapId\\\": \\\"GAP-002\\\",\\n        \\\"description\\\": \\\"Unicode en dashes (U+2013) violating INV-style-096\\\",\\n        \\\"affectedTasks\\\": [\\\"T-003\\\", \\\"T-006\\\"],\\n        \\\"resolution\\\": \\\"T-003 converted 3 en dashes, T-006 converted 7 en dashes to double-hyphens. Hex-level grep confirmed zero remain.\\\",\\n        \\\"reEntryAttempts\\\": 1,\\n        \\\"reEntryVerdict\\\": \\\"approved/approved-with-notes\\\"\\n      },\\n      {\\n        \\\"gapId\\\": \\\"GAP-003\\\",\\n        \\\"description\\\": \\\"Synchronize permission not enumerated and ancestor-chain requirement undocumented\\\",\\n        \\\"affectedTasks\\\": [\\\"T-001\\\", \\\"T-008\\\"],\\n        \\\"resolution\\\": \\\"T-001 added Synchronize to permission enumeration and added new 'Page permissions for synchronizing pages' section. T-008 updated permission sentence to include ancestor requirement and fixed cross-reference anchor.\\\",\\n        \\\"reEntryAttempts\\\": 1,\\n        \\\"reEntryVerdict\\\": \\\"approved\\\"\\n      }\\n    ],\\n    \\\"signal\\\": {\\n      \\\"type\\\": \\\"observation\\\",\\n      \\\"description\\\": \\\"All 3 gaps were discovered in gap-hunting cycle 1 and resolved in a single re-entry cycle with 100% first-attempt re-entry acceptance. GAP-002 (Unicode en dashes) is a mechanical/encoding issue that the writer could not reasonably detect without tooling — suggests adding a pre-submission encoding check. GAP-001 and GAP-003 are coverage gaps where the initial task scope missed specific operations (clone, synchronize) — suggests the task planner or impact mapper should enumerate all permission constants when scoping permission documentation tasks.\\\"\\n    }\\n  },\\n  \\\"complexityCorrelation\\\": {\\n    \\\"observation\\\": \\\"Acceptance criteria count correlated with multi-cycle likelihood\\\",\\n    \\\"data\\\": [\\n      { \\\"taskId\\\": \\\"T-001\\\", \\\"criteria\\\": 19, \\\"result\\\": \\\"multi-cycle\\\", \\\"initialAttempts\\\": 2 },\\n      { \\\"taskId\\\"