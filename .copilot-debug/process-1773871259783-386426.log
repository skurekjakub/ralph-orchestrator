      "description": "Tools for listing GitHub Actions resources.\nUse this tool to list workflows in a repository, or list workflow runs, jobs, and artifacts for a specific workflow or workflow run.\n",
      "parameters": {
        "type": "object",
        "properties": {
          "method": {
