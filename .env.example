# Copy to .env and fill in values. Never commit .env.
# Reference: docs/user-guide/environment-variables.md

# ── Required (startup fails without these) ───────────────────────────────────

# GitHub fine-grained PAT with "Copilot Requests" permission.
# Injected into every agent container.
GH_TOKEN=

# Azure DevOps PAT (Code: Read & Write).
# Used by the ado MCP server (sidecar only) and as the default repoPat for
# vcsProvider "ado" profiles (host-side repo sync).
ADO_PAT=

# JIRA credentials, one pair per JIRA data source in config.json.
# Names are JIRA_PAT_<KEY> / JIRA_EMAIL_<KEY>, where <KEY> is the data source
# key uppercased with dashes replaced by underscores.
#   config.json.sample key "my-jira"  → JIRA_PAT_MY_JIRA / JIRA_EMAIL_MY_JIRA
#   profiles' data source "kentico-jira" → JIRA_PAT_KENTICO_JIRA / JIRA_EMAIL_KENTICO_JIRA
# API token from id.atlassian.com (classic, not scoped).
# The jira-kentico MCP server reads the KENTICO_JIRA pair.
JIRA_PAT_KENTICO_JIRA=
JIRA_EMAIL_KENTICO_JIRA=

# ── Optional ─────────────────────────────────────────────────────────────────

# Anthropic API key. Not validated at startup. If set, it is injected into
# every agent container.
ANTHROPIC_API_KEY=

# Azure DevOps PAT for the kenticoxperience org (Code: Read, Packaging: Read, Build: Read).
# Passed into the ralph-docs agent container (profiles/ralph-docs/docker-compose.yml);
# the agent skips Xperience-related operations if unset.
ADO_PAT_XPERIENCE=

# Ralph Status Dashboard heartbeat reporting. Both must be set to send heartbeats.
DASHBOARD_URL=
DASHBOARD_SECRET=

# discord-hitl MCP server (required only by profiles that declare it).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional label for Discord thread names (defaults to "Agent").
# DISCORD_TASK_CONTEXT=

# Ralphchives MCP servers (ralphchives-read / ralphchives-write).
# NodeBB API URL as seen from the MCP sidecar container.
NODEBB_API_URL=http://host.docker.internal:4567
# Per-variant NodeBB tokens, resolved by the $variantEnv.NODEBB_TOKEN macro.
# Naming: NODEBB_TOKEN_<PROFILEID>_<DISPLAYNAME> (uppercase; -, ., / → _)
# Both bundled profiles use this macro, so each of their variants needs its
# token: a missing variable fails the task when its MCP config is resolved.
# Auto-populated by ralphchives/scripts/setup-nodebb.mjs or sync-profiles.mjs.
# NODEBB_TOKEN_RALPH_DOCS_RALPH=
# NODEBB_TOKEN_RALPH_DOCS_MALPH=
# NODEBB_TOKEN_RALPH_DOCS_STACKY=
# NODEBB_TOKEN_RALPH_VSCODE_RALPH=
# NODEBB_TOKEN_RALPH_VSCODE_MALPH=
# The Ralphchives compose stack itself (NodeBB, Neo4j) takes its own secrets
# from ralphchives/.env; see ralphchives/.env.example.
