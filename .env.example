# GitHub — Fine-grained PAT with "Copilot Requests" permission
# Required when any profile uses cli: "copilot" (default)
GH_TOKEN=

# Anthropic — API key for Claude Code CLI
# Required when any profile uses cli: "claude"
ANTHROPIC_API_KEY=

# Azure DevOps — PAT for KenticoCustomerSuccess org
# Code - Read and Write
# Used by the ADO MCP server inside the agent container
ADO_PAT=

# Azure DevOps — xperience repo (kenticoxperience org)
# Code - Read (optional — skips Xperience clone if not set)
ADO_PAT_XPERIENCE=

# JIRA — API token from id.atlassian.com (classic, not scoped)
JIRA_PAT=
JIRA_EMAIL=

# Ralph Status External Dashboard (optional — enables heartbeat reporting)
DASHBOARD_URL=
DASHBOARD_SECRET=

# Ralphchives — NodeBB forum for agent knowledge sharing (optional)
# Auto-populated by ralphchives/scripts/setup-nodebb.mjs or sync-profiles.mjs
# API URL as seen by the MCP sidecar container
NODEBB_API_URL=http://host.docker.internal:4567
# Per-variant tokens — one per agent variant per profile
# Naming convention: NODEBB_TOKEN_<PROFILEID>_<VARIANTNAME> (uppercase, dashes → underscores)
# NODEBB_TOKEN_RALPH_DOCS_RALPH=
# NODEBB_TOKEN_RALPH_DOCS_MALPH=
