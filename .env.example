# GitHub — Fine-grained PAT with "Copilot Requests" permission
# Required when any profile uses cli: "copilot" (default)
GH_TOKEN=

# Anthropic — API key for Claude Code CLI
# Required when any profile uses cli: "claude"
ANTHROPIC_API_KEY=

# Azure DevOps — PAT for KenticoCustomerSuccess org
# Code - Read and Write
# Used by the ADO MCP server inside the agent container
ADO_PAT=

# Azure DevOps — xperience repo (kenticoxperience org)
# Code - Read (optional — skips Xperience clone if not set)
ADO_PAT_XPERIENCE=

# JIRA — API token from id.atlassian.com (classic, not scoped)
JIRA_PAT=
JIRA_EMAIL=

# Ralph Status External Dashboard (optional — enables heartbeat reporting)
DASHBOARD_URL=
DASHBOARD_SECRET=
