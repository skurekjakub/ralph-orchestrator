{
  "dataSources": {
    "my-jira": {
      "type": "jira",
      "connection": {
        "baseUrl": "https://api.atlassian.com/ex/jira",
        "cloudId": "<your-jira-cloud-id>",
        "excludeFields": [],
        "allowedUsers": []
      },
      "pollIntervalMs": 60000
    }
  },
  "dashboard": {
    "enabled": false,
    "intervalMs": 30000
  },
  "ralphchives": {
    "enabled": false,
    "nodebbApiUrl": "http://localhost:4567",
    "neo4jUri": "bolt://localhost:7687",
    "neo4jUser": "neo4j"
  },
  "output": {
    "logDir": "./output/logs",
    "handoffDir": "./output/handoffs"
  },
  "promptAudit": {
    "mode": "warn"
  },
  "claudeAuth": "oauth-token"
}
