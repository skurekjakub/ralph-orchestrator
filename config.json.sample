{
  "jira": {
    "baseUrl": "https://api.atlassian.com/ex/jira",
    "cloudId": "<your-jira-cloud-id>",
    "pollIntervalMs": 60000
  },
  "dashboard": {
    "enabled": false,
    "intervalMs": 30000
  },
  "output": {
    "logDir": "./output/logs",
    "handoffDir": "./output/handoffs"
  },
  "promptAudit": {
    "mode": "warn"
  },
  "excludeFields": []
}
