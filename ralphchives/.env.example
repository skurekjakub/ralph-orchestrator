# Ralphchives infrastructure secrets
# Copy to .env and fill in values before starting the stack.

# Neo4j authentication password
NEO4J_PASSWORD=ralphchives

# MongoDB password (must match mongodb-user-init.js if changed)
MONGO_PASSWORD=nodebb

# NodeBB API token for the ralph-bot user (created after first NodeBB setup)
NODEBB_API_TOKEN=
