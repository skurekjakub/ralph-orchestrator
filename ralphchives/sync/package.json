{
  "name": "ralphchives-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/sync-runner.ts",
    "build": "rm -rf dist && esbuild src/sync-runner.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/sync-runner.js",
    "start": "node --enable-source-maps dist/sync-runner.js",
    "sync:full": "tsx src/sync-runner.ts --full",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "neo4j-driver": "^6.2.0",
    "ollama": "^0.6.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
