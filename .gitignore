# Ralph Orchestrator runtime
node_modules/
dist/
output/
# Trigger cache, the orchestrator's clone of each profile's repo, per-task workspaces
/cache/

# Build artifacts (generated from templates at startup)
profiles/**/.build/

# MCP server build artifacts (custom servers are built before container deployment)
shared/mcp-servers/*/dist/
shared/mcp-servers/*/node_modules/

# Ralphchives sync pipeline build artifacts
ralphchives/sync/dist/
ralphchives/sync/node_modules/

test-results/

# Secrets
.env

# OS
.DS_Store
Thumbs.db

config.json

todo.md

# Agent scratch state
/.agents/
/.sisyphus/

# Personal Claude Code settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# Agent worktrees: full checkouts that search, prettier and the main checkout's git must not see
.claude/worktrees/

# Stray vendored CLI tarballs
*.tgz

.cache/claude-scratch/

.ai/followups/*
!.ai/followups/README.md
.ai/**/*-handoff.md

# Vitest JSON report written by the RTK test wrapper
.vitest/

# superpowers subagent-driven-development workspaces
/.superpowers/
