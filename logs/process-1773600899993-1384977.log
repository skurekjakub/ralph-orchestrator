                  "pull_request",
                  "pull_request_review",
                  "pull_request_review_comment",
                  "pull_request_target",
                  "push",
                  "registry_package",
                  "release",
                  "repository_dispatch",
                  "schedule",
                  "status",
                  "watch",
                  "workflow_call",
                  "workflow_dispatch",
                  "workflow_run"
                ]
              },
              "status": {
                "type": "string",
                "description": "Filter workflow runs to only runs with a specific status",
