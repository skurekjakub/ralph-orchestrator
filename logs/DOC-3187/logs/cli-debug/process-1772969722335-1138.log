    "type": "function",
    "function": {
      "name": "ado-ado_create_pull_request",
      "description": "Create a new pull request in an Azure DevOps repository. Source branch name must include the refs/heads/ prefix. Target branch is resolved from configuration (defaults to main).",
      "parameters": {
        "type": "object",
        "properties": {
