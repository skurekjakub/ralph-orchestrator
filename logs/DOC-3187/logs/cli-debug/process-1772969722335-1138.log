  else\\n        {\\n            eventLogService.LogWarning(\\\"ExternalAuthController\\\", \\\"EXTERNALAUTH_ERROR\\\",\\n                \\\"External sign in error\\\");\\n        }\\n    }\\n    //EndInclude:external-sync\\n\\n    public IActionResult ExternalAuthenticationFailure()\\n    {\\n        return View();\\n    }\\n}\\n\", \"path\": \"/workspace/src/_code/src/CodeSamples/Membership/StandaloneSamples/ExternalAuthController.cs\"}"
