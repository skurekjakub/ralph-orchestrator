              "arguments": "{\"command\": \"cat > /tmp/write_agents.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nPrompt Writer - Re-entry cycle 1\\nGenerates/updates all 67 agent prompt files for the romantic-fantasy-writer system.\\nAddresses all 12 execution-level gaps from gap hunting.\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport re\\nimport sys\\n\\n# === CONFIGURATION ===\\nOUTPUT_DIR = \\\".fractal-factory/output/romantic-fantasy-writer/agents\\\"\\nROSTER_PATH = \\\".fractal-factory/roster.json\\\"\\nROUTING_PATH = \\\".fractal-factory/routing.json\\\"\\nARCH_PATH = \\\".fractal-factory/architecture.json\\\"\\nDOMAIN_MODEL_PATH = \\\".fractal-factory/domain-model.json\\\"\\n\\n# === LOAD DATA ===\\nwith open(ROSTER_PATH) as f:\\n    roster = json.load(f)\\nwith open(ROUTING_PATH) as f:\\n    routing = json.load(f)\\nwith open(ARCH_PATH) as f:\\n    architecture = json.load(f)\\nwith open(DOMAIN_MODEL_PATH) as f:\\n    domain_model = json.load(f)\\n\\nagents_data = {a['name']: a for a in roster['agents']}\\nrouting_data = routing['agents']\\n\\n# INV-030 text for all agents\\nINV_030_TEXT = \\\"**INV-030** (No Silent Failures): If you cannot complete your task — e.g., cannot maintain consistency, cannot find a satisfying resolution, cannot access required artifacts — you MUST surface the problem explicitly in your status.json with result `blocked` and a descriptive summary. Never produce low-quality output silently.\\\"\\n\\n# T25 text for relevant agents\\nT25_TEXT = \\\"**INV-063/T25** (Thematic Argument Scaffolding): Structure each theme as an argument — question, competing answers (embodied by characters/factions), resolution earned through protagonist experience. Act 1 introduces the question, Act 2 tests easy answers, Act 3 forces the hardest version.\\\"\\n\\n# === SKILL MAPPING (Gap MK-W02) ===\\nSKILL_MAP = {\\n    'guide': [\\n        ('agent-as-function-contract', 'Defines the filesystem artifact I/O contract all agents follow'),\\n        ('prompt-security', 'Input sanitization and content safety for user-facing interactions'),\\n        ('rules', 'System-wide behavioral rules'),\\n    ],\\n    'orchestrator': [\\n        ('agent-as-function-contract', 'Defines the filesystem artifact I/O contract for routing decisions'),\\n        ('fractal-orchestrator-architecture', 'Pipeline architecture: phase dispatch, revision-beta loops, convergence bounds'),\\n        ('rules', 'System-wide behavioral rules'),\\n    ],\\n    'coordinator': [\\n        ('agent-as-function-contract', 'Defines the filesystem artifact I/O contract for dispatch decisions'),\\n        ('fractal-coordinator-patterns', 'Coordinator routing: dispatch order, auditor retry loops, convergence bounds'),\\n        ('rules', 'System-wide behavioral rules'),\\n    ],\\n    'sub-coordinator': [\\n        ('agent-as-function-contract', 'Defines the filesystem artifact I/O contract for dispatch decisions'),\\n        ('fractal-coordinator-patterns', 'Sub-coordinator routing: sequential dispatch, blocked escalation'),\\n        ('rules', 'System-wide behavioral rules'),\\n    ],\\n    'specialist': [\\n        ('agent-as-function-contract', 'Defines the filesystem artifact I/O contract: read inputs, write outputs, write status.json'),\\n        ('rules', 'System-wide behavioral rules'),\\n    ],\\n}\\n\\ndef get_skills_section(level, agent_name):\\n    \\\"\\\"\\\"Generate Skills section for an agent based on its level.\\\"\\\"\\\"\\n    skills = SKILL_MAP.get(level, SKILL_MAP['specialist'])\\n    lines = [\\\"## Skills\\\", \\\"\\\"]\\n    lines.append(\\\"Read these skills for architectural and behavioral guidance:\\\", \\\"\\\")\\n    for skill_name, desc in skills:\\n        lines.append(f\\\"- **`skills/{skill_name}/SKILL.md`** — {desc}\\\")\\n    lines.append(\\\"\\\")\\n    return \\\"\\\\n\\\".join(lines)\\n\\n# That has a bug - too many args to append. Fix:\\ndef get_skills_section(level, agent_name):\\n    \\\"\\\"\\\"Generate Skills section for an agent based on its level.\\\"\\\"\\\"\\n    skills = SKILL_MAP.get(level, SKILL_MAP['specialist'])\\n    lines = [\\\"## Skills\\\", \\\"\\\",\\n             \\\"Read these skills for architectural and behavioral guidance:\\\", \\\"\\\"]\\n    for skill_name, desc in skills:\\n        lines.append(f\\\"- **`skills/{skill_name}/SKILL.md`** — {desc}\\\")\\n    lines.append(\\\"\\\")\\n    return \\\"\\\\n\\\".join(lines)\\n\\n\\ndef add_inv030_to_file(content, agent_data):\\n    \\\"\\\"\\\"Add INV-030 to the Key Invariants section if not present.\\\"\\\"\\\"\\n    if \\\"INV-030\\\" in content:\\n        return content  # Already has it\\n    \\n    # Find the Key Invariants section and add INV-030 at the end\\n    key_inv_pattern = r'(## Key Invariants\\\\n(?:.*\\\\n)*?)((?=\\\\n## )|$)'\\n    match = re.search(r'## Key Invariants\\\\n', content)\\n    if match:\\n        # Find the next ## section after Key Invariants\\n        next_section = re.search(r'\\\\n## ', content[match.end():])\\n        if next_section:\\n            insert_pos = match.end() + next_section.start()\\n            content = content[:insert_pos] + f\\\"\\\\n- {INV_030_TEXT}\\\\n\\\" + content[insert_pos:]\\n        else:\\n            content += f\\\"\\\\n- {INV_030_TEXT}\\\\n\\\"\\n    else:\\n        # No Key Invariants section - add one after Role section\\n        role_match = re.search(r'\\\\n## (Process|Anti-Laziness|Pass/Fail|Purity)', content)\\n        if role_match:\\n            insert_pos = role_match.start()\\n            content = content[:insert_pos] + f\\\"\\\\n\\\\n## Key Invariants\\\\n\\\\n- {INV_030_TEXT}\\\\n\\\" + content[insert_pos:]\\n    return content\\n\\n\\ndef add_skills_section(content, level, agent_name):\\n    \\\"\\\"\\\"Add Skills section before Status Contract or Result Codes.\\\"\\\"\\\"\\n    if \\\"## Skills\\\" in content:\\n        return content  # Already has it\\n    \\n    skills_text = get_skills_section(level, agent_name)\\n    \\n    # Insert before Status Contract, Result Codes, or Artifact Assignments\\n    for marker in [\\\"## Status Contract\\\", \\\"## Result Codes\\\", \\\"## Artifact Assignments\\\"]:\\n        pos = content.find(marker)\\n        if pos > 0:\\n            content = content[:pos] + skills_text + \\\"\\\\n\\\" + content[pos:]\\n            return content\\n    \\n    # Fallback: append\\n    content += \\\"\\\\n\\\" + skills_text\\n    return content\\n\\n\\ndef add_t25_to_agent(content, agent_name):\\n    \\\"\\\"\\\"Add T25 (Thematic Argument Scaffolding) awareness to specific agents.\\\"\\\"\\\"\\n    if \\\"T25\\\" in content or \\\"INV-063\\\" in content:\\n        return content  # Already has it\\n    \\n    # Add to Key Invariants section\\n    match = re.search(r'## Key Invariants\\\\n', content)\\n    if match:\\n        next_section = re.search(r'\\\\n## ', content[match.end():])\\n        if next_section:\\n            insert_pos = match.end() + next_section.start()\\n            content = content[:insert_pos] + f\\\"\\\\n- {T25_TEXT}\\\\n\\\" + content[insert_pos:]\\n    return content\\n\\n\\ndef fix_orchestrator_routing(content):\\n    \\\"\\\"\\\"Fix RC-001 and RC-002: Add blocked handlers for craft-tracker and continuity-tracker.\\\"\\\"\\\"\\n    \\n    # Check if craft-tracker blocked handler exists\\n    if \\\"craft-tracker/status.json | result == 'blocked'\\\" not in content and \\\\\\n       \\\"craft-tracker/status.json | result == \\\\\\\\'blocked\\\\\\\\'\\\" not in content:\\n        # Find the craft-tracker completed line and add blocked after it\\n        craft_completed = \\\"| agents/craft-tracker/status.json | result == 'completed' AND phaseStatuses.drafting.status == 'pending' | dispatch romantic-fantasy-writer-drafting-coordinator |\\\"\\n        craft_blocked = \\\"| agents/craft-tracker/status.json | result == 'blocked' | write own status: failed; summary: 'Craft tracking initialization failed — craft-tracker-blocked' |\\\"\\n        if craft_completed in content:\\n            content = content.replace(craft_completed, craft_completed + \\\"\\\\n\\\" + craft_blocked)\\n    \\n    # Check if continuity-tracker blocked handler exists  \\n    if \\\"continuity-tracker/status.json | result == 'blocked'\\\" not in content:\\n        # Find the continuity-tracker completed line and add blocked after it\\n        cont_completed = \\\"| agents/continuity-tracker/status.json | result == 'completed' AND phaseStatuses.revision.status == 'pending' | dispatch romantic-fantasy-writer-revision-coordinator |\\\"\\n        cont_blocked = \\\"| agents/continuity-tracker/status.json | result == 'blocked' | write own status: failed; summary: 'Continuity verification failed — continuity-tracker-blocked' |\\\"\\n        if cont_completed in content:\\n            content = content.replace(cont_completed, cont_completed + \\\"\\\\n\\\" + cont_blocked)\\n    \\n    return content\\n\\n\\ndef add_craft_enforcer_t25(content):\\n    \\\"\\\"\\\"Add T25 checking to craft-enforcer's chapter-level audit steps.\\\"\\\"\\\"\\n    if \\\"T25\\\" in content:\\n        return content\\n    \\n    # Add T25 check step to the process\\n    process_end = content.rfind(\\\"### Step\\\")\\n    if process_end > 0:\\n        # Find the last step and add T25 step before Write Rules\\n        write_rules_pos = content.find(\\\"## Write Rules\\\", process_end)\\n        artifact_pos = content.find(\\\"## Artifact Assignments\\\", process_end)\\n        status_pos = content.find(\\\"## Status Contract\\\", process_end)\\n        result_pos = content.find(\\\"## Result Codes\\\", process_end)\\n        \\n        insert_before = None\\n        for pos in [write_rules_pos, artifact_pos, result_pos, status_pos]:\\n            if pos > 0:\\n                insert_before = pos\\n                break\\n        \\n        if insert_before:\\n            t25_step = \\\"\\\"\\\"\\n### Step: Verify Thematic Argument Scaffolding (INV-063/T25)\\n\\nIf T25 is in the active craft profile, verify:\\n1. Each thematic pillar is structured as an argument — question, competing answers, earned resolution\\n2. Act 1 scenes introduce the thematic question through character encounters\\n3. Act 2 scenes test easy answers and show why they fail\\n4. Act 3 scenes force the protagonist to confront the hardest version\\n5. Theme is embodied by characters/factions, not stated in narration\\n6. Resolution is earned through protagonist experience, not deus ex machina\\n\\n\\\"\\\"\\\"\\n            content = content[:insert_before] + t25_step + content[insert_before:]\\n    \\n    # Also add to Key Invariants\\n    content = add_t25_to_agent(content, \\\"craft-enforcer\\\")\\n    return content\\n\\n\\n# === PROCESS ALL AGENTS ===\\nstats = {'written': 0, 'skipped': 0, 'anti_laziness': 0, 'errors': []}\\n\\n# Define processing order (bottom-up)\\nlevel_order = ['specialist', 'sub-coordinator', 'coordinator', 'orchestrator', 'guide']\\n\\n# Sort agents by level order\\ndef agent_sort_key(agent):\\n    level = agent['level']\\n    try:\\n        return level_order.index(level)\\n    except ValueError:\\n        return 99\\n\\nsorted_agents = sorted(roster['agents'], key=agent_sort_key)\\n\\nfor agent in sorted_agents:\\n    name = agent['name']\\n    level = agent['level']\\n    agent_file = os.path.join(OUTPUT_DIR, f\\\"{name}.agent.md\\\")\\n    \\n    try:\\n        # Read existing file\\n        if os.path.exists(agent_file):\\n            with open(agent_file) as f:\\n                content = f.read()\\n        else:\\n            stats['errors'].append(f\\\"Missing file for {name}\\\")\\n            continue\\n        \\n        original_content = content\\n        \\n        # === GAP IE-001: Add INV-030 to all agents ===\\n        content = add_inv030_to_file(content, agent)\\n        \\n        # === GAP MK-W02: Add Skills section to all agents ===\\n        content = add_skills_section(content, level, name)\\n        \\n        # === GAP RC-001 & RC-002: Fix orchestrator routing ===\\n        if level == 'orchestrator':\\n            content = fix_orchestrator_routing(content)\\n        \\n        # === GAP IE-002: Add T25 to specific agents ===\\n        if 'craft-enforcer' in name:\\n            content = add_craft_enforcer_t25(content)\\n        elif 'chapter-drafter' in name:\\n            content = add_t25_to_agent(content, name)\\n            # Also add T25 awareness in process\\n            if \\\"T25\\\" not in content or content.count(\\\"T25\\\") < 2:\\n                # Add T25 instruction to the drafting process\\n                step_pattern = \\\"### Step 1:\\\"\\n                if step_pattern in content:\\n                    pos = content.find(step_pattern)\\n                    t25_note = \\\"\\\"\\\"**T25 Awareness**: If T25 (Thematic Argument Scaffolding) is active in craft-profile.json, ensure each chapter's scenes advance thematic arguments — Act 1 chapters introduce questions, Act 2 chapters test easy answers, Act 3 chapters force the hardest version.\\n\\n\\\"\\\"\\\"\\n                    content = content[:pos] + t25_note + content[pos:]\\n        elif 'scene-beat-designer' in name:\\n            content = add_t25_to_agent(content, name)\\n            # Add T25 to beat design process\\n            if \\\"T25\\\" not in content or content.count(\\\"T25\\\") < 2:\\n                step_pattern = \\\"### Step 1:\\\"\\n                if step_pattern in content:\\n                    pos = content.find(step_pattern)\\n                    t25_note = \\\"\\\"\\\"**T25 Awareness**: If T25 (Thematic Argument Scaffolding) is active in craft-profile.json, design beats that advance thematic arguments. Assign thematic weight to individual beats — each scene should progress at least one theme's argument.\\n\\n\\\"\\\"\\\"\\n                    content = content[:pos] + t25_note + content[pos:]\\n        elif 'plotting-auditor' in name:\\n            # Plotting auditor should also check T25 compliance\\n            content = add_t25_to_agent(content, name)\\n        \\n        # Track anti-laziness agents\\n        if agent['antiLaziness']:\\n            stats['anti_laziness'] += 1\\n        \\n        # Write updated file\\n        with open(agent_file, 'w') as f:\\n            f.write(content)\\n        \\n        stats['written'] += 1\\n        \\n        if content != original_content:\\n            changes = []\\n            if \\\"INV-030\\\" in content and \\\"INV-030\\\" not in original_content:\\n                changes.append(\\\"INV-030\\\")\\n            if \\\"## Skills\\\" in content and \\\"## Skills\\\" not in original_content:\\n                changes.append(\\\"Skills\\\")\\n            if 'craft-tracker/status.json | result == \\\\'blocked\\\\'' in content and 'craft-tracker/status.json | result == \\\\'blocked\\\\'' not in original_content:\\n                changes.append(\\\"RC-001\\\")\\n            if 'continuity-tracker/status.json | result == \\\\'blocked\\\\'' in content and 'continuity-tracker/status.json | result == \\\\'blocked\\\\'' not in original_content:\\n                changes.append(\\\"RC-002\\\")\\n            if \\\"T25\\\" in content and \\\"T25\\\" not in original_content:\\n                changes.append(\\\"T25\\\")\\n            print(f\\\"  Updated {name}: +{', '.join(changes)}\\\")\\n        else:\\n            print(f\\\"  Unchanged {name}\\\")\\n            \\n    except Exception as e:\\n        stats['errors'].append(f\\\"{name}: {str(e)}\\\")\\n        print(f\\\"  ERROR {name}: {e}\\\")\\n\\nprint(f\\\"\\\\n=== SUMMARY ===\\\")\\nprint(f\\\"Written: {stats['written']}\\\")\\nprint(f\\\"Anti-laziness: {stats['anti_laziness']}\\\")\\nprint(f\\\"Errors: {len(stats['errors'])}\\\")\\nfor e in stats['errors']:\\n    print(f\\\"  {e}\\\")\\n\\nPYEOF\\ncd /home/jakubs/repositories/ralph-orchestrator && python3 /tmp/write_agents.py\", \"description\": \"Run initial batch upd