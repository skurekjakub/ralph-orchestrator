pend({\\\"id\\\": \\\"V-TYPE-03\\\", \\\"description\\\": \\\"Coordinator Routing Table check\\\",\\n                       \\\"result\\\": \\\"not-applicable\\\",\\n                       \\\"evidence\\\": f\\\"Agent is {level}\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-TYPE-04\\n    if is_coordinator or is_orchestrator:\\n        has_process = has_section(content, \\\"Process\\\")\\n        checks.append({\\\"id\\\": \\\"V-TYPE-04\\\", \\\"description\\\": \\\"Coordinator does NOT have Process section\\\",\\n                       \\\"result\\\": \\\"pass\\\" if not has_process else \\\"fail\\\",\\n                       \\\"evidence\\\": f\\\"Has Process: {has_process}\\\",\\n                       \\\"expected\\\": \\\"No Process section\\\", \\\"actual\\\": str(has_process)})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-TYPE-04\\\", \\\"description\\\": \\\"Coordinator no-Process check\\\",\\n                       \\\"result\\\": \\\"not-applicable\\\",\\n                       \\\"evidence\\\": f\\\"Agent is {level}\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-TYPE-05\\n    if is_orchestrator:\\n        has_pipeline = has_section(content, \\\"Pipeline Routing\\\") or has_section(content, \\\"Routing Table\\\")\\n        checks.append({\\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator has Pipeline Routing\\\",\\n                       \\\"result\\\": \\\"pass\\\" if has_pipeline else \\\"fail\\\",\\n                       \\\"evidence\\\": f\\\"Has Pipeline/Routing: {has_pipeline}\\\",\\n                       \\\"expected\\\": \\\"Pipeline Routing section\\\", \\\"actual\\\": str(has_pipeline)})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator Pipeline Routing check\\\",\\n                       \\\"result\\\": \\\"not-applicable\\\",\\n                       \\\"evidence\\\": f\\\"Agent is {level}\\\", \\\"expected\\\": None