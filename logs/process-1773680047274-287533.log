            "function": {
              "name": "bash",
              "arguments": "{\"command\": \"cat > /tmp/validate_agents.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nComprehensive checklist validator for romantic-fantasy-writer agent system.\\nValidates all 67 agents against structural and behavioral checklist.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport os\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom datetime import datetime, timezone\\n\\nBASE = Path(\\\"/home/jakubs/repositories/ralph-orchestrator\\\")\\nFF = BASE / \\\".fractal-factory\\\"\\nOUTPUT = FF / \\\"output\\\" / \\\"romantic-fantasy-writer\\\"\\nAGENTS_DIR = OUTPUT / \\\"agents\\\"\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\n\\n# Load source-of-truth files\\nwith open(FF / \\\"roster.json\\\") as f:\\n    roster_data = json.load(f)\\n\\nwith open(FF / \\\"context.json\\\") as f:\\n    context_data = json.load(f)\\n\\n# Build roster lookup\\nroster_agents = {}\\nfor agent in roster_data[\\\"agents\\\"]:\\n    roster_agents[agent[\\\"name\\\"]] = agent\\n\\n# List all agent files on disk\\nagent_files_on_disk = set()\\nfor f in AGENTS_DIR.glob(\\\"*.agent.md\\\"):\\n    agent_files_on_disk.add(f.stem)  # filename without .agent.md\\n\\nroster_names = set(roster_agents.keys())\\n\\n# Results accumulator\\nall_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\n\\ndef parse_frontmatter(content):\\n    \\\"\\\"\\\"Parse YAML frontmatter from agent file.\\\"\\\"\\\"\\n    fm = {}\\n    if content.startswith(\\\"---\\\"):\\n        end = content.find(\\\"---\\\", 3)\\n        if end > 0:\\n            fm_text = content[3:end].strip()\\n            for line in fm_text.split(\\\"\\\\n\\\"):\\n                if \\\":\\\" in line:\\n                    key, val = line.split(\\\":\\\", 1)\\n                    fm[key.strip()] = val.strip().strip('\\\"').strip(\\\"'\\\")\\n    return fm\\n\\ndef has_section(content, heading):\\n    \\\"\\\"\\\"Check if markdown has a section with given heading (any level).\\\"\\\"\\\"\\n    pattern = r'^#{1,6}\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    return bool(re.search(pattern, content, re.MULTILINE))\\n\\ndef has_section_fuzzy(content, heading):\\n    \\\"\\\"\\\"Check if markdown has a section containing the heading text (case-insensitive).\\\"\\\"\\\"\\n    pattern = r'^#{1,6}\\\\s+.*' + re.escape(heading) + r'.*$'\\n    return bool(re.search(pattern, content, re.MULTILINE | re.IGNORECASE))\\n\\ndef get_section_content(content, heading):\\n    \\\"\\\"\\\"Get content of a section (everything between this heading and the next heading of same or higher level).\\\"\\\"\\\"\\n    lines = content.split(\\\"\\\\n\\\")\\n    in_section = False\\n    section_level = 0\\n    section_lines = []\\n    for line in lines:\\n        if in_section:\\n            m = re.match(r'^(#{1,6})\\\\s+', line)\\n            if m and len(m.group(1)) <= section_level:\\n                break\\n            section_lines.append(line)\\n        else:\\n            if re.match(r'^#{1,6}\\\\s+.*' + re.escape(heading), line, re.IGNORECASE):\\n                m = re.match(r'^(#{1,6})\\\\s+', line)\\n                section_level = len(m.group(1))\\n                in_section = True\\n    return \\\"\\\\n\\\".join(section_lines)\\n\\ndef count_numbered_steps(section_content):\\n    \\\"\\\"\\\"Count numbered steps in a section.\\\"\\\"\\\"\\n    return len(re.findall(r'^\\\\d+\\\\.', section_content, re.MULTILINE))\\n\\ndef check_anti_laziness(content):\\n    \\\"\\\"\\\"Check for placeholder/TODO markers.\\\"\\\"\\\"\\n    issues = []\\n    patterns = [\\n        (r'\\\\bTODO\\\\b', 'Contains TODO marker'),\\n        (r'\\\\bFIXME\\\\b', 'Contains FIXME marker'),\\n        (r'\\\\bimplement later\\\\b', 'Contains \\\"implement later\\\"'),\\n        (r'\\\\bplaceholder\\\\b', 'Contains \\\"placeholder\\\"'),\\n        (r'\\\\bTBD\\\\b', 'Contains TBD marker'),\\n        (r'\\\\bcoming soon\\\\b', 'Contains \\\"coming soon\\\"'),\\n    ]\\n    for pattern, desc in patterns:\\n        if re.search(pattern, content, re.IGNORECASE):\\n            issues.append(desc)\\n    return issues\\n\\ndef validate_agent(name, roster_entry):\\n    \\\"\\\"\\\"Validate a single agent against all applicable checks.\\\"\\\"\\\"\\n    checks = []\\n    agent_file = AGENTS_DIR / f\\\"{name}.agent.md\\\"\\n    level = roster_entry.get(\\\"level\\\", \\\"\\\")\\n    children = roster_entry.get(\\\"children\\\", [])\\n    result_codes = roster_entry.get(\\\"resultCodes\\\", [])\\n    parent = roster_entry.get(\\\"parent\\\", \\\"\\\")\\n    display_name = roster_entry.get(\\\"displayName\\\", \\\"\\\")\\n    \\n    is_guide = level == \\\"guide\\\"\\n    is_orchestrator = level == \\\"orchestrator\\\"\\n    is_coordinator = level in (\\\"coordinator\\\", \\\"sub-coordinator\\\")\\n    is_specialist = level == \\\"specialist\\\"\\n    is_auditor = \\\"auditor\\\" in name\\n    \\n    # Check file exists\\n    if not agent_file.exists():\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-01\\\",\\n            \\\"description\\\": \\\"Agent prompt file exists\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"File {name}.agent.md not found in agents directory\\\",\\n            \\\"expected\\\": f\\\"{name}.agent.md\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n        return checks  # Can't do further checks\\n    \\n    content = agent_file.read_text()\\n    fm = parse_frontmatter(content)\\n    \\n    # ===== IDENTITY CHECKS =====\\n    \\n    # V-IDENTITY-01: Frontmatter name matches filename\\n    fm_name = fm.get(\\\"name\\\", \\\"\\\")\\n    expected_name = name\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-01\\\",\\n        \\\"description\\\": \\\"Frontmatter name matches filename\\\",\\n        \\\"result\\\": \\\"pass\\\" if fm_name == expected_name else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{fm_name}', filename='{name}.agent.md'\\\",\\n        \\\"expected\\\": expected_name,\\n        \\\"actual\\\": fm_name\\n    })\\n    \\n    # V-IDENTITY-02: Frontmatter description is non-empty\\n    fm_desc = fm.get(\\\"description\\\", \\\"\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\",\\n        \\\"description\\\": \\\"Frontmatter description is non-empty and accurate\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(fm_desc) > 10 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"description='{fm_desc[:80]}...' (len={len(fm_desc)})\\\" if fm_desc else \\\"description is empty\\\",\\n        \\\"expected\\\": \\\"Non-empty description\\\",\\n        \\\"actual\\\": f\\\"len={len(fm_desc)}\\\"\\n    })\\n    \\n    # V-IDENTITY-03: user-invocable setting\\n    fm_invocable = fm.get(\\\"user-invocable\\\", \\\"\\\")\\n    if is_guide:\\n        expected_inv = \\\"true\\\"\\n    else:\\n        expected_inv = \\\"false\\\"\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n        \\\"description\\\": f\\\"user-invocable is {'true' for guide, 'false' otherwise}\\\",\\n        \\\"result\\\": \\\"pass\\\" if fm_invocable == expected_inv else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"user-invocable='{fm_invocable}', level='{level}'\\\",\\n        \\\"expected\\\": expected_inv,\\n        \\\"actual\\\": fm_invocable\\n    })\\n    \\n    # V-IDENTITY-04: Correct naming prefix\\n    has_prefix = name.startswith(NAMING_PREFIX)\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\",\\n        \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_prefix else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{name}', prefix='{NAMING_PREFIX}'\\\",\\n        \\\"expected\\\": f\\\"Starts with '{NAMING_PREFIX}'\\\",\\n        \\\"actual\\\": name[:len(NAMING_PREFIX)]\\n    })\\n    \\n    # ===== SECTION PRESENCE =====\\n    \\n    # V-SECTION-01: H1 heading exists\\n    h1_match = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    h1_text = h1_match.group(1).strip() if h1_match else \\\"\\\"\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\",\\n        \\\"description\\\": \\\"H1 heading exists and matches display name from roster\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1_match else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1='{h1_text}', displayName='{display_name}'\\\",\\n        \\\"expected\\\": display_name,\\n        \\\"actual\\\": h1_text\\n    })\\n    \\n    # V-SECTION-02: Role description paragraph exists\\n    # Check for substantial text after frontmatter but before first ##\\n    post_fm = content\\n    if content.startswith(\\\"---\\\"):\\n        end = content.find(\\\"---\\\", 3)\\n        if end > 0:\\n            post_fm = content[end+3:]\\n    # Find text between H1 and first H2\\n    h1_pos = post_fm.find(\\\"\\\\n# \\\")\\n    if h1_pos < 0:\\n        h1_pos = 0\\n    h2_pos = post_fm.find(\\\"\\\\n## \\\", h1_pos + 1)\\n    if h2_pos < 0:\\n        h2_pos = len(post_fm)\\n    role_text = post_fm[h1_pos:h2_pos].strip()\\n    # Remove the H1 line itself\\n    role_lines = [l for l in role_text.split(\\\"\\\\n\\\") if l.strip() and not l.startswith(\\\"#\\\")]\\n    has_role_desc = len(role_lines) > 0 and any(len(l) > 20 for l in role_lines)\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\",\\n        \\\"description\\\": \\\"Role description paragraph exists (non-empty)\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_role_desc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found {len(role_lines)} role description lines\\\" + (f\\\": '{role_lines[0][:60]}...'\\\" if role_lines else \\\"\\\"),\\n        \\\"expected\\\": \\\"Non-empty role description\\\",\\n        \\\"actual\\\": f\\\"{len(role_lines)} lines\\\"\\n    })\\n    \\n    # V-SECTION-03: ask_questions suppression (except guide)\\n    has_aq_suppress = bool(re.search(r'ask_questions|never.*ask.*human|do not.*ask.*user|must not.*request.*human|never use.*ask_questions', content, re.IGNORECASE))\\n    if is_guide:\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression (N/A for guide)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide agent — ask_questions suppression not required\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression line present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_aq_suppress else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"ask_questions suppression {'found' if has_aq_suppress else 'NOT found'} in {name}\\\",\\n            \\\"expected\\\": \\\"ask_questions suppression present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_aq_suppress else \\\"absent\\\"\\n        })\\n    \\n    # V-SECTION-04: Context section exists\\n    has_context = has_section_fuzzy(content, \\\"Context\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\",\\n        \\\"description\\\": \\\"## Context section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_context else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Context section {'found' if has_context else 'NOT found'}\\\",\\n        \\\"expected\\\": \\\"## Context section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_context else \\\"absent\\\"\\n    })\\n    \\n    # V-SECTION-05: Inputs section exists\\n    has_inputs = has_section_fuzzy(content, \\\"Inputs\\\") or has_section_fuzzy(content, \\\"Input\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\",\\n        \\\"description\\\": \\\"## Inputs section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inputs else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Inputs section {'found' if has_inputs else 'NOT found'}\\\",\\n        \\\"expected\\\": \\\"## Inputs section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_inputs else \\\"absent\\\"\\n    })\\n    \\n    # V-SECTION-06: Write Rules section exists\\n    has_write_rules = has_section_fuzzy(content, \\\"Write Rules\\\") or has_section_fuzzy(content, \\\"Write Rule\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-06\\\",\\n        \\\"description\\\": \\\"## Write Rules section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_write_rules else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Write Rules section {'found' if has_write_rules else 'NOT found'}\\\",\\n        \\\"expected\\\": \\\"## Write Rules section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_write_rules else \\\"absent\\\"\\n    })\\n    \\n    # V-SECTION-07: Status Contract section exists\\n    has_status = has_section_fuzzy(content, \\\"Status Contract\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\",\\n        \\\"description\\\": \\\"## Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_status else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Status Contract section {'found' if has_status else 'NOT found'}\\\",\\n        \\\"expected\\\": \\\"## Status Contract section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_status else \\\"absent\\\"\\n    })\\n    \\n    # ===== TYPE-SPECIFIC CHECKS =====\\n    \\n    # V-TYPE-01: Specialists have ## Process with >= 2 numbered steps\\n    if is_specialist:\\n        has_process = has_section_fuzzy(content, \\\"Process\\\")\\n        process_content = get_section_content(content, \\\"Process\\\")\\n        step_count = count_numbered_steps(process_content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has ## Process with >= 2 numbered steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_process and step_count >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section {'found' if has_process else 'NOT found'}, {step_count} numbered steps\\\",\\n            \\\"expected\\\": \\\">= 2 numbered steps\\\",\\n            \\\"actual\\\": f\\\"{step_count} steps\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has ## Process with >= 2 numbered steps\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is '{level}', not specialist\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-02: Coordinators have ## Purity Rule\\n    if is_coordinator or is_orchestrator:\\n        has_purity = has_section_fuzzy(content, \\\"Purity Rule\\\") or has_section_fuzzy(content, \\\"Purity\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator/Orchestrator has ## Purity Rule section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_purity else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Purity Rule section {'found' if has_purity else 'NOT found'}\\\",\\n            \\\"expected\\\": \\\"## Purity Rule section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_purity else \\\"absent\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator has ## Purity Rule section\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is '{level}', not coordinator/orchestrator\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-03: Coordinators have ## Routing Table\\n    if is_coordinator or is_orchestrator:\\n        has_routing = has_section_fuzzy(content, \\\"Routing Table\\\") or has_section_fuzzy(content, \\\"Routing\\\") or has_section_fuzzy(content, \\\"Pipeline Routing\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator/Orchestrator has ## Routing Table section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_routing else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table section {'found' if has_routing else 'NOT found'}\\\",\\n            \\\"expected\\\": \\\"## Routing Table section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_routing else \\\"absent\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator has ## Routing Table section\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is '{level}', not coordinator/orchestrator\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-04: Coordinators do NOT have ## Process section\\n    if is_coordinator or is_orchestrator:\\n        has_process = has_section_fuzzy(content, \\\"Process\\\")\\n        # \\\"Process\\\" can appear as part of other section names, so be specific\\n        # Only flag if there's a standalone ## Process or ### Process section\\n        process_pattern = r'^#{2,3}\\\\s+Process\\\\s*$'\\n        has_standalone_process = bool(re.search(process_pattern, content, re.MULTILINE))\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have ## Process section\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_standalone_process else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Standalone Process section {'found (violation!)' if has_standalone_process else 'not found (correct)'}\\\",\\n            \\\"expected\\\": \\\"No ## Process section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_standalone_process else \\\"absent\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have ## Process section\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is '{level}', not coordinator\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-05: Orchestrator has ## Pipeline Routing\\n    if is_orchestrator:\\n        has_pipeline = has_section_fuzzy(content, \\\"Pipeline Routing\\\") or has_section_fuzzy(content, \\\"Pipeline\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator has ## Pipeline Routing section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pipeline else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Pipeline Routing section {'found' if has_pipeline else 'NOT found'}\\\",\\n            \\\"expected\\\": \\\"## Pipeline Routing section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_pipeline else \\\"absent\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator has ## Pipeline Routing section\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is '{level}', not orchestrator\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-06: Anti-laziness agents have ## Anti-Laziness Rules with >= 4 rules\\n    if is_auditor:\\n        has_al = has_section_fuzzy(content, \\\"Anti-Laziness\\\")\\n        al_content = get_section_content(content, \\\"Anti-Laziness\\\")\\n        al_rules = len(re.findall(r'^\\\\d+\\\\.', al_content, re.MULTILINE))\\n        # Also count bullet points as rules\\n        al