le has pipeline structure (sequential coordinator dispatch)\\n        rt = get_section(content, \\\"Routing Table\\\")\\n        has_pipeline = \\\"concept-coordinator\\\" in rt and \\\"polish-coordinator\\\" in rt\\n        checks.append({\\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator pipeline routing complete\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pipeline else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"Pipeline from concept to polish \\\" + (\\\"found\\\" if has_pipeline else \\\"missing\\\"),\\n            \\\"expected\\\": \\\"full pipeline\\\", \\\"actual\\\": \\\"complete\\\" if has_pipeline else \\\"incomplete\\\"})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Pipeline Routing (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"level=\\\" + level, \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-TYPE-06: Auditor Anti-Laziness Rules\\n    if is_auditor:\\n        has_al = has_section(content, \\\"Anti-Laziness\\\")\\n        al = get_section(content, \\\"Anti-Laziness\\\")\\n        al_count = max(count_steps(al), len(re.findall(r'^[\\\\-\\\\*]\\\\s+', al, re.MULTILINE)))\\n        checks.append({\\\"id\\\": \\\"V-TYPE-06\\\", \\\"description\\\": \\\"Auditor Anti-Laziness >= 4 rules\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_al and al_count >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"Anti-Laziness \\\" + (\\\"found\\\" if has_al else \\\"missing\\\") + \\\", \\\" + str(al_count) + \\\" rules\\\",\\n            \\\"expected\\\": \\\">= 4\\\", \\\"actual\\\": str(al_count)})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-TYPE-06\\\", \\\"description\\\": \\\"Anti-Laziness (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"not auditor\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # ========== CONTENT CORRECTNESS ==========\\n    \\n    # V-CONTENT-01: Result codes match roster\\n    rc_section = get_section(content, \\\"Result Codes\\\")\\n    if rcodes:\\n        missing_rc = [c for c in rcodes if c not in rc_section and c not in content]\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-01\\\", \\\"description\\\": \\\"Result codes match roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_rc else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"expected=\\\" + str(rcodes) + \\\" missing=\\\" + str(missing_rc) if missing_rc else \\\"All codes found: \\\" + str(rcodes),\\n            \\\"expected\\\": str(rcodes), \\\"actual\\\": str([c for c in rcodes if c in rc_section or c in content])})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-01\\\", \\\"description\\\": \\\"Result codes (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"No result codes in roster\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-CONTENT-02: Routing covers children's codes\\n    if is_router and children:\\n        rt = get_section(content, \\\"Routing Table\\\") or \\\"\\\"\\n        if not rt:\\n            rt = content  # fallback\\n        missing = []\\n        for ch in children:\\n            ch_entry = roster_agents.get(ch, {})\\n            ch_codes = ch_entry.get(\\\"resultCodes\\\", [])\\n            for code in ch_codes:\\n                # The code must appear somewhere in routing context\\n                if code not in rt:\\n                    missing.append(ch.replace(PREFIX + \\\"-\\\", \\\"\\\") + \\\":\\\" + code)\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing covers all child result codes\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"Missing: \\\" + str(missing) if missing else \\\"All \\\" + str(len(children)) + \\\" children's codes covered\\\",\\n            \\\"expected\\\": \\\"all handled\\\", \\\"actual\\\": str(len(missing)) + \\\" missing\\\" if missing else \\\"all covered\\\"})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Child routing (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"not router or no children\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-CONTENT-03: Metadata Parent matches roster\\n    meta_parent = meta.get(\\\"Parent\\\", \\\"\\\")\\n    checks.append({\\\"id\\\": \\\"V-CONTENT-03\\\", \\\"description\\\": \\\"Metadata Parent matches roster\\\",\\n        \\\"result\\\": \\\"pass\\\" if meta_parent == parent else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"meta=\\\" + repr(meta_parent) + \\\" roster=\\\" + repr(parent),\\n        \\\"expected\\\": parent, \\\"actual\\\": meta_parent})\\n    \\n    # V-CONTENT-04: Metadata Children match roster\\n    if children:\\n        meta_children_str = meta.get(\\\"Children\\\", \\\"\\\")\\n        meta_children = [c.strip() for c in meta_children_str.split(\\\",\\\") if c.strip()]\\n        missing_ch = [c for c in children if c not in meta_children]\\n        extra_ch = [c for c in meta_children if c not in children]\\n        ch_match = not missing_ch and not extra_ch\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-04\\\", \\\"description\\\": \\\"Metadata Children match roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if ch_match else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"missing=\\\" + str(missing_ch) + \\\" extra=\\\" + str(extra_ch) if not ch_match else \\\"All \\\" + str(len(children)) + \\\" children match\\\",\\n            \\\"expected\\\": str(len(children)) + \\\" children\\\", \\\"actual\\\": str(len(meta_children)) + \\\" in metadata\\\"})\\n    else:\\n        # Specialists/Guide may have children=[] but metadata may or may not list Children\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-04\\\", \\\"description\\\": \\\"Children metadata (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"no children in roster\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-CONTENT-05: INV-030 referenced (gap fix check)\\n    has_inv030 = \\\"INV-030\\\" in content\\n    checks.append({\\\"id\\\": \\\"V-CONTENT-05\\\", \\\"description\\\": \\\"INV-030 (No Silent Failures) referenced\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inv030 else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"INV-030 \\\" + (\\\"found\\\" if has_inv030 else \\\"NOT found\\\") + \\\" (gap fix IE-001)\\\",\\n        \\\"expected\\\": \\\"referenced\\\", \\\"actual\\\": \\\"present\\\" if has_inv030 else \\\"absent\\\"})\\n    \\n    # V-CONTENT-06: Artifact Assignments has Reads/Writes\\n    art_section = get_section(content, \\\"Artifact Assignments\\\")\\n    has_reads = bool(re.search(r'\\\\*\\\\*Reads?\\\\*\\\\*:', art_section))\\n    has_writes = bool(re.search(r'\\\\*\\\\*Writes?\\\\*\\\\*:', art_section))\\n    checks.append({\\\"id\\\": \\\"V-CONTENT-06\\\", \\\"description\\\": \\\"Artifact Assignments has Reads/Writes\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_reads and has_writes else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"Reads=\\\" + str(has_reads) + \\\" Writes=\\\" + str(has_writes),\\n        \\\"expected\\\": \\\"both present\\\", \\\"actual\\\": \\\"Reads=\\\" + str(has_reads) + \\\" Writes=\\\" + str(has_writes)})\\n    \\n    # ========== CONSISTENCY CHECKS ==========\\n    \\n    # V-CONSIST-03: Parent referenced in body\\n    if parent and parent != \\\"user\\\":\\n        parent_ref = parent in content\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-03\\\", \\\"description\\\": \\\"Parent referenced in prompt\\\",\\n            \\\"result\\\": \\\"pass\\\" if parent_ref else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"parent=\\\" + parent + \\\" \\\" + (\\\"referenced\\\" if parent_ref else \\\"NOT referenced\\\"),\\n            \\\"expected\\\": \\\"referenced\\\", \\\"actual\\\": \\\"present\\\" if parent_ref else \\\"absent\\\"})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-03\\\", \\\"description\\\": \\\"Parent reference (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"parent=\\\" + parent, \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-CONSIST-04: Children referenced in body\\n    if children:\\n        missing_ch = [c for c in children if c not in content]\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-04\\\", \\\"description\\\": \\\"All children referenced in prompt\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_ch else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"missing=\\\" + str(missing_ch) if missing_ch else \\\"All \\\" + str(len(children)) + \\\" referenced\\\",\\n            \\\"expected\\\": str(len(children)) + \\\" children\\\", \\\"actual\\\": str(len(children) - len(missing_ch)) + \\\"/\\\" + str(len(children))})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-04\\\", \\\"description\\\": \\\"Children refs (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"no children\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # ========== ANTI-LAZINESS ==========\\n    \\n    # V-ANTILAZY-01: No placeholders\\n    lazy_patterns = [\\n        (r'\\\\bTODO\\\\b', 'TODO'), (r'\\\\bFIXME\\\\b', 'FIXME'),\\n        (r'\\\\bimplement later\\\\b', 'implement later'), (r'\\\\bplaceholder\\\\b', 'placeholder'),\\n        (r'\\\\bTBD\\\\b', 'TBD'), (r'\\\\bcoming soon\\\\b', 'coming soon'),\\n    ]\\n    found_lazy = [desc for pat, desc in lazy_patterns if re.search(pat, content, re.IGNORECASE)]\\n    checks.append({\\\"id\\\": \\\"V-ANTILAZY-01\\\", \\\"description\\\": \\\"No TODO/TBD/placeholder markers\\\",\\n        \\\"result\\\": \\\"fail\\\" if found_lazy else \\\"pass\\\",\\n        \\\"evidence\\\": \\\"Found: \\\" + str(found_lazy) if found_lazy else \\\"Clean\\\",\\n        \\\"expected\\\": \\\"none\\\", \\\"actual\\\": str(found_lazy) if found_lazy else \\\"clean\\\"})\\n    \\n    # V-ANTILAZY-02: No empty required sections\\n    empty = []\\n    for sec in [\\\"Role\\\", \\\"Key Invariants\\\", \\\"Artifact Assignments\\\", \\\"Result Codes\\\", \\\"Status Contract\\\", \\\"Skills\\\"]:\\n        if has_section(content, sec):\\n            sc = get_section(content, sec)\\n            if len(sc.strip()) < 10:\\n                empty.append(sec)\\n    checks.append({\\\"id\\\": \\\"V-ANTILAZY-02\\\", \\\"description\\\": \\\"No empty required sections\\\",\\n        \\\"result\\\": \\\"fail\\\" if empty else \\\"pass\\\",\\n        \\\"evidence\\\": \\\"Empty: \\\" + str(empty) if empty else \\\"All populated\\\",\\n        \\\"expected\\\": \\\"none empty\\\", \\\"actual\\\": str(empty) if empty else \\\"all populated\\\"})\\n    \\n    # V-ANTILAZY-03: Skills section references at least 1 skill path\\n    skills_sec = get_section(content, \\\"Skills\\\")\\n    skill_refs = re.findall(r'skills/[^\\\\s*`]+', skills_sec)\\n    checks.append({\\\"id\\\": \\\"V-ANTILAZY-03\\\", \\\"description\\\": \\\"Skills section references skill paths\\\",\\n        \\\"result\\\": \\\"pass\\\" if skill_refs else \\\"fail\\\",\\n        \\\"evidence\\\": str(len(skill_refs)) + \\\" skill refs: \\\" + str(skill_refs[:3]),\\n        \\\"expected\\\": \\\">= 1 skill\\\", \\\"actual\\\": str(len(skill_refs)) + \\\" refs\\\"})\\n    \\n    return checks\\n\\n\\n# ===== MAIN EXECUTION =====\\nprint(\\\"=\\\" * 60)\\nprint(\\\"CHECKLIST VALIDATION — Iteration 2 (Re-entry)\\\")\\nprint(\\\"=\\\" * 60)\\n\\n# Global consistency\\nconsistency = []\\nmissing_files = roster_names - agent_files_on_disk\\nextra_files = agent_files_on_disk - roster_names\\n\\nconsistency.append({\\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"Every roster agent has prompt file\\\",\\n    \\\"result\\\": \\\"pass\\\" if not missing_files else \\\"fail\\\",\\n    \\\"evidence\\\": \\\"Missing: \\\" + str(sorted(missing_files)) if missing_files else \\\"All \\\" + str(len(roster_names)) + \\\" present\\\",\\n    \\\"expected\\\": str(len(roster_names)), \\\"actual\\\": str(len(roster_names) - len(missing_files))})\\n\\nconsistency.append({\\\"id\\\": \\\"V-CONSIST-02\\\", \\\"description\\\": \\\"No orphan agent files\\\",\\n    \\\"result\\\": \\\"pass\\\" if not extra_files else \\\"fail\\\",\\n    \\\"evidence\\\": \\\"Extra: \\\" + str(sorted(extra_files)) if extra_files else \\\"No orphans\\\",\\n    \\\"expected\\\": \\\"0 extra\\\", \\\"actual\\\": str(len(extra_files))})\\n\\n# Validate each agent\\nagent_results = []\\nfor name in sorted(roster_agents.keys()):\\n    checks = validate_agent(name, roster_agents[name])\\n    p = sum(1 for c in checks if c[\\\"result\\\"] == \\\"pass\\\")\\n    f = sum(1 for c in checks if c[\\\"result\\\"] == \\\"fail\\\")\\n    na = sum(1 for c in checks if c[\\\"result\\\"] == \\\"not-applicable\\\")\\n    g_pass += p; g_fail += f; g_na += na\\n    agent_results.append({\\\"agent\\\": name, \\\"verdict\\\": \\\"pass\\\" if f == 0 else \\\"fail\\\",\\n        \\\"score\\\": str(p) + \\\"/\\\" + str(p + f), \\\"failCount\\\": f, \\\"checks\\\": checks})\\n\\nfor c in consistency:\\n    if c[\\\"result\\\"] == \\\"pass\\\": g_pass += 1\\n    elif c[\\\"result\\\"] == \\\"fail\\\": g_fail += 1\\n    else: g_na += 1\\n\\ntotal = g_pass + g_fail\\npct = round(100 * g_pass / total, 1) if total else 0\\n\\n# Identify critical failures (V-CONTENT-* and V-CONSIST-*)\\ncritical = []\\nfor ar in agent_results:\\n    for c in ar[\\\"checks\\\"]:\\n        if c[\\\"result\\\"] == \\\"fail\\\" and c[\\\"id\\\"].startswith((\\\"V-CONTENT-\\\", \\\"V-CONSIST-\\\")):\\n            critical.append(ar[\\\"agent\\\"] + \\\": \\\" + c[\\\"id\\\"] + \\\" - \\\" + c[\\\"evidence\\\"][:100])\\nfor c in consistency:\\n    if c[\\\"result\\\"] == \\\"fail\\\":\\n        critical.append(\\\"GLOBAL: \\\" + c[\\\"id\\\"] + \\\" - \\\" + c[\\\"evidence\\\"][:100])\\n\\nverdict = \\\"fail\\\" if critical else \\\"pass\\\"\\nap = sum(1 for ar in agent_results if ar[\\\"verdict\\\"] == \\\"pass\\\")\\naf = sum(1 for ar in agent_results if ar[\\\"verdict\\\"] == \\\"fail\\\")\\n\\n# Print results\\nprint()\\nprint(\\\"OVERALL VERDICT:\\\", verdict.upper())\\nprint(\\\"Score:\\\", g_pass, \\\"/\\\", total, \\\"(\\\", pct, \\\"%)\\\")\\nprint(\\\"Agents: total=\\\" + str(len(agent_results)), \\\"passing=\\\" + str(ap), \\\"failing=\\\" + str(af))\\nprint(\\\"Checks: total=\\\" + str(total), \\\"pass=\\\" + str(g_pass), \\\"fail=\\\" + str(g_fail), \\\"N/A=\\\" + str(g_na))\\nprint(\\\"Critical failures:\\\", len(critical))\\nprint()\\n\\n# Print failing agents detail\\nif g_fail > 0:\\n    print(\\\"=\\\" * 60)\\n    print(\\\"FAILURES BY AGENT\\\")\\n    print(\\\"=\\\" * 60)\\n    for ar in agent_results:\\n        if ar[\\\"verdict\\\"] == \\\"fail\\\":\\n            fails = [c for c in ar[\\\"checks\\\"] if c[\\\"result\\\"] == \\\"fail\\\"]\\n            print()\\n            print(\\\"[FAIL]\\\", ar[\\\"agent\\\"], \\\"(\\\" + ar[\\\"score\\\"] + \\\") -\\\", ar[\\\"failCount\\\"], \\\"failures:\\\")\\n            for c in fails:\\n                crit_marker = \\\" [CRITICAL]\\\" if c[\\\"id\\\"].startswith((\\\"V-CONTENT-\\\", \\\"V-CONSIST-\\\")) else \\\"\\\"\\n                print(\\\"  \\\", c[\\\"id\\\"], c[\\\"description\\\"], \\\"->\\\", c[\\\"evidence\\\"][:120], crit_marker)\\n\\nif critical:\\n    print()\\n    print(\\\"=\\\" * 60)\\n    print(\\\"CRITICAL FAILURES (blocking)\\\")\\n    print(\\\"=\\\" * 60)\\n    for cf in critical:\\n        print(\\\"  *\\\", cf)\\n\\n# Write report\\nreport = {\\n    \\\"version\\\": 2, \\\"lastUpdated\\\": datetime.now(timezone.utc).isoformat(), \\\"iteration\\\": 2,\\n    \\\"overallVerdict\\\": verdict, \\\"overallScore\\\": str(g_pass) + \\\"/\\\" + str(total) + \\\" (\\\" + str(pct) + \\\"%)\\\",\\n    \\\"agentResults\\\": agent_results,\\n    \\\"infrastructureResults\\\": {\\\"bootstrapChecks\\\": [], \\\"schemaChecks\\\": [], \\\"consistencyChecks\\\": consistency},\\n    \\\"summary\\\": {\\\"totalAgents\\\": len(agent_results), \\\"agentsPassing\\\": ap, \\\"agentsFailing\\\": af,\\n        \\\"totalChecks\\\": total, \\\"checksPassing\\\": g_pass, \\\"checksFailing\\\": g_fail, \\\"checksNA\\\": g_na,\\n        \\\"criticalFailures\\\": critical}\\n}\\nwith open(\\\"/tmp/validation_report_v2.json\\\", \\\"w\\\") as f:\\n    json.dump(report, f, indent=2)\\nprint(\\\"\\\\nReport saved to /tmp/validation_report_v2.json\\\")\\nPYEOF\", \"description\": \"Run adapted validation script\", \"initial_wait\": 45}"
