s Rules')\\n        al_count = count_numbered_items(al)\\n        checks.append({\\n            'id': 'V-TYPE-06', 'description': 'Auditor Anti-Laziness >=4 rules',\\n            'result': 'pass' if al_count >= 4 else 'fail',\\n            'evidence': f\\\"Anti-Laziness rules: {al_count}\\\"\\n        })\\n    else:\\n        checks.append({'id': 'V-TYPE-06', 'description': 'Anti-Laziness', 'result': 'not-applicable', 'evidence': f'type={atype}'})\\n    \\n    # ===== CONTENT CORRECTNESS =====\\n    # V-CONTENT-01: Result codes match roster\\n    rc_text = get_section_text(content, 'Result Codes')\\n    sc_text = get_section_text(content, 'Status Contract')\\n    combined_rc = rc_text + '\\\\n' + sc_text\\n    if result_codes:\\n        found = [c for c in result_codes if c in combined_rc]\\n        missing = [c for c in result_codes if c not in combined_rc]\\n        checks.append({\\n            'id': 'V-CONTENT-01', 'description': 'Result codes match roster',\\n            'result': 'pass' if not missing else 'fail',\\n            'evidence': f\\\"roster={result_codes}, found={found}, missing={missing}\\\"\\n        })\\n    else:\\n        checks.append({'id': 'V-CONTENT-01', 'description': 'Result codes', 'result': 'not-applicable', 'evidence': 'No result codes in roster'})\\n    \\n    # V-CONTENT-02: Routing table covers children (coordinators)\\n    if atype in ('coordinator', 'orchestrator') and children:\\n        rt = get_section_text(content, 'Routing Table')\\n        missing_children = []\\n        for child in children:\\n            short = child.replace(PREFIX + '-', '')\\n            if short not in rt and child not in rt:\\n                missing_children.append(child)\\n        checks.append({\\n            'id': 'V-CONTENT-02', 'description': 'Routing covers all children',\\n            'result': 'pass' if not missing_children else 'fail',\\n            'evidence': f\\\"{len(children)} children, missing from RT: {missing_children}\\\"\\n       