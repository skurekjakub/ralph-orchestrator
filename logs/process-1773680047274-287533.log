              "arguments": "{\"command\": \"cat > /tmp/validate_v2.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nComprehensive checklist validator v2 for romantic-fantasy-writer agent system.\\nAdapted to the actual template format (inline metadata, not YAML frontmatter).\\n\\\"\\\"\\\"\\nimport json, os, re, sys\\nfrom datetime import datetime, timezone\\n\\nBASE = \\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory\\\"\\nOUTPUT = os.path.join(BASE, \\\"output/romantic-fantasy-writer\\\")\\nAGENTS_DIR = os.path.join(OUTPUT, \\\"agents\\\")\\nSCHEMAS_DIR = os.path.join(OUTPUT, \\\"schemas\\\")\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\n\\n# Load data files\\nwith open(os.path.join(BASE, \\\"roster.json\\\")) as f:\\n    roster_data = json.load(f)\\nroster_agents = roster_data.get(\\\"agents\\\", roster_data.get(\\\"roster\\\", []))\\n\\nwith open(os.path.join(BASE, \\\"architecture.json\\\")) as f:\\n    arch_data = json.load(f)\\n\\nwith open(os.path.join(BASE, \\\"routing.json\\\")) as f:\\n    routing_data = json.load(f)\\n\\n# Build roster lookup\\nroster_by_name = {a[\\\"name\\\"]: a for a in roster_agents}\\n\\ndef classify_agent(agent_info):\\n    name = agent_info[\\\"name\\\"]\\n    children = agent_info.get(\\\"children\\\", [])\\n    if name == f\\\"{NAMING_PREFIX}-guide\\\":\\n        return \\\"guide\\\"\\n    elif name == NAMING_PREFIX:\\n        return \\\"orchestrator\\\"\\n    elif len(children) > 0:\\n        return \\\"coordinator\\\"\\n    elif \\\"auditor\\\" in name:\\n        return \\\"auditor\\\"\\n    else:\\n        return \\\"specialist\\\"\\n\\ndef parse_inline_meta(content):\\n    \\\"\\\"\\\"Parse inline metadata like **Agent ID:** A-001, **Level:** specialist\\\"\\\"\\\"\\n    meta = {}\\n    patterns = {\\n        \\\"agent_id\\\": r'\\\\*\\\\*Agent ID:\\\\*\\\\*\\\\s*(.+)',\\n        \\\"level\\\": r'\\\\*\\\\*Level:\\\\*\\\\*\\\\s*(.+)',\\n        \\\"parent\\\": r'\\\\*\\\\*Parent:\\\\*\\\\*\\\\s*(.+)',\\n        \\\"pass_phase\\\": r'\\\\*\\\\*Pass/Phase:\\\\*\\\\*\\\\s*(.+)',\\n    }\\n    for key, pat in patterns.items():\\n        m = re.search(pat, content)\\n        if m:\\n            meta[key] = m.group(1).strip()\\n    return meta\\n\\ndef has_section(content, heading):\\n    pattern = r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    return bool(re.search(pattern, content, re.MULTILINE))\\n\\ndef has_section_flexible(content, *headings):\\n    \\\"\\\"\\\"Check if any of the given headings exist as ## sections\\\"\\\"\\\"\\n    for h in headings:\\n        if has_section(content, h):\\n            return True\\n    return False\\n\\ndef get_h1(content):\\n    m = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    return m.group(1).strip() if m else None\\n\\ndef get_section_text(content, heading):\\n    \\\"\\\"\\\"Extract text of a section from ## heading to next ##\\\"\\\"\\\"\\n    pattern = r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    m = re.search(pattern, content, re.MULTILINE)\\n    if not m:\\n        return \\\"\\\"\\n    start = m.end()\\n    next_sect = re.search(r'^##\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_sect.start() if next_sect else len(content)\\n    return content[start:end].strip()\\n\\ndef count_numbered_steps(section_text):\\n    return len(re.findall(r'^\\\\d+\\\\.', section_text, re.MULTILINE))\\n\\ndef count_steps_in_subsections(content, heading):\\n    \\\"\\\"\\\"Count ### Step N subsections within a ## section\\\"\\\"\\\"\\n    section_text = get_section_text(content, heading)\\n    steps = re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', section_text, re.MULTILINE)\\n    if steps:\\n        return len(steps)\\n    # Also count bare numbered items\\n    return count_numbered_steps(section_text)\\n\\ndef has_ask_questions_suppression(content):\\n    patterns = [\\n        r'must\\\\s+never\\\\s+use\\\\s+`?ask_questions`?',\\n        r'never\\\\s+use\\\\s+`?ask_questions`?',\\n        r'do\\\\s+not\\\\s+use\\\\s+`?ask_questions`?',\\n        r'NEVER.*ask_questions',\\n        r'never.*request\\\\s+human\\\\s+input',\\n    ]\\n    for p in patterns:\\n        if re.search(p, content, re.IGNORECASE):\\n            return True\\n    return False\\n\\ndef extract_result_codes(content):\\n    \\\"\\\"\\\"Extract result codes from ## Result Codes section\\\"\\\"\\\"\\n    codes = set()\\n    section = get_section_text(content, \\\"Result Codes\\\")\\n    if not section:\\n        return codes\\n    # Format: **code**, **code**, **code**  OR  - **code** — description\\n    for m in re.finditer(r'\\\\*\\\\*([a-z][a-z0-9-]*)\\\\*\\\\*', section):\\n        codes.add(m.group(1))\\n    return codes\\n\\ndef extract_status_contract_codes(content):\\n    \\\"\\\"\\\"Also look for result codes in Status Contract\\\"\\\"\\\"\\n    codes = set()\\n    section = get_section_text(content, \\\"Status Contract\\\")\\n    for m in re.finditer(r'\\\"result\\\"\\\\s*:\\\\s*\\\"([a-z][a-z0-9-]*)\\\"', section):\\n        codes.add(m.group(1))\\n    for m in re.finditer(r'`([a-z][a-z0-9-]*)`', section):\\n        code = m.group(1)\\n        if code not in ('status', 'result', 'agent', 'task_id', 'summary', 'next_hint',\\n                         'artifacts', 'iteration', 'status.json', 'json', 'startTime',\\n                         'endTime', 'artifactsProduced', 'metadata', 'manifest.json',\\n                         'progress.json', 'story-config.json', 'delivery-report.json'):\\n            codes.add(code)\\n    return codes\\n\\ndef check_routing_covers_children(content, children):\\n    \\\"\\\"\\\"Check that all children are mentioned in the Routing Table\\\"\\\"\\\"\\n    rt_text = get_section_text(content, \\\"Routing Table\\\")\\n    if not rt_text:\\n        return [], children\\n    mentioned = []\\n    missing = []\\n    for child in children:\\n        short = child.replace(f\\\"{NAMING_PREFIX}-\\\", \\\"\\\")\\n        if child in rt_text or short in rt_text:\\n            mentioned.append(child)\\n        else:\\n            missing.append(child)\\n    return mentioned, missing\\n\\n# ============ RUN ALL CHECKS ============\\nall_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\ntotal_checks = 0\\nagents_passing = 0\\nagents_failing = 0\\ncritical_failures = []\\n\\nagent_files = [f for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md')]\\nagent_names_on_disk = set(f.replace('.agent.md', '') for f in agent_files)\\nroster_names = set(a[\\\"name\\\"] for a in roster_agents)\\n\\nconsist01_missing = roster_names - agent_names_on_disk\\nconsist02_extra = agent_names_on_disk - roster_names\\n\\nfor agent_info in roster_agents:\\n    name = agent_info[\\\"name\\\"]\\n    atype = classify_agent(agent_info)\\n    result_codes = set(agent_info.get(\\\"resultCodes\\\", agent_info.get(\\\"result_codes\\\", [])))\\n    children = agent_info.get(\\\"children\\\", [])\\n    parent = agent_info.get(\\\"parent\\\", \\\"\\\")\\n    display = agent_info.get(\\\"displayName\\\", agent_info.get(\\\"display_name\\\", \\\"\\\"))\\n    \\n    agent_file = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    checks = []\\n    \\n    if not os.path.exists(agent_file):\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"Agent has prompt file\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": f\\\"File missing: {name}.agent.md\\\",\\n            \\\"expected\\\": f\\\"{name}.agent.md\\\", \\\"actual\\\": \\\"missing\\\"})\\n        all_results.append({\\\"agent\\\": name, \\\"type\\\": atype, \\\"checks\\\": checks})\\n        continue\\n    \\n    with open(agent_file) as f:\\n        content = f.read()\\n    \\n    meta = parse_inline_meta(content)\\n    h1 = get_h1(content)\\n    \\n    # ====== V-IDENTITY-01: Agent ID/name present and consistent ======\\n    # In this format, identity is via **Agent ID:** and filename\\n    # Check that the file has metadata identifying it\\n    has_agent_id = bool(meta.get(\\\"agent_id\\\"))\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-01\\\",\\n        \\\"description\\\": \\\"Agent has identifying metadata (Agent ID)\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_agent_id else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Agent ID: '{meta.get('agent_id','')}'\\\",\\n        \\\"expected\\\": \\\"Agent ID present\\\", \\\"actual\\\": meta.get(\\\"agent_id\\\", \\\"(missing)\\\")\\n    })\\n    \\n    # ====== V-IDENTITY-02: Level matches classification ======\\n    meta_level = meta.get(\\\"level\\\", \\\"\\\")\\n    expected_level_map = {\\\"guide\\\": \\\"guide\\\", \\\"orchestrator\\\": \\\"orchestrator\\\", \\n                          \\\"coordinator\\\": \\\"coordinator\\\", \\\"specialist\\\": \\\"specialist\\\", \\\"auditor\\\": \\\"specialist\\\"}\\n    expected_level = expected_level_map.get(atype, \\\"\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\",\\n        \\\"description\\\": \\\"Level metadata matches agent classification\\\",\\n        \\\"result\\\": \\\"pass\\\" if meta_level == expected_level else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"level='{meta_level}', expected='{expected_level}' (type={atype})\\\",\\n        \\\"expected\\\": expected_level, \\\"actual\\\": meta_level\\n    })\\n    \\n    # ====== V-IDENTITY-03: user-invocable (guide=user-facing, others=not) ======\\n    # In this format, guide's parent is 'user', others are not\\n    if atype == \\\"guide\\\":\\n        check_inv = meta.get(\\\"parent\\\", \\\"\\\") == \\\"user\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n            \\\"description\\\": \\\"Guide is user-facing (parent=user)\\\",\\n            \\\"result\\\": \\\"pass\\\" if check_inv else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"parent='{meta.get('parent','')}'\\\",\\n            \\\"expected\\\": \\\"user\\\", \\\"actual\\\": meta.get(\\\"parent\\\", \\\"\\\")\\n        })\\n    else:\\n        # Non-guide agents should have a parent that's another agent\\n        check_inv = meta.get(\\\"parent\\\", \\\"\\\") != \\\"user\\\" and meta.get(\\\"parent\\\", \\\"\\\") != \\\"\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n            \\\"description\\\": \\\"Non-guide agent has agent parent (not user)\\\",\\n            \\\"result\\\": \\\"pass\\\" if check_inv else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"parent='{meta.get('parent','')}'\\\",\\n            \\\"expected\\\": \\\"agent parent\\\", \\\"actual\\\": meta.get(\\\"parent\\\", \\\"\\\")\\n        })\\n    \\n    # ====== V-IDENTITY-04: Name uses correct prefix ======\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\",\\n        \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if name.startswith(NAMING_PREFIX) else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{name}', prefix='{NAMING_PREFIX}'\\\",\\n        \\\"expected\\\": f\\\"starts with '{NAMING_PREFIX}'\\\", \\\"actual\\\": name\\n    })\\n    \\n    # ====== V-SECTION-01: H1 heading exists ======\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\",\\n        \\\"description\\\": \\\"H1 heading exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1='{h1}'\\\", \\\"expected\\\": \\\"H1 present\\\", \\\"actual\\\": h1 or \\\"(missing)\\\"\\n    })\\n    \\n    # ====== V-SECTION-02: Role section exists (serves as role description) ======\\n    has_role = has_section(content, \\\"Role\\\")\\n    role_text = get_section_text(content, \\\"Role\\\") if has_role else \\\"\\\"\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\",\\n        \\\"description\\\": \\\"Role section exists with substantive content\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_role and len(role_text) > 30 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Role found: {has_role}, text length: {len(role_text)}\\\",\\n        \\\"expected\\\": \\\"## Role with >30 chars\\\", \\\"actual\\\": f\\\"{'present' if has_role else 'missing'}, {len(role_text)} chars\\\"\\n    })\\n    \\n    # ====== V-SECTION-03: ask_questions suppression (except guide) ======\\n    if atype == \\\"guide\\\":\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression (guide exempt - user-facing)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide agent is user-facing\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    else:\\n        has_suppress = has_ask_questions_suppression(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_suppress else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Suppression found: {has_suppress}\\\",\\n            \\\"expected\\\": \\\"suppression present\\\", \\\"actual\\\": \\\"present\\\" if has_suppress else \\\"missing\\\"\\n        })\\n    \\n    # ====== V-SECTION-04: Key Invariants section (serves as Context) ======\\n    has_inv = has_section(content, \\\"Key Invariants\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\",\\n        \\\"description\\\": \\\"Key Invariants section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inv else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Key Invariants found: {has_inv}\\\",\\n        \\\"expected\\\": \\\"## Key Invariants section\\\", \\\"actual\\\": \\\"present\\\" if has_inv else \\\"missing\\\"\\n    })\\n    \\n    # ====== V-SECTION-05: Artifact Assignments section (serves as Inputs/Writes) ======\\n    has_aa = has_section(content, \\\"Artifact Assignments\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\",\\n        \\\"description\\\": \\\"Artifact Assignments section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_aa else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Artifact Assignments found: {has_aa}\\\",\\n        \\\"expected\\\": \\\"## Artifact Assignments section\\\", \\\"actual\\\": \\\"present\\\" if has_aa else \\\"missing\\\"\\n    })\\n    \\n    # ====== V-SECTION-06: Result Codes section exists ======\\n    has_rc = has_section(content, \\\"Result Codes\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-06\\\",\\n        \\\"description\\\": \\\"Result Codes section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_rc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Result Codes found: {has_rc}\\\",\\n        \\\"expected\\\": \\\"## Result Codes section\\\", \\\"actual\\\": \\\"present\\\" if has_rc else \\\"missing\\\"\\n    })\\n    \\n    # ====== V-SECTION-07: Status Contract section exists ======\\n    has_sc = has_section(content, \\\"Status Contract\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\",\\n        \\\"description\\\": \\\"Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_sc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Status Contract found: {has_sc}\\\",\\n        \\\"expected\\\": \\\"## Status Contract section\\\", \\\"actual\\\": \\\"present\\\" if has_sc else \\\"missing\\\"\\n    })\\n    \\n    # ====== V-TYPE-01: Specialists/Auditors have ## Process ======\\n    if atype in (\\\"specialist\\\", \\\"auditor\\\"):\\n        has_process = has_section(content, \\\"Process\\\")\\n        step_count = count_steps_in_subsections(content, \\\"Process\\\") if has_process else 0\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist/Auditor has Process section with >=2 steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_process and step_count >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process: {has_process}, steps: {step_count}\\\",\\n            \\\"expected\\\": \\\"Process with >=2 steps\\\", \\\"actual\\\": f\\\"{'present' if has_process else 'missing'}, {step_count} steps\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\", \\\"description\\\": \\\"Specialist Process (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-TYPE-02: Coordinators have Purity Rule ======\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\"):\\n        has_pr = has_section_flexible(content, \\\"Pure Router Purity Rule\\\", \\\"Purity Rule\\\", \\\"Pure Router\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator/Orchestrator has Purity Rule section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pr else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Purity Rule found: {has_pr}\\\",\\n            \\\"expected\\\": \\\"Purity Rule section\\\", \\\"actual\\\": \\\"present\\\" if has_pr else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\", \\\"description\\\": \\\"Coordinator Purity Rule (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-TYPE-03: Coordinators have Routing Table ======\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\"):\\n        has_rt = has_section(content, \\\"Routing Table\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator/Orchestrator has Routing Table section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_rt else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table found: {has_rt}\\\",\\n            \\\"expected\\\": \\\"Routing Table section\\\", \\\"actual\\\": \\\"present\\\" if has_rt else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\", \\\"description\\\": \\\"Coordinator Routing Table (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-TYPE-04: Coordinators do NOT have Process section ======\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\"):\\n        has_process = has_section(content, \\\"Process\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have Process section\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_process else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process found: {has_process}\\\",\\n            \\\"expected\\\": \\\"No Process section\\\", \\\"actual\\\": \\\"absent (good)\\\" if not has_process else \\\"present (bad)\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\", \\\"description\\\": \\\"Coordinator no-Process (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-TYPE-05: Orchestrator has pipeline routing ======\\n    if atype == \\\"orchestrator\\\":\\n        # The routing table IS the pipeline routing for this template\\n        has_plr = has_section(content, \\\"Routing Table\\\")\\n        rt_text = get_section_text(content, \\\"Routing Table\\\")\\n        # Check it references phases/coordinators\\n        has_phases = bool(re.search(r'concept|worldbuilding|character|plotting|style|drafting|revision|beta|polish', rt_text, re.IGNORECASE))\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator has pipeline routing via Routing Table\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_plr and has_phases else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table: {has_plr}, references phases: {has_phases}\\\",\\n            \\\"expected\\\": \\\"Routing Table with phase references\\\", \\\"actual\\\": f\\\"{'present' if has_plr else 'missing'}, phases={'yes' if has_phases else 'no'}\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator Pipeline Routing (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-TYPE-06: Auditors have Anti-Laziness Rules ======\\n    if atype == \\\"auditor\\\":\\n        has_al = has_section(content, \\\"Anti-Laziness Rules\\\")\\n        al_text = get_section_text(content, \\\"Anti-Laziness Rules\\\") if has_al else \\\"\\\"\\n        al_count = count_numbered_steps(al_text) if al_text else 0\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\",\\n            \\\"description\\\": \\\"Auditor has Anti-Laziness Rules with >=4 rules\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_al and al_count >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Anti-Laziness: {has_al}, rules: {al_count}\\\",\\n            \\\"expected\\\": \\\">=4 anti-laziness rules\\\", \\\"actual\\\": f\\\"{'present' if has_al else 'missing'}, {al_count} rules\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\", \\\"description\\\": \\\"Anti-laziness rules (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-CONTENT-01: Result codes match roster ======\\n    if atype == \\\"guide\\\" and len(result_codes) == 0:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\",\\n            \\\"description\\\": \\\"Result codes match roster (guide exempt)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide has no roster result codes\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    else:\\n        extracted = extract_result_codes(content)\\n        sc_codes = extract_status_contract_codes(content)\\n        all_extracted = extracted | sc_codes\\n        missing = result_codes - all_extracted\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\",\\n            \\\"description\\\": \\\"Result codes match roster.json\\\",\\n            \\\"result\\\": \\\"pass\\\" if len(missing) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"roster={sorted(result_codes)}, found={sorted(all_extracted)}, missing={sorted(missing)}\\\",\\n            \\\"expected\\\": sorted(list(result_codes)), \\\"actual\\\": sorted(list(all_extracted))\\n        })\\n    \\n    # ====== V-CONTENT-02: Routing table covers all children ======\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\"):\\n        mentioned, missing_children = check_routing_covers_children(content, children)\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table references all children\\\",\\n            \\\"result\\\": \\\"pass\\\" if len(missing_children) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Children: {len(children)}, mentioned: {len(mentioned)}, missing: {sorted(missing_children)}\\\",\\n            \\\"expected\\\": f\\\"All {len(children)} children\\\", \\\"actual\\\": f\\\"{len(mentioned)} found, {len(missing_children)} missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing covers children (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"Type: {atype}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-CONTENT-03: Artifact Assignments has Reads and Writes ======\\n    if has_aa:\\n        aa_text = get_section_text(content, \\\"Artifact Assignments\\\")\\n        has_reads = bool(re.search(r'Read', aa_text, re.IGNORECASE))\\n        has_writes = bool(re.search(r'Write', aa_text, re.IGNORECASE))\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Artifact Assignments has Reads and Writes\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_reads and has_writes else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Reads: {has_reads}, Writes: {has_writes}\\\",\\n            \\\"expected\\\": \\\"Both Reads and Writes\\\", \\\"actual\\\": f\\\"Reads={'yes' if has_reads else 'no'}, Writes={'yes' if has_writes else 'no'}\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Artifact Assignments has Reads and Writes\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No Artifact Assignments section\\\",\\n            \\\"expected\\\": \\\"Reads and Writes\\\", \\\"actual\\\": \\\"section missing\\\"\\n        })\\n    \\n    # ====== V-CONTENT-04: Parent metadata matches roster ======\\n    meta_parent = meta.get(\\\"parent\\\", \\\"\\\")\\n    roster_parent = parent\\n    checks.append({\\n        \\\"id\\\": \\\"V-CONTENT-04\\\",\\n        \\\"description\\\": \\\"Parent metadata matches roster.json\\\",\\n        \\\"result\\\": \\\"pass\\\" if meta_parent == roster_parent else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"meta_parent='{meta_parent}', roster_parent='{roster_parent}'\\\",\\n        \\\"expected\\\": roster_parent, \\\"actual\\\": meta_parent\\n    })\\n    \\n    # ====== V-CONTENT-05: Skills section exists and references skills ======\\n    has_skills = has_section(content, \\\"Skills\\\")\\n    if has_skills:\\n        skills_text = get_section_text(content, \\\"Skills\\\")\\n        has_skill_refs = bool(re.search(r'skills/', skills_text))\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Skills section references skill files\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_skill_refs else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Skills section present, references skills/: {has_skill_refs}\\\",\\n            \\\"expected\\\": \\\"Skill file references\\\", \\\"actual\\\": \\\"present\\\" if has_skill_refs else \\\"no skill paths\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Skills section exists\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No Skills section found\\\",\\n            \\\"expected\\\": \\\"Skills section\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ====== V-CONTENT-06: Status Contract references status.json path ======\\n    if has_sc:\\n        sc_text = get_section_text(content, \\\"Status Contract\\\")\\n        has_status_path = bool(re.search(r'status\\\\.json', sc_text))\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"Status Contract references status.json write path\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_status_path else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"status.json reference: {has_status_path}\\\",\\n            \\\"expected\\\": \\\"status.json path in Status Contract\\\", \\\"actual\\\": \\\"present\\\" if has_status_path else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"Status Contract references status.json\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No Status Contract section\\\",\\n            \\\"expected\\\": \\\"status.json reference\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ====== V-CONSIST-03: Parent/child hierarchy consistency ======\\n    if parent and parent != \\\"user\\\":\\n        # Check that parent agent exists in roster\\n        parent_exists = parent in roster_by_name\\n        # Check the parent's children list includes this agent\\n        if parent_exists:\\n            parent_children = roster_by_name[parent].get(\\\"children\\\", [])\\n            listed_as_child = name in parent_children\\n        else:\\n            listed_as_child = False\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-03\\\",\\n            \\\"description\\\": \\\"Parent/child hierarchy consistent with roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if parent_exists and listed_as_child else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"parent='{parent}', exists={parent_exists}, listed_as_child={listed_as_child}\\\",\\n            \\\"expected\\\": \\\"Parent exists and lists this agent as child\\\",\\n            \\\"actual\\\": f\\\"exists={parent_exists}, listed={listed_as_child}\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-03\\\", \\\"description\\\": \\\"Parent/child hierarchy (N/A for top-level)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": f\\\"parent='{parent}'\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ====== V-CONSIST-04: INV-030 (No Silent Failures) is referenced ======\\n    has_inv030 = bool(re.search(r'INV-030', content))\\n    checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-04\\\",\\n        \\\"description\\\": \\\"INV-030