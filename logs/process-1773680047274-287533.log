: Routing table covers children's codes (coordinators)\\n    if is_coordinator or is_orchestrator:\\n        routing = get_section(content, \\\"Routing Table\\\") or get_section(content, \\\"Pipeline Routing\\\")\\n        missing_child_codes = []\\n        for child_name in children:\\n            child_info = roster_agents.get(child_name, {})\\n            child_codes = child_info.get(\\\"resultCodes\\\", [])\\n            for cc in child_codes:\\n                # Check for the code in routing text (case-insensitive)\\n                if cc.lower() not in routing.lower():\\n                    # Also check for partial matches (revision-loop might be mentioned as 'revision')\\n                    if not any(part in routing.lower() for part in cc.lower().split(\\\"-\\\")):\\n                        missing_child_codes.append(f\\\"{child_name}:{cc}\\\")\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing table covers children's result codes\\\",\\n                       \\\"result\\\": \\\"pass\\\" if not missing_child_codes else \\\"fail\\\",\\n                       \\\"evidence\\\": f\\\"Missing: {missing_child_codes[:5]}\\\" if missing_child_codes else \\\"All child codes covered\\\",\\n                       \\\"expected\\\": \\\"All child result codes\\\", \\\"actual\\\": f\\\"{len(missing_child_codes)} missing\\\" if missing_child_codes else \\\"all covered\\\"})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing table child coverage\\\",\\n                       \\\"result\\\": \\\"not-applicable\\\",\\n                       \\\"evidence\\\": f\\\"Agent is {level}\\\", \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-CONTENT-03\\n    writes_meta = get_metadata(content, \\\"Writes\\\")\\n    checks.append({\\\"id\\\": \\\"V-CONTENT-03\\\", \\\"description\\\": \\\"Write Rules reference correct artifact fields\\\",\\n                   \\\"result\\\": \