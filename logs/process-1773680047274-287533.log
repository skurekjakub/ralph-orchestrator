"\\\")\\n    else:\\n        # Context signals have type like \\\"pipeline bottleneck pattern\\\"\\n        subcategory = sig_type.replace(\\\" \\\", \\\"-\\\")\\n    \\n    entry = {\\n        \\\"id\\\": mk_id,\\n        \\\"category\\\": category,\\n        \\\"subcategory\\\": subcategory,\\n        \\\"content\\\": sig[\\\"content\\\"],\\n        \\\"confidence\\\": \\\"low\\\",\\n        \\\"confidenceValue\\\": 0.3,\\n        \\\"sourceStrength\\\": sig[\\\"strength\\\"],\\n        \\\"sourceArtifact\\\": sig.get(\\\"sourceArtifact\\\", \\\"unknown\\\"),\\n        \\\"sourceEvidence\\\": sig.get(\\\"sourceEvidence\\\", \\\"\\\"),\\n        \\\"sourceRun\\\": RUN_TIMESTAMP,\\n        \\\"sourceAnalyzer\\\": \\\"fractal-factory-factory-signal-analyzer\\\" if item[\\\"source\\\"] == \\\"factory\\\" else \\\"fractal-factory-context-signal-analyzer\\\",\\n        \\\"confirmationCount\\\": 1,\\n        \\\"deprecated\\\": False,\\n        \\\"createdAt\\\": RUN_TIMESTAMP,\\n        \\\"updatedAt\\\": RUN_TIMESTAMP,\\n        \\\"history\\\": [\\n            {\\n                \\\"action\\\": \\\"created\\\",\\n                \\\"timestamp\\\": RUN_TIMESTAMP,\\n                \\\"fromConfidence\\\": None,\\n                \\\"toConfidence\\\": \\\"low\\\",\\n                \\\"reason\\\": \\\"Cold start — first observation from initial factory run\\\"\\n            }\\n        ]\\n    }\\n    \\n    # Write entry file\\n    entry_filename = f\\\"entry-{entry_num:03d}.json\\\"\\n    entry_path = os.path.join(META_DIR, category, entry_filename)\\n    with open(entry_path, \\\"w\\\") as f:\\n        json.dump(entry, f, indent=2)\\n    \\n    # Add to index\\n    index_entries.append({\\n        \\\"id\\\": mk_id,\\n        \\\"category\\\": category,\\n        \\\"subcategory\\\": subcategory,\\n        \\\"confidence\\\": \\\"low\\\",\\n        \\\"confidenceValue\\\": 0.3,\\n        \\\"deprecated\\\": False,\\n        \\\"file\\\": f\\\"{category}/{entry_filen