+ re.escape(heading) + r'\\\\s*$'\\n    m = re.search(pattern, content, re.MULTILINE)\\n    if not m: return ''\\n    start = m.end()\\n    next_h2 = re.search(r'^##\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_h2.start() if next_h2 else len(content)\\n    return content[start:end].strip()\\n\\ndef count_step_subsections(content, heading):\\n    section = get_section_text(content, heading)\\n    return len(re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', section, re.MULTILINE))\\n\\ndef count_numbered_items(text):\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\n# Load all agent contents\\nagent_contents = {}\\nfor name in roster_names:\\n    fp = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    if os.path.exists(fp):\\n        with open(fp) as f:\\n            agent_contents[name] = f.read()\\n\\n# ============================================================\\n# VALIDATE ALL AGENTS\\n# ============================================================\\nall_agent_results = []\\n\\nfor agent_info in roster_agents:\\n    name = agent_info['name']\\n    atype = get_agent_type(agent_info)\\n    level = agent_info.get('level', '')\\n    children = agent_info.get('children', [])\\n    result_codes = agent_info.get('resultCodes', [])\\n    parent = agent_info.get('parent', '')\\n    \\n    checks = []\\n    content = agent_contents.get(name, '')\\n    \\n    if not content:\\n        checks.append({'id': 'V-CONSIST-01', 'description': 'Agent file exists', 'result': 'fail',\\n            'evidence': f'File {name}.agent.md not found'})\\n        all_agent_results.append({'agent': name, 'verdict': 'fail', 'checks': checks})\\n        continue\\n    \\n    h1 = get_h1(content)\\n    meta_level = get_metadata_field(content, 'Level')\\n    meta_agent_id = get_metadata_field(content, 'Agent ID')\\n    meta_parent = get_metadata_field(content, 'Parent')\\n    meta_children_raw = get_metadata_field(content, 'Children')\\n    role_text = get_section_text(content, 'Role')\\n    \\n    # ===== IDENTITY CHECKS =====\\n    # V-IDENTITY-01: Identity metadata present\\n    checks.append({\\n        'id': 'V-IDENTITY-01', 'description': 'Frontmatter identity (H1 + Agent ID + Level)',\\n        'result': 'pass' if (h1 and meta_agent_id and meta_level) else 'fail',\\n        'evidence': f\\\"H1='{h1}', AgentID='{meta_agent_id}', Level='{meta_level}'\\\"\\n    })\\n    \\n    # V-IDENTITY-02: Description non-empty\\n    checks.append({\\n        'id': 'V-IDENTITY-02', 'description': 'Role description non-empty',\\n        'result': 'pass' if len(role_text) > 30 else 'fail',\\n        'evidence': f\\\"Role text: {len(role_text)} chars\\\"\\n    })\\n    \\n    # V-IDENTITY-03: Level matches roster\\n    checks.append({\\n        'id': 'V-IDENTITY-03', 'description': 'Level metadata matches roster',\\n        'result': 'pass' if meta_level == level else 'fail',\\n        'evidence': f\\\"meta='{meta_level}', roster='{level}'\\\"\\n    })\\n    \\n    # V-IDENTITY-04: Naming prefix\\n    checks.append({\\n        'id': 'V-IDENTITY-04', 'description': 'Correct naming prefix',\\n        'result': 'pass' if name.startswith(PREFIX) else 'fail',\\n        'evidence': f\\\"name='{name}'\\\"\\n    })\\n    \\n    # ===== SECTION PRESENCE =====\\n    # V-SECTION-01: H1 heading\\n    checks.append({\\n        'id': 'V-SECTION-01', 'description': 'H1 heading exists',\\n        'result': 'pass' if h1 else 'fail',\\n        'evidence': f\\\"H1='{h1}'\\\"\\n    })\\n    \\n    # V-SECTION-02: Role description\\n    checks.append({\\n        'id': 'V-SECTION-02', 'description': 'Role section exists and descriptive',\\n        'result': 'pass' if has_section(content, 'Role') and len(role_text) > 20 else 'fail',\\n        'evidence': f\\\"## Role={has_section(content, 'Role')}, len={len(role_text)}\\\"\\n    })\\n    \\n    # V-SECTION-03: ask_questions suppression\\n    if atype == 'guide':\\n        has_aq = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n        checks.append({\\n            'id': 'V-SECTION-03', 'description': 'ask_questions suppression (guide exempt)',\\n            'result': 'pass' if has_aq else 'not-applicable',\\n            'evidence': f\\\"Guide — found: {has_aq}\\\"\\n        })\\n    elif atype in ('coordinator', 'orchestrator'):\\n        # Coordinators are pure routers. Check says all non-guide should have it.\\n        has_aq = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n        has_purity = has_section_fuzzy(content, 'Purity Rule')\\n        # Accept either explicit suppression or purity rule as equivalent\\n        checks.append({\\n            'id': 'V-SECTION-03', 'description': 'ask_questions suppression or purity rule',\\n            'result': 'pass' if has_aq or has_purity else 'fail',\\n            'evidence': f\\\"ask_questions={has_aq}, purity_rule={has_purity}\\\"\\n        })\\n    else:\\n        has_aq = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n        checks.append({\\n            'id': 'V-SECTION-03', 'description': 'ask_questions suppression present',\\n            'result': 'pass' if has_aq else 'fail',\\n            'evidence': f\\\"ask_questions found: {has_aq}\\\"\\n        })\\n    \\n    # V-SECTION-04: Context metadata (Agent ID, Level, Parent)\\n    checks.append({\\n        'id': 'V-SECTION-04', 'description': 'Context metadata (ID, Level, Parent)',\\n        'result': 'pass' if meta_agent_id and meta_level and meta_parent else 'fail',\\n        'evidence': f\\\"ID={meta_agent_id}, Level={meta_level}, Parent={meta_parent}\\\"\\n    })\\n    \\n    # V-SECTION-05: Artifact Assignments (inputs)\\n    has_aa = has_section(content, 'Artifact Assignments')\\n    checks.append({\\n        'id': 'V-SECTION-05', 'description': 'Artifact Assignments section exists',\\n        'result': 'pass' if has_aa else 'fail',\\n        'evidence': f\\\"## Artifact Assignments: {has_aa}\\\"\\n    })\\n    \\n    