l_writers)\\n    roster_writers_set = set(roster_declared)\\n    \\n    if roster_writers_set and arch_writers_set:\\n        extra_in_roster = roster_writers_set - arch_writers_set\\n        extra_in_arch = arch_writers_set - roster_writers_set\\n        if extra_in_roster or extra_in_arch:\\n            protocol_mismatch.append((name, protocol, sorted(arch_writers_set), sorted(roster_writers_set)))\\n\\nprint('=== Artifacts with no writer ===')\\nfor n in no_writer: print(f'  {n}')\\nprint(f'Total: {len(no_writer)}')\\n\\nprint()\\nprint('=== Artifacts with no reader ===')\\nfor n in no_reader: print(f'  {n}')\\nprint(f'Total: {len(no_reader)}')\\n\\nprint()\\nprint('=== Writer mismatches (architecture vs roster) ===')\\nfor name, proto, arch, rost in protocol_mismatch:\\n    print(f'  {name} (protocol: {proto})')\\n    print(f'    architecture: {arch}')\\n    print(f'    roster:       {rost}')\\nprint(f'Total mismatches: {len(protocol_mismatch)}')\\n\\\" 2>&1\", \"description\": \"Comprehensive artifact coverage analysis\", \"initial_wait\": 30}"
