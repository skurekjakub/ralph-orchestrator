              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator\\n\\npython3 << 'PYEOF'\\nimport json, os, re, sys\\nfrom pathlib import Path\\nfrom datetime import datetime, timezone\\n\\nBASE = Path(\\\"/home/jakubs/repositories/ralph-orchestrator\\\")\\nFF = BASE / \\\".fractal-factory\\\"\\nOUTPUT = FF / \\\"output\\\" / \\\"romantic-fantasy-writer\\\"\\nAGENTS_DIR = OUTPUT / \\\"agents\\\"\\nPREFIX = \\\"romantic-fantasy-writer\\\"\\n\\nwith open(FF / \\\"roster.json\\\") as f:\\n    roster_data = json.load(f)\\n\\nroster_agents = {}\\nfor a in roster_data[\\\"agents\\\"]:\\n    roster_agents[a[\\\"name\\\"]] = a\\n\\nagent_files_on_disk = set(f.stem for f in AGENTS_DIR.glob(\\\"*.agent.md\\\"))\\nroster_names = set(roster_agents.keys())\\n\\n# Counters\\ng_pass = 0\\ng_fail = 0\\ng_na = 0\\n\\ndef has_section(content, heading):\\n    \\\"\\\"\\\"Check if content has a heading containing the text (case-insensitive).\\\"\\\"\\\"\\n    return bool(re.search(r'^#{1,6}\\\\s+.*' + re.escape(heading), content, re.MULTILINE | re.IGNORECASE))\\n\\ndef get_section(content, heading):\\n    \\\"\\\"\\\"Get text under a heading until next same-level or higher heading.\\\"\\\"\\\"\\n    lines = content.split(\\\"\\\\n\\\")\\n    collecting = False\\n    level = 0\\n    result = []\\n    for line in lines:\\n        if collecting:\\n            m = re.match(r'^(#{1,6})\\\\s+', line)\\n            if m and len(m.group(1)) <= level:\\n                break\\n            result.append(line)\\n        else:\\n            if re.match(r'^#{1,6}\\\\s+.*' + re.escape(heading), line, re.IGNORECASE):\\n                m = re.match(r'^(#{1,6})\\\\s+', line)\\n                level = len(m.group(1))\\n                collecting = True\\n    return \\\"\\\\n\\\".join(result)\\n\\ndef count_steps(text):\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\ndef parse_metadata(content):\\n    \\\"\\\"\\\"Parse bold metadata lines like **Level:** coordinator\\\"\\\"\\\"\\n    meta = {}\\n    for m in re.finditer(r'\\\\*\\\\*(\\\\w[\\\\w\\\\s/]*?):\\\\*\\\\*\\\\s*(.+)', content):\\n        meta[m.group(1).strip()] = m.group(2).strip()\\n    return meta\\n\\ndef validate_agent(name, entry):\\n    checks = []\\n    fpath = AGENTS_DIR / (name + \\\".agent.md\\\")\\n    level = entry.get(\\\"level\\\", \\\"\\\")\\n    children = entry.get(\\\"children\\\", [])\\n    rcodes = entry.get(\\\"resultCodes\\\", [])\\n    parent = entry.get(\\\"parent\\\", \\\"\\\")\\n    dname = entry.get(\\\"displayName\\\", \\\"\\\")\\n    \\n    is_guide = level == \\\"guide\\\"\\n    is_orch = level == \\\"orchestrator\\\"\\n    is_coord = level in (\\\"coordinator\\\", \\\"sub-coordinator\\\")\\n    is_spec = level == \\\"specialist\\\"\\n    is_auditor = \\\"auditor\\\" in name\\n    is_router = is_orch or is_coord\\n    \\n    if not fpath.exists():\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"File exists\\\", \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": name + \\\".agent.md missing\\\", \\\"expected\\\": \\\"exists\\\", \\\"actual\\\": \\\"missing\\\"})\\n        return checks\\n    \\n    content = fpath.read_text()\\n    meta = parse_metadata(content)\\n    \\n    # ========== IDENTITY CHECKS ==========\\n    \\n    # V-IDENTITY-01: H1 matches displayName\\n    h1 = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    h1_text = h1.group(1).strip() if h1 else \\\"\\\"\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-01\\\", \\\"description\\\": \\\"H1 heading matches displayName\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1_text == dname else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"H1=\\\" + repr(h1_text) + \\\" expected=\\\" + repr(dname),\\n        \\\"expected\\\": dname, \\\"actual\\\": h1_text})\\n    \\n    # V-IDENTITY-02: Role section non-empty\\n    role = get_section(content, \\\"Role\\\")\\n    role_len = len(role.strip())\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-02\\\", \\\"description\\\": \\\"Role section non-empty\\\",\\n        \\\"result\\\": \\\"pass\\\" if role_len > 30 else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"Role section len=\\\" + str(role_len),\\n        \\\"expected\\\": \\\"> 30 chars\\\", \\\"actual\\\": str(role_len) + \\\" chars\\\"})\\n    \\n    # V-IDENTITY-03: Metadata Level matches roster\\n    meta_level = meta.get(\\\"Level\\\", \\\"\\\")\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-03\\\", \\\"description\\\": \\\"Metadata Level matches roster\\\",\\n        \\\"result\\\": \\\"pass\\\" if meta_level == level else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"meta=\\\" + repr(meta_level) + \\\" roster=\\\" + repr(level),\\n        \\\"expected\\\": level, \\\"actual\\\": meta_level})\\n    \\n    # V-IDENTITY-04: Naming prefix\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-04\\\", \\\"description\\\": \\\"Correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if name.startswith(PREFIX) else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"name=\\\" + name, \\\"expected\\\": PREFIX + \\\"-*\\\", \\\"actual\\\": name})\\n    \\n    # ========== SECTION PRESENCE ==========\\n    \\n    # V-SECTION-01: H1 exists\\n    checks.append({\\\"id\\\": \\\"V-SECTION-01\\\", \\\"description\\\": \\\"H1 heading exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1 else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"H1 \\\" + (\\\"present\\\" if h1 else \\\"missing\\\"),\\n        \\\"expected\\\": \\\"present\\\", \\\"actual\\\": \\\"present\\\" if h1 else \\\"missing\\\"})\\n    \\n    # V-SECTION-02: Role section\\n    checks.append({\\\"id\\\": \\\"V-SECTION-02\\\", \\\"description\\\": \\\"## Role section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_section(content, \\\"Role\\\") else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"Role \\\" + (\\\"found\\\" if has_section(content, \\\"Role\\\") else \\\"missing\\\"),\\n        \\\"expected\\\": \\\"pre