            "type": "string",
            "description": "The string in the file to replace. Leading and ending whitespaces from file content should be preserved!"
          },
          "new_str": {
            "type": "string",
            "description": "The new string to replace old_str with."
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
