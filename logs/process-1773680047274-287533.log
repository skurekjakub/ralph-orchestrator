nvariants\\\": [\\n            \\\"INV-027\\\",\\n            \\\"INV-013\\\"\\n        ],\\n        \\\"additionalVariant\\\": {\\n            \\\"name\\\": \\\"Delivered-with-gaps series-kb-manager blocked\\\",\\n            \\\"description\\\": \\\"Second routing path: polish completes but series-kb-manager returns blocked. Orchestrator emits delivered-with-gaps with summary 'Delivered but series KB update failed'.\\\",\\n            \\\"trigger\\\": {\\n                \\\"agent\\\": \\\"romantic-fantasy-writer\\\",\\n                \\\"action\\\": \\\"invoke (resume at series-kb phase)\\\"\\n            },\\n            \\\"expectedOutput\\\": {\\n                \\\"resultCode\\\": \\\"delivered-with-gaps\\\",\\n                \\\"summary\\\": \\\"Delivered but series KB update failed\\\"\\n            }\\n        }\\n    },\\n    {\\n        \\\"id\\\": \\\"TEST-023\\\",\\n        \\\"name\\\": \\\"Plotting-auditor rejection retry with sub-coordinator cascade\\\",\\n        \\\"category\\\": \\\"auditor-rejection\\\",\\n        \\\"priority\\\": \\\"P1\\\",\\n        \\\"description\\\": \\\"Exercises plotting-auditor rejection and the complex retry path. The plotting phase has depth-3 hierarchy with two sub-coordinators (structural-design-coordinator with 3 specialists, chapter-design-coordinator with 2 specialists). On plotting-auditor failure, ALL sub-coordinator and specialist statuses (8 total) must be deleted before re-dispatch.\\\",\\n        \\\"gapAddressed\\\": \\\"TC-003\\\",\\n        \\\"initialState\\\": {\\n            \\\"contextJson\\\": {\\n                \\\"bookId\\\": \\\"test-book-023\\\",\\n                \\\"targetChapters\\\": 3\\n            },\\n            \\\"existingArtifacts\\\": [\\n                \\\"concept.json (complete)\\\",\\n                \\\"world/*.json (complete)\\\",\\n                \\\"characters/*.json (complete)\\\"\\n            ],\\n            \\\"inputFiles\\\": [],\\n            \\\"preconditions\\\"