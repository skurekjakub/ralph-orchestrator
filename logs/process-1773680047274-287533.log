e\\\": f\\\"Context path references: {has_path_refs}, content length: {len(context_content)}\\\",\\n        \\\"expected\\\": \\\"Domain path references in Context\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_path_refs else \\\"absent\\\"\\n    })\\n    \\n    # V-CONTENT-05: Inputs list exists and has numbered items\\n    inputs_content = get_section_content(content, \\\"Inputs\\\") or get_section_content(content, \\\"Input\\\")\\n    input_items = len(re.findall(r'^\\\\d+\\\\.', inputs_content, re.MULTILINE))\\n    checks.append({\\n        \\\"id\\\": \\\"V-CONTENT-05\\\",\\n        \\\"description\\\": \\\"Inputs list has numbered items\\\",\\n        \\\"result\\\": \\\"pass\\\" if input_items >= 1 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Inputs section has {input_items} numbered items\\\",\\n        \\\"expected\\\": \\\">= 1 numbered input\\\",\\n        \\\"actual\\\": f\\\"{input_items} items\\\"\\n    })\\n    \\n    # V-CONTENT-06: next_hint values in status contract\\n    # For specialists, next_hint should reference their parent coordinator\\n    if is_specialist:\\n        has_next_hint = \\\"next_hint\\\" in status_content\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"next_hint value present in status contract\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_next_hint else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"next_hint {'found' if has_next_hint else 'NOT found'} in status contract\\\",\\n            \\\"expected\\\": \\\"next_hint present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_next_hint else \\\"absent\\\"\\n        })\\n    elif is_coordinator or is_orchestrator:\\n        has_next_hint = \\\"next_hint\\\" in status_content\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"next_hint value present in status contract\\\",\\n            \\\"result\\\": \\\"pass\\\" if