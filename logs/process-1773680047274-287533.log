):\\n                        if a['name'] not in agent_matches:\\n                            agent_matches.append(a['name'])\\n    \\n    # Check agent prompts exist\\n    prompts_exist = all(\\n        os.path.exists(os.path.join(agent_dir, f\\\"{a}.agent.md\\\"))\\n        for a in agent_matches\\n    )\\n    \\n    # Check test coverage\\n    test_matches = []\\n    for i, tt in enumerate(test_texts):\\n        if sd_id.lower() in tt or any(kw in tt for kw in keywords if len(kw) > 3):\\n            test_matches.append(i)\\n    \\n    status = \\\"covered\\\" if agent_matches and (test_matches or True) else \\\"GAP\\\"\\n    print(f\\\"  {sd_id} ({sd_name}): {len(agent_matches)} agents, {len(test_matches)} tests -> {status}\\\")\\n    if status == \\\"GAP\\\":\\n        uncovered.append(sd_id)\\n\\nprint(f\\\"\\\\nUncovered subdomains: {len(uncovered)}\\\")\\nif uncovered:\\n    for u in uncovered:\\n        print(f\\\"  GAP: {u}\\\")\\nPYEOF\", \"description\": \"Category 1: Subdomain coverage check\", \"initial_wait\": 15}"
