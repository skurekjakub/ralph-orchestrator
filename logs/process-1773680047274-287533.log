            "maximum": 100
          },
          "pullNumber": {
            "type": "number",
            "description": "Pull request number"
          },
          "repo": {
            "type": "string",
            "description": "Repository name"
          }
        },
        "required": [
          "method",
          "owner",
          "repo",
          "pullNumber"
        ]
      }
