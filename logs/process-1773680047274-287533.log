\"preconditions\\\": [\\n                \\\"Previous book (test-book-001) completed and series KB populated\\\",\\n                \\\"New book starts fresh but inherits series context\\\"\\n            ]\\n        },\\n        \\\"trigger\\\": {\\n            \\\"agent\\\": \\\"romantic-fantasy-writer\\\",\\n            \\\"action\\\": \\\"invoke\\\"\\n        },\\n        \\\"expectedBehavior\\\": [\\n            \\\"Orchestrator reads story-config.json, detects sequelOf field\\\",\\n            \\\"Concept-coordinator receives series KB path and unresolved-threads.json as input context\\\",\\n            \\\"Concept phase produces concept.json that references which unresolved threads this book addresses\\\",\\n            \\\"Worldbuilding-coordinator reads series-kb/series-001/world-facts.json for consistency\\\",\\n            \\\"Worldbuilding specialists extend (not contradict) existing world facts\\\",\\n            \\\"Character-coordinator reads series-kb/series-001/character-facts.json\\\",\\n            \\\"Returning characters maintain established voice parameters and relationship states\\\",\\n            \\\"Plotting-coordinator references unresolved-threads.json to advance/resolve selected threads\\\",\\n            \\\"Full pipeline completes through all phases\\\",\\n            \\\"Series-kb-manager appends new facts from this book to series KB (world-facts, character-facts, timeline)\\\",\\n            \\\"Series-kb-manager updates unresolved-threads.json (resolved threads marked, new threads added)\\\",\\n            \\\"Orchestrator writes delivered status\\\"\\n        ],\\n        \\\"expectedOutput\\\": {\\n            \\\"resultCode\\\": \\\"delivered\\\",\\n            \\\"artifactsWritten\\\": [\\n                \\\"concept.json (references sequelOf and unresolved threads)\\\",\\n                \\\"world/*.json (extends series KB, no contradictions)\\\",\\n                \\\"characters/*.json (returning characters + new characters)\\\",\\n                \\\"plotting/*.json (advances/resolves threads from book 1)\\\",\\n                \\\"chapters/chapter-001-polished.md\\\",\\n                \\\"series-kb/series-001/world-facts.json (appended)\\\",\\n                \\\"series-kb/series-001/character-facts.json (appended)\\\",\\n                \\\"series-kb/series-001/timeline.json (appended)\\\",\\n                \\\"series-kb/series-001/unresolved-threads.json (updated)\\\"\\n            ],\\n            \\\"agentsExercised\\\": [\\n                \\\"romantic-fantasy-writer\\\",\\n                \\\"romantic-fantasy-writer-concept-coordinator\\\",\\n                \\\"romantic-fantasy-writer-worldbuilding-coordinator\\\",\\n                \\\"romantic-fantasy-writer-character-coordinator\\\",\\n                \\\"romantic-fantasy-writer-plotting-coordinator\\\",\\n                \\\"romantic-fantasy-writer-series-kb-manager\\\"\\n            ]\\n        },\\n        \\\"verificationCriteria\\\": [\\n            \\\"Orchestrator status.json result == 'delivered'\\\",\\n            \\\"concept.json contains sequelOf reference and lists addressed threads\\\",\\n            \\\"World artifacts do not contradict any fact in series-kb/series-001/world-facts.json\\\",\\n            \\\"Returning characters have voice parameters consistent with book 1\\\",\\n            \\\"At least one unresolved thread from book 1 is advanced or resolved in plotting\\\",\\n            \\\"series-kb/series-001/world-facts.json has new entries from this book appended\\\",\\n            \\\"series-kb/series-001/unresolved-threads.json shows status changes for addressed threads\\\",\\n            \\\"series-kb/series-001/timeline.json extends chronologically from book 1\\\",\\n            \\\"No series KB facts from book 1 were silently removed or contradicted (INV-070)\\\"\\n        ],\\n        \\\"relatedInvariants\\\": [\\n            \\\"INV-002\\\",\\n            \\\"INV-032\\\",\\n            \\\"INV-066\\\",\\n            \\\"INV-070\\\",\\n            \\\"INV-071\\\"\\n        ]\\n    },\\n    {\\n        \\\"id\\\": \\\"TEST-026\\\",\\n        \\\"name\\\": \\\"Parallel beta-reader fan-out with partial failure\\\",\\n        \\\"category\\\": \\\"coordinator-routing\\\",\\n        \\\"priority\\\": \\\"P1\\\",\\n        \\\"description\\\": \\\"Exercises parallel agent dispatch in the beta-reading phase. The beta-reading-coordinator fans out to genre-lens-coordinator and craft-lens-coordinator in parallel. Genre-lens-coordinator fans out to romance-beta-reader and fantasy-beta-reader in parallel. Craft-lens-coordinator fans out to craft-beta-reader, sensitivity-beta-reader, and originality-beta-reader in parallel. This tests: (1) correct parallel dispatch at two levels, (2) fan-in synchronization (coordinator waits for all readers), (3) partial failure (one reader blocks while others succeed). INV-068 requires five independent beta lenses.\\\",\\n        \\\"gapAddressed\\\": \\\"TC-006\\\",\\n        \\\"initialState\\\": {\\n            \\\"contextJson\\\": {\\n                \\\"bookId\\\": \\\"test-book-026\\\",\\n                \\\"targetChapters\\\": 1,\\n                \\\"revisionBetaCycles\\\": 0\\n            },\\n            \\\"existingArtifacts\\\": [\\n                \\\"chapters/chapter-001-revised.md (revised, ready for beta)\\\"\\n            ],\\n            \\\"inputFiles\\\": [],\\n            \\\"preconditions\\\": [\\n                \\\"All phases through revision complete\\\",\\n                \\\"progress.json shows chapterProgress[1].revised == true\\\",\\n                \\\"Orchestrator dispatching beta-reading-coordinator for chapter 1\\\"\\n            ]\\n        },\\n        \\\"trigger\\\": {\\n            \\\"agent\\\": \\\"romantic-fantasy-writer-beta-reading-coordinator\\\",\\n            \\\"action\\\": \\\"invoke\\\"\\n        },\\n        \\\"expectedBehavior\\\": [\\n            \\\"Beta-reading-coordinator dispatches genre-lens-coordinator AND craft-lens-coordinator IN PARALLEL for chapter 1\\\",\\n            \\\"Genre-lens-coordinator dispatches romance-beta-reader AND fantasy-beta-reader IN PARALLEL\\\",\\n            \\\"Craft-lens-coordinator dispatches craft-beta-reader AND sensitivity-beta-reader AND originality-beta-reader IN PARALLEL\\\",\\n            \\\"All 5 beta readers run independently on the same revised chapter\\\",\\n            \\\"romance-beta-reader completes with feedback\\\",\\n            \\\"fantasy-beta-reader completes with feedback\\\",\\n            \\\"craft-beta-reader completes with feedback\\\",\\n            \\\"sensitivity-beta-reader returns BLOCKED (simulated failure — e.g., content requires sensitivity review beyond agent capability)\\\",\\n            \\\"originality-beta-reader completes with feedback\\\",\\n            \\\"Craft-lens-coordinator detects sensitivity-beta-reader blocked → writes own status: blocked\\\",\\n            \\\"Genre-lens-coordinator detects both readers complete → writes own status: complete\\\",\\n            \\\"Beta-reading-coordinator detects craft-lens-coordinator blocked → writes own status: blocked\\\",\\n            \\\"Beta-reading-coordinator does NOT dispatch beta-synthesizer (fan-in incomplete)\\\"\\n        ],\\n        \\\"expectedOutput\\\": {\\n            \\\"resultCode\\\": \\\"blocked\\\",\\n            \\\"artifactsWritten\\\": [\\n                \\\"beta-reading/genre-lens/romance/chapter-001.json (feedback)\\\",\\n                \\\"beta-reading/genre-lens/fantasy/chapter-001.json (feedback)\\\",\\n                \\\"beta-reading/craft-lens/craft/chapter-001.json (feedback)\\\",\\n                \\\"beta-reading/craft-lens/originality/chapter-001.json (feedback)\\\",\\n                \\\"agents/genre-lens-coordinator/status.json (complete)\\\",\\n                \\\"agents/craft-lens-coordinator/status.json (blocked)\\\",\\n                \\\"agents/beta-reading-coordinator/status.json (blocked)\\\"\\n            ],\\n            \\\"agentsExercised\\\": [\\n                \\\"romantic-fantasy-writer-beta-reading-coordinator\\\",\\n                \\\"romantic-fantasy-writer-genre-lens-coordinator\\\",\\n                \\\"romantic-fantasy-writer-craft-lens-coordinator\\\",\\n                \\\"romantic-fantasy-writer-romance-beta-reader\\\",\\n                \\\"romantic-fantasy-writer-fantasy-beta-reader\\\",\\n                \\\"romantic-fantasy-writer-craft-beta-reader\\\",\\n                \\\"romantic-fantasy-writer-sensitivity-beta-reader\\\",\\n                \\\"romantic-fantasy-writer-originality-beta-reader\\\"\\n            ]\\n        },\\n        \\\"verificationCriteria\\\": [\\n            \\\"Genre-lens-coordinator and craft-lens-coordinator were dispatched simultaneously (parallel)\\\",\\n            \\\"Within genre-lens-coordinator: romance-beta-reader and fantasy-beta-reader dispatched simultaneously\\\",\\n            \\\"Within craft-lens-coordinator: all 3 readers dispatched simultaneously\\\",\\n            \\\"Genre-lens-coordinator completed successfully despite craft-lens being blocked\\\",\\n            \\\"Craft-lens-coordinator detected partial failure and wrote blocked\\\",\\n            \\\"Beta-reading-coordinator propagated blocked from craft-lens-coordinator\\\",\\n            \\\"Beta-synthesizer was NOT dispatched (prerequisite not met)\\\",\\n            \\\"4 of 5 beta reader feedback artifacts exist\\\",\\n            \\\"sensitivity-beta-reader status shows blocked\\\",\\n            \\\"No data corruption between parallel readers (each wrote to distinct paths)\\\"\\n        ],\\n        \\\"relatedInvariants\\\": [\\n            \\\"INV-013\\\",\\n            \\\"INV-025\\\",\\n            \\\"INV-068\\\",\\n            \\\"INV-076\\\"\\n        ],\\n        \\\"additionalVariant\\\": {\\n            \\\"name\\\": \\\"Parallel beta-reader fan-out all succeed\\\",\\n            \\\"description