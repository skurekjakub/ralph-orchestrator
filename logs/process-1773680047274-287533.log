ing for wildcards)\\n    has_writer = False\\n    for w_art in all_writes:\\n        # Exact match\\n        if art == w_art:\\n            has_writer = True\\n            break\\n        # Pattern match (e.g., chapters/{N}/draft.md matches)\\n        if '{N}' in art or '{N}' in w_art:\\n            base_art = art.replace('{N}', 'X').replace('{CHAR-NNN}', 'Y')\\n            base_w = w_art.replace('{N}', 'X').replace('{CHAR-NNN}', 'Y')\\n            if base_art == base_w:\\n                has_writer = True\\n                break\\n        # Wildcard match\\n        if '*' in w_art:\\n            import fnmatch\\n            if fnmatch.fnmatch(art, w_art):\\n                has_writer = True\\n                break\\n    \\n    if not has_writer:\\n        orphan_count += 1\\n        if orphan_count <= 15:\\n            print(f\\\"  {art} (read by: {readers[:3]})\\\")\\n\\nprint(f\\\"\\\\nTotal artifacts read but no writer: {orphan_count}\\\")\\nprint(f\\\"Total unique written artifacts: {len(all_writes)}\\\")\\nprint(f\\\"Total unique read artifacts: {len(all_reads)}\\\")\\nPYEOF\", \"description\": \"Cross-check artifact consistency\"}"
