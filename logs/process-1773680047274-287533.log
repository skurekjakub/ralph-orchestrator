              "arguments": "{\"command\": \"# Deep content review: check routing completeness in coordinators\\necho \\\"=== COORDINATOR ROUTING COMPLETENESS ===\\\"\\npython3 << 'PYEOF'\\nimport json, os, re\\n\\nwith open('.fractal-factory/roster.json') as f:\\n    roster = json.load(f)\\n\\nagents_dir = '.fractal-factory/output/romantic-fantasy-writer/agents'\\nagents_by_name = {a['name']: a for a in roster['agents']}\\n\\n# Check each coordinator/sub-coordinator\\nfor agent in roster['agents']:\\n    if agent['level'] not in ('coordinator', 'sub-coordinator', 'orchestrator'):\\n        continue\\n    \\n    name = agent['name']\\n    children = agent.get('children', [])\\n    if not children:\\n        continue\\n    \\n    fname = os.path.join(agents_dir, f\\\"{name}.agent.md\\\")\\n    with open(fname) as f:\\n        content = f.read()\\n    \\n    # Extract routing table\\n    rt_match = re.search(r'## Routing Table\\\\s*\\\\n(.*?)(?=\\\\n## |\\\\Z)', content, re.DOTALL)\\n    if not rt_match:\\n        print(f\\\"  NO ROUTING TABLE: {name}\\\")\\n        continue\\n    \\n    rt_text = rt_match.group(1)\\n    \\n    # Check each child's result codes have handlers\\n    missing = []\\n    for child_name in children:\\n        child = agents_by_name.get(child_name)\\n        if not child:\\n            missing.append(f\\\"{child_name}: NOT IN ROSTER\\\")\\n            continue\\n        \\n        child_codes = child.get('resultCodes', [])\\n        # Get short name for routing table lookup\\n        short_name = child_name.replace('romantic-fantasy-writer-', '')\\n        \\n        for code in child_codes:\\n            # Check if routing table references this child + code\\n            if code not in rt_text or short_name not in rt_text:\\n                # More detailed check\\n                if short_name not in rt_text:\\n                    missing.append(f\\\"{short_name}: not referenced at all\\\")\\n                    break\\n                elif code not in rt_text:\\n                    missing.append(f\\\"{short_name}/{code}: code not in routing\\\")\\n    \\n    if missing:\\n        print(f\\\"  {name.replace('romantic-fantasy-writer-', '')}: MISSING: {missing}\\\")\\n    else:\\n        print(f\\\"  {name.replace('romantic-fantasy-writer-', '')}: OK\\\")\\nPYEOF\", \"description\": \"Check routing completeness\"}"
