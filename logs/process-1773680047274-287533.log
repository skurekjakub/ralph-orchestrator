     for child in children:\\n            child_short = child.replace(NAMING_PREFIX + \\\"-\\\", \\\"\\\")\\n            if child not in content and child_short not in content:\\n                missing_children.append(child)\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-04\\\",\\n            \\\"description\\\": \\\"Children referenced in prompt match roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_children else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Children: {len(children)}, missing references: {missing_children}\\\" if missing_children else f\\\"All {len(children)} children referenced\\\",\\n            \\\"expected\\\": f\\\"All children: {children}\\\",\\n            \\\"actual\\\": f\\\"{len(children) - len(missing_children)}/{len(children)} referenced\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-04\\\",\\n            \\\"description\\\": \\\"Children referenced in prompt match roster\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent '{name}' has no children\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # ANTI-LAZINESS CHECK (bonus)\\n    laziness_issues = check_anti_laziness(content)\\n    checks.append({\\n        \\\"id\\\": \\\"V-ANTILAZY-01\\\",\\n        \\\"description\\\": \\\"No placeholder/TODO/TBD markers in content\\\",\\n        \\\"result\\\": \\\"fail\\\" if laziness_issues else \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Issues found: {laziness_issues}\\\" if laziness_issues else \\\"No placeholder markers found\\\",\\n        \\\"expected\\\": \\\"No TODO/FIXME/TBD/placeholder markers\\\",\\n        \\\"actual\\\": str(laziness_issues) if laziness_issues else \\\"clean\\\"\\n    })\\n    \\n    # EMPTY SECTIONS CHECK\\n    sections_to_check = [\\\"Context\\\", \\\"Inputs\\\", \\\"Write Rules\\\", \\\"Status Contract\\\"]\\n    empty_sections = []\\n    for sec in sections_to_check:\\n        sec_content = get_section_content(content, sec)\\n        if sec_content is not None and len(sec_content.strip()) < 10:\\n            # Check if section exists but is empty\\n            if has_section_fuzzy(content, sec):\\n                empty_sections.append(sec)\\n    checks.append({\\n        \\\"id\\\": \\\"V-ANTILAZY-02\\\",\\n        \\\"description\\\": \\\"No empty required sections\\\",\\n        \\\"result\\\": \\\"fail\\\" if empty_sections else \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Empty sections: {empty_sections}\\\" if empty_sections else \\\"All required sections have content\\\",\\n        \\\"expected\\\": \\\"No empty sections\\\",\\n        \\\"actual\\\": str(empty_sections) if empty_sections else \\\"all populated\\\"\\n    })\\n    \\n    return checks\\n\\n\\n# ===== MAIN VALIDATION =====\\nprint(\\\"Starting validation of 67 agents...\\\")\\n\\n# V-CONSIST-01: Every agent in roster has a file\\nmissing_files = roster_names - agent_files_on_disk\\n# V-CONSIST-02: No extra files\\nextra_files = agent_files_on_disk - roster_names\\n\\nconsistency_checks = []\\nconsistency_checks.append({\\n    \\\"id\\\": \\\"V-CONSIST-01\\\",\\n    \\\"description\\\": \\\"Every agent in roster.json has a corresponding prompt file\\\",\\n    \\\"result\\\": \\\"pass\\\" if not missing_files else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Missing files: {sorted(missing_files)}\\\" if missing_files else f\\\"All {len(roster_names)} roster agents have prompt files\\\",\\n    \\\"expected\\\": f\\\"{len(roster_names)} files\\\",\\n    \\\"actual\\\": f\\\"{len(roster_names) - len(missing_files)} files, missing {len(missing_files)}\\\"\\n})\\n\\nconsistency_checks.append({\\n    \\\"id\\\": \\\"V-CONSIST-02\\\",\\n    \\\"description\\\": \\\"No prompt files exist for agents not in roster.json\\\",\\n    \\\"result\\\": \\\"pass\\\" if not extra_files else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Extra files: {sorted(extra_files)}\\\" if extra_files else f\\\"No orphan agent files found\\\",\\n    \\\"expected\\\": \\\"0 extra files\\\",\\n    \\\"actual\\\": f\\\"{len(extra_files)} extra files\\\"\\n})\\n\\n# Validate each agent\\nagent_results = []\\nfor name, entry in sorted(roster_agents.items()):\\n    checks = validate_agent(name, entry)\\n    \\n    pass_count = sum(1 for c in checks if c[\\\"result\\\"] == \\\"pass\\\")\\n    fail_count = sum(1 for c in checks if c[\\\"result\\\"] == \\\"fail\\\")\\n    na_count = sum(1 for c in checks if c[\\\"result\\\"] == \\\"not-applicable\\\")\\n    applicable = pass_count + fail_count\\n    \\n    total_pass += pass_count\\n    total_fail += fail_count\\n    total_na += na_count\\n    \\n    verdict = \\\"pass\\\" if fail_count == 0 else \\\"fail\\\"\\n    \\n    agent_results.append({\\n        \\\"agent\\\": name,\\n        \\\"verdict\\\": verdict,\\n        \\\"score\\\": f\\\"{pass_count}/{applicable}\\\",\\n        \\\"checks\\\": checks\\n    })\\n\\n# Add consistency checks to totals\\nfor c in consistency_checks:\\n    if c[\\\"result\\\"] == \\\"pass\\\":\\n        total_pass += 1\\n    elif c[\\\"result\\\"] == \\\"fail\\\":\\n        total_fail += 1\\n    else:\\n        total_na += 1\\n\\ntotal_checks = total_pass + total_fail\\noverall_pct = round(100 * total_pass / total_checks, 1) if total_checks > 0 else 0\\n\\n# Determine overall verdict\\ncritical_failures = []\\nfor ar in agent_results:\\n    for c in ar[\\\"checks\\\"]:\\n        if c[\\\"result\\\"] == \\\"fail\\\" and c[\\\"id\\\"].startswith((\\\"V-CONTENT-\\\", \\\"V-CONSIST-\\\")):\\n            critical_failures.append(f\\\"{ar['agent']}: {c['id']} - {c['description']}\\\")\\n\\nfor c in consistency_checks:\\n    if c[\\\"result\\\"] == \\\"fail\\\":\\n        critical_failures.append(f\\\"GLOBAL: {c['id']} - {c['description']}\\\")\\n\\noverall_verdict = \\\"fail\\\" if critical_failures else \\\"pass\\\"\\n\\nagents_passing = sum(1 for ar in agent_results if ar[\\\"verdict\\\"] == \\\"pass\\\")\\nagents_failing = sum(1 for ar in agent_results if ar[\\\"verdict\\\"] == \\\"fail\\\")\\n\\n# Print summary\\nprint(f\\\"\\\\n===== VALIDATION SUMMARY =====\\\")\\nprint(f\\\"Total agents: {len(agent_results)}\\\")\\nprint(f\\\"Agents passing: {agents_passing}\\\")\\nprint(f\\\"Agents failing: {agents_failing}\\\")\\nprint(f\\\"Total checks: {total_checks}\\\")\\nprint(f\\\"Checks passing: {total_pass}\\\")\\nprint(f\\\"Checks failing: {total_fail}\\\")\\nprint(f\\\"Score: {total_pass}/{total_checks} ({overall_pct}%)\\\")\\nprint(f\\\"Overall verdict: {overall_verdict}\\\")\\nprint(f\\\"Critical failures: {len(critical_failures)}\\\")\\n\\nif critical_failures:\\n    print(f\\\"\\\\n===== CRITICAL FAILURES =====\\\")\\n    for cf in critical_failures:\\n        print(f\\\"  - {cf}\\\")\\n\\n# Print all failing checks\\nprint(f\\\"\\\\n===== ALL FAILURES =====\\\")\\nfor ar in agent_results:\\n    for c in ar[\\\"checks\\\"]:\\n        if c[\\\"result\\\"] == \\\"fail\\\":\\n            print(f\\\"  {ar['agent']}: {c['id']} - {c['description']}: {c['evidence']}\\\")\\n\\n# Output the full report as JSON\\nreport = {\\n    \\\"version\\\": 2,\\n    \\\"lastUpdated\\\": datetime.now(timezone.utc).isoformat(),\\n    \\\"iteration\\\": 2,\\n    \\\"overallVerdict\\\": overall_verdict,\\n    \\\"overallScore\\\": f\\\"{total_pass}/{total_checks} ({overall_pct}%)\\\",\\n    \\\"agentResults\\\": agent_results,\\n    \\\"infrastructureResults\\\": {\\n        \\\"bootstrapChecks\\\": [],\\n        \\\"schemaChecks\\\": [],\\n        \\\"consistencyChecks\\\": consistency_checks\\n    },\\n    \\\"summary\\\": {\\n        \\\"totalAgents\\\": len(agent_results),\\n        \\\"agentsPassing\\\": agents_passing,\\n        \\\"agentsFailing\\\": agents_failing,\\n        \\\"totalChecks\\\": total_checks,\\n        \\\"checksPassing\\\": total_pass,\\n        \\\"checksFailing\\\": total_fail,\\n        \\\"checksNA\\\": total_na,\\n        \\\"criticalFailures\\\": critical_failures\\n    }\\n}\\n\\nwith open(\\\"/tmp/validation_report_partial.json\\\", \\\"w\\\") as f:\\n    json.dump(report, f, indent=2)\\n\\nprint(f\\\"\\\\nPartial report written to /tmp/validation_report_partial.json\\\")\\n\\nPYEOF\\npython3 /tmp/validate_agents.py\", \"description\": \"Run comprehensive validation script\", \"initial_wait\": 30}"
