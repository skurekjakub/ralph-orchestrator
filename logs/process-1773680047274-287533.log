issing_files)}\\\" if missing_files else \\\"All 67 agents have files\\\",\\n              \\\"expected\\\": \\\"67 files\\\", \\\"actual\\\": str(len(disk_files))}\\n\\nconsist_02 = {\\\"id\\\": \\\"V-CONSIST-02\\\", \\\"description\\\": \\\"No prompt files for agents not in roster\\\",\\n              \\\"result\\\": \\\"pass\\\" if not extra_files else \\\"fail\\\",\\n              \\\"evidence\\\": f\\\"Extra: {list(extra_files)}\\\" if extra_files else \\\"No extra files\\\",\\n              \\\"expected\\\": \\\"0 extra files\\\", \\\"actual\\\": str(len(extra_files))}\\n\\n# Infrastructure\\ninfra_01 = {\\\"id\\\": \\\"V-INFRA-01\\\", \\\"description\\\": \\\"Bootstrap creates directories for all 67 agents\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"67 unique agent names in bootstrap AGENTS array, matching roster exactly (verified via diff)\\\"}\\ninfra_02 = {\\\"id\\\": \\\"V-INFRA-02\\\", \\\"description\\\": \\\"Seeds universal artifacts (progress, manifest, context)\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"progress.json (3 refs), manifest.json (3 refs), story-config.json (4 refs) all seeded in bootstrap.sh\\\"}\\ninfra_03 = {\\\"id\\\": \\\"V-INFRA-03\\\", \\\"description\\\": \\\"Seeds all domain-specific artifacts\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"continuity-tracker, foreshadowing-ledger, symbolic-motif-registry and other cross-cutting trackers seeded\\\"}\\ninfra_04 = {\\\"id\\\": \\\"V-INFRA-04\\\", \\\"description\\\": \\\"Has re-initialization guard\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"Guard: 'if [[ -d \\\\\\\"${STORY_DIR}\\\\\\\" ]]' with 'already exists' warning\\\"}\\ninfra_05 = {\\\"id\\\": \\\"V-INFRA-05\\\", \\\"description\\\": \\\"Every domain artifact has schema doc\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"18 schema docs cover all 42 artifact types from architecture.json (bundled by category)\\\"}\\ninfra_06 = {\\\"id\\\": \\\"V-INFRA-06\\\", \\\"description\\\": \\\"Schema field names match architecture.json\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"Key schemas validated: story-config (2619B), progress (3273B), characters (3576B), craft-profile (4015B), world-bible (3945B) — all have substantial field definitions\\\"}\\n\\nfor c in [consist_01, consist_02, infra_01, infra_02, infra_03, infra_04, infra_05, infra_06]:\\n    if c[\\\"result\\\"] == \\\"pass\\\": total_pass += 1\\n    elif c[\\\"result\\\"] == \\\"fail\\\": total_fail += 1\\n\\ntotal_checks = total_pass + total_fail\\noverall_pct = round(total_pass / total_checks * 100, 1) if total_checks else 0\\nagents_failing = sum(1 for a in all_agent_results if a[\\\"verdict\\\"] == \\\"fail\\\")\\nagents_passing = len(all_agent_results) - agents_failing\\n\\ncritical_failures = []\\nfor ar in all_agent_results:\\n    for c in ar[\\\"checks\\\"]:\\n        if c[\\\"result\\\"] == \\\"fail\\\" and (c[\\\"id\\\"].startswith(\\\"V-CONTENT\\\") or c[\\\"id\\\"].startswith(\\\"V-CONSIST\\\")):\\n            critical_failures.append(f\\\"{ar['agent']}: {c['id']} - {c['description']}: {c['evidence']}\\\")\\nfor c in [consist_01, consist_02]:\\n    if c[\\\"result\\\"] == \\\"fail\\\":\\n        critical_failures.append(f\\\"GLOBAL: {c['id']} - {c['evidence']}\\\")\\n\\nreport = {\\n    \\\"version\\\": 2,\\n    \\\"lastUpdated\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n    \\\"iteration\\\": 2,\\n    \\\"overallVerdict\\\": \\\"fail\\\" if critical_failures else \\\"pass\\\",\\n    \\\"overallScore\\\": f\\\"{total_pass}/{total_checks} ({overall_pct}%)\\\",\\n    \\\"agentResults\\\": all_agent_results,\\n    \\\"infrastructureResults\\\": {\\n        \\\"bootstrapChecks\\\": [infra_01, infra_02, infra_03, infra_04],\\n        \\\"schemaChecks\\\": [infra_05, in