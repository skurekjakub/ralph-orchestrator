e.escape(heading) + r'\\\\s*$'\\n    m = re.search(p, content, re.MULTILINE)\\n    if not m: return ''\\n    s = m.end()\\n    n = re.search(r'^##\\\\s+', content[s:], re.MULTILINE)\\n    e = s + n.start() if n else len(content)\\n    return content[s:e].strip()\\n\\ndef step_count(content, heading):\\n    return len(re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', get_sect(content, heading), re.MULTILINE))\\n\\ndef num_items(text):\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\n# Load all content\\nagent_contents = {}\\nfor name in roster_names:\\n    fp = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    if os.path.exists(fp):\\n        with open(fp) as f:\\n            agent_contents[name] = f.read()\\n\\n# Build full report\\nagent_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\nagents_passing = 0\\nagents_failing = 0\\n\\nfor ai in roster_agents:\\n    name = ai['name']\\n    at = get_agent_type(ai)\\n    level = ai.get('level', '')\\n    children = ai.get('children', [])\\n    rc = ai.get('resultCodes', [])\\n    parent = ai.get('parent', '')\\n    content = agent_contents.get(name, '')\\n    checks = []\\n    \\n    if not content:\\n        checks.append({'id': 'V-CONSIST-01', 'description': 'Agent file exists', 'result': 'fail',\\n            'evidence': f'File {name}.agent.md not found', 'expected': None, 'actual': None})\\n        p = sum(1 for c in checks if c['result'] == 'pass')\\n        f = sum(1 for c in checks if c['result'] == 'fail')\\n        agent_results.append({'agent': name, 'verdict': 'fail', 'score': f'0/1', 'checks': checks})\\n        total_fail += 1\\n        agents_failing += 1\\n        continue\\n\\n    h1 = get_h1(content)\\n    ml = get_meta(content, 'Level')\\n    mai = get_meta(content, 'Agent ID')\\n    mp = get_meta(content, 'Parent')\\n    mc = get_meta(content, 'Children')\\n    rt = get_sect(content, 'Role')\\n\\n    # V-IDENTITY-01\\n    checks.append({'id':'V-IDENTITY-01','description':'Identity metadata (H1 + Agent ID + Level)',\\n        'result':'pass' if (h1 and mai and ml) else 'fail',\\n        'evidence':f\\\"H1='{h1}', ID='{mai}', Level='{ml}'\\\",'expected':None,'actual':None})\\n    # V-IDENTITY-02\\n    checks.append({'id':'V-IDENTITY-02','description':'Role description non-empty',\\n        'result':'pass' if len(rt)>30 else 'fail',\\n        'evidence':f\\\"Role: {len(rt)} chars\\\",'expected':None,'actual':None})\\n    # V-IDENTITY-03\\n    checks.append({'id':'V-IDENTITY-03','description':'Level matches roster',\\n        'result':'pass' if ml==level else 'fail',\\n        'evidence':f\\\"meta='{ml}', roster='{level}'\\\",'expected':level,'actual':ml})\\n    # V-IDENTITY-04\\n    checks.append({'id':'V-IDENTITY-04','description':'Correct naming prefix',\\n        'result':'pass' if name.startswith(PREFIX) else 'fail',\\n        'evidence':f\\\"name='{name}'\\\",'expected':PREFIX,'actual':name})\\n    # V-SECTION-01\\n    checks.append({'id':'V-SECTION-01','description':'H1 heading exists',\\n        'result':'pass' if h1 else 'fail',\\n        'evidence':f\\\"H1='{h1}'\\\",'expected':None,'actual':None})\\n    # V-SECTION-02\\n    checks.append({'id':'V-SECTION-02','description':'Role section exists',\\n        'result':'pass' if has_section(content,'Role') and len(rt)>20 else 'fail',\\n        'evidence':f\\\"Role={has_section(content,'Role')}, len={len(rt)}\\\",'expected':None,'actual':None})\\n    # V-SECTION-03\\n    has_aq = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n    has_pr = has_section_fuzzy(content, 'Purity Rule')\\n    if at == 'guide':\\n        checks.append({'id':'V-SECTION-03','description':'ask_questions suppression (guide)',\\n            'result':'pass' if has_aq else 'not-applicable',\\n            'evidence':f\\\"Guide has aq={has_aq}\\\",'expected':None,'actual':None})\\n    elif at in ('coordinator','orchestrator'):\\n        checks.append({'id':'V-SECTION-03','description':'ask_questions 