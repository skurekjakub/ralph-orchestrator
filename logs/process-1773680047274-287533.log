\\\"id\\\": \\\"V-CONSIST-02\\\", \\\"description\\\": \\\"No extra prompt files beyond roster\\\",\\n    \\\"result\\\": \\\"pass\\\" if len(consist02_extra) == 0 else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Extra: {sorted(consist02_extra) if consist02_extra else 'none'}\\\",\\n    \\\"expected\\\": \\\"0 extra\\\", \\\"actual\\\": f\\\"{len(consist02_extra)} extra\\\"\\n})\\n\\nfor gc in global_checks:\\n    if gc[\\\"result\\\"] == \\\"pass\\\":\\n        total_pass += 1\\n    else:\\n        total_fail += 1\\n        if gc[\\\"id\\\"].startswith((\\\"V-CONTENT\\\", \\\"V-CONSIST\\\")):\\n            critical_failures.append(f\\\"GLOBAL: {gc['id']} - {gc['description']}\\\")\\n    total_checks += 1\\n\\n# ====== OUTPUT ======\\nprint(f\\\"{'='*60}\\\")\\nprint(f\\\"VALIDATION SUMMARY (v2)\\\")\\nprint(f\\\"{'='*60}\\\")\\nprint(f\\\"Total agents: {len(roster_agents)}\\\")\\nprint(f\\\"Passing: {agents_passing}\\\")\\nprint(f\\\"Failing: {agents_failing}\\\")\\nprint(f\\\"Total checks: {total_checks} (+ {total_na} N/A)\\\")\\nprint(f\\\"Passing: {total_pass}\\\")\\nprint(f\\\"Failing: {total_fail}\\\")\\nprint(f\\\"Score: {total_pass}/{total_checks} ({100*total_pass/total_checks:.1f}%)\\\")\\nprint(f\\\"Critical failures: {len(critical_failures)}\\\")\\n\\nif agents_failing > 0:\\n    print(f\\\"\\\\nFAILING AGENTS:\\\")\\n    for ar in all_results:\\n        if ar[\\\"verdict\\\"] == \\\"fail\\\":\\n            fails = [c for c in ar[\\\"checks\\\"] if c[\\\"result\\\"] == \\\"fail\\\"]\\n            print(f\\\"\\\\n  {ar['agent']} ({ar['type']}): {len(fails)} failures\\\")\\n            for f in fails:\\n                print(f\\\"    {f['id']}: {f['description']}\\\")\\n                print(f\\\"      expected={f['expected']}, actual={f['actual']}\\\")\\n\\nif critical_failures:\\n    print(f\\\"\\\\n{'='*60}\\\")\\n    print(f\\\"CRITICAL FAILURES ({len(critical_failures)}):\\\")\\n    for cf in critical_failures[:20]:\\n        print(f\\\"  - {cf}\\\")\\n    if len(critical_failures) > 20:\\n        print(f\\\"  ... and {len(critical_failures)-20} more\\\")\\n\\nwith open(\\\"/tmp/validation_results_v2.json\\\", \\\"w\\\") as f:\\n    json.dump({\\n        \\\"all_results\\\": all_results,\\n        \\\"global_checks\\\": global_checks,\\n        \\\"total_pass\\\": total_pass,\\n        \\\"total_fail\\\": total_fail,\\n        \\\"total_na\\\": total_na,\\n        \\\"total_checks\\\": total_checks,\\n        \\\"agents_passing\\\": agents_passing,\\n        \\\"agents_failing\\\": agents_failing,\\n        \\\"critical_failures\\\": critical_failures\\n    }, f, indent=2)\\n\\nprint(f\\\"\\\\nResults saved to /tmp/validation_results_v2.json\\\")\\nPYEOF\\npython3 /tmp/validate_v2.py\", \"description\": \"Run corrected validation v2\", \"initial_wait\": 30}"
