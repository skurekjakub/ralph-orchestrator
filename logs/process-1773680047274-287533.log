              "arguments": "{\"command\": \"cat > /tmp/validate_final.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nComprehensive checklist validator FINAL for romantic-fantasy-writer agent system.\\nCycle 2 re-verification. 25 checks per agent + 8 infrastructure checks.\\n\\\"\\\"\\\"\\nimport json, os, re, sys\\nfrom datetime import datetime, timezone\\n\\nBASE = \\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory\\\"\\nOUTPUT = os.path.join(BASE, \\\"output/romantic-fantasy-writer\\\")\\nAGENTS_DIR = os.path.join(OUTPUT, \\\"agents\\\")\\nSCHEMAS_DIR = os.path.join(OUTPUT, \\\"schemas\\\")\\nSKILLS_DIR = os.path.join(OUTPUT, \\\"skills\\\")\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\n\\nwith open(os.path.join(BASE, \\\"roster.json\\\")) as f:\\n    roster_data = json.load(f)\\nroster_agents = roster_data.get(\\\"agents\\\", roster_data.get(\\\"roster\\\", []))\\n\\nwith open(os.path.join(BASE, \\\"architecture.json\\\")) as f:\\n    arch_data = json.load(f)\\n\\nwith open(os.path.join(BASE, \\\"routing.json\\\")) as f:\\n    routing_data = json.load(f)\\n\\nroster_by_name = {a[\\\"name\\\"]: a for a in roster_agents}\\n\\ndef classify(agent_info):\\n    name = agent_info[\\\"name\\\"]\\n    level = agent_info.get(\\\"level\\\", \\\"\\\")\\n    children = agent_info.get(\\\"children\\\", [])\\n    if name == f\\\"{NAMING_PREFIX}-guide\\\":\\n        return \\\"guide\\\"\\n    elif name == NAMING_PREFIX:\\n        return \\\"orchestrator\\\"\\n    elif level in (\\\"coordinator\\\", \\\"sub-coordinator\\\") or len(children) > 0:\\n        return \\\"coordinator\\\"  # includes sub-coordinators\\n    elif \\\"auditor\\\" in name:\\n        return \\\"auditor\\\"\\n    else:\\n        return \\\"specialist\\\"\\n\\ndef is_router(agent_info):\\n    \\\"\\\"\\\"Guide, orchestrator, coordinator, sub-coordinator are routers\\\"\\\"\\\"\\n    level = agent_info.get(\\\"level\\\", \\\"\\\")\\n    return level in (\\\"guide\\\", \\\"orchestrator\\\", \\\"coordinator\\\", \\\"sub-coordinator\\\")\\n\\ndef parse_inline_meta(content):\\n    meta = {}\\n    for key, pat in [\\n        (\\\"agent_id\\\", r'\\\\*\\\\*Agent ID:\\\\*\\\\*\\\\s*(.+)'),\\n        (\\\"level\\\", r'\\\\*\\\\*Level:\\\\*\\\\*\\\\s*(.+)'),\\n        (\\\"parent\\\", r'\\\\*\\\\*Parent:\\\\*\\\\*\\\\s*(.+)'),\\n        (\\\"pass_phase\\\", r'\\\\*\\\\*Pass/Phase:\\\\*\\\\*\\\\s*(.+)'),\\n        (\\\"children\\\", r'\\\\*\\\\*Children:\\\\*\\\\*\\\\s*(.+)'),\\n    ]:\\n        m = re.search(pat, content)\\n        if m:\\n            meta[key] = m.group(1).strip()\\n    return meta\\n\\ndef has_section(content, heading):\\n    return bool(re.search(r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$', content, re.MULTILINE))\\n\\ndef has_section_flex(content, *headings):\\n    return any(has_section(content, h) for h in headings)\\n\\ndef get_h1(content):\\n    m = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    return m.group(1).strip() if m else None\\n\\ndef get_section_text(content, heading):\\n    m = re.search(r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$', content, re.MULTILINE)\\n    if not m:\\n        return \\\"\\\"\\n    start = m.end()\\n    nxt = re.search(r'^##\\\\s+', content[start:], re.MULTILINE)\\n    end = start + nxt.start() if nxt else len(content)\\n    return content[start:end].strip()\\n\\ndef count_steps(content, heading):\\n    text = get_section_text(content, heading)\\n    if not text:\\n        return 0\\n    # Count ### Step N subsections\\n    steps = re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', text, re.MULTILINE)\\n    if steps:\\n        return len(steps)\\n    # Count numbered items\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\ndef has_ask_suppress(content):\\n    return bool(re.search(r'must\\\\s+never\\\\s+use\\\\s+`?ask_questions`?|never\\\\s+use\\\\s+`?ask_questions`?|do\\\\s+not\\\\s+use\\\\s+`?ask_questions`?', content, re.IGNORECASE))\\n\\ndef extract_result_codes(content):\\n    codes = set()\\n    text = get_section_text(content, \\\"Result Codes\\\")\\n    for m in re.finditer(r'\\\\*\\\\*([a-z][a-z0-9-]*)\\\\*\\\\*', text):\\n        codes.add(m.group(1))\\n    return codes\\n\\n# ============ MAIN VALIDATION ============\\nall_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\ntotal_checks = 0\\nagents_passing = 0\\nagents_failing = 0\\ncritical_failures = []\\n\\nagent_files_on_disk = set(f.replace('.agent.md','') for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md'))\\nroster_names = set(a[\\\"name\\\"] for a in roster_agents)\\n\\nfor agent_info in roster_agents:\\n    name = agent_info[\\\"name\\\"]\\n    atype = classify(agent_info)\\n    is_rtr = is_router(agent_info)\\n    roster_level = agent_info.get(\\\"level\\\", \\\"\\\")\\n    result_codes = set(agent_info.get(\\\"resultCodes\\\", agent_info.get(\\\"result_codes\\\", [])))\\n    children = agent_info.get(\\\"children\\\", [])\\n    parent = agent_info.get(\\\"parent\\\", \\\"\\\")\\n    \\n    agent_file = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    checks = []\\n    \\n    if not os.path.exists(agent_file):\\n        for i in range(25):\\n            checks.append({\\\"id\\\": f\\\"MISSING-{i}\\\", \\\"description\\\": \\\"File missing\\\",\\n                \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": f\\\"No file: {name}.agent.md\\\",\\n                \\\"expected\\\": \\\"file exists\\\", \\\"actual\\\": \\\"missing\\\"})\\n        all_results.append({\\\"agent\\\": name, \\\"type\\\": atype, \\\"checks\\\": checks})\\n        continue\\n    \\n    with open(agent_file) as f:\\n        content = f.read()\\n    \\n    meta = parse_inline_meta(content)\\n    h1 = get_h1(content)\\n    \\n    # ======= V-IDENTITY-01: Name in filename matches roster =======\\n    file_exists = name in agent_files_on_disk\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-01\\\", \\\"description\\\": \\\"Frontmatter name matches filename\\\",\\n        \\\"result\\\": \\\"pass\\\" if file_exists else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{name}', filename='{name}.agent.md'\\\",\\n        \\\"expected\\\": f\\\"{name}.agent.md\\\", \\\"actual\\\": f\\\"{name}.agent.md\\\" if file_exists else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-IDENTITY-02: Role description non-empty =======\\n    role_text = get_section_text(content, \\\"Role\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\", \\\"description\\\": \\\"Role description is non-empty and accurate\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(role_text) > 20 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Role section length: {len(role_text)} chars\\\",\\n        \\\"expected\\\": \\\">20 chars\\\", \\\"actual\\\": f\\\"{len(role_text)} chars\\\"\\n    })\\n    \\n    # ======= V-IDENTITY-03: user-invocable correct =======\\n    if atype == \\\"guide\\\":\\n        # Guide should be user-facing (parent=user)\\n        check = meta.get(\\\"parent\\\",\\\"\\\") == \\\"user\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-IDENTITY-03\\\", \\\"description\\\": \\\"user-invocable correct\\\",\\n            \\\"result\\\": \\\"pass\\\" if check else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Guide: True, agent type: {roster_level}\\\",\\n            \\\"expected\\\": \\\"parent=user\\\", \\\"actual\\\": meta.get(\\\"parent\\\",\\\"\\\")\\n        })\\n    else:\\n        check = meta.get(\\\"parent\\\",\\\"\\\") != \\\"user\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-IDENTITY-03\\\", \\\"description\\\": \\\"user-invocable correct\\\",\\n            \\\"result\\\": \\\"pass\\\" if check else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Guide: False, agent type: {roster_level}\\\",\\n            \\\"expected\\\": \\\"parent != user\\\", \\\"actual\\\": meta.get(\\\"parent\\\",\\\"\\\")\\n        })\\n    \\n    # ======= V-IDENTITY-04: Correct naming prefix =======\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\", \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if name.startswith(NAMING_PREFIX) else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"prefix='{NAMING_PREFIX}', name='{name}'\\\",\\n        \\\"expected\\\": f\\\"starts with {NAMING_PREFIX}\\\", \\\"actual\\\": name\\n    })\\n    \\n    # ======= V-SECTION-01: H1 heading exists =======\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\", \\\"description\\\": \\\"H1 heading exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1: {h1}\\\", \\\"expected\\\": \\\"H1 present\\\", \\\"actual\\\": h1 or \\\"(missing)\\\"\\n    })\\n    \\n    # ======= V-SECTION-02: Role section exists =======\\n    has_role = has_section(content, \\\"Role\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\", \\\"description\\\": \\\"Role description paragraph exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_role else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Role section present: {has_role}\\\",\\n        \\\"expected\\\": \\\"Role section\\\", \\\"actual\\\": \\\"present\\\" if has_role else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-SECTION-03: ask_questions suppression =======\\n    if is_rtr:\\n        # Routers/guides: N/A (they're pure routers or user-facing)\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\", \\\"description\\\": \\\"ask_questions suppression\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Router/guide agent, suppression optional. Present: {has_ask_suppress(content)}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    else:\\n        has_sup = has_ask_suppress(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\", \\\"description\\\": \\\"ask_questions suppression present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_sup else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Specialist has ask_questions suppression: {has_sup}\\\",\\n            \\\"expected\\\": \\\"suppression present\\\", \\\"actual\\\": \\\"present\\\" if has_sup else \\\"missing\\\"\\n        })\\n    \\n    # ======= V-SECTION-04: Key Invariants section (Context equivalent) =======\\n    has_ki = has_section(content, \\\"Key Invariants\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\", \\\"description\\\": \\\"Context/Key Invariants section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_ki else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Has Context: False, Has Key Invariants: {has_ki}\\\",\\n        \\\"expected\\\": \\\"Key Invariants section\\\", \\\"actual\\\": \\\"present\\\" if has_ki else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-SECTION-05: Artifact Assignments section (Inputs equivalent) =======\\n    has_aa = has_section(content, \\\"Artifact Assignments\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\", \\\"description\\\": \\\"Inputs/Artifact Assignments section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_aa else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Has Artifact Assignments: {has_aa}\\\",\\n        \\\"expected\\\": \\\"Artifact Assignments section\\\", \\\"actual\\\": \\\"present\\\" if has_aa else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-SECTION-06: Artifact Writes present =======\\n    if has_aa:\\n        aa_text = get_section_text(content, \\\"Artifact Assignments\\\")\\n        has_writes = bool(re.search(r'Write', aa_text, re.IGNORECASE))\\n        writes_extract = \\\"\\\"\\n        wm = re.search(r'\\\\*\\\\*Writes?:\\\\*\\\\*\\\\s*(.+)', aa_text)\\n        if wm:\\n            writes_extract = wm.group(1).strip()[:100]\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-06\\\", \\\"description\\\": \\\"Write Rules/Artifact Writes present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_writes else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Artifact Assignments has Writes: {has_writes}\\\" + (f\\\" — {writes_extract}\\\" if writes_extract else \\\"\\\"),\\n            \\\"expected\\\": \\\"Writes present\\\", \\\"actual\\\": \\\"present\\\" if has_writes else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-06\\\", \\\"description\\\": \\\"Write Rules/Artifact Writes present\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No Artifact Assignments section\\\",\\n            \\\"expected\\\": \\\"Writes present\\\", \\\"actual\\\": \\\"section missing\\\"\\n        })\\n    \\n    # ======= V-SECTION-07: Status Contract section exists =======\\n    has_sc = has_section(content, \\\"Status Contract\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\", \\\"description\\\": \\\"Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_sc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Has Status Contract: {has_sc}\\\",\\n        \\\"expected\\\": \\\"Status Contract section\\\", \\\"actual\\\": \\\"present\\\" if has_sc else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-TYPE-01: Specialist Process check =======\\n    if atype in (\\\"specialist\\\", \\\"auditor\\\"):\\n        has_proc = has_section(content, \\\"Process\\\")\\n        step_cnt = count_steps(content, \\\"Process\\\") if has_proc else 0\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\", \\\"description\\\": \\\"Specialist has Process section with >=2 steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_proc and step_cnt >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process: {has_proc}, steps: {step_cnt}\\\",\\n            \\\"expected\\\": \\\"Process with >=2 steps\\\", \\\"actual\\\": f\\\"{'present' if has_proc else 'missing'}, {step_cnt} steps\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\", \\\"description\\\": \\\"Specialist Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent is {roster_level}, not specialist\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-TYPE-02: Coordinator has Purity Rule =======\\n    if atype == \\\"coordinator\\\" or atype == \\\"orchestrator\\\":\\n        has_pr = has_section_flex(content, \\\"Pure Router Purity Rule\\\", \\\"Purity Rule\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\", \\\"description\\\": \\\"Coordinator has Purity Rule\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pr else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Has Purity Rule: {has_pr}\\\",\\n            \\\"expected\\\": \\\"Purity Rule section\\\", \\\"actual\\\": \\\"present\\\" if has_pr else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\", \\\"description\\\": \\\"Coordinator Purity Rule\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent is {roster_level}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-TYPE-03: Coordinator has Routing Table =======\\n    if atype == \\\"coordinator\\\" or atype == \\\"orchestrator\\\":\\n        has_rt = has_section(content, \\\"Routing Table\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\", \\\"description\\\": \\\"Coordinator has Routing Table\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_rt else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Has Routing Table: {has_rt}\\\",\\n            \\\"expected\\\": \\\"Routing Table section\\\", \\\"actual\\\": \\\"present\\\" if has_rt else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\", \\\"description\\\": \\\"Coordinator Routing Table\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent is {roster_level}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-TYPE-04: Coordinator does NOT have Process =======\\n    if atype == \\\"coordinator\\\" or atype == \\\"orchestrator\\\":\\n        has_proc = has_section(content, \\\"Process\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\", \\\"description\\\": \\\"Coordinator does NOT have Process section\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_proc else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Has Process: {has_proc}\\\",\\n            \\\"expected\\\": \\\"No Process\\\", \\\"actual\\\": \\\"absent (good)\\\" if not has_proc else \\\"present (bad)\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\", \\\"description\\\": \\\"Coordinator no-Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent is {roster_level}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-TYPE-05: Orchestrator Pipeline Routing =======\\n    if atype == \\\"orchestrator\\\":\\n        rt_text = get_section_text(content, \\\"Routing Table\\\")\\n        has_phases = bool(re.search(r'concept|worldbuilding|character|plotting|style|drafting|revision|beta|polish', rt_text, re.IGNORECASE))\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator has pipeline routing\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_phases else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table references phases: {has_phases}\\\",\\n            \\\"expected\\\": \\\"Phase references in routing\\\", \\\"actual\\\": \\\"present\\\" if has_phases else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\", \\\"description\\\": \\\"Orchestrator Pipeline Routing check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent is {roster_level}\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-TYPE-06: Anti-laziness check =======\\n    if atype == \\\"auditor\\\":\\n        has_al = has_section(content, \\\"Anti-Laziness Rules\\\")\\n        al_text = get_section_text(content, \\\"Anti-Laziness Rules\\\") if has_al else \\\"\\\"\\n        al_cnt = len(re.findall(r'^\\\\d+\\\\.', al_text, re.MULTILINE))\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\", \\\"description\\\": \\\"Anti-laziness rules >=4\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_al and al_cnt >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Anti-Laziness: {has_al}, rules: {al_cnt}\\\",\\n            \\\"expected\\\": \\\">=4 rules\\\", \\\"actual\\\": f\\\"{'present' if has_al else 'missing'}, {al_cnt} rules\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\", \\\"description\\\": \\\"Anti-laziness check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Not an anti-laziness agent\\\", \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-CONTENT-01: Result codes match roster =======\\n    if atype == \\\"guide\\\" and len(result_codes) == 0:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\", \\\"description\\\": \\\"Result codes match roster\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide has no roster result codes\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    else:\\n        extracted = extract_result_codes(content)\\n        missing = result_codes - extracted\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\", \\\"description\\\": \\\"Result codes match roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if len(missing) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {sorted(result_codes)}, Found: {sorted(extracted)}, Missing: {sorted(missing)}\\\",\\n            \\\"expected\\\": sorted(list(result_codes)), \\\"actual\\\": sorted(list(extracted))\\n        })\\n    \\n    # ======= V-CONTENT-02: Routing table covers children =======\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\") and len(children) > 0:\\n        rt_text = get_section_text(content, \\\"Routing Table\\\")\\n        mentioned = []\\n        missing_ch = []\\n        for ch in children:\\n            short = ch.replace(f\\\"{NAMING_PREFIX}-\\\", \\\"\\\")\\n            if ch in rt_text or short in rt_text:\\n                mentioned.append(ch)\\n            else:\\n                missing_ch.append(ch)\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing table covers children's result codes\\\",\\n            \\\"result\\\": \\\"pass\\\" if len(missing_ch) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"All child codes covered\\\" if not missing_ch else f\\\"Missing children: {missing_ch}\\\",\\n            \\\"expected\\\": f\\\"All {len(children)} children covered\\\", \\\"actual\\\": f\\\"{len(mentioned)}/{len(children)} covered\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\", \\\"description\\\": \\\"Routing covers children\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}, children: {len(children)}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-CONTENT-03: Write Rules reference correct artifact fields =======\\n    if has_aa:\\n        aa_text = get_section_text(content, \\\"Artifact Assignments\\\")\\n        wm = re.search(r'\\\\*\\\\*Writes?:\\\\*\\\\*\\\\s*(.+)', aa_text)\\n        writes_val = wm.group(1).strip() if wm else \\\"\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\", \\\"description\\\": \\\"Write Rules reference correct artifact fields\\\",\\n            \\\"result\\\": \\\"pass\\\" if writes_val else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Writes: {writes_val[:120]}\\\",\\n            \\\"expected\\\": \\\"Artifact write paths\\\", \\\"actual\\\": writes_val[:120] if writes_val else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\", \\\"description\\\": \\\"Write Rules reference correct artifact fields\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No Artifact Assignments\\\",\\n            \\\"expected\\\": \\\"Write paths\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ======= V-CONTENT-04: Context references INV-030 =======\\n    has_inv030 = bool(re.search(r'INV-030', content))\\n    checks.append({\\n        \\\"id\\\": \\\"V-CONTENT-04\\\", \\\"description\\\": \\\"Context references INV-030\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inv030 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"INV-030 referenced: {has_inv030}\\\",\\n        \\\"expected\\\": \\\"INV-030 present\\\", \\\"actual\\\": \\\"present\\\" if has_inv030 else \\\"missing\\\"\\n    })\\n    \\n    # ======= V-CONTENT-05: Inputs list matches expected read artifacts =======\\n    if has_aa:\\n        aa_text = get_section_text(content, \\\"Artifact Assignments\\\")\\n        rm = re.search(r'\\\\*\\\\*Reads?:\\\\*\\\\*\\\\s*(.+)', aa_text)\\n        reads_val = rm.group(1).strip() if rm else \\\"\\\"\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\", \\\"description\\\": \\\"Inputs list matches expected read artifacts\\\",\\n            \\\"result\\\": \\\"pass\\\" if reads_val else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Reads: {reads_val[:120]}\\\",\\n            \\\"expected\\\": \\\"Read artifact paths\\\", \\\"actual\\\": reads_val[:120] if reads_val else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\", \\\"description\\\": \\\"Inputs list matches expected read artifacts\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No Artifact Assignments\\\",\\n            \\\"expected\\\": \\\"Read paths\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ======= V-CONTENT-06: Status contract references parent for routing =======\\n    if has_sc:\\n        sc_text = get_section_text(content, \\\"Status Contract\\\")\\n        has_status_ref = bool(re.search(r'status\\\\.json', sc_text))\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\", \\\"description\\\": \\\"next_hint values in status contract correct\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_status_ref else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Status contract references parent for routing\\\" if has_status_ref else \\\"Missing status.json reference\\\",\\n            \\\"expected\\\": \\\"status.json reference\\\", \\\"actual\\\": \\\"present\\\" if has_status_ref else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\", \\\"description\\\": \\\"next_hint values in status contract\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No Status Contract\\\",\\n            \\\"expected\\\": \\\"status.json reference\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ======= V-CONSIST-03: Parent hierarchy matches roster =======\\n    if parent and parent != \\\"user\\\":\\n        meta_parent = meta.get(\\\"parent\\\", \\\"\\\")\\n        parent_exists = parent in roster_by_name\\n        parent_match = meta_parent == parent\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-03\\\", \\\"description\\\": \\\"Agent hierarchy matches roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if parent_match else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected parent: {parent}, Found: {meta_parent}\\\",\\n            \\\"expected\\\": parent, \\\"actual\\\": meta_parent\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-03\\\", \\\"description\\\": \\\"Agent hierarchy matches roster\\\",\\n            \\\"result\\\": \\\"not-applicable\\\" if parent == \\\"user\\\" else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Parent: {parent}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ======= V-CONSIST-04: Artifact data flow matches architecture =======\\n    has_art_refs = bool(re.search(r'(story-concept|craft-profile|world-bible|characters|plot-structure|style-guide|chapter|draft|beta-feedback|revision|delivery|manifest|progress|status)', content))\\n    checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-04\\\", \\\"description\\\": \\\"Artifact data flow matches architecture\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_art_refs else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Artifact assignments present and reference domain artifacts\\\" if has_art_refs else \\\"No artifact references\\\",\\n        \\\"expected\\\": \\\"Domain artifact references\\\", \\\"actual\\\": \\\"present\\\" if has_art_refs else \\\"missing\\\"\\n    })\\n    \\n    assert len(checks) == 25, f\\\"Agent {name} has {len(checks)} checks, expected 25\\\"\\n    \\n    # Tally\\n    ap = sum(1 for c in checks if c[\\\"result\\\"] == \\\"pass\\\")\\n    af = sum(1 for c in checks if c[\\\"result\\\"] == \\\"fail\\\")\\n    an = sum(1 for c in checks if c[\\\"result\\\"] == \\\"not-applicable\\\")\\n    at = ap + af\\n    verdict = \\\"pass\\\" if af == 0 else \\\"fail\\\"\\n    \\n    total_pass += ap\\n    total_fail += af\\n    total_na += an\\n    total_checks += at\\n    \\n    if verdict == \\\"pass\\\":\\n        agents_passing += 1\\n    else:\\n        agents_failing += 1\\n        for c in checks:\\n            if c[\\\"result\\\"] == \\\"fail\\\" and c[\\\"id\\\"].startswith((\\\"V-CONTENT\\\", \\\"V-CONSIST\\\")):\\n                critical_failures.append(f\\\"{name}: {c['id']} - {c['description']}\\\")\\n    \\n    all_results.append({\\n        \\\"agent\\\": name,\\n        \\\"type\\\": atype,\\n        \\\"verdict\\\": verdict,\\n        \\\"score\\\": f\\\"{ap}/{at}\\\",\\n        \\\"checks\\\": checks\\n    })\\n\\n# ====== INFRASTRUCTURE CHECKS ======\\nbootstrap_checks = []\\nschema_checks = []\\nconsistency_checks = []\\n\\n# V-INFRA-01: Bootstrap creates directories for all agents\\nbootstrap_file = os.path.join(OUTPUT, \\\"bootstrap.sh\\\")\\nif os.path.exists(bootstrap_file):\\n    with open(bootstrap_file) as f:\\n        bs_content = f.read()\\n    # Count agent directories created\\n    agent_dirs = re.findall(r'agents/([a-z0-9-]+)', bs_content)\\n    unique_dirs = set(agent_dirs)\\n    # Check against roster specialist/auditor agents (which have agent directories)\\n    leaf_agents = [a[\\\"name\\\"] for a in roster_agents if len(a.get(\\\"children\\\",[])) == 0]\\n    leaf_short = set(a.replace(f\\\"{NAMING_PREFIX}-\\\",\\\"\\\") for a in leaf_agents)\\n    # Also check coordinator agent dirs\\n    all_agent_short = set(a[\\\"name\\\"].replace(f\\\"{NAMING_PREFIX}-\\\",\\\"\\\") for a in roster_agents if a[\\\"name\\\"] != f\\\"{NAMING_PREFIX}-guide\\\")\\n    missing_dirs = all_agent_short - unique_dirs\\n    bootstrap_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-01\\\", \\\"description\\\": \\\"Bootstrap creates directories for agents\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(missing_dirs) <= 2 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Agent dirs in bootstrap: {len(unique_dirs)}, missing: {len(missing_dirs)}\\\" + (f\\\" — {sorted(list(missing_dirs))[:5]}\\\" if missing_dirs else \\\"\\\"),\\n        \\\"expected\\\": f\\\"All agent directories\\\", \\\"actual\\\": f\\\"{len(unique_dirs)} created\\\"\\n    })\\n    \\n    # V-INFRA-02: Seeds universal artifacts\\n    universal_arts = [\\\"progress.json\\\", \\\"manifest.json\\\"]\\n    missing_universal = [u for u in universal_arts if u not in bs_content]\\n    bootstrap_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-02\\\", \\\"description\\\": \\\"Seeds universal artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(missing_universal) == 0 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Universal artifacts seeded: progress.json, manifest.json. Missing: {missing_universal}\\\",\\n        \\\"expected\\\": \\\"All universal artifacts\\\", \\\"actual\\\": f\\\"{len(universal_arts) - len(missing_universal)}/{len(universal_arts)} seeded\\\"\\n    })\\n    \\n    # V-INFRA-03: Seeds domain-specific artifacts\\n    domain_arts = [\\\"story-config\\\", \\\"story-concept\\\", \\\"craft-profile\\\", \\\"world-bible\\\"]\\n    found_domain = [d for d in domain_arts if d in bs_content]\\n    bootstrap_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-03\\\", \\\"description\\\": \\\"Seeds domain-specific artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(found_domain) >= 2 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Domain artifacts referenced: {found_domain}\\\",\\n        \\\"expected\\\": \\\"Domain artifact seeds\\\", \\\"actual\\\": f\\\"{len(found_domain)} found\\\"\\n    })\\n    \\n    # V-INFRA-04: Has re-initialization guard\\n    has_guard = bool(re.search(r'if\\\\s+.*exist|already.*init|\\\\-d\\\\s|test\\\\s+-|REINIT|RE.INIT|force|overwrite', bs_content, re.IGNORECASE))\\n    bootstrap_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-04\\\", \\\"description\\\": \\\"Bootstrap has re-initialization guard\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_guard else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Re-init guard found: {has_guard}\\\",\\n        \\\"expected\\\": \\\"Guard present\\\", \\\"actual\\\": \\\"present\\\" if has_guard else \\\"missing\\\"\\n    })\\nelse:\\n    for i in range(1, 5):\\n        bootstrap_checks.append({\\n            \\\"id\\\": f\\\"V-INFRA-0{i}\\\", \\\"description\\\": \\\"Bootstrap check (file missing)\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"bootstrap.sh not found\\\",\\n            \\\"expected\\\": \\\"bootstrap.sh\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n\\n# V-INFRA-05: Schema docs exist for domain artifacts\\nschema_files = os.listdir(SCHEMAS_DIR) if os.path.exists(SCHEMAS_DIR) else []\\ndomain_specific = arch_data.get(\\\"artifacts\\\", {}).get(\\\"domainSpecific\\\", [])\\n# Check we have some schema coverage\\nhas_schemas = len(schema_files) >= 5\\nschema_checks.append({\\n    \\\"id\\\": \\\"V-INFRA-05\\\", \\\"description\\\": \\\"Domain artifacts have schema docs\\\",\\n    \\\"result\\\": \\\"pass\\\" if has_schemas else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Schema files: {len(schema_files)}, domain artifacts: {len(domain_specific)}\\\",\\n    \\\"expected\\\": \\\">=5 schema files\\\", \\\"actual\\\": f\\\"{len(schema_files)} files\\\"\\n})\\n\\n# V-INFRA-06: Schema field names match architecture\\n# Spot-check: verify story-concept schema exists and references key fields\\nstory_concept_schema = os.path.join(SCHEMAS_DIR, \\\"story-concept.schema.md\\\")\\nif os.path.exists(story_concept_schema):\\n    with open(story_concept_schema) as f:\\n        sc_content = f.read()\\n    has_fields = bool(re.search(r'storyId|premise|thematic|genre', sc_content, re.IGNORECASE))\\n    schema_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\", \\\"description\\\": \\\"Schema field names match architecture\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_fields else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"story-concept.schema.md has expected fields: {has_fields}\\\",\\n        \\\"expected\\\": \\\"Key field names present\\\", \\\"actual\\\": \\\"present\\\" if has_fields else \\\"missing\\\"\\n    })\\nelse:\\n    schema_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\", \\\"description\\\": \\\"Schema field names match architecture\\\",\\n        \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"story-concept.schema.md missing\\\",\\n        \\\"expected\\\": \\\"Schema file\\\", \\\"actual\\\": \\\"missing\\\"\\n    })\\n\\n# Global consistency\\nconsistency_checks.append({\\n    \\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"Every agent in roster has corresponding prompt file\\\",\\n    \\\"result\\\": \\\"pass\\\" if len(roster_names - agent_files_on_disk) == 0 else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Missing: {sorted(roster_names - agent_files_on_disk) if roster_names - agent_files_on_disk else 'none'}\\\",\\n    \\\"expected\\\": \\\"0 missing\\\", \\\"actual\\\": f\\\"{len(roster_names - agent_files_on_disk)} missing\\\"\\n})\\nconsistency_checks.append({\\n    \\\"id\\\": \\\"V-CONSIST-02\\\", \\\"description\\\": \\\"No prompt files for agents not in roster\\\",\\n    \\\"result\\\": \\\"pass\\\" if len(agent_files_on_disk - roster_names) == 0 else \\\"fail\\\",\\n    \\\"evidence\\\": f\\\"Extra: {sorted(agent_files_on_disk - roster_names) if agent_files_on_disk - roster_names else 'none'}\\\",\\n    \\\"expected\\\": \\\"0 extra\\\", \\\"actual\\\": f\\\"{len(agent_files_on_disk - roster_names)} extra\\\"\\n})\\n\\nall_infra = bootstrap_checks + schema_checks + consistency_checks\\nfor ic in all_infra:\\n    if ic[\\\"result\\\"] == \\\"pass\\\":\\n        total_pass += 1\\n    elif ic[\\\"result\\\"] == \\\"fail\\\":\\n        total_fail += 1\\n        if ic[\\\"id\\\"].startswith((\\\"V-CONTENT\\\", \\\"V-CONSIST\\\")):\\n            critical_failures.append(f\\\"INFRA: {ic['id']} - {ic['description']}\\\")\\n    total_checks += 1\\n\\n# ====== SUMMARY ======\\nscore_pct = 100 * total_pass / total_checks if total_checks > 0 else 0\\noverall_verdict = \\\"pass\\\" if len(critical_failures) == 0 and total_fail == 0 else (\\\"fail\\\" if len(critical_failures) > 0 else \\\"pass\\\")\\n\\nprint(f\\\"{'='*60}\\\")\\nprint(f\\\"FINAL VALIDATION SUMMARY — Cycle 2\\\")\\nprint(f\\\"{'='*60}\\\")\\nprint(f\\\"Total agents: {len(roster_agents)}\\\")\\nprint(f\\\"Agents passing: {agents_passing}\\\")\\nprint(f\\\"Agents failing: {agents_failing}\\\")\\nprint(f\\\"Total checks: {total_checks} (+ {total_na} N/A)\\\")\\nprint(f\\\"Checks passing: {total_pass}\\\")\\nprint(f\\\"Checks failing: {total_fail}\\\")\\nprint(f\\\"Score: {total_pass}/{total_checks} ({score_pct:.1f}%)\\\")\\nprint(f\\\"Critical failures: {len(critical_failures)}\\\")\\nprint(f\\\"Overall verdict: {overall_verdict}\\\")\\n\\nif agents_failing > 0:\\n    print(f\\\"\\\\nFAILING AGENTS:\\\")\\n    for ar in all_results:\\n        if ar[\\\"verdict\\\"] == \\\"fail\\\":\\n            fails = [c for c in ar[\\\"checks\\\"] if c[\\\"result\\\"] == \\\"fail\\\"]\\n            print(f\\\"  {ar['agent']} ({ar['type']}): {len(fails)} failures\\\")\\n            for fc in fails:\\n                print(f\\\"    {fc['id']}: {fc['description']} — {fc.get('evidence','')[:100]}\\\")\\n\\nif critical_failures:\\n    print(f\\\"\\\\nCRITICAL FAILURES:\\\")\\n    for cf in critical_failures:\\n        print(f\\\"  - {cf}\\\")\\n\\n# Save results\\nresults = {\\n    \\\"all_results\\\": all_results,\\n    \\\"infra\\\": {\\n        \\\"bootstrap\\\": bootstrap_checks,\\n        \\\"schema\\\": schema_checks,\\n        \\\"consistency\\\": consistency_checks\\n    },\\n    \\\"stats\\\": {\\n        \\\"total_pass\\\": total_pass,\\n        \\\"total_fail\\\": total_fail,\\n        \\\"total_na\\\": total_na,\\n        \\\"total_checks\\\": total_checks,\\n        \\\"agents_passing\\\": agents_passing,\\n        \\\"agents_failing\\\": agents_failing,\\n        \