ail',\\n        'evidence': f\\\"metadata Parent='{meta_parent}', roster parent='{parent}'\\\"\\n    })\\n    \\n    # ---- V-CONTENT-05: Children metadata matches roster (for coordinators) ----\\n    if atype in ('coordinator', 'orchestrator') and children:\\n        meta_children_raw = get_metadata_field(content, 'Children')\\n        if meta_children_raw:\\n            meta_children = [c.strip() for c in meta_children_raw.split(',')]\\n            missing_from_meta = set(children) - set(meta_children)\\n            extra_in_meta = set(meta_children) - set(children)\\n            checks.append({\\n                'id': 'V-CONTENT-05', 'description': 'Children metadata matches roster',\\n                'result': 'pass' if not missing_from_meta and not extra_in_meta else 'fail',\\n                'evidence': f\\\"roster children={len(children)}, meta children={len(meta_children)}, missing={list(missing_from_meta)}, extra={list(extra_in_meta)}\\\"\\n            })\\n        else:\\n            checks.append({\\n                'id': 'V-CONTENT-05', 'description': 'Children metadata matches roster',\\n                'result': 'fail', 'evidence': f\\\"No Children metadata found, roster has {len(children)} children\\\"\\n            })\\n    else:\\n        checks.append({\\n            'id': 'V-CONTENT-05', 'description': 'Children metadata match',\\n            'result': 'not-applicable', 'evidence': f'Agent type={atype}'\\n        })\\n    \\n    # ---- V-CONTENT-06: Skills section references skill files ----\\n    skills_text = get_section_text(content, 'Skills')\\n    has_skill_refs = 'skills/' in skills_text or 'SKILL.md' in skills_text\\n    checks.append({\\n        'id': 'V-CONTENT-06', 'description': 'Skills section references skill files',\\n        'result': 'pass' if has_skill_refs else 'fail',\\n        'evidence': f\\\"Skills section references skill files: {has_skill_refs}, length: {len(skills_text)}\\\"\\n    })\\n    \\n    # ---- V-CONSIST-03: INV-0