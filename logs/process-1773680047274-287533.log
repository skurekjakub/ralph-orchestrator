d':'V-TYPE-01','description':'Specialist Process','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-TYPE-02\\n    if at in ('coordinator','orchestrator'):\\n        checks.append({'id':'V-TYPE-02','description':'Purity Rule section',\\n            'result':'pass' if has_pr else 'fail',\\n            'evidence':f\\\"PurityRule={has_pr}\\\",'expected':None,'actual':None})\\n    else:\\n        checks.append({'id':'V-TYPE-02','description':'Purity Rule','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-TYPE-03\\n    if at in ('coordinator','orchestrator'):\\n        checks.append({'id':'V-TYPE-03','description':'Routing Table section',\\n            'result':'pass' if has_section(content,'Routing Table') else 'fail',\\n            'evidence':f\\\"RT={has_section(content,'Routing Table')}\\\",'expected':None,'actual':None})\\n    else:\\n        checks.append({'id':'V-TYPE-03','description':'Routing Table','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-TYPE-04\\n    if at in ('coordinator','orchestrator'):\\n        hp = has_section(content,'Process')\\n        checks.append({'id':'V-TYPE-04','description':'Coordinator NO Process',\\n            'result':'pass' if not hp else 'fail',\\n            'evidence':f\\\"Process={hp}\\\",'expected':None,'actual':None})\\n    else:\\n        checks.append({'id':'V-TYPE-04','description':'No-Process','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-TYPE-05\\n    if at == 'orchestrator':\\n        rtt = get_sect(content,'Routing Table')\\n        phases = ['concept-coordinator','worldbuilding-coordinator','character-coordinator',\\n                  'plotting-coordinator','style-coordinator','drafting-coordinator',\\n                  'revision-coordinator','beta-reading-coordinator','polish-coordinator']\\n        cov = [p for p in phases if p in rtt]\\n        checks.append({'id':'V-TYPE-05','description':'Pipeline covers all phases',\\n            'result':'pass' if len(cov)==len(phases) else 'fail',\\n            'evidence':f\\\"{len(cov)}/{len(phases)} phases\\\",'expected':None,'actual':None})\\n    else:\\n        checks.append({'id':'V-TYPE-05','description':'Pipeline routing','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-TYPE-06\\n    if at == 'auditor':\\n        alc = num_items(get_sect(content,'Anti-Laziness Rules'))\\n        checks.append({'id':'V-TYPE-06','description':'Anti-Laziness >=4 rules',\\n            'result':'pass' if alc>=4 else 'fail',\\n            'evidence':f\\\"rules={alc}\\\",'expected':None,'actual':None})\\n    else:\\n        checks.append({'id':'V-TYPE-06','description':'Anti-Laziness','result':'not-applicable','evidence':f'type={at}','expected':None,'actual':None})\\n    # V-CONTENT-01\\n    rcs = get_sect(content,'Result Codes') + '\\\\n' + get_sect(content,'Status Contract')\\n    if rc:\\n        found = [c for c in rc if c in rcs]\\n        miss = [c for c in rc if c not in rcs]\\n        checks.append({'id':'V-CONTENT-01','description':'Result codes match roster',\\n            'result':'pass' if not miss else 'fail',\\n            'evidence':f\\\"found={found}, missing={miss}\\\",'expected':str(rc),'actual':str(found)})\\n    else:\\n        checks.append({'id':'V-CONTENT-01','description':'Result codes','result':'not-applicable','evidence':'No roster codes','expected':None,'actual':None})\\n    # V-CONTENT-02\\n    if at in ('coordinator','orchestrator') and children:\\n        rtt = get_sect(content,'Routing Table')\\n        mc_ = [ch for ch in children if ch.replace(PREFIX+'-','') not in rtt and ch not in rtt]\\n        checks.append({'id':'V-CONTENT-02','description':'Routing covers all children',\\n            'result':'pass' if not mc_ else 'fail',\\n            'evidence':f\\\"{len(children)} children, missing={mc_}\\\",'expect