tr(sorted(found_codes))\\n        })\\n    else:\\n        # Guide has no result codes\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\",\\n            \\\"description\\\": \\\"Status contract result codes match roster.json\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent '{name}' has no result codes in roster\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-CONTENT-02: Routing table covers every child's result codes (coordinators)\\n    if (is_coordinator or is_orchestrator) and children:\\n        routing_content = get_section_content(content, \\\"Routing Table\\\") or get_section_content(content, \\\"Routing\\\") or get_section_content(content, \\\"Pipeline Routing\\\") or get_section_content(content, \\\"Pipeline\\\")\\n        missing_handlers = []\\n        for child_name in children:\\n            child_entry = roster_agents.get(child_name, {})\\n            child_codes = child_entry.get(\\\"resultCodes\\\", [])\\n            for code in child_codes:\\n                # Check if routing content references both the child and the code\\n                # Be flexible about how it's referenced\\n                child_short = child_name.replace(NAMING_PREFIX + \\\"-\\\", \\\"\\\")\\n                if code in routing_content or code in content:\\n                    pass  # Found somewhere\\n                else:\\n                    missing_handlers.append(f\\\"{child_name}:{code}\\\")\\n        \\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table covers every child's result codes\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_handlers else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Missing handlers: {missing_handlers}\\\" if missing_handlers else f\\\"All child result codes handled for {len(children)} children\\\",\\n            \\