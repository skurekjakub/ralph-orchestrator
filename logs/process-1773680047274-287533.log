lse \\\"fail\\\",\\n        \\\"evidence\\\": \\\"Skills \\\" + (\\\"found\\\" if has_sk else \\\"missing\\\"),\\n        \\\"expected\\\": \\\"present\\\", \\\"actual\\\": \\\"present\\\" if has_sk else \\\"missing\\\"})\\n    \\n    # ========== TYPE-SPECIFIC CHECKS ==========\\n    \\n    # V-TYPE-01: Specialist Process\\n    if is_spec:\\n        has_proc = has_section(content, \\\"Process\\\")\\n        proc = get_section(content, \\\"Process\\\")\\n        steps = count_steps(proc)\\n        # Also count ### Step entries\\n        step_headings = len(re.findall(r'^###\\\\s+Step', proc, re.MULTILINE))\\n        total_steps = max(steps, step_headings)\\n        checks.append({\\\"id\\\": \\\"V-TYPE-01\\\", \\\"description\\\": \\\"Specialist ## Process >= 2 steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_proc and total_steps >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"Process \\\" + (\\\"found\\\" if has_proc else \\\"missing\\\") + \\\", \\\" + str(total_steps) + \\\" steps\\\",\\n            \\\"expected\\\": \\\">= 2\\\", \\\"actual\\\": str(total_steps)})\\n    else:\\n        checks.append({\\\"id\\\": \\\"V-TYPE-01\\\", \\\"description\\\": \\\"Specialist Process (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\", \\\"evidence\\\": \\\"level=\\\" + level, \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-TYPE-02: Purity Rule for routers\\n    if is_router:\\n        has_pur = has_section(content, \\\"Purity Rule\\\") or has_section(content, \\\"Purity\\\")\\n        checks.append({\\\"id\\\": \\\"V-TYPE-02\\\", \\\"description\\\": \\\"Router has Purity Rule\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pur else \\\"fail\\\",\\n            \\\"evidence\\\": \\\"Purity Rule \\\" + (\\\"found\\\" if has_pur else \\\"missing\\\"),\\n            \\\"expected\\\": \\\"present\\\", \\\"actual\\\": \\\"present\\\" if has_pur else \\\"missing\\\"})\\n    else:\\n        checks.append({\\\"id\\\": \\\