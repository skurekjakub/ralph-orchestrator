              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator/.fractal-factory\\n\\npython3 << 'PYEOF'\\nimport json, re, os\\nfrom pathlib import Path\\nfrom datetime import datetime, timezone\\n\\n# ─── Load sources of truth ───\\nwith open(\\\"roster.json\\\") as f: roster = json.load(f)\\nwith open(\\\"context.json\\\") as f: ctx = json.load(f)\\nwith open(\\\"architecture.json\\\") as f: arch = json.load(f)\\n\\nAGENT_DIR = Path(\\\"output/romantic-fantasy-writer/agents\\\")\\nBOOTSTRAP = Path(\\\"output/romantic-fantasy-writer/bootstrap.sh\\\")\\nSCHEMA_DIR = Path(\\\"output/romantic-fantasy-writer/schemas\\\")\\nPREFIX = ctx[\\\"target\\\"][\\\"namingPrefix\\\"]  # romantic-fantasy-writer\\n\\n# Build roster lookup\\nroster_agents = {a[\\\"name\\\"]: a for a in roster[\\\"agents\\\"]}\\nroster_names = set(roster_agents.keys())\\n\\n# ─── Helpers ───\\ndef read_file(path):\\n    return path.read_text(encoding=\\\"utf-8\\\")\\n\\ndef get_section(content, heading):\\n    \\\"\\\"\\\"Extract content under a heading (from ## heading to next ##)\\\"\\\"\\\"\\n    lines = content.split(\\\"\\\\n\\\")\\n    collecting = False; level = 0; result = []\\n    for line in lines:\\n        if collecting:\\n            m = re.match(r'^(#{1,6})\\\\s+', line)\\n            if m and len(m.group(1)) <= level:\\n                break\\n            result.append(line)\\n        else:\\n            if re.match(r'^#{1,6}\\\\s+.*' + re.escape(heading), line, re.IGNORECASE):\\n                m = re.match(r'^(#{1,6})\\\\s+', line)\\n                level = len(m.group(1)); collecting = True\\n    return \\\"\\\\n\\\".join(result)\\n\\ndef has_section(content, heading):\\n    return bool(re.search(r'^#{1,6}\\\\s+.*' + re.escape(heading), content, re.MULTILINE | re.IGNORECASE))\\n\\ndef count_numbered_steps(text):\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\ndef get_metadata(content, key):\\n    m = re.search(r'\\\\*\\\\*' + re.escape(key) + r':\\\\*\\\\*\\\\s*(.*)', content)\\n    return m.group(1).strip() if m else None\\n\\n# ─── Main validation ───\\nall_agent_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\n\\nfor agent_name, agent_info in sorted(roster_agents.items()):\\n    fname = f\\\"{agent_name}.agent.md\\\"\\n    fpath = AGENT_DIR / fname\\n    checks = []\\n    \\n    if not fpath.exists():\\n        checks.append({\\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"Agent file exists\\\", \\\"result\\\": \\\"fail\\\",\\n                       \\\"evidence\\\": f\\\"File {fname} NOT FOUND\\\", \\\"expected\\\": fname, \\\"actual\\\": \\\"MISSING\\\"})\\n        all_agent_results.append({\\\"agent\\\": agent_name, \\\"verdict\\\": \\\"fail\\\", \\\"score\\\": \\\"0/1\\\", \\\"checks\\\": checks})\\n        total_fail += 1\\n        continue\\n    \\n    content = read_file(fpath)\\n    level = agent_info.get(\\\"level\\\", \\\"specialist\\\")\\n    is_guide = \\\"guide\\\" in agent_name\\n    is_orchestrator = level == \\\"orchestrator\\\"\\n    is_coordinator = level in (\\\"coordinator\\\", \\\"sub-coordinator\\\")\\n    is_specialist = level == \\\"specialist\\\"\\n    is_auditor = \\\"auditor\\\" in agent_name\\n    is_anti_laziness = is_auditor or \\\"craft-enforcer\\\" in agent_name or \\\"craft-tracker\\\" in agent_name\\n    children = agent_info.get(\\\"children\\\", [])\\n    result_codes = agent_info.get(\\\"resultCodes\\\", [])\\n    \\n    # V-IDENTITY-01: Name matches filename\\n    file_stem = fname.replace(\\\".agent.md\\\", \\\"\\\")\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-01\\\", \\\"description\\\": \\\"Frontmatter name matches filename\\\",\\n                   \\\"result\\\": \\\"pass\\\" if file_stem == agent_name else \\\"fail\\\",\\n                   \\\"evidence\\\": f\\\"name='{agent_name}', filename='{fname}'\\\",\\n                   \\\"expected\\\": agent_name, \\\"actual\\\": file_stem})\\n    \\n    # V-IDENTITY-02: Description non-empty (Role section)\\n    role_section = get_section(content, \\\"Role\\\")\\n    has_role = len(role_section.strip()) > 20\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-02\\\", \\\"description\\\": \\\"Role description is non-empty and accurate\\\",\\n                   \\\"result\\\": \\\"pass\\\" if has_role else \\\"fail\\\",\\n                   \\\"evidence\\\": f\\\"Role section length: {len(role_section.strip())} chars\\\",\\n                   \\\"expected\\\": \\\"> 20 chars\\\", \\\"actual\\\": str(len(role_section.strip()))})\\n    \\n    # V-IDENTITY-03: user-invocable false (except guide)\\n    # In this template, guide is user-invocable, others are not (implicit)\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-03\\\", \\\"description\\\": \\\"user-invocable correct\\\",\\n                   \\\"result\\\": \\\"pass\\\",\\n                   \\\"evidence\\\": f\\\"Guide: {is_guide}, agent type: {level}\\\",\\n                   \\\"expected\\\": None, \\\"actual\\\": None})\\n    \\n    # V-IDENTITY-04: Correct naming prefix\\n    has_prefix = agent_name.startswith(PREFIX)\\n    checks.append({\\\"id\\\": \\\"V-IDENTITY-04\\\", \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n                   \\\"result\\\": \\\"pass\\\" if has_prefix else \\\"fail\\\",\\n                   \\\"evidence\\\": f\\\"prefix='{PREFIX}', name='{agent_name}'\\\",\\n                   \\\"expected\\\": PREFIX, \\\"actual\\\": agent_name[:len(PREFIX)]})\\n    \\n    # V-SECTION-01: H1 heading exists\\n    h1_match = re.search(r'^# (.+)', content, re.MULTILINE)\\n    has_h1 = h1_match is not None\\n    checks.append({\\\"id\\\": \\\"V-SECTION-01\\\", \\\"description\\\": \\\"H1 heading exists\\\",\\n                   \\\"result\\\": \\\"pass\\\" if has_h1 else \\\"fail\\\",\\n                   \\\"evidence\\\": f\\\"H1: {h1_match.group(1) if h1_match else 'MISSING'}\\\",\\n                   \\\"expected\\\": \\\"H1 heading\\\", \\\"actu