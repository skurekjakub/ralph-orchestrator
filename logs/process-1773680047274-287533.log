            "type": "function",
            "function": {
              "name": "bash",
              "arguments": "{\"command\": \"cat > /tmp/validate_all.py << 'PYEOF'\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nComprehensive checklist validator for romantic-fantasy-writer agent system.\\nValidates all 67 agents against the full structural and behavioral checklist.\\n\\\"\\\"\\\"\\nimport json, os, re, sys\\nfrom datetime import datetime, timezone\\n\\nBASE = \\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory\\\"\\nOUTPUT = os.path.join(BASE, \\\"output/romantic-fantasy-writer\\\")\\nAGENTS_DIR = os.path.join(OUTPUT, \\\"agents\\\")\\nSCHEMAS_DIR = os.path.join(OUTPUT, \\\"schemas\\\")\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\n\\n# Load roster\\nwith open(os.path.join(BASE, \\\"roster.json\\\")) as f:\\n    roster_data = json.load(f)\\nroster_agents = roster_data.get(\\\"agents\\\", roster_data.get(\\\"roster\\\", []))\\n\\n# Load architecture\\nwith open(os.path.join(BASE, \\\"architecture.json\\\")) as f:\\n    arch_data = json.load(f)\\n\\n# Load routing\\nwith open(os.path.join(BASE, \\\"routing.json\\\")) as f:\\n    routing_data = json.load(f)\\n\\n# Build roster lookup\\nroster_by_name = {}\\nfor a in roster_agents:\\n    roster_by_name[a[\\\"name\\\"]] = a\\n\\n# Classify agents\\ndef classify_agent(agent_info):\\n    name = agent_info[\\\"name\\\"]\\n    children = agent_info.get(\\\"children\\\", [])\\n    if name == f\\\"{NAMING_PREFIX}-guide\\\":\\n        return \\\"guide\\\"\\n    elif name == NAMING_PREFIX:\\n        return \\\"orchestrator\\\"\\n    elif len(children) > 0:\\n        return \\\"coordinator\\\"\\n    elif \\\"auditor\\\" in name:\\n        return \\\"auditor\\\"\\n    else:\\n        return \\\"specialist\\\"\\n\\n# Parse frontmatter from agent.md\\ndef parse_frontmatter(content):\\n    fm = {}\\n    if content.startswith(\\\"---\\\"):\\n        end = content.find(\\\"---\\\", 3)\\n        if end > 0:\\n            fm_text = content[3:end].strip()\\n            for line in fm_text.split(\\\"\\\\n\\\"):\\n                if \\\":\\\" in line:\\n                    key, val = line.split(\\\":\\\", 1)\\n                    fm[key.strip()] = val.strip().strip(\\\"'\\\\\\\"\\\")\\n    return fm\\n\\n# Check if section exists in markdown\\ndef has_section(content, heading):\\n    # Match ## heading or # heading\\n    pattern = r'^#{1,3}\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    return bool(re.search(pattern, content, re.MULTILINE))\\n\\ndef has_h1(content):\\n    match = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    return match.group(1).strip() if match else None\\n\\ndef count_numbered_steps(content, section_heading):\\n    \\\"\\\"\\\"Count numbered steps in a section\\\"\\\"\\\"\\n    pattern = r'^#{1,3}\\\\s+' + re.escape(section_heading)\\n    match = re.search(pattern, content, re.MULTILINE)\\n    if not match:\\n        return 0\\n    start = match.end()\\n    # Find next section\\n    next_section = re.search(r'^#{1,3}\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_section.start() if next_section else len(content)\\n    section_text = content[start:end]\\n    # Count numbered items (1. 2. 3. etc)\\n    steps = re.findall(r'^\\\\d+\\\\.', section_text, re.MULTILINE)\\n    return len(steps)\\n\\ndef count_anti_laziness_rules(content):\\n    \\\"\\\"\\\"Count anti-laziness rules in Anti-Laziness Rules section\\\"\\\"\\\"\\n    pattern = r'^#{1,3}\\\\s+Anti-Laziness Rules'\\n    match = re.search(pattern, content, re.MULTILINE)\\n    if not match:\\n        return 0\\n    start = match.end()\\n    next_section = re.search(r'^#{1,3}\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_section.start() if next_section else len(content)\\n    section_text = content[start:end]\\n    rules = re.findall(r'^\\\\d+\\\\.', section_text, re.MULTILINE)\\n    return len(rules)\\n\\ndef extract_result_codes_from_content(content):\\n    \\\"\\\"\\\"Extract result codes from Status Contract section\\\"\\\"\\\"\\n    codes = set()\\n    # Look for status contract section\\n    pattern = r'^#{1,3}\\\\s+Status Contract'\\n    match = re.search(pattern, content, re.MULTILINE)\\n    if not match:\\n        return codes\\n    start = match.end()\\n    next_section = re.search(r'^#{1,3}\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_section.start() if next_section else len(content)\\n    section_text = content[start:end]\\n    \\n    # Look for result codes in various formats:\\n    # - `code` — description\\n    # | code | description |\\n    # \\\"result\\\": \\\"code\\\"\\n    \\n    # Pattern 1: `code` in bullet points or table\\n    for m in re.finditer(r'`([a-z][a-z0-9-]*)`', section_text):\\n        code = m.group(1)\\n        if code not in ('status', 'result', 'agent', 'task_id', 'summary', 'next_hint', \\n                         'artifacts', 'iteration', 'status.json', 'completed', 'json'):\\n            codes.add(code)\\n    \\n    # Pattern 2: \\\"result\\\": \\\"code\\\" in JSON blocks\\n    for m in re.finditer(r'\\\"result\\\"\\\\s*:\\\\s*\\\"([a-z][a-z0-9-]*)\\\"', section_text):\\n        codes.add(m.group(1))\\n    \\n    return codes\\n\\ndef has_ask_questions_suppression(content):\\n    \\\"\\\"\\\"Check for ask_questions suppression\\\"\\\"\\\"\\n    patterns = [\\n        r'must\\\\s+never\\\\s+use\\\\s+`?ask_questions`?',\\n        r'never\\\\s+use\\\\s+`?ask_questions`?',\\n        r'do\\\\s+not\\\\s+use\\\\s+`?ask_questions`?',\\n        r'must\\\\s+not\\\\s+.*ask_questions',\\n        r'never\\\\s+.*request\\\\s+human\\\\s+input',\\n        r'no\\\\s+human\\\\s+input',\\n        r'ask_questions.*suppress',\\n        r'suppress.*ask_questions',\\n        r'NEVER.*ask_questions',\\n        r'without.*human.*input',\\n        r'autonomous.*no.*human',\\n    ]\\n    for p in patterns:\\n        if re.search(p, content, re.IGNORECASE):\\n            return True\\n    return False\\n\\ndef has_routing_table(content):\\n    \\\"\\\"\\\"Check for routing table - look for markdown table with result codes\\\"\\\"\\\"\\n    pattern = r'^#{1,3}\\\\s+Routing Table'\\n    if re.search(pattern, content, re.MULTILINE):\\n        return True\\n    # Also check for \\\"Dispatch\\\" or \\\"Routing\\\" sections with tables\\n    pattern2 = r'^#{1,3}\\\\s+(?:Dispatch|Routing)\\\\b'\\n    if re.search(pattern2, content, re.MULTILINE):\\n        # Check for table in the section\\n        if re.search(r'\\\\|.*\\\\|.*\\\\|', content):\\n            return True\\n    return False\\n\\ndef has_purity_rule(content):\\n    \\\"\\\"\\\"Check for purity rule section\\\"\\\"\\\"\\n    patterns = [\\n        r'^#{1,3}\\\\s+Purity Rule',\\n        r'^#{1,3}\\\\s+Coordinator Purity',\\n        r'^#{1,3}\\\\s+Pure Router',\\n        r'^#{1,3}\\\\s+Purity',\\n    ]\\n    for p in patterns:\\n        if re.search(p, content, re.MULTILINE):\\n            return True\\n    # Also check for purity statements\\n    if re.search(r'pure\\\\s+router|never\\\\s+write|never\\\\s+create|dispatch\\\\s+only|route\\\\s+only', content, re.IGNORECASE):\\n        return True\\n    return False\\n\\ndef has_pipeline_routing(content):\\n    \\\"\\\"\\\"Check orchestrator has pipeline routing section\\\"\\\"\\\"\\n    patterns = [\\n        r'^#{1,3}\\\\s+Pipeline(?:\\\\s+Routing)?',\\n        r'^#{1,3}\\\\s+Phase\\\\s+Pipeline',\\n        r'^#{1,3}\\\\s+Dispatch\\\\s+Pipeline',\\n        r'^#{1,3}\\\\s+(?:Main\\\\s+)?Pipeline',\\n        r'^#{1,3}\\\\s+Routing',\\n    ]\\n    for p in patterns:\\n        if re.search(p, content, re.MULTILINE):\\n            return True\\n    return False\\n\\n# ============ RUN ALL CHECKS ============\\nall_results = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\ntotal_checks = 0\\nagents_passing = 0\\nagents_failing = 0\\ncritical_failures = []\\n\\n# List of agent files on disk\\nagent_files = [f for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md')]\\nagent_names_on_disk = set(f.replace('.agent.md', '') for f in agent_files)\\nroster_names = set(a[\\\"name\\\"] for a in roster_agents)\\n\\n# V-CONSIST-01: Every agent in roster has a prompt file\\nconsist01_missing = roster_names - agent_names_on_disk\\n# V-CONSIST-02: No extra prompt files\\nconsist02_extra = agent_names_on_disk - roster_names\\n\\nprint(f\\\"Roster agents: {len(roster_names)}\\\")\\nprint(f\\\"Agent files on disk: {len(agent_names_on_disk)}\\\")\\nprint(f\\\"Missing files: {consist01_missing}\\\")\\nprint(f\\\"Extra files: {consist02_extra}\\\")\\n\\nfor agent_info in roster_agents:\\n    name = agent_info[\\\"name\\\"]\\n    atype = classify_agent(agent_info)\\n    result_codes = agent_info.get(\\\"resultCodes\\\", agent_info.get(\\\"result_codes\\\", []))\\n    children = agent_info.get(\\\"children\\\", [])\\n    parent = agent_info.get(\\\"parent\\\", \\\"\\\")\\n    \\n    agent_file = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    checks = []\\n    \\n    if not os.path.exists(agent_file):\\n        # All checks fail\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-01\\\",\\n            \\\"description\\\": \\\"Agent in roster has corresponding prompt file\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"File {name}.agent.md does not exist\\\",\\n            \\\"expected\\\": f\\\"{name}.agent.md\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n        all_results.append({\\\"agent\\\": name, \\\"type\\\": atype, \\\"checks\\\": checks})\\n        continue\\n    \\n    with open(agent_file) as f:\\n        content = f.read()\\n    \\n    fm = parse_frontmatter(content)\\n    h1 = has_h1(content)\\n    \\n    # ====== IDENTITY CHECKS ======\\n    \\n    # V-IDENTITY-01: Frontmatter name matches filename\\n    fm_name = fm.get(\\\"name\\\", \\\"\\\")\\n    expected_name = name\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-01\\\",\\n        \\\"description\\\": \\\"Frontmatter name matches filename\\\",\\n        \\\"result\\\": \\\"pass\\\" if fm_name == expected_name else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{fm_name}', filename='{name}.agent.md'\\\",\\n        \\\"expected\\\": expected_name,\\n        \\\"actual\\\": fm_name\\n    })\\n    \\n    # V-IDENTITY-02: Frontmatter description is non-empty\\n    fm_desc = fm.get(\\\"description\\\", \\\"\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\",\\n        \\\"description\\\": \\\"Frontmatter description is non-empty\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(fm_desc) > 5 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"description='{fm_desc[:80]}...'\\\",\\n        \\\"expected\\\": \\\"non-empty description\\\",\\n        \\\"actual\\\": fm_desc[:80] if fm_desc else \\\"(empty)\\\"\\n    })\\n    \\n    # V-IDENTITY-03: user-invocable is false (except guide)\\n    fm_invocable = fm.get(\\\"user-invocable\\\", fm.get(\\\"userInvocable\\\", \\\"\\\"))\\n    if atype == \\\"guide\\\":\\n        expected_inv = \\\"true\\\"\\n        check_result = \\\"pass\\\" if fm_invocable.lower() == \\\"true\\\" else \\\"fail\\\"\\n    else:\\n        expected_inv = \\\"false\\\"\\n        check_result = \\\"pass\\\" if fm_invocable.lower() == \\\"false\\\" else \\\"fail\\\"\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n        \\\"description\\\": f\\\"user-invocable is {'true' if atype == 'guide' else 'false'}\\\",\\n        \\\"result\\\": check_result,\\n        \\\"evidence\\\": f\\\"user-invocable='{fm_invocable}', agent_type='{atype}'\\\",\\n        \\\"expected\\\": expected_inv,\\n        \\\"actual\\\": fm_invocable\\n    })\\n    \\n    # V-IDENTITY-04: Agent name uses correct naming prefix\\n    checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\",\\n        \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if name.startswith(NAMING_PREFIX) else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{name}', prefix='{NAMING_PREFIX}'\\\",\\n        \\\"expected\\\": f\\\"starts with '{NAMING_PREFIX}'\\\",\\n        \\\"actual\\\": name\\n    })\\n    \\n    # ====== SECTION PRESENCE ======\\n    \\n    # V-SECTION-01: H1 heading exists  \\n    display_name = agent_info.get(\\\"displayName\\\", agent_info.get(\\\"display_name\\\", \\\"\\\"))\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\",\\n        \\\"description\\\": \\\"H1 heading exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1='{h1}'\\\",\\n        \\\"expected\\\": \\\"H1 heading present\\\",\\n        \\\"actual\\\": h1 or \\\"(none)\\\"\\n    })\\n    \\n    # V-SECTION-02: Role description paragraph exists\\n    # Check for substantial text after H1 and before first H2\\n    h1_match = re.search(r'^#\\\\s+.+$', content, re.MULTILINE)\\n    has_role_desc = False\\n    if h1_match:\\n        after_h1 = content[h1_match.end():]\\n        h2_match = re.search(r'^#{1,2}\\\\s+', after_h1, re.MULTILINE)\\n        role_text = after_h1[:h2_match.start()].strip() if h2_match else after_h1.strip()\\n        has_role_desc = len(role_text) > 20\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\",\\n        \\\"description\\\": \\\"Role description paragraph exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_role_desc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Role text length: {len(role_text) if h1_match else 0}\\\",\\n        \\\"expected\\\": \\\">20 chars of role description\\\",\\n        \\\"actual\\\": f\\\"{len(role_text) if h1_match else 0} chars\\\"\\n    })\\n    \\n    # V-SECTION-03: ask_questions suppression (except guide)\\n    if atype == \\\"guide\\\":\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression (guide exempt)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide agent is exempt from ask_questions suppression\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    else:\\n        has_suppress = has_ask_questions_suppression(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_suppress else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"ask_questions suppression found: {has_suppress}\\\",\\n            \\\"expected\\\": \\\"suppression present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_suppress else \\\"missing\\\"\\n        })\\n    \\n    # V-SECTION-04: Context section exists\\n    has_ctx = has_section(content, \\\"Context\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\",\\n        \\\"description\\\": \\\"Context section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_ctx else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Context found: {has_ctx}\\\",\\n        \\\"expected\\\": \\\"## Context section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_ctx else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-05: Inputs section with numbered list\\n    has_inputs = has_section(content, \\\"Inputs\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\",\\n        \\\"description\\\": \\\"Inputs section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inputs else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Inputs found: {has_inputs}\\\",\\n        \\\"expected\\\": \\\"## Inputs section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_inputs else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-06: Write Rules section exists\\n    has_wr = has_section(content, \\\"Write Rules\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-06\\\",\\n        \\\"description\\\": \\\"Write Rules section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_wr else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Write Rules found: {has_wr}\\\",\\n        \\\"expected\\\": \\\"## Write Rules section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_wr else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-07: Status Contract section exists\\n    has_sc = has_section(content, \\\"Status Contract\\\")\\n    checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\",\\n        \\\"description\\\": \\\"Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_sc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Status Contract found: {has_sc}\\\",\\n        \\\"expected\\\": \\\"## Status Contract section\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_sc else \\\"missing\\\"\\n    })\\n    \\n    # ====== TYPE-SPECIFIC CHECKS ======\\n    \\n    # V-TYPE-01: Specialists have ## Process with >= 2 numbered steps\\n    if atype in (\\\"specialist\\\", \\\"auditor\\\"):\\n        has_process = has_section(content, \\\"Process\\\")\\n        step_count = count_numbered_steps(content, \\\"Process\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has Process section with >=2 steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_process and step_count >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section: {has_process}, steps: {step_count}\\\",\\n            \\\"expected\\\": \\\"Process section with >=2 numbered steps\\\",\\n            \\\"actual\\\": f\\\"{'present' if has_process else 'missing'}, {step_count} steps\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has Process section (N/A for coordinator/orchestrator/guide)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-02: Coordinators have Purity Rule\\n    if atype == \\\"coordinator\\\":\\n        has_pr = has_purity_rule(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator has Purity Rule section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pr else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Purity rule found: {has_pr}\\\",\\n            \\\"expected\\\": \\\"Purity Rule section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_pr else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator Purity Rule (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-03: Coordinators have Routing Table\\n    if atype == \\\"coordinator\\\":\\n        has_rt = has_routing_table(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator has Routing Table section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_rt else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing table found: {has_rt}\\\",\\n            \\\"expected\\\": \\\"Routing Table section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_rt else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator Routing Table (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-04: Coordinators do NOT have Process section\\n    if atype == \\\"coordinator\\\":\\n        has_process = has_section(content, \\\"Process\\\")\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have Process section\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_process else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section found: {has_process}\\\",\\n            \\\"expected\\\": \\\"No Process section\\\",\\n            \\\"actual\\\": \\\"present (bad)\\\" if has_process else \\\"absent (good)\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator no-Process check (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-05: Orchestrator has Pipeline Routing\\n    if atype == \\\"orchestrator\\\":\\n        has_plr = has_pipeline_routing(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator has Pipeline Routing section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_plr else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Pipeline routing found: {has_plr}\\\",\\n            \\\"expected\\\": \\\"Pipeline Routing section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_plr else \\\"missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator Pipeline Routing (N/A)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-06: Anti-laziness agents have Anti-Laziness Rules with >= 4 rules\\n    if atype == \\\"auditor\\\":\\n        has_al = has_section(content, \\\"Anti-Laziness Rules\\\")\\n        al_count = count_anti_laziness_rules(content)\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\",\\n            \\\"description\\\": \\\"Auditor has Anti-Laziness Rules with >=4 rules\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_al and al_count >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Anti-Laziness section: {has_al}, rules: {al_count}\\\",\\n            \\\"expected\\\": \\\">=4 anti-laziness rules\\\",\\n            \\\"actual\\\": f\\\"{'present' if has_al else 'missing'}, {al_count} rules\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\",\\n            \\\"description\\\": \\\"Anti-laziness rules (N/A for non-auditor)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # ====== CONTENT CORRECTNESS ======\\n    \\n    # V-CONTENT-01: Status contract result codes match roster.json\\n    extracted_codes = extract_result_codes_from_content(content)\\n    roster_codes = set(result_codes)\\n    # For guide, result codes are typically empty in roster\\n    if atype == \\\"guide\\\" and len(roster_codes) == 0:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\",\\n            \\\"description\\\": \\\"Status contract result codes match roster (guide has no explicit codes)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Guide agent, no result codes in roster\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    else:\\n        codes_match = roster_codes.issubset(extracted_codes) if roster_codes else True\\n        missing_codes = roster_codes - extracted_codes\\n        extra_codes = extracted_codes - roster_codes\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-01\\\",\\n            \\\"description\\\": \\\"Status contract result codes match roster.json\\\",\\n            \\\"result\\\": \\\"pass\\\" if codes_match and len(missing_codes) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"roster={sorted(roster_codes)}, extracted={sorted(extracted_codes)}, missing={sorted(missing_codes)}\\\",\\n            \\\"expected\\\": sorted(list(roster_codes)),\\n            \\\"actual\\\": sorted(list(extracted_codes))\\n        })\\n    \\n    # V-CONTENT-02: Routing table covers every child's result codes (coordinators only)\\n    if atype in (\\\"coordinator\\\", \\\"orchestrator\\\"):\\n        # Check that routing table references all children\\n        child_names_mentioned = []\\n        for child_name in children:\\n            short = child_name.replace(f\\\"{NAMING_PREFIX}-\\\", \\\"\\\")\\n            if child_name in content or short in content:\\n                child_names_mentioned.append(child_name)\\n        missing_children = set(children) - set(child_names_mentioned)\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table/pipeline references all children\\\",\\n            \\\"result\\\": \\\"pass\\\" if len(missing_children) == 0 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Children in roster: {len(children)}, mentioned: {len(child_names_mentioned)}, missing: {sorted(missing_children)}\\\",\\n            \\\"expected\\\": f\\\"All {len(children)} children referenced\\\",\\n            \\\"actual\\\": f\\\"{len(child_names_mentioned)} referenced, {len(missing_children)} missing\\\"\\n        })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table covers children (N/A for leaf agents)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent type: {atype}, no children\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-CONTENT-03: Write Rules reference correct artifact paths\\n    # Check that Write Rules section exists and references some artifact paths\\n    if has_wr:\\n        wr_match = re.search(r'^#{1,3}\\\\s+Write Rules', content, re.MULTILINE)\\n        if wr_match:\\n            wr_start = wr_match.end()\\n            next_sect = re.search(r'^#{1,3}\\\\s+', content[wr_start:], re.MULTILINE)\\n            wr_end = wr_start + next_sect.start() if next_sect else len(content)\\n            wr_text = content[wr_start:wr_end]\\n            has_artifact_refs = bool(re.search(r'(\\\\.fantasy-writer|status\\\\.json|output\\\\.md|\\\\.json|\\\\.md)', wr_text))\\n            checks.append({\\n                \\\"id\\\": \\\"V-CONTENT-03\\\",\\n                \\\"description\\\": \\\"Write Rules reference artifact paths\\\",\\n                \\\"result\\\": \\\"pass\\\" if has_artifact_refs else \\\"fail\\\",\\n                \\\"evidence\\\": f\\\"Artifact references found in Write Rules: {has_artifact_refs}\\\",\\n                \\\"expected\\\": \\\"Artifact path references in Write Rules\\\",\\n                \\\"actual\\\": \\\"present\\\" if has_artifact_refs else \\\"missing\\\"\\n            })\\n        else:\\n            checks.append({\\n                \\\"id\\\": \\\"V-CONTENT-03\\\",\\n                \\\"description\\\": \\\"Write Rules reference artifact paths\\\",\\n                \\\"result\\\": \\\"fail\\\",\\n                \\\"evidence\\\": \\\"Write Rules section not parseable\\\",\\n                \\\"expected\\\": \\\"Artifact references\\\",\\n                \\\"actual\\\": \\\"unparseable\\\"\\n            })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Write Rules reference artifact paths\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No Write Rules section found\\\",\\n            \\\"expected\\\": \\\"Write Rules with artifact paths\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # V-CONTENT-04: Context section references correct .{domain}/ paths\\n    if has_ctx:\\n        ctx_match = re.search(r'^#{1,3}\\\\s+Context', content, re.MULTILINE)\\n        if ctx_match:\\n            ctx_start = ctx_match.end()\\n            next_sect = re.search(r'^#{1,3}\\\\s+', content[ctx_start:], re.MULTILINE)\\n            ctx_end = ctx_start + next_sect.start() if next_sect else len(content)\\n            ctx_text = content[ctx_start:ctx_end]\\n            has_domain_ref = bool(re.search(r'\\\\.fantasy-writer|romantic-fantasy-writer', ctx_text))\\n            checks.append({\\n                \\\"id\\\": \\\"V-CONTENT-04\\\",\\n                \\\"description\\\": \\\"Context section references domain paths\\\",\\n                \\\"result\\\": \\\"pass\\\" if has_domain_ref else \\\"fail\\\",\\n                \\\"evidence\\\": f\\\"Domain path references found: {has_domain_ref}\\\",\\n                \\\"expected\\\": \\\"Domain path reference in Context\\\",\\n                \\\"actual\\\": \\\"present\\\" if has_domain_ref else \\\"missing\\\"\\n            })\\n        else:\\n            checks.append({\\n                \\\"id\\\": \\\"V-CONTENT-04\\\",\\n                \\\"description\\\": \\\"Context section references domain paths\\\",\\n                \\\"result\\\": \\\"fail\\\",\\n                \\\"evidence\\\": \\\"Context section not parseable\\\",\\n                \\\"expected\\\": \\\"Domain path references\\\",\\n                \\\"actual\\\": \\\"unparseable\\\"\\n            })\\n    else:\\n        checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Context section references do