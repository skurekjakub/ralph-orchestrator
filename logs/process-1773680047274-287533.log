              "arguments": "{\"command\": \"cat > /tmp/full_validator.py << 'PYEOF'\\nimport json, os, re, sys\\n\\nBASE = \\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory\\\"\\nOUTPUT = os.path.join(BASE, \\\"output/romantic-fantasy-writer\\\")\\nAGENTS_DIR = os.path.join(OUTPUT, \\\"agents\\\")\\nPREFIX = \\\"romantic-fantasy-writer\\\"\\n\\n# Load all context files\\nwith open(os.path.join(BASE, \\\"context.json\\\")) as f:\\n    context = json.load(f)\\nwith open(os.path.join(BASE, \\\"roster.json\\\")) as f:\\n    roster = json.load(f)\\nwith open(os.path.join(BASE, \\\"architecture.json\\\")) as f:\\n    architecture = json.load(f)\\nwith open(os.path.join(BASE, \\\"routing.json\\\")) as f:\\n    routing = json.load(f)\\n\\nroster_agents = roster['agents']\\nagent_by_name = {a['name']: a for a in roster_agents}\\nroster_names = set(agent_by_name.keys())\\nproduced_files = {f.replace('.agent.md', '') for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md')}\\n\\ndef get_agent_type(agent_info):\\n    level = agent_info.get('level', '')\\n    name = agent_info.get('name', '')\\n    if level == 'guide': return 'guide'\\n    if level == 'orchestrator': return 'orchestrator'\\n    if level in ('coordinator', 'sub-coordinator'): return 'coordinator'\\n    if 'auditor' in name: return 'auditor'\\n    return 'specialist'\\n\\ndef has_section(content, heading):\\n    return bool(re.search(r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$', content, re.MULTILINE))\\n\\ndef has_section_fuzzy(content, heading):\\n    return bool(re.search(r'^##\\\\s+.*' + re.escape(heading), content, re.MULTILINE | re.IGNORECASE))\\n\\ndef get_h1(content):\\n    m = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    return m.group(1).strip() if m else None\\n\\ndef get_metadata_field(content, field):\\n    m = re.search(r'\\\\*\\\\*' + re.escape(field) + r':\\\\*\\\\*\\\\s*(.+)', content)\\n    return m.group(1).strip() if m else None\\n\\ndef get_section_text(content, heading):\\n    pattern = r'^##\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    m = re.search(pattern, content, re.MULTILINE)\\n    if not m: return ''\\n    start = m.end()\\n    next_h2 = re.search(r'^##\\\\s+', content[start:], re.MULTILINE)\\n    end = start + next_h2.start() if next_h2 else len(content)\\n    return content[start:end].strip()\\n\\ndef count_step_subsections(content, heading):\\n    section = get_section_text(content, heading)\\n    return len(re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', section, re.MULTILINE))\\n\\ndef count_numbered_items(text):\\n    return len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n\\n# ============================================================\\n# BUILD VALIDATION MATRIX\\n# ============================================================\\nall_agent_results = []\\n\\nfor agent_info in roster_agents:\\n    name = agent_info['name']\\n    atype = get_agent_type(agent_info)\\n    level = agent_info.get('level', '')\\n    children = agent_info.get('children', [])\\n    result_codes = agent_info.get('resultCodes', [])\\n    parent = agent_info.get('parent', '')\\n    \\n    filepath = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    checks = []\\n    \\n    if not os.path.exists(filepath):\\n        checks.append({'id': 'V-CONSIST-01', 'description': 'Agent file exists',\\n            'result': 'fail', 'evidence': f'File {name}.agent.md not found'})\\n        all_agent_results.append({'agent': name, 'checks': checks})\\n        continue\\n    \\n    with open(filepath) as f:\\n        content = f.read()\\n    \\n    # ---- V-IDENTITY-01: Name identification ----\\n    # In this template: check metadata Level line and H1 title exist\\n    h1 = get_h1(content)\\n    meta_level = get_metadata_field(content, 'Level')\\n    meta_agent_id = get_metadata_field(content, 'Agent ID')\\n    checks.append({\\n        'id': 'V-IDENTITY-01', 'description': 'Agent has identity metadata (H1 + Agent ID + Level)',\\n        'result': 'pass' if (h1 and meta_agent_id and meta_level) else 'fail',\\n        'evidence': f\\\"H1='{h1}', AgentID='{meta_agent_id}', Level='{meta_level}'\\\"\\n    })\\n    \\n    # ---- V-IDENTITY-02: Description non-empty (Role section) ----\\n    role_text = get_section_text(content, 'Role')\\n    checks.append({\\n        'id': 'V-IDENTITY-02', 'description': 'Role section non-empty and descriptive',\\n        'result': 'pass' if len(role_text) > 30 else 'fail',\\n        'evidence': f\\\"Role text length: {len(role_text)} chars, first 80: '{role_text[:80]}...'\\\"\\n    })\\n    \\n    # ---- V-IDENTITY-03: Level matches roster ----\\n    checks.append({\\n        'id': 'V-IDENTITY-03', 'description': 'Level metadata matches roster',\\n        'result': 'pass' if meta_level == level else 'fail',\\n        'evidence': f\\\"metadata Level='{meta_level}', roster level='{level}'\\\"\\n    })\\n    \\n    # ---- V-IDENTITY-04: Naming prefix ----\\n    checks.append({\\n        'id': 'V-IDENTITY-04', 'description': 'Agent name uses correct prefix',\\n        'result': 'pass' if name.startswith(PREFIX) else 'fail',\\n        'evidence': f\\\"name='{name}', expected prefix='{PREFIX}'\\\"\\n    })\\n    \\n    # ---- V-SECTION-01: H1 heading exists ----\\n    checks.append({\\n        'id': 'V-SECTION-01', 'description': 'H1 heading exists',\\n        'result': 'pass' if h1 else 'fail',\\n        'evidence': f\\\"H1='{h1}'\\\" if h1 else \\\"No H1 heading found\\\"\\n    })\\n    \\n    # ---- V-SECTION-02: Role description paragraph ----\\n    checks.append({\\n        'id': 'V-SECTION-02', 'description': 'Role description paragraph exists (## Role)',\\n        'result': 'pass' if has_section(content, 'Role') and len(role_text) > 20 else 'fail',\\n        'evidence': f\\\"## Role found: {has_section(content, 'Role')}, length: {len(role_text)}\\\"\\n    })\\n    \\n    # ---- V-SECTION-03: ask_questions suppression ----\\n    if atype == 'guide':\\n        # Guide: check if it has the suppression too (it does per inspection)\\n        has_suppress = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n        checks.append({\\n            'id': 'V-SECTION-03', 'description': 'ask_questions suppression (guide)',\\n            'result': 'pass' if has_suppress else 'not-applicable',\\n            'evidence': f\\\"Guide agent — suppression found: {has_suppress}\\\"\\n        })\\n    else:\\n        has_suppress = bool(re.search(r'ask.?question', content, re.IGNORECASE))\\n        checks.append({\\n            'id': 'V-SECTION-03', 'description': 'ask_questions suppression present',\\n            'result': 'pass' if has_suppress else 'fail',\\n            'evidence': f\\\"ask_questions reference found: {has_suppress}\\\"\\n        })\\n    \\n    # ---- V-SECTION-04: Context information (metadata header) ----\\n    has_context_info = bool(meta_agent_id and meta_level and get_metadata_field(content, 'Parent'))\\n    checks.append({\\n        'id': 'V-SECTION-04', 'description': 'Context metadata present (Agent ID, Level, Parent)',\\n        'result': 'pass' if has_context_info else 'fail',\\n        'evidence': f\\\"AgentID={meta_agent_id}, Level={meta_level}, Parent={get_metadata_field(content, 'Parent')}\\\"\\n    })\\n    \\n    # ---- V-SECTION-05: Artifact Assignments / Inputs ----\\n    has_artifacts = has_section(content, 'Artifact Assignments')\\n    artifact_text = get_section_text(content, 'Artifact Assignments')\\n    has_reads = '**Reads:**' in artifact_text or '**Reads:**' in content\\n    checks.append({\\n        'id': 'V-SECTION-05', 'description': 'Artifact Assignments section with Reads',\\n        'result': 'pass' if has_artifacts else 'fail',\\n        'evidence': f\\\"## Artifact Assignments found: {has_artifacts}, has Reads: {has_reads}\\\"\\n    })\\n    \\n    # ---- V-SECTION-06: Status Contract (write rules) ----\\n    has_sc = has_section(content, 'Status Contract')\\n    checks.append({\\n        'id': '