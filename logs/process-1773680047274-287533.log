itten\\\": [\\n                \\\"characters/leads/protagonist.json (rewritten on retry)\\\",\\n                \\\"characters/leads/love-interest.json (rewritten on retry)\\\",\\n                \\\"characters/romance-arc.json (rewritten on retry)\\\",\\n                \\\"characters/ensemble/*.json (rewritten on retry)\\\",\\n                \\\"characters/voice-parameters.json (rewritten on retry)\\\",\\n                \\\"audit-reports/character/gate.json (two entries: failed then passed)\\\"\\n            ],\\n            \\\"agentsExercised\\\": [\\n                \\\"romantic-fantasy-writer-character-coordinator\\\",\\n                \\\"romantic-fantasy-writer-core-characters-coordinator\\\",\\n                \\\"romantic-fantasy-writer-ensemble-coordinator\\\",\\n                \\\"romantic-fantasy-writer-character-auditor\\\",\\n                \\\"romantic-fantasy-writer-protagonist-profiler\\\",\\n                \\\"romantic-fantasy-writer-romance-arc-designer\\\",\\n                \\\"romantic-fantasy-writer-supporting-cast-developer\\\",\\n                \\\"romantic-fantasy-writer-character-voice-designer\\\"\\n            ]\\n        },\\n        \\\"verificationCriteria\\\": [\\n            \\\"Character-coordinator status.json result == 'complete'\\\",\\n            \\\"Character-coordinator iteration count == 2 (initial + 1 retry)\\\",\\n            \\\"audit-reports/character/gate.json contains both failed and passed entries\\\",\\n            \\\"All 7 resetOnRetry statuses were deleted before re-dispatch\\\",\\n            \\\"Feedback artifact path was passed to re-dispatched core-characters-coordinator\\\",\\n            \\\"Voice parameters in retry output show measurably distinct values per character\\\",\\n            \\\"Romance arc in retry has identifiable emotional spine stages matching INV-021\\\",\\n            \\\"No stale status.json files from first attempt remain\\\"\\n        ],\\n        \\\"relatedInvariants\\\": [\\