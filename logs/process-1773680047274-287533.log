dirty\\\" if any(c.get('status') == 'dirty' for c in infra.get('categories', [])) else \\\"clean\\\",\\n            \\\"categories\\\": [7, 8, 9],\\n            \\\"gapsFound\\\": sum(c.get('gapsFound', 0) for c in infra.get('categories', []))\\n        }\\n    ],\\n    \\\"categories\\\": all_categories\\n}\\n\\nwith open('gap-report.json', 'w') as f:\\n    json.dump(gap_report, f, indent=2)\\n\\nprint(\\\"\\\\nWrote gap-report.json successfully\\\")\\n\\n# Print per-category summary\\nfor c in all_categories:\\n    print(f\\\"  Cat {c['id']}: {c['name']} — {c['status']} ({c.get('gapsFound',0)} gaps)\\\")\\n\\nPYEOF\", \"description\": \"Aggregate specialist outputs into gap-report.json\", \"shellId\": \"coord-aggregate\", \"initial_wait\": 30}"
