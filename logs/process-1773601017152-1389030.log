      'gen_ai.tool.call.result': '1. # context.json Schema\n' +
        '2. \n' +
        '3. User-provided configuration that parameterizes the fractal factory run. Filled in by the guide agent after user interview, or manually by the user before invoking the orchestrator.\n' +
        '4. \n' +
        '5. ## Schema\n' +
        '6. \n' +
        '7. ```json\n' +
        '8. {\n' +
        '9.   "version": 1,\n' +
        '10. \n' +
        '11.   "domain": {\n' +
        `12.     "name": "<string, short identifier, e.g. 'security-audit', 'api-migration'>",\n` +
        '13.     "description": "<string, 1-3 sentence description of what the produced agent system should do>"\n' +
        '14.   },\n' +
        '15. \n' +
        '16.   "target": {\n' +
        '17.     "outputDirectory": "<string, absolute or relative path where the produced agent family is written>",\n' +
        `18.     "namingPrefix": "<string, prefix for all produced agent names, e.g. 'security-audit' → 'security-audit-domain-scanner'>"\n` +
        '19.   },\n' +
        '20. \n' +
        '21.   "inputs": {\n' +
        '22.     "domainBrief": "<string, path to domain-brief.md — narrative description of the domain>",\n' +
        '23.     "domainDocs": "<string | null, path to directory of supporting documents>",\n' +
        '24.     "exemplars": "<string | null, path to directory of exemplar agent families to learn from>",\n' +
        '25.     "invariants": "<string | null, path to invariants.md — behavioral rules that must be preserved>",\n' +
        '26.     "constraints": "<string | null, path to constraints.json — bounds and hard requirements>"\n' +
        '27.   },\n' +
        '28. \n' +
        '29.   "options": {\n' +
        '30.     "maxDepth": "<2 | 3, default 3 — maximum hierarchy depth for the produced system>",\n' +
        '31.     "maxAgents": "<number, default 50 — upper bound on total agents in produced system>",\n' +
        '32.     "maxGapCycles": "<number, default 3 — how many gap-hunting re-entry cycles before forced delivery>",\n' +
        '33.     "maxWriterReviewerRetries": "<number, default 3 — prompt-writer → prompt-reviewer loop retry limit>",\n' +
        '34.     "pipelinePasses": "<string[], which passes the produced system should have — subset of the universal 7>"\n' +
        '35.   }\n' +
        '36. }\n' +
        '37. ```\n' +
        '38. \n' +
        '39. ## Field Details\n' +
        '40. \n' +
        '41. ### domain.name\n' +
        '42. Used as the artifact directory prefix (`.{name}/`) and in generated agent descriptions. Should be a short, lowercase, hyphenated identifier.\n' +
        '43. \n' +
        '44. ### target.outputDirectory\n' +
        '45. Where all produced files go:\n' +
        '46. ```\n' +
        '47. {outputDirectory}/\n' +
        '48. ├── agents/           — .agent.md files for every produced agent\n' +
        '49. ├── schemas/          — Artifact JSON schemas for the produced system\n' +
        '50. ├── skills/           — Domain-specific skills for the produced agents'
    },
