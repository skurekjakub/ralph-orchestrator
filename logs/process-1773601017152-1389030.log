        '  --arg cwd "$CWD" \\\n' +
        "  '{event: $event, timestamp: ($ts | tonumber), session: $session, reason: $reason, cwd: $cwd}' \\\n" +
        '  >> "$LOG_DIR/audit.jsonl"\n' +
        '\n' +
        '\n' +
