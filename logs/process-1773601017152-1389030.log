es\\": 10,\\n23.     \\"pipelinePasses\\": [\\"discovery\\", \\"analysis\\", \\"planning\\", \\"execution\\", \\"verification\\", \\"gapHunting\\", \\"delivery\\"]\\n24.   }\\n25. }\\n26. "}]},{"role":"tool","parts":[{"type":"tool_call_response","id":"toolu_012QLJ8p3eVqFDixBRY9KvtY","response":"1. {\\n2.   \\"version\\": 1,\\n3.   \\"lastUpdated\\": \\"2026-03-15T19:00:19Z\\",\\n4.   \\"subdomains\\": [\\n5.     {\\n6.       \\"id\\": \\"SD-001\\",\\n7.       \\"name\\": \\"user-interaction\\",\\n8.       \\"description\\": \\"Guide agent as sole user-facing entry point: gathers story idea, optional style samples, mood/tone, character sketches, world fragments, and constraints. Validates inputs, fills defaults, writes story-config.json, confirms with user, launches the autonomous pipeline, and reports results.\\",\\n9.       \\"sourceFiles\\": [\\".fractal-factory/domain-brief.md\\"],\\n10.       \\"complexity\\": \\"low\\",\\n11.       \\"estimatedAgentCount\\": 1,\\n12.       \\"crossCuttingConcerns\\": [\\"artifact-management\\"],\\n13.       \\"discoveredBy\\": \\"fractal-factory-domain-scanner\\"\\n14.     },\\n15.     {\\n16.       \\"id\\": \\"SD-002\\",\\n17.       \\"name\\": \\"concept-development\\",\\n18.       \\"description\\": \\"Phase 1 of the creative pipeline: distills raw inputs into a crystallized story concept. Includes idea distillation (thematic core), theme extraction (2-3 thematic pillars), premise refinement (one-liner + paragraph hook), comparable title identification, and initial craft toolbox selection producing a Story Craft Profile.\\",\\n19.       \\"sourceFiles\\": [\\".fractal-factory/domain-brief.md\\", \\".fractal-factory/invariants.md\\"],\\n20.       \\"complexity\\": \\"medium\\",\\n21.       \\"estimatedAgentCount\\": 2,\\n22.       \\"crossCuttingConcerns\\": [\\"genre-compliance\\", \\"craft-toolbox-framework\\", \\"adversarial-quality-gates\\"],\\n23.       \\"discoveredBy\\": \\"fractal-factory-domain-scanner\\"\\n24.     },\\n25.     {\\n26.       \\"id\\": \\"SD-003\\",\\n27.       \\"name\\": \\"world-building\\",\\n28.       \\"description\\": \\"Phase 2: constructs the complete fictional world in subcategorized artifacts. Covers geography/setting (maps, regions, climates, travel distances), magic system design (rules, costs, limitations per Sanderson's Laws), political/social structures (kingdoms, factions, class, religion), history/lore (key events, creation myths, legends), culture/daily life (customs, food, clothing, languages, festivals, taboos), and flora/fauna. Produces a consistency bible decomposed into typed subdirectories.\\",\\n29.       \\"sourceFiles\\": [\\".fractal-factory/domain-brief.md\\"],\\n30.       \\"complexity\\": \\"high\\",\\n31.       \\"estimatedAgentCount\\": 4,\\n32.       \\"crossCuttingConcerns\\": [\\"continuity-tracking\\", \\"series-knowledge-management\\", \\"adversarial-quality-gates\\", \\"artifact-management\\"],\\n33.       \\"discoveredBy\\": \\"fractal-factory-domain-scanner\\"\\n34.     },\\n35.     {\\n36.       \\"id\\": \\"SD-004\\",\\n37.       \\"name\\": \\"character-design\\",\\n38.       \\"description\\": \\"Phase 3: creates full character profiles for romantic leads (backstory, psychological wounds, desires, flaws, strengths, voice patterns), designs the romance arc dynamic (attraction/obstacles/vulnerability/climax), builds supporting cast with mini-arcs, designs antagonist with comprehensible motivation, writes per-character voice guides with distinct speech patterns, and maps the full relationship web between all named characters.\\",\\n39.       \\"sourceFiles\\": [\\".fractal-factory/domain-brief.md\\", \\".fractal-factory/invariants.md\\"],\\n40.       \\"complexity\\": \\"high\\",\\n41.       \\"estimatedAgentCount\\": 3,\\n42.       \\"crossCuttingConcerns\\": [\\"genre-compliance\\", \\"continuity-tracking\\", \\"adversarial-quality-gates\\", \\"series-knowledge-management\\"],\\n43.       \\"discoveredBy\\": \\"fract