description\\": \\"Create full character profiles for leads, supporting cast, antagonists with psychological depth\\" },\\n        { \\"phase\\": 4, \\"name\\": \\"plot-architecture\\", \\"type\\": \\"sequential\\", \\"writerReviewerLoop\\": true, \\"description\\": \\"Select story structure framework, produce chapter-level outlines, tension map, subplot tracker\\" },\\n        { \\"phase\\": 5, \\"name\\": \\"prose-style-development\\", \\"type\\": \\"sequential\\", \\"writerReviewerLoop\\": true, \\"description\\": \\"Analyze reference fiction (if provided), produce style guide, tone palette, voice calibration\\" },\\n        { \\"phase\\": 6, \\"name\\": \\"chapter-drafting\\", \\"type\\": \\"sequential-per-chapter\\", \\"writerReviewerLoop\\": true, \\"description\\": \\"Write each chapter in sequence following outline, maintaining continuity tracking\\" },\\n        { \\"phase\\": 7, \\"name\\": \\"revision-editing\\", \\"type\\": \\"multi-pass-sequential\\", \\"writerReviewerLoop\\": false, \\"description\\": \\"Developmental edit → line edit → copy edit, each as separate specialist pass\\" },\\n        { \\"phase\\": 8, \\"name\\": \\"beta-reading-simulation\\", \\"type\\": \\"parallel-lenses\\", \\"writerReviewerLoop\\": false, \\"description\\": \\"5 independent reader lenses (romance, fantasy, craft, sensitivity, originality) producing findings\\" },\\n        { \\"phase\\": 9, \\"name\\": \\"polish-delivery\\", \\"type\\": \\"sequential\\", \\"writerReviewerLoop\\": false, \\"description\\": \\"Final proofread, chapter summaries, series knowledge base update, delivery packaging\\" }\\n      ],\\n      \\"crossCuttingSystems\\": [\\n        { \\"name\\": \\"adversarial-quality-gates\\", \\"scope\\": \\"phases 1-6\\", \\"description\\": \\"Adversarial auditors gate every creative phase with writer-reviewer loops (max retries from config)\\" },\\n        { \\"name\\": \\"continuity-tracking\\", \\"scope\\": \\"phases 6-9\\", \\"description\\": \\"Track character positions, timeline, knowledge matrix, Chekhov's guns across chapters\\" },\\n        { \\"name\\": \\"series-knowledge-management\\", \\"scope\\": \\"all phases + post-completion\\", \\"description\\": \\"Series knowledge base lifecycle: load for sequels, cross-reference during production, merge on completion\\" },\\n        { \\"name\\": \\"artifact-management\\", \\"scope\\": \\"all phases\\", \\"description\\": \\"Enforce subcategory decomposition, per-book directory structure, cross-reference integrity\\" },\\n        { \\"name\\": \\"genre-compliance\\", \\"scope\\": \\"phases 1-9\\", \\"description\\": \\"Enforce romantic fantasy genre conventions: dual-arc, HFN/HEA resolution, fantasy-first plot\\" },\\n        { \\"name\\": \\"craft-toolbox-framework\\", \\"scope\\": \\"phases 1-9\\", \\"description\\": \\"Two-tier quality: non-negotiable invariants always apply + selected craft tools from profile\\" },\\n        { \\"name\\": \\"originality-assurance\\", \\"scope\\": \\"phases 5-9\\", \\"description\\": \\"Zero-tolerance plagiarism enforcement, transformative influence only\\" }\\n      ],\\n      \\"keyPatterns\\": {\\n        \\"writerReviewerLoops\\": \\"Phases 1-6 use writer → adversarial-auditor loops with maxRetries from story config. Critical findings block phase completion (INV-052).\\",\\n        \\"sequentialChapterProduction\\": \\"Chapter N+1 cannot start until Chapter N is complete with continuity tracker updated (INV-012). This is the main throughput bottleneck.\\",\\n        \\"parallelBetaReading\\": \\"5 beta reader lenses are independent and CAN run in parallel (INV-053). Each produces a structured findings document. Synthesis agent aggregates.\\",\\n        \\"multiPassRevision\\": \\"3 separate revision passes (developmental, line, copy) run sequentially. Each produces per-chapter findings. Revision agent applies fixes with traceability (INV-014).\\",\\n        \\"seriesLifecycle\\": \\"Even standalone books create series knowledge