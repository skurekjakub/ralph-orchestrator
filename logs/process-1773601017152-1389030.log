well\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BC-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-craft-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/sensitivity-lens.json\\\",\\n            \\\"phase\\\": \\\"phase8-beta-reading\\\",\\n            \\\"purpose\\\": \\\"Sensitivity reader perspective: cultural representation, harmful tropes, power dynamics, consent, potentially problematic content (INV-053 lens 4 of 5).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"sensitivity\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, representationQuality, consentHandling, powerDynamics }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: BS-NNN, chapter, severity, category, description, evidence, suggestion, trope }\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Positive representation elements\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BS-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-sensitivity-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/originality-lens.json\\\",\\n            \\\"phase\\\": \\\"phase8-beta-reading\\\",\\n            \\\"purpose\\\": \\\"Originality checker perspective: plagiarism detection, derivative passages, over-reliance on reference material, cliche plot structures (INV-023, INV-024, INV-025, INV-053 lens 5 of 5).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"originality\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, originalityScore, derivativeRisk, transformativeSuccess }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: BO-NNN, chapter, severity, category, description, evidence, suggestion, similarTo }\\\"},\\n                    {\\\"name\\\": \\\"plagiarismFlags\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Zero-tolerance items - any non-empty list is critical (INV-023)\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Original and creative elements\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BO-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-originality-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/synthesis.json\\\",\\n            \\\"phase\\\": \\\"phase8-beta-reading\\\",\\n            \\\"purpose\\\": \\\"Aggregated beta reading findings across all 5 lenses: prioritized action items, cross-lens conflict resolution, go/no-go decision for polish vs. re-entry to revision (INV-054).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lensesCompleted\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Which lenses have reported\\\"},\\n                    {\\\"name\\\": \\\"aggregatedFindings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: BETA-NNN, originLens, originFindingId, chapter, severity, category, description, priority }\\\"},\\n                    {\\\"name\\\": \\\"crossLensConflicts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { conflict, lens1, lens2, resolution, rationale }\\\"},\\n                    {\\\"name\\\": \\\"actionItems\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ critical: array, major: array, minor: array } - prioritized\\\"},\\n                    {\\\"name\\\": \\\"verdict\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"proceed-to-polish | re-enter-revision\\\"},\\n                    {\\\"name\\\": \\\"reEntryScope\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"If re-entering revision: { affectedChapters, revisionType, specificFindings }\\\"},\\n                    {\\\"name\\\": \\\"overallScores\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Aggregated scores from all lenses\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BETA-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-reading-coordinator\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None,\\n            \\\"notes\\\": \\\"Critical decision point: if verdict is re-enter-revision, the beta-reading coordinator signals the orchestrator to re-dispatch revision (bounded by maxCycles). INV-054 requires all critical/major findings addressed.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"delivery/chapter-summaries.json\\\",\\n            \\\"phase\\\": \\\"phase9-polish\\\",\\n            \\\"purpose\\\": \\\"One-paragraph summary per chapter for series knowledge base, reader reference, and sequel continuity.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { chapterId: CH-NNN, title, summary, keyEvents, romanceProgress, plotProgress }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"Indexed by CH-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"delivery/book-metadata.json\\\",\\n            \\\"phase\\\": \\\"phase9-polish\\\",\\n            \\\"purpose\\\": \\\"Final book metadata: title, blurb, word count, chapter count, completion metrics, quality scores from beta reading, craft profile used.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"bookId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique book identifier\\\"},\\n                    {\\\"name\\\": \\\"title\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Final title\\\"},\\n                    {\\\"name\\\": \\\"blurb\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Back-cover blurb\\\"},\\n                    {\\\"name\\\": \\\"wordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total word count\\\"},\\n                    {\\\"name\\\": \\\"chapterCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total chapters\\\"},\\n                    {\\\"name\\\": \\\"qualityScores\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Aggregated from beta-reading synthesis\\\"},\\n                    {\\\"name\\\": \\\"craftProfileUsed\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Which craft tools were selected for this book\\\"},\\n                    {\\\"name\\\": \\\"invariantCoverage\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Summary of invariant enforcement across all phases\\\"},\\n                    {\\\"name\\\": \\\"seriesPosition\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ seriesName, bookNumber, unresolvedThreadsForSequel }\\\"},\\n                    {\\\"name\\\": \\\"productionMetrics\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalRevisionPasses, betaRevisionCycles, writerReviewerIterations }\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        }\\n    ],\\n\\n    \\\"dataFlow\\\": [\\n        {\\\"from\\\": \\\"phase1-concept\\\", \\\"artifact\\\": \\\"story-concept.json\\\", \\\"to\\\": \\\"phase2-world-building\\\", \\\"purpose\\\": \\\"Concept worldSeed, genre promise, and scope parameters guide world construction\\\"},\\n        {\\\"from\\\": \\\"phase1-concept\\\", \\\"artifact\\\": \\\"story-craft-profile.json\\\", \\\"to\\\": \\\"phase2-world-building\\\", \\\"purpose\\\": \\\"Selected craft tools inform world-building depth (e.g., T10 Sanderson Law -> magic system hardness)\\\"},\\n        {\\\"from\\\": \\\"phase2-world-building\\\", \\\"artifact\\\": \\\"world-bible/*.json\\\", \\\"to\\\": \\\"phase3-character-design\\\", \\\"purpose\\\": \\\"Characters grounded in the world: culture informs customs, politics informs allegiances, magic informs abilities\\\"},\\n        {\\\"from\\\": \\\"phase2-world-building\\\", \\\"artifact\\\": \\\"world-bible/*.json\\\", \\\"to\\\": \\\"phase4-plot-architecture\\\", \\\"purpose\\\": \\\"Plot leverages world conflicts, political tensions, magical constraints\\\"},\\n        {\\\"from\\\": \\\"phase3-character-design\\\", \\\"artifact\\\": \\\"characters/*.json\\\", \\\"to\\\": \\\"phase4-plot-architecture\\\", \\\"purpose\\\": \\\"Plot driven by character psychology, motivations, romantic resistance (INV-008 agency)\\\"},\\n        {\\\"from\\\": \\\"phase1-concept\\\", \\\"artifact\\\": \\\"story-craft-profile.json\\\", \\\"to\\\": \\\"phase4-plot-architecture\\\", \\\"purpose\\\": \\\"Craft tools T1 scene-sequel, T3 five commandments, T4 try-fail, T7 black moment, T12 dual-arc interleave shape plot\\\"},\\n        {\\\"from\\\": \\\"phase4-plot-architecture\\\", \\\"artifact\\\": \\\"plot/chapter-outlines.json\\\", \\\"to\\\": \\\"phase5-prose-style\\\", \\\"purpose\\\": \\\"Outline pacing and emotional trajectory inform style guide pacing rules and tonal variation\\\"},\\n        {\\\"from\\\": \\\"phase4-plot-architecture\\\", \\\"artifact\\\": \\\"plot/tension-map.json\\\", \\\"to\\\": \\\"phase5-prose-style\\\", \\\"purpose\\\": \\\"Tension map informs style guide action vs. emotional scene pacing rules\\\"},\\n        {\\\"from\\\": \\\"phase1-concept\\\", \\\"artifact\\\": \\\"story-concept.json\\\", \\\"to\\\": \\\"phase6-chapter-drafting\\\", \\\"purpose\\\": \\\"Concept genre promise and tone palette guide prose production\\\"},\\n        {\\\"from\\\": \\\"phase2-world-building\\\", \\\"artifact\\\": \\\"world-bible/*.json\\\", \\\"to\\\": \\\"phase6-chapter-drafting\\\", \\\"purpose\\\": \\\"Chapter drafter references world details for accurate setting, magic use, cultural details\\\"},\\n        {\\\"from\\\": \\\"phase3-character-design\\\", \\\"artifact\\\": \\\"characters/*.json\\\", \\\"to\\\": \\\"phase6-chapter-drafting\\\", \\\"purpose\\\": \\\"Chapter drafter uses character voice guides, psychology, knowledge boundaries for POV accuracy\\\"},\\n        {\\\"from\\\": \\\"phase4-plot-architecture\\\", \\\"artifact\\\": \\\"plot/chapter-outlines.json\\\", \\\"to\\\": \\\"phase6-chapter-drafting\\\", \\\"purpose\\\": \\\"Each chapter drafted following its outline (INV-010). Outline is the chapter specification.\\\"},\\n        {\\\"from\\\": \\\"phase5-prose-style\\\", \\\"artifact\\\": \\\"style-guide.json\\\", \\\"to\\\": \\\"phase6-chapter-drafting\\\", \\\"purpose\\\": \\\"Style guide constrains prose: vocabulary, sentence rhythm, tone, POV voice variations\\\"},\\n        {\\\"from\\\": \\\"phase6-chapter-drafting\\\", \\\"artifact\\\": \\\"chapters/chapter-*.md\\\", \\\"to\\\": \\\"phase7-revision\\\", \\\"purpose\\\": \\\"Draft chapters are input to multi-pass revision\\\"},\\n        {\\\"from\\\": \\\"phase6-chapter-drafting\\\", \\\"artifact\\\": \\\"continuity-tracker.json\\\", \\\"to\\\": \\\"phase7-revision\\\", \\\"purpose\\\": \\\"Revision agents cross-reference continuity tracker for factual consistency\\\"},\\n        {\\\"from\\\": \\\"phase7-revision\\\", \\\"artifact\\\": \\\"chapters/chapter-*.md (revised)\\\", \\\"to\\\": \\\"phase8-beta-reading\\\", \\\"purpose\\\": \\\"Revised chapters read by 5 independent beta reader lenses\\\"},\\n        {\\\"from\\\": \\\"phase7-revision\\\", \\\"artifact\\\": \\\"revision/*.json\\\", \\\"to\\\": \\\"phase8-beta-reading\\\", \\\"purpose\\\": \\\"Beta readers can reference what was already found and fixed in revision\\\"},\\n        {\\\"from\\\": \\\"phase8-beta-reading\\\", \\\"artifact\\\": \\\"beta-reading/synthesis.json\\\", \\\"to\\\": \\\"phase7-revision (re-entry)\\\", \\\"purpose\\\": \\\"If synthesis verdict is re-enter-revision, critical/major findings trigger additional revision pass (INV-054). Bounded by maxCycles.\\\"},\\n        {\\\"from\\\": \\\"phase8-beta-reading\\\", \\\"artifact\\\": \\\"beta-reading/synthesis.json\\\", \\\"to\\\": \\\"phase9-polish\\\", \\\"purpose\\\": \\\"Remaining minor findings and quality assessment inform final polish priorities\\\"},\\n        {\\\"from\\\": \\\"phase8-beta-reading\\\", \\\"artifact\\\": \\\"chapters/chapter-*.md (final revised)\\\", \\\"to\\\": \\\"phase9-polish\\\", \\\"purpose\\\": \\\"Final revised chapters receive last proofread and formatting pass\\\"},\\n        {\\\"from\\\": \\\"phase9-polish\\\", \\\"artifact\\\": \\\"delivery/chapter-summaries.json\\\", \\\"to\\\": \\\"series-knowledge-base.json\\\", \\\"purpose\\\": \\\"Chapter summaries, resolved/unresolved threads, character arcs merged into series KB for sequel use\\\"},\\n        {\\\"from\\\": \\\"phase9-polish\\\", \\\"artifact\\\": \\\"delivery/book-metadata.json\\\", \\\"to\\\": \\\"series-knowledge-base.json\\\", \\\"purpose\\\": \\\"Book metadata added to series KB book list\\\"},\\n        {\\\"from\\\": \\\"series-knowledge-base.json\\\", \\\"artifact\\\": \\\"series-knowledge-base.json\\\", \\\"to\\\": \\\"phase1-concept (sequel)\\\", \\\"purpose\\\": \\\"For sequels: series KB loaded before concept phase. Provides canon, unresolved threads, character histories, naming registry (INV-049, INV-051, INV-059)\\\"}\\n    ],\\n\\n    \\\"multiWriterContracts\\\": [\\n        {\\n            \\\"artifact\\\": \\\"continuity-tracker.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"protocol\\\": \\\"Single-writer accumulator. Only the continuity-tracker agent writes this artifact. It reads the latest chapter, cross-references world-bible and characters, and appends/updates entries. Updated after every chapter draft (INV-011).\\\",\\n            \\\"mergeRules\\\": \\\"Append-only for timeline, characterKnowledge, establishedFacts. Update-in-place for characterPositions (latest state). Chekhov items transition: planted -> growing -> paid-off.\\\",\\n            \\\"lockingModel\\\": \\\"Sequential - only one chapter in production at a time (INV-012), so no concurrent writes.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"chapters/chapter-{NNN}-metadata.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-line-editor\\\", \\\"romantic-fantasy-writer-copy-editor\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"protocol\\\": \\\"Read-modify-write with field-level ownership. Each revision agent updates only its revisionStatus field and increments draftVersion. Drafter creates initial record.\\\",\\n            \\\"mergeRules\\\": \\\"Drafter owns: chapterId, chapterNumber, pov, scenes, craftToolCompliance. Each editor owns its revisionStatus sub-field. draftVersion incremented by whichever agent last modified the chapter.\\\",\\n            \\\"lockingModel\\\": \\\"Sequential - revision passes run in strict order (developmental -> line -> copy -> beta -> polish), so no concurrent writes.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\"],\\n            \\\"protocol\\\": \\\"Single-writer accumulator. Series-kb-manager is sole writer. Merges current book continuity data, character evolution, world changes into series-level record at phase 9.\\\",\\n            \\\"mergeRules\\\": \\\"Append to books, canon, worldEvolution arrays. Update characterEvolution map. Existing entries from prior books immutable (INV-051). New entries may reference prior entries.\\\",\\n            \\\"lockingModel\\\": \\\"Runs once at end of pipeline. No concurrency.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"manifest.json\\\",\\n            \\\"writers\\\": [\\\"all agents\\\"],\\n            \\\"protocol\\\": \\\"Prepend-only audit log. Every agent prepends its entry to top of array after completing its task.\\\",\\n            \\\"mergeRules\\\": \\\"No modifications to existing entries. New entries always prepended (newest first). Each entry self-contained.\\\",\\n            \\\"lockingModel\\\": \\\"Agents run sequentially within each phase (except 5 parallel beta readers). Beta readers each prepend independently - order within that batch is non-deterministic but all entries preserved.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"progress.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\"],\\n            \\\"protocol\\\": \\\"Single-writer. Only orchestrator updates pipeline progress.\\\",\\n            \\\"mergeRules\\\": \\\"Update phase status fields. currentPhase advances monotonically (except during re-entry). betaRevisionCycles increments on each beta-to-revision re-entry.\\\",\\n            \\\"lockingModel\\\": \\\"Orchestrator is single-threaded.\\\"\\n        }\\n    ],\\n\\n    \\\"acyclicityValidation\\\": {\\n        \\\"verified\\\": True,\\n        \\\"explanation\\\": \\\"The artifact dependency graph follows the 9-phase creative pipeline with strict forward flow: concept -> world -> characters -> plot -> style -> chapters -> revision -> beta-reading -> polish. The only backward edge is the bounded beta-reading -> revision re-entry loop (INV-054), which is controlled by maxCycles and does not create a true dependency cycle - it is a re-execution of phase 7 with new inputs from phase 8, not a circular data dependency. Cross-cutting artifacts (continuity-tracker, series-knowledge-base) accumulate forward and are never dependencies of their own earlier state within the same production run.\\\",\\n        \\\"forwardEdges\\\": \\\"phase1->phase2->phase3->phase4->phase5->phase6->phase7->phase8->phase9->series-KB\\\",\\n        \\\"controlledReEntry\\\": \\\"phase8.synthesis.verdict=re-enter-revision -> phase7 (bounded by maxCycles)\\\",\\n        \\\"crossBookEdge\\\": \\\"series-KB -> phase1 (sequel only, across separate production runs)\\\"\\n    }\\n}\\n\\narch['artifacts'] = artifacts\\narch['lastUpdated'] = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.000Z')\\n\\nwith open('.fractal-factory/architecture.json', 'w') as f:\\n    json.dump(arch, f, indent=2)\\n\\nuniversal_count = len(artifacts['universal'])\\ndomain_count = len(artifacts['domainSpecific'])\\nmulti_writer = len(artifacts['multiWriterContracts'])\\ndata_flows = len(artifacts['dataFlow'])\\n\\nprint(f\\\"architecture.json updated successfully\\\")\\nprint(f\\\"   Universal artifacts: {universal_count}\\\")\\nprint(f\\\"   Domain-specific artifacts: {domain_count}\\\")\\nprint(f\\\"   Multi-writer contracts: {multi_writer}\\\")\\nprint(f\\\"   Data flow edges: {data_flows}\\\")\\nprint(f\\\"   Total artifacts: {universal_count + domain_count}\\\")\\nPYEOF\", \"description\": \"Write artifacts to architecture.json\", \"initial_wait\": 30}"
