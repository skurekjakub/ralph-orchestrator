              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json\\nfrom datetime import datetime, timezone\\n\\n# Load existing architecture.json\\nwith open('.fractal-factory/architecture.json') as f:\\n    arch = json.load(f)\\n\\n# Design the complete artifacts section\\nartifacts = {\\n    \\\"designRationale\\\": \\\"The romantic-fantasy-writer system produces deeply subcategorized creative artifacts organized per-book with series-level accumulators. The artifact design follows 5 principles: (1) subcategory decomposition — artifacts with 3+ distinct topics split into separate files per INV-031/INV-055/INV-064, (2) per-chapter isolation — each chapter is a separate file enabling sequential production per INV-012, (3) cross-cutting accumulators — continuity tracker and series KB span multiple phases with read-modify-write discipline, (4) phase-gated data flow — each phase's outputs feed the next phase's inputs with no backward dependencies except the bounded beta→revision re-entry, (5) schema-first contracts — every shared artifact has a defined JSON schema so agents can load/modify/write without ambiguity.\\\",\\n\\n    \\\"universal\\\": [\\n        {\\n            \\\"name\\\": \\\"story-config.json\\\",\\n            \\\"purpose\\\": \\\"All user inputs and story parameters: premise, constraints, series position, optional reference fiction paths, optional style samples. Single source of truth for what the user requested (INV-048, INV-050).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique story identifier (e.g., 'book-1', 'series-enchanted-bonds-book-2')\\\"},\\n                    {\\\"name\\\": \\\"premise\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"The story idea — minimum viable input (INV-050)\\\"},\\n                    {\\\"name\\\": \\\"seriesPosition\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ seriesName, bookNumber, isSequel, priorBooksPath }\\\"},\\n                    {\\\"name\\\": \\\"constraints\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ chapterCount, targetWordCount, pov, subgenre, heatLevel, contentBoundaries }\\\"},\\n                    {\\\"name\\\": \\\"referenceInputs\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ styleSamples: string[], referenceFiction: string[] } — optional paths\\\"},\\n                    {\\\"name\\\": \\\"craftOverrides\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Optional user-specified craft tools to include/exclude from T1-T14\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"readers\\\": [\\\"all agents\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"progress.json\\\",\\n            \\\"purpose\\\": \\\"Pipeline state tracking for the 9-phase creative pipeline. Records which phase is active, which are complete, cycle counts for re-entry loops.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"currentPhase\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Active phase number (1-9)\\\"},\\n                    {\\\"name\\\": \\\"phases\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of phase-name → { status: pending|active|completed|blocked, startedAt, completedAt, iterations }\\\"},\\n                    {\\\"name\\\": \\\"betaRevisionCycles\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Count of beta→revision re-entry cycles (bounded by maxCycles)\\\"},\\n                    {\\\"name\\\": \\\"overallStatus\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"pending | in-progress | completed | failed\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\", \\\"all coordinators\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"manifest.json\\\",\\n            \\\"purpose\\\": \\\"Immutable audit trail of all agent executions, prepend-only (newest first). Records every action taken during story production.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"timestamp\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"ISO-8601 UTC timestamp\\\"},\\n                    {\\\"name\\\": \\\"agent\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent name that performed the action\\\"},\\n                    {\\\"name\\\": \\\"phase\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Creative pipeline phase (concept, world-building, etc.)\\\"},\\n                    {\\\"name\\\": \\\"artifacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"List of artifact paths written or modified\\\"},\\n                    {\\\"name\\\": \\\"status\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"completed | failed\\\"},\\n                    {\\\"name\\\": \\\"result\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Domain-specific result verb\\\"},\\n                    {\\\"name\\\": \\\"iteration\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Iteration counter for writer-reviewer loops\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"all agents\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-polish-delivery-coordinator\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"prepend-only\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"agents/*/status.json\\\",\\n            \\\"purpose\\\": \\\"Per-agent routing signal following the universal 8-field contract (PATTERN-006). Read by parent coordinators for routing decisions.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"agent\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent name\\\"},\\n                    {\\\"name\\\": \\\"task_id\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Phase/task slug (e.g., 'phase6/chapter-03')\\\"},\\n                    {\\\"name\\\": \\\"status\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"completed | failed\\\"},\\n                    {\\\"name\\\": \\\"result\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Domain-specific result verb (drafted, revised, approved, needs-revision, etc.)\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Human-readable 20-50 word summary\\\"},\\n                    {\\\"name\\\": \\\"artifacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"List of produced file paths\\\"},\\n                    {\\\"name\\\": \\\"next_hint\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Suggested next agent\\\"},\\n                    {\\\"name\\\": \\\"iteration\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Iteration counter\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"each agent (own status only)\\\"],\\n            \\\"readers\\\": [\\\"parent coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once-per-iteration\\\"\\n        }\\n    ],\\n\\n    \\\"domainSpecific\\\": [\\n        # ─── PHASE 1: CONCEPT DEVELOPMENT ───\\n        {\\n            \\\"name\\\": \\\"story-concept.json\\\",\\n            \\\"purpose\\\": \\\"Crystallized story concept produced from user's premise: genre promise, thematic core, dual-arc summary (fantasy plot + romance spine), world seed, tone/mood targets, and scope parameters (INV-001, INV-030).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"conceptId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique concept identifier\\\"},\\n                    {\\\"name\\\": \\\"title\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Working title\\\"},\\n                    {\\\"name\\\": \\\"premise\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Refined premise (1-3 sentences)\\\"},\\n                    {\\\"name\\\": \\\"genrePromise\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ fantasyArc: string, romanceArc: string, subgenre: string }\\\"},\\n                    {\\\"name\\\": \\\"themes\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Core thematic threads\\\"},\\n                    {\\\"name\\\": \\\"worldSeed\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ settingType, era, magicPresence, technologyLevel, culturalInspiration }\\\"},\\n                    {\\\"name\\\": \\\"tonePalette\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ primaryTone, secondaryTones, moodProgression, heatLevel }\\\"},\\n                    {\\\"name\\\": \\\"scope\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ chapterCount, estimatedWordCount, povStyle, timespan }\\\"},\\n                    {\\\"name\\\": \\\"dualArcSummary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ fantasyArcSummary, romanceArcSummary, intersectionPoints }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CONCEPT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-concept-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-concept-auditor\\\", \\\"all downstream phase agents\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Created once by concept-writer, validated by concept-auditor. All downstream phases reference this as the authoritative scope definition.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"story-craft-profile.json\\\",\\n            \\\"purpose\\\": \\\"Selected craft tools (5-8 from T1-T14) and their application parameters for this specific story. Two-tier quality system: non-negotiable invariants always apply, plus these conditional tools (INV-032, INV-063).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Links to story-config.json\\\"},\\n                    {\\\"name\\\": \\\"selectedTools\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { toolId: 'T1'-'T14', toolName, rationale, applicationNotes }\\\"},\\n                    {\\\"name\\\": \\\"deselectedTools\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { toolId, toolName, rationale } — explicitly excluded tools with reasoning\\\"},\\n                    {\\\"name\\\": \\\"selectionCriteria\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Narrative explaining why these tools fit this story\\\"},\\n                    {\\\"name\\\": \\\"invariantOverrides\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Empty — non-negotiable invariants cannot be overridden. This field exists as a verification target.\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"TCP-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-concept-writer\\\"],\\n            \\\"readers\\\": [\\\"all auditors\\\", \\\"romantic-fantasy-writer-plot-writer\\\", \\\"all revision agents\\\", \\\"all beta readers\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Produced during concept development, refined during plot architecture. Every auditor references this to know which craft tools to enforce.\\\"\\n        },\\n\\n        # ─── PHASE 2: WORLD BUILDING (6 subcategory files per INV-031, INV-055) ───\\n        {\\n            \\\"name\\\": \\\"world-bible/geography.json\\\",\\n            \\\"purpose\\\": \\\"Physical world: continents, kingdoms, cities, terrain, climate, travel distances, maps. Self-contained per INV-064.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"worldId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Links to story-concept worldSeed\\\"},\\n                    {\\\"name\\\": \\\"locations\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { locationId: 'LOC-NNN', name, type, description, climate, significance, connections }\\\"},\\n                    {\\\"name\\\": \\\"travelRoutes\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { from, to, method, duration, hazards }\\\"},\\n                    {\\\"name\\\": \\\"geographicRules\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"World-level geographic constraints and patterns\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"LOC-NNN\\\",\\n                \\\"itemSchema\\\": {\\\"locationId\\\": \\\"string\\\", \\\"name\\\": \\\"string\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"string\\\", \\\"climate\\\": \\\"string\\\", \\\"significance\\\": \\\"string\\\", \\\"connections\\\": \\\"array\\\"}\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\", \\\"romantic-fantasy-writer-series-kb-manager\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/magic-system.json\\\",\\n            \\\"purpose\\\": \\\"Magic rules, costs, limitations, power scaling, known abilities, forbidden magic. Sanderson's First Law compliance tracked here (INV-009, T10/INV-042).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"systemName\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Name of the magic system\\\"},\\n                    {\\\"name\\\": \\\"hardness\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Soft/medium/hard classification\\\"},\\n                    {\\\"name\\\": \\\"rules\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { ruleId: 'MAG-NNN', rule, cost, limitation, established: boolean }\\\"},\\n                    {\\\"name\\\": \\\"abilities\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { abilityId, name, user, cost, limitation }\\\"},\\n                    {\\\"name\\\": \\\"forbiddenMagic\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"What magic cannot do — hard boundaries\\\"},\\n                    {\\\"name\\\": \\\"powerScaling\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ novice, intermediate, master, legendary } — power levels and what's achievable\\\"},\\n                    {\\\"name\\\": \\\"magicInSociety\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"How magic is perceived, regulated, feared/revered\\\"},\\n                    {\\\"name\\\": \\\"expansionRules\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"For sequels: how the system can grow without contradiction (INV-056)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"MAG-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\", \\\"romantic-fantasy-writer-fantasy-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/politics.json\\\",\\n            \\\"purpose\\\": \\\"Power structures: kingdoms, factions, alliances, rivalries, governance, laws, conflicts, succession rules.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"factions\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { factionId: 'FAC-NNN', name, type, leader, territory, goals, rivals, allies }\\\"},\\n                    {\\\"name\\\": \\\"governanceStructures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { regionId, system, laws, succession }\\\"},\\n                    {\\\"name\\\": \\\"activePoliticalConflicts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { conflictId, parties, stakes, currentState }\\\"},\\n                    {\\\"name\\\": \\\"treaties\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Known agreements between factions\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FAC-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-plot-writer\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/culture.json\\\",\\n            \\\"purpose\\\": \\\"Social fabric: customs, religions, festivals, food, clothing, social norms, taboos, languages, naming conventions.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"cultures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { cultureId: 'CUL-NNN', name, region, customs, religion, festivals, socialNorms, taboos }\\\"},\\n                    {\\\"name\\\": \\\"languages\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { languageId, name, speakers, notableExpressions }\\\"},\\n                    {\\\"name\\\": \\\"namingConventions\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Per-culture naming patterns to prevent collisions (INV-058)\\\"},\\n                    {\\\"name\\\": \\\"socialHierarchy\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Class/caste structures per culture\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CUL-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-character-writer\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-sensitivity-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/history.json\\\",\\n            \\\"purpose\\\": \\\"Timeline of the world: founding myths, wars, cataclysms, political shifts, magical discoveries, key historical figures.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"timeline\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { eventId: 'HIST-NNN', date/era, event, significance, participants, consequences }\\\"},\\n                    {\\\"name\\\": \\\"eras\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { eraId, name, startEvent, endEvent, characteristics }\\\"},\\n                    {\\\"name\\\": \\\"foundingMyths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Creation stories, legends, prophecies\\\"},\\n                    {\\\"name\\\": \\\"historicalFigures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { name, era, role, legacy }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"HIST-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/flora-fauna.json\\\",\\n            \\\"purpose\\\": \\\"Creatures, plants, ecosystem, mounts, pets, dangerous wildlife, magical beasts, medicinal herbs.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"creatures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { creatureId: 'CREAT-NNN', name, habitat, behavior, magicalProperties, dangerLevel }\\\"},\\n                    {\\\"name\\\": \\\"plants\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { plantId: 'PLANT-NNN', name, habitat, uses, rarity }\\\"},\\n                    {\\\"name\\\": \\\"ecosystems\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { regionId, dominantSpecies, foodChain, magicalInfluence }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CREAT-NNN / PLANT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-world-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-world-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n\\n        # ─── PHASE 3: CHARACTER DESIGN (per-character files) ───\\n        {\\n            \\\"name\\\": \\\"characters/cast-index.json\\\",\\n            \\\"purpose\\\": \\\"Master index of all characters: IDs, names, roles, relationship map, and pointers to individual character files. Prevents naming collisions (INV-058).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"characters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { characterId: 'CHAR-NNN', name, role: lead|supporting|antagonist|minor, filePath, introduced }\\\"},\\n                    {\\\"name\\\": \\\"relationships\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { from: CHAR-NNN, to: CHAR-NNN, type, description, evolution }\\\"},\\n                    {\\\"name\\\": \\\"namingRegistry\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"All used names mapped to character IDs — collision prevention (INV-058)\\\"},\\n                    {\\\"name\\\": \\\"voiceDistinctivenessMatrix\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Per-character voice markers ensuring distinctness (INV-003)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CHAR-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-character-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-character-auditor\\\", \\\"romantic-fantasy-writer-plot-writer\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\", \\\"romantic-fantasy-writer-romance-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"characters/{character-slug}.json\\\",\\n            \\\"purpose\\\": \\\"Individual character profile: backstory, psychology, motivations, arc, voice guide, appearance, relationships, knowledge boundaries. One file per significant character (INV-055, INV-064).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"characterId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CHAR-NNN from cast-index\\\"},\\n                    {\\\"name\\\": \\\"name\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Full name and any aliases\\\"},\\n                    {\\\"name\\\": \\\"role\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"lead-romantic | lead-romantic | supporting | antagonist | minor\\\"},\\n                    {\\\"name\\\": \\\"backstory\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ origin, formativeEvents, secrets, woundsAndDesires }\\\"},\\n                    {\\\"name\\\": \\\"psychology\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ personality, fears, desires, flaws, strengths, internalConflict }\\\"},\\n                    {\\\"name\\\": \\\"arc\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ startingState, catalystForChange, midpointShift, darkMoment, resolution }\\\"},\\n                    {\\\"name\\\": \\\"voiceGuide\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ vocabulary, sentencePatterns, speechMannerisms, internalMonologueStyle, distinctMarkers } (INV-003)\\\"},\\n                    {\\\"name\\\": \\\"appearance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ physical, clothing, distinguishingFeatures }\\\"},\\n                    {\\\"name\\\": \\\"knowledgeBoundary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"What this character knows and doesn't know — prevents POV leaks (INV-002)\\\"},\\n                    {\\\"name\\\": \\\"romanceRole\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ attachmentStyle, romanticResistance, vulnerabilityTriggers, attractionToOther } (INV-008, INV-040)\\\"},\\n                    {\\\"name\\\": \\\"agency\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Active choices this character makes that drive the plot (INV-008)\\\"},\\n                    {\\\"name\\\": \\\"motivation\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Core motivation — especially important for antagonists (INV-022)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CHAR-NNN\\\",\\n                \\\"itemSchema\\\": \\\"One file per character, filename is character slug (e.g., characters/elara-nightbloom.json)\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-character-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-character-auditor\\\", \\\"romantic-fantasy-writer-plot-writer\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-voice-consistency-checker\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Voice guides carry across books in a series (INV-057). For sequels, existing character files are loaded from series KB and extended.\\\"\\n        },\\n\\n        # ─── PHASE 4: PLOT ARCHITECTURE ───\\n        {\\n            \\\"name\\\": \\\"plot/structure-framework.json\\\",\\n            \\\"purpose\\\": \\\"Selected story structure (3-Act, Save the Cat, Hero's Journey, etc.) with the romantic fantasy dual-arc overlay mapping fantasy and romance arcs to structural beats.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"frameworkName\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Selected structure framework\\\"},\\n                    {\\\"name\\\": \\\"fantasyArcBeats\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { beatId: 'FBEAT-NNN', name, description, chapter, purpose }\\\"},\\n                    {\\\"name\\\": \\\"romanceArcBeats\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { beatId: 'RBEAT-NNN', name, stage, chapter, purpose } (INV-021)\\\"},\\n                    {\\\"name\\\": \\\"intersectionPoints\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Where fantasy and romance arcs converge/diverge (INV-044/T12)\\\"},\\n                    {\\\"name\\\": \\\"actBreaks\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { act, startChapter, endChapter, escalation }\\\"},\\n                    {\\\"name\\\": \\\"blackMoment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"The 'all is lost' point for romance arc (INV-039/T7)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FBEAT-NNN / RBEAT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-plot-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"plot/chapter-outlines.json\\\",\\n            \\\"purpose\\\": \\\"Per-chapter outline specifying POV, scene goals, conflicts, expected outcomes, beat assignments. No chapter may be drafted without its outline (INV-010).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of chapter outline objects\\\"},\\n                    {\\\"name\\\": \\\"totalChapters\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total planned chapter count\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CH-NNN\\\",\\n                \\\"itemSchema\\\": {\\n                    \\\"chapterId\\\": \\\"string (CH-NNN)\\\",\\n                    \\\"chapterNumber\\\": \\\"number\\\",\\n                    \\\"title\\\": \\\"string\\\",\\n                    \\\"pov\\\": \\\"string (character name)\\\",\\n                    \\\"scenes\\\": \\\"array of { sceneId: SCN-NNN, goal, conflict, outcome, valueshifts, setting }\\\",\\n                    \\\"fantasyBeat\\\": \\\"string (which story beat this chapter serves)\\\",\\n                    \\\"romanceBeat\\\": \\\"string (which romance stage this advances)\\\",\\n                    \\\"chekhovIntroductions\\\": \\\"array (elements introduced here)\\\",\\n                    \\\"chekhovPayoffs\\\": \\\"array (elements resolved here)\\\",\\n                    \\\"emotionalArc\\\": \\\"string (chapter-level emotional trajectory)\\\",\\n                    \\\"wordCountTarget\\\": \\\"number\\\"\\n                }\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-plot-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Outline must exist before any chapter draft (INV-010). Craft tools T1 (scene-sequel), T3 (five commandments), T5 (tone contract) shape scene design.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"plot/tension-map.json\\\",\\n            \\\"purpose\\\": \\\"Tension rise-and-fall across all chapters for both arcs. Validates pacing variation (INV-020) and stakes escalation (T6/INV-038). Includes T13 tension mapping if selected.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { chapterId, fantasyTension: 1-10, romanceTension: 1-10, overallPacing: string, stakes: string }\\\"},\\n                    {\\\"name\\\": \\\"pacingViolations\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Pre-identified pacing concerns (3+ consecutive high-action chapters, etc.)\\\"},\\n                    {\\\"name\\\": \\\"stakesProgression\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Act-by-act stakes description showing escalation\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"Indexed by CH-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-plot-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-craft-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"plot/subplot-tracker.json\\\",\\n            \\\"purpose\\\": \\\"All subplots with their status, involved characters, chapter appearances, and resolution tracking.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"subplots\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of subplot objects\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"SUB-NNN\\\",\\n                \\\"itemSchema\\\": {\\n                    \\\"subplotId\\\": \\\"string (SUB-NNN)\\\",\\n                    \\\"name\\\": \\\"string\\\",\\n                    \\\"type\\\": \\\"string (political, romantic-secondary, mystery, character-growth, etc.)\\\",\\n                    \\\"characters\\\": \\\"array of CHAR-NNN\\\",\\n                    \\\"chapters\\\": \\\"array of CH-NNN where this subplot appears\\\",\\n                    \\\"status\\\": \\\"string (active | resolved | abandoned-intentionally)\\\",\\n                    \\\"resolutionChapter\\\": \\\"string or null\\\",\\n                    \\\"unresolvedThreads\\\": \\\"array (for sequel hooks)\\\"\\n                }\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-writer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-plot-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n\\n        # ─── PHASE 5: PROSE STYLE DEVELOPMENT ───\\n        {\\n            \\\"name\\\": \\\"style-guide.json\\\",\\n            \\\"purpose\\\": \\\"Prose style parameters: voice, tone, vocabulary constraints, sentence rhythm, POV-specific style variations, and reference analysis results (if style samples provided). Enforces INV-024 transformative-only influence.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"overallVoice\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ narrativeDistance, tense, person, register, lushness: 1-10, emotionalOpenness }\\\"},\\n                    {\\\"name\\\": \\\"tonePalette\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ primary, secondary, forbidden, moodTransitionRules }\\\"},\\n                    {\\\"name\\\": \\\"vocabularyRules\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ periodAppropriate: boolean, forbiddenAnachronisms: array, clicheWatchlist: array } (INV-018, INV-017)\\\"},\\n                    {\\\"name\\\": \\\"sentenceRhythm\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ avgLength, variation, actionScenePacing, emotionalScenePacing }\\\"},\\n                    {\\\"name\\\": \\\"dialogueStyle\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ naturalism rules, interruption patterns, subtext guidelines } (INV-019)\\\"},\\n                    {\\\"name\\\": \\\"povVoiceVariations\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Per-POV-character style adjustments (links to character voice guides)\\\"},\\n                    {\\\"name\\\": \\\"referenceAnalysis\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ analyzed: boolean, abstractPatterns: array, specificBorrowings: [] } — INV-024 enforced: zero specific borrowings\\\"},\\n                    {\\\"name\\\": \\\"showDontTellRules\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Specific emotion-to-physicality mappings (INV-005)\\\"},\\n                    {\\\"name\\\": \\\"proseQualityFloor\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Quantified thresholds from INV-017 (max clichés, adverb density, etc.)\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-style-analyst\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-style-auditor\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-line-editor\\\", \\\"romantic-fantasy-writer-craft-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"If no reference fiction provided, style is derived entirely from genre conventions and concept tone palette.\\\"\\n        },\\n\\n        # ─── PHASE 6: CHAPTER DRAFTING (per-chapter files) ───\\n        {\\n            \\\"name\\\": \\\"chapters/chapter-{NNN}.md\\\",\\n            \\\"purpose\\\": \\\"Individual chapter prose. One file per chapter, produced sequentially (INV-012). Chapter N+1 cannot start until Chapter N is complete with continuity tracker updated.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"content\\\", \\\"type\\\": \\\"markdown\\\", \\\"description\\\": \\\"Full chapter prose with scene breaks\\\"},\\n                    {\\\"name\\\": \\\"frontmatter\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"YAML frontmatter: chapterId, chapterNumber, title, pov, wordCount, scenes, draftVersion\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"chapter-001.md, chapter-002.md, etc.\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-auditor\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-line-editor\\\", \\\"romantic-fantasy-writer-copy-editor\\\", \\\"all beta readers\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once-then-revise\\\",\\n            \\\"ownershipField\\\": \\\"frontmatter.draftVersion\\\",\\n            \\\"notes\\\": \\\"Initial draft by chapter-drafter (v1). Revision agents produce v2, v3, v4. Polish agent produces vFinal. Each version is tracked in frontmatter. Original draft preserved in revision findings for traceability (INV-014).\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"chapters/chapter-{NNN}-metadata.json\\\",\\n            \\\"purpose\\\": \\\"Structured metadata for each chapter: scenes list, word count, POV, craft tool compliance, continuity checkpoint, revision status.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CH-NNN\\\"},\\n                    {\\\"name\\\": \\\"chapterNumber\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Sequential number\\\"},\\n                    {\\\"name\\\": \\\"pov\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"POV character name\\\"},\\n                    {\\\"name\\\": \\\"wordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Current word count\\\"},\\n                    {\\\"name\\\": \\\"scenes\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { sceneId: SCN-NNN, startLine, endLine, valueShift, goal, outcome }\\\"},\\n                    {\\\"name\\\": \\\"craftToolCompliance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Per-selected-tool compliance status: { T1: pass/fail, T3: pass/fail, ... }\\\"},\\n                    {\\\"name\\\": \\\"continuityCheckpoint\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Timestamp of last continuity-tracker update after this chapter\\\"},\\n                    {\\\"name\\\": \\\"revisionStatus\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ developmental: pending|complete, lineEdit: pending|complete, copyEdit: pending|complete, betaReading: pending|complete, polish: pending|complete }\\\"},\\n                    {\\\"name\\\": \\\"draftVersion\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Current draft version number\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"Indexed by CH-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-line-editor\\\", \\\"romantic-fantasy-writer-copy-editor\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-drafting-coordinator\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"revisionStatus\\\",\\n            \\\"notes\\\": \\\"Multi-writer: drafter creates initial metadata, each revision pass updates its section of revisionStatus and increments draftVersion. Each writer modifies only its own revisionStatus field.\\\"\\n        },\\n\\n        # ─── CROSS-CUTTING: CONTINUITY TRACKING ───\\n        {\\n            \\\"name\\\": \\\"continuity-tracker.json\\\",\\n            \\\"purpose\\\": \\\"Running continuity state updated after every chapter: character positions, timeline, knowledge matrix, Chekhov's gun registry, established facts. The single source of truth for story consistency (INV-011, INV-016).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lastUpdatedAfterChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number of last update\\\"},\\n                    {\\\"name\\\": \\\"timeline\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { entryId: 'TL-NNN', chapter, event, date/time, duration, participants }\\\"},\\n                    {\\\"name\\\": \\\"characterPositions\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → { currentLocation, lastSeenChapter, physicalState, emotionalState }\\\"},\\n                    {\\\"name\\\": \\\"characterKnowledge\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → { knows: [], doesNotKnow: [] } — prevents POV knowledge leaks\\\"},\\n                    {\\\"name\\\": \\\"chekhovRegistry\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { itemId: 'CK-NNN', element, introducedChapter, status: planted|growing|paid-off|abandoned, payoffChapter, notes }\\\"},\\n                    {\\\"name\\\": \\\"establishedFacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { factId: 'FACT-NNN', fact, establishedChapter, category, referencedBy }\\\"},\\n                    {\\\"name\\\": \\\"openThreads\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { threadId, description, introducedChapter, expectedResolution }\\\"},\\n                    {\\\"name\\\": \\\"anachronismWatch\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Technology/concept references to verify against world-bible (INV-018)\\\"},\\n                    {\\\"name\\\": \\\"injuries\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { characterId, injury, chapter, healed: boolean, healedChapter } — prevents magically healed injuries\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"TL-NNN / CK-NNN / FACT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-chapter-auditor\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-continuity-verifier\\\", \\\"all beta readers\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedAfterChapter\\\",\\n            \\\"notes\\\": \\\"Updated after every chapter draft (INV-011). The continuity-tracker agent reads the new chapter, cross-references against world-bible and character files, and appends/updates entries. This is the most frequently written artifact in the system. Chekhov registry enforces INV-006. For sequels, initial state loaded from series-knowledge-base.\\\"\\n        },\\n\\n        # ─── CROSS-CUTTING: SERIES KNOWLEDGE BASE ───\\n        {\\n            \\\"name\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"purpose\\\": \\\"Series-level accumulated knowledge: established canon, character histories across books, world evolution, resolved/unresolved threads, naming registry. Loaded at start for sequels, merged at end of every book (INV-049, INV-051).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"seriesName\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Series identifier\\\"},\\n                    {\\\"name\\\": \\\"books\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { bookId, title, summary, chapterCount }\\\"},\\n                    {\\\"name\\\": \\\"canon\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { canonId: 'CANON-NNN', fact, establishedInBook, category, immutable: boolean }\\\"},\\n                    {\\\"name\\\": \\\"characterEvolution\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → { bookAppearances: [], arcAcrossBooks, voiceEvolution }\\\"},\\n                    {\\\"name\\\": \\\"worldEvolution\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { change, book, category: geography|magic|politics|culture }\\\"},\\n                    {\\\"name\\\": \\\"magicSystemState\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Current state of magic system including all expansions across books (INV-056)\\\"},\\n                    {\\\"name\\\": \\\"unresolvedThreads\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { threadId, description, originBook, status: open|resolved|deferred }\\\"},\\n                    {\\\"name\\\": \\\"namingRegistry\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"All names used across all books with character/place mappings (INV-058)\\\"},\\n                    {\\\"name\\\": \\\"retconLog\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Any intentional changes to prior canon — must be explicitly justified and acknowledged (INV-051)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CANON-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-concept-writer\\\", \\\"romantic-fantasy-writer-world-writer\\\", \\\"romantic-fantasy-writer-character-writer\\\", \\\"romantic-fantasy-writer-plot-writer\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"books[-1].bookId\\\",\\n            \\\"notes\\\": \\\"Lifecycle: (1) For standalones, created fresh at phase 9 polish. (2) For sequels, loaded before phase 1 and cross-referenced throughout. (3) Append-mostly: facts from prior books cannot be silently contradicted (INV-051). Retcon log required for any canonical changes.\\\"\\n        },\\n\\n        # ─── PHASE 7: REVISION ───\\n        {\\n            \\\"name\\\": \\\"revision/developmental-findings.json\\\",\\n            \\\"purpose\\\": \\\"Developmental edit findings: plot holes, pacing issues, character inconsistencies, structural problems, missing emotional beats. Per-chapter granularity.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"passType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"developmental\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of finding objects\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor, byCategory }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"DEV-NNN\\\",\\n                \\\"itemSchema\\\": {\\n                    \\\"findingId\\\": \\\"string (DEV-NNN)\\\",\\n                    \\\"chapter\\\": \\\"string (CH-NNN)\\\",\\n                    \\\"severity\\\": \\\"string (critical | major | minor)\\\",\\n                    \\\"category\\\": \\\"string (plot-hole | pacing | character-consistency | emotional-arc | structure)\\\",\\n                    \\\"description\\\": \\\"string\\\",\\n                    \\\"evidence\\\": \\\"string (exact quote or reference)\\\",\\n                    \\\"suggestedFix\\\": \\\"string\\\",\\n                    \\\"invariantRef\\\": \\\"string (INV-NNN if applicable)\\\",\\n                    \\\"status\\\": \\\"string (open | addressed | wont-fix-with-justification)\\\",\\n                    \\\"addressedIn\\\": \\\"string (draft version that fixed this)\\\"\\n                }\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-developmental-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"First revision pass. Findings are addressed by the revision-applier agent who modifies chapter files and marks findings as addressed with traceability (INV-014).\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"revision/line-edit-findings.json\\\",\\n            \\\"purpose\\\": \\\"Line edit findings: prose quality, voice consistency, show-don't-tell violations, dialogue naturalism, cliché usage, adverb density. Per-chapter granularity.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"passType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"line-edit\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of finding objects\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor, byCategory }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"LINE-NNN\\\",\\n                \\\"itemSchema\\\": {\\n                    \\\"findingId\\\": \\\"string (LINE-NNN)\\\",\\n                    \\\"chapter\\\": \\\"string (CH-NNN)\\\",\\n                    \\\"severity\\\": \\\"string (critical | major | minor)\\\",\\n                    \\\"category\\\": \\\"string (voice | show-dont-tell | dialogue | cliche | prose-density | pov-consistency)\\\",\\n                    \\\"description\\\": \\\"string\\\",\\n                    \\\"evidence\\\": \\\"string (exact quote)\\\",\\n                    \\\"suggestedFix\\\": \\\"string\\\",\\n                    \\\"invariantRef\\\": \\\"string (INV-NNN or T-NN if applicable)\\\",\\n                    \\\"status\\\": \\\"string (open | addressed | wont-fix-with-justification)\\\",\\n                    \\\"addressedIn\\\": \\\"string\\\"\\n                }\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-line-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Second revision pass. Runs after developmental findings are addressed. Enforces INV-003, INV-005, INV-017, INV-019, and applicable craft tools.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"revision/copy-edit-findings.json\\\",\\n            \\\"purpose\\\": \\\"Copy edit findings: grammar, spelling, punctuation, formatting, consistency of proper nouns, timeline errors, factual contradictions against world-bible.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"passType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"copy-edit\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of finding objects\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor, byCategory }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"COPY-NNN\\\",\\n                \\\"itemSchema\\\": {\\n                    \\\"findingId\\\": \\\"string (COPY-NNN)\\\",\\n                    \\\"chapter\\\": \\\"string (CH-NNN)\\\",\\n                    \\\"severity\\\": \\\"string (critical | major | minor)\\\",\\n                    \\\"category\\\": \\\"string (grammar | spelling | formatting | proper-noun | timeline | factual)\\\",\\n                    \\\"description\\\": \\\"string\\\",\\n                    \\\"evidence\\\": \\\"string (exact quote)\\\",\\n                    \\\"suggestedFix\\\": \\\"string\\\",\\n                    \\\"invariantRef\\\": \\\"string\\\",\\n                    \\\"status\\\": \\\"string (open | addressed | wont-fix-with-justification)\\\",\\n                    \\\"addressedIn\\\": \\\"string\\\"\\n                }\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-copy-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Third and final revision pass. Cross-references continuity-tracker and world-bible for factual accuracy.\\\"\\n        },\\n\\n        # ─── PHASE 8: BETA READING (5 parallel lenses) ───\\n        {\\n            \\\"name\\\": \\\"beta-reading/romance-lens.json\\\",\\n            \\\"purpose\\\": \\\"Romance reader perspective: emotional resonance, chemistry, relationship pacing, HFN/HEA satisfaction, romantic tension, vulnerability beats (INV-053).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"romance\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, chemistryScore, emotionalResonance, pacing, resolution }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BR-NNN', chapter, severity, category, description, evidence, suggestion }\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Specific romance elements that work well\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BR-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-romance-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/fantasy-lens.json\\\",\\n            \\\"purpose\\\": \\\"Fantasy reader perspective: world immersion, magic system consistency, plot engagement, suspension of disbelief, info-dumping detection (INV-053).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"fantasy\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, worldImmersion, magicCoherence, plotEngagement, suspenseOfDisbelief }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BF-NNN', chapter, severity, category, description, evidence, suggestion }\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Specific fantasy elements that work well\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BF-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-fantasy-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/craft-lens.json\\\",\\n            \\\"purpose\\\": \\\"Craft/technique perspective: prose quality, structure compliance, selected craft tool adherence, pacing, scene construction, voice consistency (INV-053).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"craft\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, proseQuality, structuralIntegrity, craftToolCompliance, voiceConsistency }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BC-NNN', chapter, severity, category, description, evidence, suggestion, craftToolRef }\\\"},\\n                    {\\\"name\\\": \\\"craftToolAudit\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Per-selected-tool compliance assessment\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Specific craft elements that work well\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BC-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-craft-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/sensitivity-lens.json\\\",\\n            \\\"purpose\\\": \\\"Sensitivity reader perspective: cultural representation, harmful tropes, power dynamics, consent, potentially problematic content (INV-053).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"sensitivity\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, representationQuality, consentHandling, powerDynamics }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BS-NNN', chapter, severity, category, description, evidence, suggestion, trope }\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Positive representation elements\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BS-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-sensitivity-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/originality-lens.json\\\",\\n            \\\"purpose\\\": \\\"Originality checker perspective: plagiarism detection, derivative passages, over-reliance on reference material, cliché plot structures (INV-023, INV-024, INV-025, INV-053).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"originality\\\"},\\n                    {\\\"name\\\": \\\"overallAssessment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ rating: 1-10, originalityScore, derivativeRisk, transformativeSuccess }\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BO-NNN', chapter, severity, category, description, evidence, suggestion, similarTo }\\\"},\\n                    {\\\"name\\\": \\\"plagiarismFlags\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Zero-tolerance items — any non-empty list is critical (INV-023)\\\"},\\n                    {\\\"name\\\": \\\"strengths\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Original and creative elements\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalFindings, critical, major, minor }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BO-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-originality-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-reading/synthesis.json\\\",\\n            \\\"purpose\\\": \\\"Aggregated beta reading findings across all 5 lenses: prioritized action items, conflict resolution between lenses, go/no-go decision for polish phase vs. re-entry to revision (INV-054).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"lensesCompleted\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Which lenses have reported\\\"},\\n                    {\\\"name\\\": \\\"aggregatedFindings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { findingId: 'BETA-NNN', originLens, originFindingId, chapter, severity, category, description, priority: number }\\\"},\\n                    {\\\"name\\\": \\\"crossLensConflicts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { conflict, lens1, lens2, resolution, rationale }\\\"},\\n                    {\\\"name\\\": \\\"actionItems\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ critical: array, major: array, minor: array } — prioritized\\\"},\\n                    {\\\"name\\\": \\\"verdict\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"proceed-to-polish | re-enter-revision\\\"},\\n                    {\\\"name\\\": \\\"reEntryScope\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"If re-entering revision: { affectedChapters, revisionType, specificFindings }\\\"},\\n                    {\\\"name\\\": \\\"overallScores\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Aggregated scores from all lenses\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BETA-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-beta-synthesis-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-reading-coordinator\\\", \\\"romantic-fantasy-writer-revision-coordinator\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null,\\n            \\\"notes\\\": \\\"Critical decision point: if verdict is re-enter-revision, the beta-reading coordinator signals the orchestrator to re-dispatch revision (bounded by maxCycles). INV-054 requires all critical/major findings addressed.\\\"\\n        },\\n\\n        # ─── PHASE 9: POLISH & DELIVERY ───\\n        {\\n            \\\"name\\\": \\\"delivery/chapter-summaries.json\\\",\\n            \\\"purpose\\\": \\\"One-paragraph summary per chapter for series knowledge base, reader reference, and sequel continuity.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Array of { chapterId: CH-NNN, title, summary, keyEvents, romanceProgress, plotProgress }\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"Indexed by CH-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        },\\n        {\\n            \\\"name\\\": \\\"delivery/book-metadata.json\\\",\\n            \\\"purpose\\\": \\\"Final book metadata: title, blurb, word count, chapter count, completion metrics, quality scores from beta reading, craft profile used.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"bookId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique book identifier\\\"},\\n                    {\\\"name\\\": \\\"title\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Final title\\\"},\\n                    {\\\"name\\\": \\\"blurb\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Back-cover blurb\\\"},\\n                    {\\\"name\\\": \\\"wordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total word count\\\"},\\n                    {\\\"name\\\": \\\"chapterCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total chapters\\\"},\\n                    {\\\"name\\\": \\\"qualityScores\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Aggregated from beta-reading synthesis\\\"},\\n                    {\\\"name\\\": \\\"craftProfileUsed\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Which craft tools were selected for this book\\\"},\\n                    {\\\"name\\\": \\\"invariantCoverage\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Summary of invariant enforcement across all phases\\\"},\\n                    {\\\"name\\\": \\\"seriesPosition\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ seriesName, bookNumber, unresolvedThreadsForSequel }\\\"},\\n                    {\\\"name\\\": \\\"productionMetrics\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{ totalRevisionPasses, betaRevisionCycles, writerReviewerIterations }\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\", \\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": null\\n        }\\n    ],\\n\\n    \\\"dataFlow\\\": [\\n        # Phase 1 → Phase 2\\n        {\\n            \\\"from\\\": \\\"phase1-concept\\\",\\n            \\\"artifact\\\": \\\"story-concept.json\\\",\\n            \\\"to\\\": \\\"phase2-world-building\\\",\\n            \\\"purpose\\\": \\\"Concept's worldSeed, genre promise, and scope parameters guide world construction\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase1-concept\\\",\\n            \\\"artifact\\\": \\\"story-craft-profile.json\\\",\\n            \\\"to\\\": \\\"phase2-world-building\\\",\\n            \\\"purpose\\\": \\\"Selected craft tools inform world-building depth (e.g., T10 Sanderson's Law → magic system hardness)\\\"\\n        },\\n        # Phase 2 → Phase 3\\n        {\\n            \\\"from\\\": \\\"phase2-world-building\\\",\\n            \\\"artifact\\\": \\\"world-bible/*.json\\\",\\n            \\\"to\\\": \\\"phase3-character-design\\\",\\n            \\\"purpose\\\": \\\"Characters are grounded in the world: culture informs customs, politics informs allegiances, magic informs abilities\\\"\\n        },\\n        # Phase 2+3 → Phase 4\\n        {\\n            \\\"from\\\": \\\"phase2-world-building\\\",\\n            \\\"artifact\\\": \\\"world-bible/*.json\\\",\\n            \\\"to\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"purpose\\\": \\\"Plot leverages world conflicts, political tensions, magical constraints\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase3-character-design\\\",\\n            \\\"artifact\\\": \\\"characters/*.json\\\",\\n            \\\"to\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"purpose\\\": \\\"Plot is driven by character psychology, motivations, romantic resistance (INV-008 agency)\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase1-concept\\\",\\n            \\\"artifact\\\": \\\"story-craft-profile.json\\\",\\n            \\\"to\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"purpose\\\": \\\"Craft tools T1 scene-sequel, T3 five commandments, T4 try-fail, T7 black moment, T12 dual-arc interleave shape plot structure\\\"\\n        },\\n        # Phase 4 → Phase 5\\n        {\\n            \\\"from\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"artifact\\\": \\\"plot/chapter-outlines.json\\\",\\n            \\\"to\\\": \\\"phase5-prose-style\\\",\\n            \\\"purpose\\\": \\\"Outline's pacing and emotional trajectory inform style guide's pacing rules and tonal variation\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"artifact\\\": \\\"plot/tension-map.json\\\",\\n            \\\"to\\\": \\\"phase5-prose-style\\\",\\n            \\\"purpose\\\": \\\"Tension map informs style guide's action vs. emotional scene pacing rules\\\"\\n        },\\n        # Phases 1-5 → Phase 6\\n        {\\n            \\\"from\\\": \\\"phase1-concept\\\",\\n            \\\"artifact\\\": \\\"story-concept.json\\\",\\n            \\\"to\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"purpose\\\": \\\"Concept's genre promise and tone palette guide prose production\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase2-world-building\\\",\\n            \\\"artifact\\\": \\\"world-bible/*.json\\\",\\n            \\\"to\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"purpose\\\": \\\"Chapter drafter references world details for accurate setting, magic use, cultural details\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase3-character-design\\\",\\n            \\\"artifact\\\": \\\"characters/*.json\\\",\\n            \\\"to\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"purpose\\\": \\\"Chapter drafter uses character voice guides, psychology, knowledge boundaries for POV accuracy\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase4-plot-architecture\\\",\\n            \\\"artifact\\\": \\\"plot/chapter-outlines.json\\\",\\n            \\\"to\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"purpose\\\": \\\"Each chapter is drafted following its outline (INV-010). Outline is the chapter's specification.\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase5-prose-style\\\",\\n            \\\"artifact\\\": \\\"style-guide.json\\\",\\n            \\\"to\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"purpose\\\": \\\"Style guide constrains prose: vocabulary, sentence rhythm, tone, POV voice variations\\\"\\n        },\\n        # Phase 6 → Phase 7 (with continuity tracker cross-cutting)\\n        {\\n            \\\"from\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"artifact\\\": \\\"chapters/chapter-*.md\\\",\\n            \\\"to\\\": \\\"phase7-revision\\\",\\n            \\\"purpose\\\": \\\"Draft chapters are the input to multi-pass revision\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase6-chapter-drafting\\\",\\n            \\\"artifact\\\": \\\"continuity-tracker.json\\\",\\n            \\\"to\\\": \\\"phase7-revision\\\",\\n            \\\"purpose\\\": \\\"Revision agents cross-reference continuity tracker for factual consistency\\\"\\n        },\\n        # Phase 7 → Phase 8\\n        {\\n            \\\"from\\\": \\\"phase7-revision\\\",\\n            \\\"artifact\\\": \\\"chapters/chapter-*.md (revised)\\\",\\n            \\\"to\\\": \\\"phase8-beta-reading\\\",\\n            \\\"purpose\\\": \\\"Revised chapters are read by 5 independent beta reader lenses\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase7-revision\\\",\\n            \\\"artifact\\\": \\\"revision/*.json\\\",\\n            \\\"to\\\": \\\"phase8-beta-reading\\\",\\n            \\\"purpose\\\": \\\"Beta readers can reference what was already found and fixed in revision\\\"\\n        },\\n        # Phase 8 → Phase 7 (re-entry loop)\\n        {\\n            \\\"from\\\": \\\"phase8-beta-reading\\\",\\n            \\\"artifact\\\": \\\"beta-reading/synthesis.json\\\",\\n            \\\"to\\\": \\\"phase7-revision (re-entry)\\\",\\n            \\\"purpose\\\": \\\"If synthesis verdict is re-enter-revision, critical/major findings trigger additional revision pass (INV-054). Bounded by maxCycles.\\\"\\n        },\\n        # Phase 8 → Phase 9\\n        {\\n            \\\"from\\\": \\\"phase8-beta-reading\\\",\\n            \\\"artifact\\\": \\\"beta-reading/synthesis.json\\\",\\n            \\\"to\\\": \\\"phase9-polish\\\",\\n            \\\"purpose\\\": \\\"Remaining minor findings and overall quality assessment inform final polish priorities\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase8-beta-reading\\\",\\n            \\\"artifact\\\": \\\"chapters/chapter-*.md (final revised)\\\",\\n            \\\"to\\\": \\\"phase9-polish\\\",\\n            \\\"purpose\\\": \\\"Final revised chapters receive last proofread and formatting pass\\\"\\n        },\\n        # Phase 9 → Series KB (cross-cutting)\\n        {\\n            \\\"from\\\": \\\"phase9-polish\\\",\\n            \\\"artifact\\\": \\\"delivery/chapter-summaries.json\\\",\\n            \\\"to\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"purpose\\\": \\\"Chapter summaries, resolved/unresolved threads, character arcs merged into series KB for sequel use\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"phase9-polish\\\",\\n            \\\"artifact\\\": \\\"delivery/book-metadata.json\\\",\\n            \\\"to\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"purpose\\\": \\\"Book metadata added to series KB's book list\\\"\\n        },\\n        # Series KB → Phase 1 (sequel lifecycle)\\n        {\\n            \\\"from\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"artifact\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"to\\\": \\\"phase1-concept (sequel)\\\",\\n            \\\"purpose\\\": \\\"For sequels: series KB loaded before concept phase. Provides canon, unresolved threads, character histories, naming registry (INV-049, INV-051, INV-059)\\\"\\n        }\\n    ],\\n\\n    \\\"multiWriterContracts\\\": [\\n        {\\n            \\\"artifact\\\": \\\"continuity-tracker.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-continuity-tracker\\\"],\\n            \\\"protocol\\\": \\\"Single-writer accumulator. Only the continuity-tracker agent writes this artifact. It reads the latest chapter, cross-references world-bible and characters, and appends/updates entries. Updated after every chapter draft (INV-011).\\\",\\n            \\\"mergeRules\\\": \\\"Append-only for timeline, characterKnowledge, establishedFacts. Update-in-place for characterPositions (latest state). Chekhov items transition: planted → growing → paid-off.\\\",\\n            \\\"lockingModel\\\": \\\"Sequential — only one chapter is in production at a time (INV-012), so no concurrent writes.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"chapters/chapter-{NNN}-metadata.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-developmental-editor\\\", \\\"romantic-fantasy-writer-line-editor\\\", \\\"romantic-fantasy-writer-copy-editor\\\", \\\"romantic-fantasy-writer-polish-agent\\\"],\\n            \\\"protocol\\\": \\\"Read-modify-write with field-level ownership. Each revision agent updates only its revisionStatus field and increments draftVersion. Drafter creates initial record.\\\",\\n            \\\"mergeRules\\\": \\\"Drafter owns: chapterId, chapterNumber, pov, scenes, craftToolCompliance. Each editor owns its revisionStatus sub-field. draftVersion is incremented by whichever agent last modified the chapter.\\\",\\n            \\\"lockingModel\\\": \\\"Sequential — revision passes run in strict order (developmental → line → copy → beta → polish), so no concurrent writes.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"series-knowledge-base.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\"],\\n            \\\"protocol\\\": \\\"Single-writer accumulator. The series-kb-manager is the sole writer. It merges current book's continuity data, character evolution, world changes into the series-level record at phase 9.\\\",\\n            \\\"mergeRules\\\": \\\"Append to books array, canon array, worldEvolution. Update characterEvolution map. Existing entries from prior books are immutable (INV-051). New entries may reference prior entries.\\\",\\n            \\\"lockingModel\\\": \\\"Runs once at end of pipeline. No concurrency.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"manifest.json\\\",\\n            \\\"writers\\\": [\\\"all agents\\\"],\\n            \\\"protocol\\\": \\\"Prepend-only audit log. Every agent prepends its entry to the top of the array after completing its task.\\\",\\n            \\\"mergeRules\\\": \\\"No modifications to existing entries. New entries always prepended (newest first). Each entry is self-contained.\\\",\\n            \\\"lockingModel\\\": \\\"Agents run sequentially within each phase (except 5 parallel beta readers). Beta readers each prepend independently — array order within that batch is non-deterministic but all entries are preserved.\\\"\\n        },\\n        {\\n            \\\"artifact\\\": \\\"progress.json\\\",\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\"],\\n            \\\"protocol\\\": \\\"Single-writer. Only the orchestrator updates pipeline progress. Read by coordinators for context.\\\",\\n            \\\"mergeRules\\\": \\\"Update phase status fields. currentPhase advances monotonically (except during re-entry). betaRevisionCycles increments on each beta→revision re-entry.\\\",\\n            \\\"lockingModel\\\": \\\"Orchestrator is single-threaded.\\\"\\n        }\\n    ],\\n\\n    \\\"acyclicityValidation\\\": {\\n        \\\"verified\\\": True,\\n        \\\"explanation\\\": \\\"The artifact dependency graph follows the 9-phase creative pipeline with strict forward flow: concept → world → characters → plot → style → chapters → revision → beta-reading → polish. The only backward edge is the bounded beta-reading → revision re-entry loop (INV-054), which is controlled by maxCycles and does not create a true dependency cycle — it is a re-execution of phase 7 with new inputs from phase 8, not a circular data dependency. Cross-cutting artifacts (continuity-tracker, series-knowledge-base) accumulate forward and are never dependencies of their own earlier state within the same production run.\\\",\\n        \\\"forwardEdges\\\": \\\"phase1→phase2→phase3→phase4→phase5→phase6→phase7→phase8→phase9→series-KB\\\",\\n        \\\"controlledReEntry\\\": \\\"phase8.synthesis.verdict=re-enter-revision → phase7 (bounded by maxCycles)\\\",\\n        \\\"crossBookEdge\\\": \\\"series-KB → phase1 (sequel only, across separate production runs)\\\"\\n    }\\n}\\n\\n# Update architecture.json\\narch['artifacts'] = artifacts\\narch['lastUpdated'] = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.000Z')\\n\\nwith open('.fractal-factory/architecture.json', 'w') as f:\\n    json.dump(arch, f, indent=2)\\n\\n# Count artifacts\\nuniversal_count = len(artifacts['universal'])\\ndomain_count = len(artifacts['domainSpecific'])\\nmulti_writer = len(artifacts['multiWriterContracts'])\\ndata_flows = len(artifacts['dataFlow'])\\n\\nprint(f\\\"✅ architecture.json updated\\\")\\nprint(f\\\"   Universal artifacts: {universal_count}\\\")\\nprint(f\\\"   Domain-specific artifacts: {domain_count}\\\")\\nprint(f\\\"   Multi-writer contracts: {multi_writer}\\\")\\nprint(f\\\"   Data flow edges: {data_flows}\\\")\\nprint(f\\\"   Total artifacts: {universal_count + domain_count}\\\")\\nPYEOF\", \"description\": \"Write artifacts section to architecture.json\", \"initial_wait\": 15}"
            }
