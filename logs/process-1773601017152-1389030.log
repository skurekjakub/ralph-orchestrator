        'INPUT=$(cat)\n' +
        '\n' +
        'LOG_DIR="/workspace/.ralph/logs"\n' +
        'SESSION_ID=$(cat "$LOG_DIR/.current-session-id" 2>/dev/null || echo "unknown")\n' +
        '\n' +
        '# Single jq call: extract all fields at once.\n' +
        `read -r TIMESTAMP ERROR_NAME <<< "$(echo "$INPUT" | jq -r '[.timestamp, (.error.name // "UnknownError")] | @tsv')"\n` +
