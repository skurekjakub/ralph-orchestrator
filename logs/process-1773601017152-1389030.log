        'INPUT=$(cat)\n' +
        '\n' +
        'LOG_DIR="/workspace/.ralph/logs"\n' +
        'SESSION_ID=$(cat "$LOG_DIR/.current-session-id" 2>/dev/null || echo "unknown")\n' +
        '\n' +
        `TIMESTAMP=$(echo "$INPUT" | jq -r '.timestamp')\n` +
        `PROMPT=$(echo "$INPUT" | jq -r '.prompt // ""')\n` +
        '\n' +
        '# Prompt can be very large — pass INPUT directly to jq to avoid shell variable limits.\n' +
        'jq -n -c \\\n' +
        '  --arg event "prompt" \\\n' +
        '  --arg ts "$TIMESTAMP" \\\n' +
        '  --arg session "$SESSION_ID" \\\n' +
        '  --arg prompt "$PROMPT" \\\n' +
        "  '{event: $event, timestamp: ($ts | tonumber), session: $session, prompt: $prompt}' \\\n" +
        '  >> "$LOG_DIR/audit.jsonl"\n' +
