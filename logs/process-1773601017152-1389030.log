              "arguments": "{\"path\": \"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/architecture.json\", \"old_str\": \"{\\n  \\\"version\\\": 1,\\n  \\\"lastUpdated\\\": null,\\n  \\\"pipeline\\\": null,\\n  \\\"artifacts\\\": null,\\n  \\\"depth\\\": null\\n}\", \"new_str\": \"{\\n  \\\"version\\\": 1,\\n  \\\"lastUpdated\\\": \\\"2026-03-15T20:45:00.000Z\\\",\\n  \\\"pipeline\\\": {\\n    \\\"designRationale\\\": \\\"All 7 universal passes are included because the romantic-fantasy-writer domain scores HIGH on every complexity axis: 17 subdomains (10 sequential creative phases + 7 cross-cutting concerns), 64 invariants (28 non-negotiable + 14 conditional craft tools + 22 workflow/structural), 25 reusable assets to integrate, and 20 exemplar patterns to follow. The produced system is a depth-3 creative pipeline (guide → orchestrator → 10+ phase coordinators → 50+ specialist agents) with writer-reviewer loops at every phase, sequential chapter production, 5-lens parallel beta reading, and series-first artifact management. No pass can be safely skipped.\\\",\\n    \\\"producedSystemOverview\\\": {\\n      \\\"description\\\": \\\"The romantic-fantasy-writer is a 9-phase creative pipeline with 7 cross-cutting systems, processing one story at a time from concept through publication-ready chapters\\\",\\n      \\\"creativePhases\\\": [\\n        { \\\"phase\\\": 1, \\\"name\\\": \\\"concept-development\\\", \\\"type\\\": \\\"sequential\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Distill raw inputs into crystallized story concept, premise, craft profile, constraints\\\" },\\n        { \\\"phase\\\": 2, \\\"name\\\": \\\"world-building\\\", \\\"type\\\": \\\"sequential-accumulator\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Construct fictional world in subcategorized artifacts (geography, magic, politics, culture, history, flora/fauna)\\\" },\\n        { \\\"phase\\\": 3, \\\"name\\\": \\\"character-design\\\", \\\"type\\\": \\\"sequential-accumulator\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Create full character profiles for leads, supporting cast, antagonists with psychological depth\\\" },\\n        { \\\"phase\\\": 4, \\\"name\\\": \\\"plot-architecture\\\", \\\"type\\\": \\\"sequential\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Select story structure framework, produce chapter-level outlines, tension map, subplot tracker\\\" },\\n        { \\\"phase\\\": 5, \\\"name\\\": \\\"prose-style-development\\\", \\\"type\\\": \\\"sequential\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Analyze reference fiction (if provided), produce style guide, tone palette, voice calibration\\\" },\\n        { \\\"phase\\\": 6, \\\"name\\\": \\\"chapter-drafting\\\", \\\"type\\\": \\\"sequential-per-chapter\\\", \\\"writerReviewerLoop\\\": true, \\\"description\\\": \\\"Write each chapter in sequence following outline, maintaining continuity tracking\\\" },\\n        { \\\"phase\\\": 7, \\\"name\\\": \\\"revision-editing\\\", \\\"type\\\": \\\"multi-pass-sequential\\\", \\\"writerReviewerLoop\\\": false, \\\"description\\\": \\\"Developmental edit → line edit → copy edit, each as separate specialist pass\\\" },\\n        { \\\"phase\\\": 8, \\\"name\\\": \\\"beta-reading-simulation\\\", \\\"type\\\": \\\"parallel-lenses\\\", \\\"writerReviewerLoop\\\": false, \\\"description\\\": \\\"5 independent reader lenses (romance, fantasy, craft, sensitivity, originality) producing findings\\\" },\\n        { \\\"phase\\\": 9, \\\"name\\\": \\\"polish-delivery\\\", \\\"type\\\": \\\"sequential\\\", \\\"writerReviewerLoop\\\": false, \\\"description\\\": \\\"Final proofread, chapter summaries, series knowledge base update, delivery packaging\\\" }\\n      ],\\n      \\\"crossCuttingSystems\\\": [\\n        { \\\"name\\\": \\\"adversarial-quality-gates\\\", \\\"scope\\\": \\\"phases 1-6\\\", \\\"description\\\": \\\"Adversarial auditors gate every creative phase with writer-reviewer loops (max retries from config)\\\" },\\n        { \\\"name\\\": \\\"continuity-tracking\\\", \\\"scope\\\": \\\"phases 6-9\\\", \\\"description\\\": \\\"Track character positions, timeline, knowledge matrix, Chekhov's guns across chapters\\\" },\\n        { \\\"name\\\": \\\"series-knowledge-management\\\", \\\"scope\\\": \\\"all phases + post-completion\\\", \\\"description\\\": \\\"Series knowledge base lifecycle: load for sequels, cross-reference during production, merge on completion\\\" },\\n        { \\\"name\\\": \\\"artifact-management\\\", \\\"scope\\\": \\\"all phases\\\", \\\"description\\\": \\\"Enforce subcategory decomposition, per-book directory structure, cross-reference integrity\\\" },\\n        { \\\"name\\\": \\\"genre-compliance\\\", \\\"scope\\\": \\\"phases 1-9\\\", \\\"description\\\": \\\"Enforce romantic fantasy genre conventions: dual-arc, HFN/HEA resolution, fantasy-first plot\\\" },\\n        { \\\"name\\\": \\\"craft-toolbox-framework\\\", \\\"scope\\\": \\\"phases 1-9\\\", \\\"description\\\": \\\"Two-tier quality: non-negotiable invariants always apply + selected craft tools from profile\\\" },\\n        { \\\"name\\\": \\\"originality-assurance\\\", \\\"scope\\\": \\\"phases 5-9\\\", \\\"description\\\": \\\"Zero-tolerance plagiarism enforcement, transformative influence only\\\" }\\n      ],\\n      \\\"keyPatterns\\\": {\\n        \\\"writerReviewerLoops\\\": \\\"Phases 1-6 use writer → adversarial-auditor loops with maxRetries from story config. Critical findings block phase completion (INV-052).\\\",\\n        \\\"sequentialChapterProduction\\\": \\\"Chapter N+1 cannot start until Chapter N is complete with continuity tracker updated (INV-012). This is the main throughput bottleneck.\\\",\\n        \\\"parallelBetaReading\\\": \\\"5 beta reader lenses are independent and CAN run in parallel (INV-053). Each produces a structured findings document. Synthesis agent aggregates.\\\",\\n        \\\"multiPassRevision\\\": \\\"3 separate revision passes (developmental, line, copy) run sequentially. Each produces per-chapter findings. Revision agent applies fixes with traceability (INV-014).\\\",\\n        \\\"seriesLifecycle\\\": \\\"Even standalone books create series knowledge base artifacts. Sequels load existing series KB and cross-reference throughout (INV-049, INV-051).\\\",\\n        \\\"craftToolboxConditional\\\": \\\"Invariants T1-T14 are conditionally applied based on the Story Craft Profile produced in concept/plotting. Auditors verify against selected tools only (INV-032, INV-063).\\\",\\n        \\\"betaToRevisionLoop\\\": \\\"Beta reading critical/major findings trigger re-entry to revision (INV-054). Bounded by maxGapCycles equivalent.\\\"\\n      }\\n    },\\n    \\\"passes\\\": [\\n      {\\n        \\\"pass\\\": 1,\\n        \\\"name\\\": \\\"discovery\\\",\\n        \\\"displayName\\\": \\\"Domain Discovery\\\",\\n        \\\"purpose\\\": \\\"Scan the romantic fantasy writing domain to produce a structured inventory of subdomains, invariants, reusable assets, and exemplar patterns that inform the full agent family design\\\",\\n        \\\"entryCondition\\\": \\\"Always first — context.json and domain-brief.md exist\\\",\\n        \\\"exitCondition\\\": \\\"All 4 discovery agents have status 'completed': domain-scanner (scanned), invariant-extractor (extracted), asset-auditor (audited), exemplar-analyzer (analyzed). domain-model.json contains all sections populated.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-discovery-coordinator\\\",\\n        \\\"estimatedAgents\\\": 4,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"domain-scanner\\\", \\\"invariant-extractor\\\", \\\"asset-auditor\\\", \\\"exemplar-analyzer\\\"],\\n        \\\"notes\\\": \\\"Discovery was complex because the domain spans 9 sequential creative phases and 7 cross-cutting concerns, requiring the scanner to identify both the linear production pipeline and the lateral quality systems. The invariant extractor found 64 rules including 14 conditional craft tools — the two-tier quality system (non-negotiable invariants + per-story craft tool selection) is a domain-specific pattern that must inform all downstream planning. Asset auditor found 25 reusable assets, many directly adaptable (writer-reviewer loops, multi-reviewer panels, revision workflows). Sequential execution because each agent builds on the previous one's additions to domain-model.json.\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"subdomainCount\\\": 17,\\n          \\\"invariantCount\\\": 64,\\n          \\\"assetCount\\\": 25,\\n          \\\"exemplarPatternCount\\\": 20,\\n          \\\"complexityDrivers\\\": [\\n            \\\"9-phase sequential creative pipeline with strict ordering dependencies\\\",\\n            \\\"7 cross-cutting concerns that run alongside the creative phases\\\",\\n            \\\"64 invariants including 14 conditional craft tools creating a two-tier quality system\\\",\\n            \\\"Series-first design requiring cross-book artifact management and consistency tracking\\\",\\n            \\\"5 independent parallel beta reader lenses with adversarial quality requirements\\\",\\n            \\\"Sequential chapter production creating the main throughput bottleneck\\\"\\n          ]\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 2,\\n        \\\"name\\\": \\\"analysis\\\",\\n        \\\"displayName\\\": \\\"Architecture Analysis\\\",\\n        \\\"purpose\\\": \\\"Design the pipeline structure, shared artifact schemas, and hierarchy depth for the produced romantic-fantasy-writer agent family based on domain model findings\\\",\\n        \\\"entryCondition\\\": \\\"Pass 1 (discovery) completed — domain-model.json fully populated with 17 subdomains, 64 invariants, 25 assets, 20 exemplar patterns\\\",\\n        \\\"exitCondition\\\": \\\"All 3 analysis agents have status 'completed': pipeline-architect (designed), artifact-designer (designed), depth-analyzer (analyzed). architecture.json contains pipeline, artifacts, and depth sections all populated.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-analysis-coordinator\\\",\\n        \\\"estimatedAgents\\\": 3,\\n        \\\"parallelizable\\\": true,\\n        \\\"agentSequence\\\": [\\\"pipeline-architect\\\", \\\"artifact-designer\\\", \\\"depth-analyzer\\\"],\\n        \\\"notes\\\": \\\"Analysis agents CAN run in parallel because they write to independent sections of architecture.json (pipeline, artifacts, depth). The pipeline architect must map the 9 creative phases + 7 cross-cutting concerns into the factory's understanding of what the produced system needs. The artifact designer must handle the complex subcategory decomposition (world-bible split into geography/magic/politics/culture/history, per-character files, per-chapter outlines). The depth analyzer faces a clear case for depth-3: guide → orchestrator → phase coordinators → specialist agents — 17 subdomains with 47 estimated agents across them cannot be flat.\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"pipelineComplexity\\\": \\\"HIGH — 9 sequential creative phases with strict dependencies, writer-reviewer loops at every phase, sequential chapter production, multi-pass revision, parallel beta reading\\\",\\n          \\\"artifactComplexity\\\": \\\"HIGH — deeply subcategorized artifacts (world split 6 ways, characters per-file, chapters per-file, revision per-pass-per-chapter), plus series-level accumulator artifacts\\\",\\n          \\\"depthDecision\\\": \\\"Almost certainly depth-3. The 17 subdomains with 47+ estimated specialist agents plus 10+ coordinators exceeds flat routing capacity. Guide → orchestrator → coordinators → specialists is the natural fit matching exemplar PATTERN-001.\\\",\\n          \\\"estimatedProducedAgents\\\": \\\"50-70 agents: 1 guide + 1 orchestrator + ~10 phase coordinators + ~40-55 specialist writers/reviewers/auditors + cross-cutting utility agents\\\"\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 3,\\n        \\\"name\\\": \\\"planning\\\",\\n        \\\"displayName\\\": \\\"Roster & Routing Planning\\\",\\n        \\\"purpose\\\": \\\"Design the complete agent roster (names, roles, hierarchy), routing tables for every coordinator, and golden test scenarios for the romantic-fantasy-writer family\\\",\\n        \\\"entryCondition\\\": \\\"Pass 2 (analysis) completed — architecture.json fully populated with pipeline, artifacts, and depth sections\\\",\\n        \\\"exitCondition\\\": \\\"All 3 planning agents have status 'completed': roster-planner (planned), routing-planner (planned), test-planner (planned). roster.json populated with all agents. Routing tables defined for every coordinator. test-plan.json populated.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-planning-coordinator\\\",\\n        \\\"estimatedAgents\\\": 3,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"roster-planner\\\", \\\"routing-planner\\\", \\\"test-planner\\\"],\\n        \\\"notes\\\": \\\"Sequential execution required: roster-planner must name all agents first (following romantic-fantasy-writer-{role-slug} convention from PATTERN-016), then routing-planner designs tables based on actual agent names, then test-planner creates scenarios using actual agents and routing. This is the heaviest planning pass because it must handle: (1) mapping 17 subdomains to ~60 agents with correct parent-child hierarchy, (2) designing writer-reviewer loop routing for 6 creative phases with maxRetries, (3) handling sequential chapter dispatch with continuity-tracker updates between chapters, (4) routing 5 parallel beta reader lenses through a synthesis agent, (5) designing re-entry from beta-reading back to revision, and (6) weaving 7 cross-cutting concerns into phase coordinators. Result codes must follow the three-tier vocabulary (PATTERN-015): orchestrator uses outcome verbs (published, published-with-issues, failed), coordinators use completion verbs (complete, blocked), specialists use domain verbs (drafted, revised, approved, needs-revision, consistent, inconsistent, resonant, flat).\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"rosterComplexity\\\": \\\"HIGH — ~60 agents across 4 hierarchy levels. Every creative phase needs at minimum a coordinator + writer + auditor. Chapter drafting needs per-chapter dispatch logic. Beta reading needs 5 lens agents + synthesizer.\\\",\\n          \\\"routingComplexity\\\": \\\"HIGH — writer-reviewer loops with maxRetries at phases 1-6, sequential chapter iteration at phase 6, multi-pass sequential revision at phase 7, parallel-then-synthesize at phase 8, re-entry from beta to revision bounded by gap cycles\\\",\\n          \\\"testComplexity\\\": \\\"MEDIUM — golden tests should cover: standalone book flow, sequel with series KB, all 5 beta lenses producing findings, writer-reviewer loop reaching maxRetries, gap hunting re-entry cycle\\\"\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 4,\\n        \\\"name\\\": \\\"execution\\\",\\n        \\\"displayName\\\": \\\"Prompt Writing & Review\\\",\\n        \\\"purpose\\\": \\\"Write all .agent.md prompt files for the romantic-fantasy-writer family, adversarially review each one, and write infrastructure (bootstrap scripts, artifact schemas, skills stubs)\\\",\\n        \\\"entryCondition\\\": \\\"Pass 3 (planning) completed — roster.json populated with all agents, routing tables defined, test-plan.json populated\\\",\\n        \\\"exitCondition\\\": \\\"All execution agents have status 'completed': prompt-writer (written — all prompts), prompt-reviewer (approved — all prompts pass review or maxRetries reached), infra-writer (written). All .agent.md files exist in produced output directory.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-execution-coordinator\\\",\\n        \\\"estimatedAgents\\\": 3,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"prompt-writer → prompt-reviewer (loop, max 10 retries)\\\", \\\"infra-writer\\\"],\\n        \\\"notes\\\": \\\"This is the longest pass. The prompt-writer and prompt-reviewer operate in a bounded feedback loop (maxWriterReviewerRetries=10 from context.json). The writer produces prompts following the universal template (PATTERN-010): YAML frontmatter → H1 role → Context → Process → Status Contract → Anti-Laziness (for reviewers). The reviewer applies adversarial anti-laziness rules (PATTERN-011) and the audit-chain accountability principle (PATTERN-012). Bottom-up generation order (PATTERN-020): specialists first, then coordinators, then orchestrator — ensures routing tables reference known result codes. The infra-writer runs after prompts are approved and produces: bootstrap script, artifact schema definitions (matching the subcategory decomposition), story-config.json template, and any skill stubs needed. Domain-specific execution challenges: (1) each creative-phase coordinator needs a full routing table with writer-reviewer loop handling, (2) the chapter-drafting coordinator needs per-chapter sequential dispatch, (3) beta-reading coordinator needs parallel-dispatch-then-synthesize routing, (4) cross-cutting concerns must be woven into relevant specialist prompts as skill references or inline rules.\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"promptCount\\\": \\\"50-70 prompts to write, each requiring domain-specific process sections tailored to the creative task\\\",\\n          \\\"reviewFocus\\\": \\\"Reviewer must verify: invariant coverage (all 64 invariants enforced by at least one agent), craft toolbox conditional enforcement, series knowledge base read-modify-write discipline, anti-plagiarism rules in all content-producing agents, adversarial depth in all reviewer/auditor agents\\\",\\n          \\\"infraScope\\\": \\\"Bootstrap script, story-config.json template, artifact directory scaffolding, subcategory file templates, continuity tracker schema, series KB merge logic\\\"\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 5,\\n        \\\"name\\\": \\\"verification\\\",\\n        \\\"displayName\\\": \\\"Quality Verification\\\",\\n        \\\"purpose\\\": \\\"Validate all produced prompts against the full structural and behavioral checklist, then perform deep compliance audit against agent-as-function and domain invariant requirements\\\",\\n        \\\"entryCondition\\\": \\\"Pass 4 (execution) completed — all .agent.md files written and reviewed, infra artifacts produced\\\",\\n        \\\"exitCondition\\\": \\\"Both verification agents have status 'completed': checklist-validator (verified), audit-oracle (audited). Verification report produced. If critical issues found, status includes findings for gap-hunting to process.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-verification-coordinator\\\",\\n        \\\"estimatedAgents\\\": 2,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"checklist-validator\\\", \\\"audit-oracle\\\"],\\n        \\\"notes\\\": \\\"Sequential execution: checklist-validator provides structural pass, then audit-oracle does deep behavioral analysis. The romantic fantasy writer domain demands unusually thorough verification because: (1) 64 invariants must be enforced — each invariant must be traceable to at least one agent that checks it, (2) the conditional craft toolbox (14 tools) must be correctly wired — agents must check selected tools only, not the full toolbox, (3) series knowledge management lifecycle must be complete (load → cross-reference → merge), (4) cross-cutting concerns (7 systems) must actually be referenced in relevant phase prompts, (5) the adversarial quality gates must form a genuine accountability chain (PATTERN-012) — no rubber-stamping. Verification must also check that the 5 beta reader lenses are truly independent (INV-053) and that all their findings flow to the revision re-entry path.\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"invariantCoverage\\\": \\\"All 64 invariants must map to at least one enforcing agent. Conditional invariants (T1-T14 craft tools) must reference the Story Craft Profile for activation.\\\",\\n          \\\"architecturalChecks\\\": \\\"Depth-3 hierarchy integrity, pure-router compliance for all coordinators, status.json contract for all agents, manifest.json prepend in all agents\\\",\\n          \\\"domainSpecificChecks\\\": \\\"Sequential chapter ordering enforcement, continuity tracker update after each chapter, 5-lens beta reading independence, series KB append-mostly discipline, dual-arc (fantasy + romance) presence in concept/plotting agents\\\"\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 6,\\n        \\\"name\\\": \\\"gapHunting\\\",\\n        \\\"displayName\\\": \\\"Gap Hunting & Convergence\\\",\\n        \\\"purpose\\\": \\\"Adversarially search for missing coverage, orphaned references, unenforced invariants, and architectural gaps across the entire produced agent family\\\",\\n        \\\"entryCondition\\\": \\\"Pass 5 (verification) completed — all prompts verified and audited\\\",\\n        \\\"exitCondition\\\": \\\"Gap hunter returns 'clean' (zero new items found) → converged. OR gap cycle count reaches maxGapCycles (10) → proceed to delivery with outstanding items flagged.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-gap-hunting-coordinator\\\",\\n        \\\"estimatedAgents\\\": 1,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"gap-hunter\\\"],\\n        \\\"notes\\\": \\\"Gap hunting is CRITICAL for this domain because of its layered complexity. The 8 search categories (PATTERN-013) adapted for this domain: (1) subdomain coverage — are all 17 subdomains represented by agents? (2) invariant enforcement — do all 64 invariants have at least one enforcing agent? (3) routing completeness — do all coordinators handle all child result codes? (4) artifact coverage — are all artifact directories from the domain brief represented in agent outputs? (5) cross-reference integrity — do agents that reference shared artifacts use consistent paths? (6) cross-cutting concern integration — are all 7 cross-cutting systems actually wired into relevant phases? (7) series lifecycle completeness — does the load→reference→merge path work? (8) beta-to-revision re-entry — does the findings→revision→re-read loop have proper routing? Each dirty finding increments the cycle counter and triggers re-entry to the earliest affected pass. The romantic fantasy domain is likely to need 2-3 gap cycles because of the craft toolbox conditional invariants (easy to miss wiring T1-T14 to auditor prompts) and the series knowledge management lifecycle (easy to forget merge-on-completion step).\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"likelyGapAreas\\\": [\\n            \\\"Craft toolbox conditional invariants (T1-T14) not wired to auditor prompts for the selected-tools-only check\\\",\\n            \\\"Series knowledge base merge step missing from polish-delivery agents\\\",\\n            \\\"Continuity tracker not updated between every chapter (INV-011 enforcement gap)\\\",\\n            \\\"Cross-cutting concerns referenced in coordinator notes but not actually embedded in specialist prompts\\\",\\n            \\\"Beta reader synthesis agent missing routing to trigger revision re-entry\\\",\\n            \\\"Killed-darlings tracking (INV-043 T11) missing from revision agents\\\"\\n          ],\\n          \\\"convergenceExpectation\\\": \\\"2-4 cycles for clean convergence based on domain complexity. The conditional craft toolbox and series lifecycle are the most likely sources of gaps.\\\"\\n        }\\n      },\\n      {\\n        \\\"pass\\\": 7,\\n        \\\"name\\\": \\\"delivery\\\",\\n        \\\"displayName\\\": \\\"Packaging & Delivery\\\",\\n        \\\"purpose\\\": \\\"Package the complete romantic-fantasy-writer agent family into the output directory, write architecture documentation, and produce the final delivery report with quality metrics\\\",\\n        \\\"entryCondition\\\": \\\"Pass 6 (gap hunting) converged OR maxGapCycles reached. All prompts, infra, and verification artifacts are final.\\\",\\n        \\\"exitCondition\\\": \\\"All 3 delivery agents have status 'completed': packager (packaged), documentation-writer (documented), report-writer (reported). Output directory contains the complete agent family ready for deployment.\\\",\\n        \\\"coordinatorHint\\\": \\\"fractal-factory-delivery-coordinator\\\",\\n        \\\"estimatedAgents\\\": 3,\\n        \\\"parallelizable\\\": false,\\n        \\\"agentSequence\\\": [\\\"packager\\\", \\\"documentation-writer\\\", \\\"report-writer\\\"],\\n        \\\"notes\\\": \\\"Sequential execution: packager assembles files first, documentation-writer references packaged structure, report-writer summarizes everything. The romantic fantasy writer delivery is substantial: (1) packager must organize 50-70 .agent.md files plus infrastructure into the output directory with correct directory structure matching the depth-3 hierarchy, (2) documentation must cover: the 9-phase creative pipeline, all 7 cross-cutting systems, the writer-reviewer loop pattern, sequential chapter dispatch, 5-lens beta reading, series lifecycle, and the craft toolbox selection mechanism, (3) the report must include: agent count, invariant coverage metrics, gap hunting cycle history, verification findings summary, and any outstanding items from maxCycles-bounded delivery. The documentation is especially important because the romantic-fantasy-writer is a complex domain system — operators need to understand the creative pipeline, the quality gate system, and the series knowledge management lifecycle.\\\",\\n        \\\"domainInsights\\\": {\\n          \\\"deliverableCount\\\": \\\"50-70 agent prompts + bootstrap script + story-config template + artifact schemas + architecture docs + user guide + delivery report\\\",\\n          \\\"documentationScope\\\": \\\"Must explain: how to configure a new story, how the creative pipeline flows, how adversarial gates work, how series knowledge accumulates, how the craft toolbox selection mechanism works, how to run a sequel\\\"\\n        }\\n      }\\n    ],\\n    \\\"reEntryRules\\\": [\\n      {\\n        \\\"trigger\\\": \\\"Gap hunter finds invariants not enforced by any agent or cross-cutting concerns missing from phase prompts\\\",\\n        \\\"reEntryPass\\\": 2,\\n        \\\"resetPasses\\\": [2, 3, 4, 5, 6],\\n        \\\"maxReEntries\\\": 2,\\n        \\\"rationale\\\": \\\"Architecture-level gaps (missing artifact schemas, incorrect depth decisions, unmodeled cross-cutting concerns) require re-analysis before roster and prompt changes can be planned\\\"\\n      },\\n      {\\n        \\\"trigger\\\": \\\"Gap hunter finds missing agents in roster, incomplete routing tables, or unhandled result codes\\\",\\n        \\\"reEntryPass\\\": 3,\\n        \\\"resetPasses\\\": [3, 4, 5, 6],\\n        \\\"maxReEntries\\\": 3,\\n        \\\"rationale\\\": \\\"Roster or routing gaps require re-planning before prompts can be updated. Most common trigger: writer-reviewer loop handling for a phase missing the re-dispatch routing\\\"\\n      },\\n      {\\n        \\\"trigger\\\": \\\"Gap hunter finds prompt-level issues: missing invariant enforcement, incorrect artifact references, or shallow anti-laziness rules\\\",\\n        \\\"reEntryPass\\\": 4,\\n        \\\"resetPasses\\\": [4, 5, 6],\\n        \\\"maxReEntries\\\": 5,\\n        \\\"rationale\\\": \\\"Most gap-hunting findings will be prompt-level: a craft tool not mentioned in an auditor's checklist, a continuity-tracker update step missing from the chapter-drafter's process, or a beta reader lens not covering a required check. These are fixed by re-entering execution (prompt-writer updates → prompt-reviewer re-reviews)\\\"\\n      },\\n      {\\n        \\\"trigger\\\": \\\"Verification finds critical structural violations (pure-router breach, status contract violation, missing manifest prepend)\\\",\\n        \\\"reEntryPass\\\": 4,\\n        \\\"resetPasses\\\": [4, 5],\\n        \\\"maxReEntries\\\": 2,\\n        \\\"rationale\\\": \\\"Structural violations in prompts require re-writing and re-verification but do not invalidate the roster or routing plan\\\"\\n      }\\n    ],\\n    \\\"convergence\\\": {\\n      \\\"maxGapCycles\\\": 10,\\n      \\\"convergenceSignal\\\": \\\"Gap hunter returns zero new items across all 8 search categories\\\",\\n      \\\"limitBehavior\\\": \\\"Proceed to delivery with outstanding items flagged in the delivery report as 'known gaps — recommended for manual review'. The report-writer must list every unresolved finding with its category and severity.\\\",\\n      \\\"expectedCycles\\\": \\\"2-4 cycles for full convergence based on domain complexity analysis. The conditional craft toolbox (14 tools requiring per-story activation wiring) and series knowledge lifecycle (load→reference→merge across 9 phases) are the most likely sources of multi-cycle gap findings.\\\",\\n      \\\"cycleEscalation\\\": \\\"If cycles 1-3 find gaps primarily in pass 4 (prompts), cycles 4+ finding pass 3 (routing) gaps indicates a deeper planning issue. The gap-hunting coordinator should flag this pattern in its status summary.\\\"\\n    }\\n  },\\n  \\\"artifacts\\\": null,\\n  \\\"depth\\\": null\\n}\"}"
            }
          }
