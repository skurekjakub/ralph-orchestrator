            "function": {
              "name": "bash",
              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json\\nfrom datetime import datetime, timezone\\n\\n# Load existing domain model\\nwith open('.fractal-factory/domain-model.json', 'r') as f:\\n    model = json.load(f)\\n\\n# All subdomain IDs for \\\"global\\\" invariants\\nALL_SDS = [f\\\"SD-{i:03d}\\\" for i in range(1, 18)]\\n\\ninvariants = []\\n\\n# ============================================================\\n# PART 1: EXPLICIT INVARIANTS from invariants.md (confidence 0.9-1.0)\\n# ============================================================\\n\\n# --- Narrative Invariants (behavioral) ---\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-001\\\",\\n    \\\"description\\\": \\\"Genre Promise: Every story MUST be romantic fantasy — fantasy plot arc primary, romance arc as emotional spine. Neither arc may be absent. Romance must reach at minimum HFN resolution.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I1 (line 17)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\", \\\"SD-015\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify concept doc specifies both arcs; verify outline contains both fantasy and romance beat columns; verify final chapters contain romance resolution (HFN/HEA); beta romance-reader lens confirms arc presence.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-002\\\",\\n    \\\"description\\\": \\\"Internal Consistency: All worldbuilding details (magic rules, geography, politics, culture, character knowledge) MUST remain internally consistent across every artifact and chapter. For sequels, consistency extends across books via the series knowledge base.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I2 (line 20)\\\",\\n    \\\"affectedSubdomains\\\": ALL_SDS[:],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference every factual claim in chapters against world bible, continuity tracker, and series KB. Flag any contradiction between artifacts or between chapters.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-003\\\",\\n    \\\"description\\\": \\\"Character Voice Distinctness: Each POV character MUST have a recognizably distinct internal voice — vocabulary, sentence rhythm, emotional register, thought patterns. Indistinguishable POV voices are a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I3 (line 23)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Strip character names from POV passages and verify distinguishability. Compare vocabulary/rhythm metrics per POV character across chapters. Voice consistency checker compares against voice guides.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-004\\\",\\n    \\\"description\\\": \\\"Earned Emotional Beats: Every major emotional beat (first kiss, betrayal, sacrifice, reconciliation) MUST be preceded by sufficient buildup. No emotional payoff without prior investment. Beta reader simulation must flag unearned beats.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I4 (line 26)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\", \\\"SD-015\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each major emotional beat in the manuscript, trace back through preceding chapters to verify buildup scenes exist. Beta readers flag any beat that feels unearned.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-005\\\",\\n    \\\"description\\\": \\\"Show Don't Tell (for emotions): Character emotions MUST be conveyed primarily through action, dialogue, physical sensation, and internal reaction — not narrator declarations. Telling acceptable only for background summary or time-skips, never for key emotional moments.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I5 (line 29)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Scan prose for narrator-declared emotions in key scenes (e.g., 'she was sad', 'he felt angry'). Flag instances in emotional climax scenes. Prose quality floor enforces max 3 told emotions per chapter.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-006\\\",\\n    \\\"description\\\": \\\"Chekhov's Gun: Every significant element introduced (artifact, secret, prophecy, weapon, tension) MUST pay off or be explicitly tagged as series setup. Dangling threads without purpose are failures. Series-tagged threads exempt from single-book payoff but MUST be tracked.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I6 (line 32)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-012\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference promises tracker: every planted element must have a payoff entry or a series-setup tag. Flag any element in the tracker with status 'open' that is not tagged for sequel resolution.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-007\\\",\\n    \\\"description\\\": \\\"No Info-Dumping: Worldbuilding exposition MUST be woven into action, dialogue, and character experience. No paragraphs of raw encyclopedic information. One-page rule: no more than one paragraph of pure exposition before returning to scene.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I7 (line 35)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Scan chapters for contiguous exposition paragraphs exceeding one paragraph. Flag blocks of worldbuilding not embedded in scene action or character experience.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-008\\\",\\n    \\\"description\\\": \\\"Character Agency: Both romantic leads MUST have agency — making active choices that drive the story. Neither lead may be passive, repeatedly rescued without contributing, or reduced to only reacting without initiating.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I8 (line 38)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-015\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each romantic lead, count scenes where they initiate action vs. merely react. Verify both leads have roughly equal agency counts. Flag any lead with fewer than 30% initiative scenes.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-009\\\",\\n    \\\"description\\\": \\\"No Deus Ex Machina: Magic rules or abilities not established before needed MUST NOT resolve conflict. Every resolution uses only previously demonstrated capabilities or character qualities. New abilities to solve immediate problems are critical failures. Applies to non-magical resolutions too.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I9 (line 41)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"For every conflict resolution, verify the capability/resource used was established in a prior chapter or world bible entry. Flag any resolution relying on previously unmentioned abilities.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Structural Invariants ---\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-010\\\",\\n    \\\"description\\\": \\\"Outline Before Draft: No chapter may be drafted until a chapter-level outline exists specifying POV, scene goal, conflict, emotional arc, and which romance/fantasy beats the chapter hits.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I10 (line 46)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Before each chapter draft begins, verify corresponding chapter outline file exists with required fields (POV, goal, conflict, emotional arc, beats). Block drafting if outline is missing.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-011\\\",\\n    \\\"description\\\": \\\"Continuity Tracking: A continuity document MUST be updated after every chapter draft, tracking character locations, timeline, character knowledge, reader promises, and open plot threads. For sequels, extends series-level tracker.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I11 (line 49)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-012\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"After each chapter draft, verify continuity tracker has been updated with new entries. Check that tracker contains current character positions, timeline, and knowledge state.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-012\\\",\\n    \\\"description\\\": \\\"Sequential Chapter Production: Chapters MUST be produced in sequence. Chapter N+1 cannot be drafted until Chapter N is complete and its continuity implications are recorded.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I12 (line 52)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify chapter files are created in strict numerical order. Confirm continuity tracker is updated for chapter N before chapter N+1 drafting begins.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-013\\\",\\n    \\\"description\\\": \\\"Multi-Pass Review (Exhaustive): Every chapter MUST pass at minimum: developmental review, line edit, consistency check, AND multi-perspective beta read. No chapter reaches 'final' status without all passes. All critical and major findings must be resolved.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I13 (line 55)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-010\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each chapter, verify existence of developmental, line-edit, copy-edit, and beta-feedback artifacts. Verify all critical/major findings in those artifacts have resolution entries in the revision log.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-014\\\",\\n    \\\"description\\\": \\\"Revision Traceability: Every revision must cite what feedback or finding prompted it. No changes without justification. The revision history must be auditable.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14 (line 58)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Examine revision-log.md entries: every revision entry must contain a citation to the specific finding (by ID or description) that prompted it. Flag any revision without a justification link.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-015\\\",\\n    \\\"description\\\": \\\"Voice Consistency Verification: At verification phase, every POV character's chapters must be compared for voice consistency — vocabulary, sentence patterns, emotional register, thought patterns. Drift must be flagged and corrected. For sequels, compare against prior-book voice guide.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14a (line 61)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-004\\\"],\\n    \\\"verificationStrategy\\\": \\\"Run voice comparison analysis across all chapters for each POV character. Compare against established voice guide. Flag statistically significant drift in vocabulary, rhythm, or register.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-016\\\",\\n    \\\"description\\\": \\\"Continuity Verification (Exhaustive): Verification phase must cross-reference EVERY factual claim in manuscript against continuity tracker — locations, timeline, character knowledge, descriptions, names, titles, world rules, magic, politics. For sequels, extends to series KB. Every discrepancy is a finding.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14b (line 64)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"Systematically extract factual claims from each chapter and cross-reference against continuity tracker and world bible. Generate discrepancy report with chapter/line references.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-017\\\",\\n    \\\"description\\\": \\\"Prose Quality Floor: No chapter passes verification if it contains: more than 2 cliché fantasy prose instances, more than 3 told-not-shown emotions in key scenes, or more than 5 bland/generic sentences. The prose quality auditor must flag these specifically.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14c (line 67)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Count cliché instances (e.g., 'orbs' for eyes, breath-holding), told emotions in key scenes, and bland generic sentences per chapter. Block chapter if any threshold exceeded.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Quality Invariants ---\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-018\\\",\\n    \\\"description\\\": \\\"No Anachronisms: Characters must not reference concepts, technologies, or idioms that don't exist in their world unless worldbuilding explicitly includes them. Modern slang in a medieval fantasy court is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I15 (line 72)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Scan dialogue and narration for modern idioms, technology references, or concepts not established in world bible. Cross-reference against world's established technology/culture level.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-019\\\",\\n    \\\"description\\\": \\\"Dialogue Naturalism: Dialogue must sound like speech — characters interrupt, trail off, use contractions, disagree, talk past each other. Perfectly articulate philosophical monologues from every character is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I16 (line 75)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Audit dialogue passages for naturalism markers: contractions, interruptions, incomplete sentences, disagreements. Flag monologue-heavy exchanges or uniformly articulate speech patterns.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-020\\\",\\n    \\\"description\\\": \\\"Pacing Variation: Story must alternate between high-tension and low-tension scenes. Three consecutive high-action chapters without recovery, or three consecutive slow chapters without rising tension, constitutes a pacing failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I17 (line 78)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Map tension level per chapter/scene across full manuscript. Flag any sequence of 3+ consecutive chapters at same tension level (all high or all low).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-021\\\",\\n    \\\"description\\\": \\\"Romance Arc Pacing: Romance must escalate through stages: awareness → attraction → tension → vulnerability → setback → deepening → commitment. Skipping stages (e.g., strangers to 'I love you' in two chapters) is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I18 (line 81)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-015\\\"],\\n    \\\"verificationStrategy\\\": \\\"Map romance arc beats per chapter against the required progression stages. Verify each stage is represented and no stage is skipped. Flag compressed progressions.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-022\\\",\\n    \\\"description\\\": \\\"Antagonist Motivation: The antagonist MUST have comprehensible motivations. 'Evil for evil's sake' is only acceptable if story explicitly explores why (corruption, trauma, ideology). Cardboard villains are failures.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I19 (line 84)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify antagonist character file contains explicit motivation. Check that manuscript scenes reveal or imply that motivation. Flag antagonists whose actions lack discernible rationale.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Originality Invariants ---\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-023\\\",\\n    \\\"description\\\": \\\"No Plagiarism — Zero Tolerance: All prose, dialogue, names, magic mechanics, and plot structures MUST be entirely original. Nothing may be quotable from or closely paraphraseable of any existing published work. Reference materials are for stylistic analysis ONLY, never content reproduction.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I20 (line 89)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-009\\\", \\\"SD-017\\\"],\\n    \\\"verificationStrategy\\\": \\\"Originality reader lens scans all prose for close similarity to known works. Flag any passage that could be attributed to an existing work. Cross-reference character names and world elements against published fiction.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-024\\\",\\n    \\\"description\\\": \\\"Transformative Influence Only: When style samples are provided, extract only abstract patterns (sentence length, vocabulary register, metaphor density, POV style). NEVER reproduce specific metaphors, turns of phrase, character archetypes with identifying details, plot beats in same sequence, or distinctive world elements.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I21 (line 92)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-017\\\"],\\n    \\\"verificationStrategy\\\": \\\"Review style guide for abstract-only patterns. Compare prose against reference material for specific metaphor/phrase reproduction. Verify style analysis cites structural patterns, not content.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-025\\\",\\n    \\\"description\\\": \\\"Originality Self-Audit: Beta reading phase MUST include an originality check that flags any passage, character, plot element, or world detail that too closely resembles a known published work, citing the specific similarity and source work.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I22 (line 95)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-009\\\", \\\"SD-017\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify originality reader lens exists in beta reading phase. Check that its output contains explicit similarity citations with source work references for any flagged items.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Process Invariants ---\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-026\\\",\\n    \\\"description\\\": \\\"Adversarial Phase Gates: Every creative phase (Concept, Worldbuilding, Character, Plotting, Style, Drafting) MUST include an adversarial consistency audit BEFORE phase completion. Auditor cross-references against ALL prior artifacts. Critical findings block phase completion. No phase may skip its gate.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I23 (line 99)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-003\\\", \\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify each phase produces an adversarial audit report before marking complete. Check audit cross-references prior artifacts. Confirm no critical findings remain unresolved at phase completion.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-027\\\",\\n    \\\"description\\\": \\\"Input Consumption: When reference stories or style samples are provided, the style analysis agent MUST produce a concrete style guide derived from those inputs, citing specific abstract patterns observed. Ignoring provided inputs is a failure.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I24 (line 103)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\", \\\"SD-006\\\"],\\n    \\\"verificationStrategy\\\": \\\"When style samples are present in story-config, verify style guide artifact references them. Check that reference-analysis.md cites specific abstract patterns extracted from each input.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-028\\\",\\n    \\\"description\\\": \\\"Artifact Cross-References: Every artifact must reference its upstream dependencies. Outline references character/world bibles. Draft references outline. Revision notes reference draft and style guide. Orphan artifacts are failures.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I25 (line 106)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-003\\\", \\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each artifact, verify it contains explicit references (file paths or links) to its upstream dependencies. Flag any artifact without upstream references as orphan.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-029\\\",\\n    \\\"description\\\": \\\"No Silent Failures: If an agent cannot complete its task, it MUST surface the problem explicitly rather than producing low-quality output. A clearly flagged problem statement is better than a silently broken story.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I26 (line 109)\\\",\\n    \\\"affectedSubdomains\\\": ALL_SDS[:],\\n    \\\"verificationStrategy\\\": \\\"Verify every agent's output includes a status/quality self-assessment. Check that no agent produces output with known unresolved issues without explicitly flagging them.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-030\\\",\\n    \\\"description\\\": \\\"Scope Fidelity: System must produce what was specified in concept phase. If concept says standalone, 20 chapters, enemies-to-lovers, dark tone — output must match. Scope drift without re-approval is a failure.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I27 (line 112)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Compare final output against concept/constraints artifacts: chapter count, trope, tone, standalone/series, heat level. Flag any deviation not explicitly approved in revision log.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-031\\\",\\n    \\\"description\\\": \\\"Series Artifact Isolation & Subcategory Decomposition: Every book's artifacts organized under book-level directory. Series KB at series root as single cross-book truth source. Per-book artifacts MUST NOT directly reference another book's internals. Content decomposed into subcategory files within typed directories, not monolithic files. Cross-references use relative file paths.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I28 (line 115)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-013\\\", \\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify directory structure matches book-N/ isolation pattern. Check no cross-book direct references. Verify artifacts are split into subcategory files. Confirm cross-references use relative paths.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# PART 2: CRAFT TOOLBOX FRAMEWORK & TOOLS (confidence 0.9)\\n# ============================================================\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-032\\\",\\n    \\\"description\\\": \\\"Craft Toolbox Selection Framework: During Concept and Plotting, system must select 5-8 craft tools per story and record selection in a Story Craft Profile artifact with rationale. Once selected, tools are binding for that story. Auditors verify against selected toolset, not full toolbox.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, Part 2 introduction (lines 119-123)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-005\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify Story Craft Profile exists with 5-8 selected tools, each with rationale. Verify auditor reports reference selected profile, not the full toolbox.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-033\\\",\\n    \\\"description\\\": \\\"Craft Tool T1 — Scene-Sequel Structure (Swain): When selected, scenes follow Goal → Conflict → Disaster; Sequels follow Reaction → Dilemma → Decision. Best for action-driven narratives. May be loosened for introspective/lyrical passages.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T1 (line 128)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected in craft profile, verify action/plot scenes follow Scene-Sequel structure. Auditor checks each scene for Goal/Conflict/Disaster or Reaction/Dilemma/Decision pattern.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-034\\\",\\n    \\\"description\\\": \\\"Craft Tool T2 — Scene Value Shifts (Story Grid): When selected, every scene must shift at least one value (emotional, relational, informational, situational) from beginning to end. Dead scenes where nothing changes are failures.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T2 (line 131)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, annotate each scene's opening and closing value states. Flag any scene where no value has shifted. Allow rare exception for transitional/bridging scenes.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-035\\\",\\n    \\\"description\\\": \\\"Craft Tool T3 — Five Commandments Per Scene (Story Grid): When selected, every scene contains Inciting Incident, Turning Point Progressive Complication, Crisis, Climax, and Resolution. May be loosened for quiet character moments or atmospheric interludes.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T3 (line 134)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, verify each major scene contains all five commandments. Auditor identifies each element. Flag scenes missing commandments (except designated quiet/atmospheric scenes).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-036\\\",\\n    \\\"description\\\": \\\"Craft Tool T4 — Try-Fail Cycles: When selected, characters must fail before succeeding at significant challenges. Major problems require at minimum two failed approaches before solution. Each failure teaches something.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T4 (line 137)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, identify major challenges in plot and verify at least two failed attempts precede success. Check that failures provide learning/growth. Flag instant successes.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-037\\\",\\n    \\\"description\\\": \\\"Craft Tool T5 — Tone Contract: When selected, opening chapters establish a tonal promise honored throughout. Tonal shifts must be gradual, motivated, and consistent with story identity.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T5 (line 142)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, characterize tone of opening chapters. Compare each subsequent chapter's tone against the established baseline. Flag abrupt unmotivated tonal shifts.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-038\\\",\\n    \\\"description\\\": \\\"Craft Tool T6 — Stakes Escalation: When selected, stakes escalate through each act — characters risk more in Act 3 than Act 1, both in fantasy arc and romance arc.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T6 (line 145)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, map stakes per act for both fantasy and romance arcs. Verify escalation from act to act. Flag any act where stakes decrease without narrative justification.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-039\\\",\\n    \\\"description\\\": \\\"Craft Tool T7 — The Black Moment: When selected, story must include a devastating 'all is lost' point where romance seems doomed and fantasy plot appears lost. Must feel genuinely threatening. Adjustable for multiple romantic pairs or cozy fantasy.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T7 (line 148)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-015\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, identify the Black Moment in the manuscript. Verify it threatens both romance and fantasy arcs. Beta romance reader confirms it feels genuinely devastating.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-040\\\",\\n    \\\"description\\\": \\\"Craft Tool T8 — Internal Romantic Resistance: When selected, obstacles between leads include internal resistance — fear, wounds, conflicting beliefs, trust issues. At least half of major romantic obstacles should be internal/psychological.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T8 (line 151)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-015\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, categorize romantic obstacles as internal vs. external. Verify at least 50% are internal/psychological. Flag stories with only external obstacles.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-041\\\",\\n    \\\"description\\\": \\\"Craft Tool T9 — Subtext in Dialogue: When selected, characters rarely say exactly what they mean in charged scenes. Dialogue carries subtext — what's unsaid matters as much as spoken. Exception: climactic revelations where directness IS the payoff.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T9 (line 154)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, audit dialogue in charged/emotional scenes for subtext presence. Flag on-the-nose emotional declarations in non-climactic scenes. Verify directness is reserved for payoff moments.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-042\\\",\\n    \\\"description\\\": \\\"Craft Tool T10 — Sanderson's First Law (Magic Clarity): When selected, the ability to solve conflict with magic is proportional to reader understanding of said magic. Hard magic needs clear rules; soft magic shouldn't solve problems.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T10 (line 157)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, classify magic system as hard/soft. For hard magic, verify rules are established before any magic-based resolution. For soft magic, verify conflict resolution comes from character choices not magical convenience.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-043\\\",\\n    \\\"description\\\": \\\"Craft Tool T11 — Kill Your Darlings: When selected, every revision pass actively hunts for 'darlings' — passages or elements that are beautiful/clever but don't serve the story. Flagged darlings moved to killed-darlings file, not deleted.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T11 (line 160)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, verify revision reports include darling-hunting findings. Check killed-darlings.md file exists and contains removed passages. Verify flagged darlings were actually removed from manuscript.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-044\\\",\\n    \\\"description\\\": \\\"Craft Tool T12 — Dual-Arc Interleave: When selected, fantasy plot arc and romance arc are plotted in parallel with key beats reinforcing or complicating each other. Fantasy crises must also be romantic inflection points or vice versa.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T12 (line 166)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-011\\\", \\\"SD-015\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, map fantasy and romance beats per chapter. Verify key beats intersect — at least major turning points affect both arcs. Flag arcs that run independently without intersection.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-045\\\",\\n    \\\"description\\\": \\\"Craft Tool T13 — Tension Mapping: When selected, a visual/textual pacing chart shows tension rise-and-fall across all chapters. Used during plotting to ensure proper rhythm and avoid flat stretches.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T13 (line 169)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\", \\\"SD-008\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, verify tension-map.md artifact exists in outline directory. Check it covers all chapters with tension ratings. Flag flat stretches of 3+ chapters at same level.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-046\\\",\\n    \\\"description\\\": \\\"Craft Tool T14 — Scene-Sequel MRU (Motivation-Reaction Units): When selected, at sentence/paragraph level: external stimulus (Motivation) followed by character response (Reaction) in order Feeling → Reflex → Rational Action. Best for action/high-tension scenes.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T14 (line 172)\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected, audit action/high-tension scenes for MRU pattern compliance. Verify stimulus precedes response. Check reaction order (Feeling → Reflex → Rational) in key sequences.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# PART 3: IMPLICIT INVARIANTS from domain-brief.md (confidence 0.6-0.8)\\n# ============================================================\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-047\\\",\\n    \\\"description\\\": \\\"Guide Agent Sole Entry Point: The guide agent is the ONLY agent that interacts with the user. All other agents in the pipeline are fully autonomous with no user interaction.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 49-57\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify only the guide agent has user-interaction capabilities. Confirm all other agents operate without user prompts or confirmations.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-048\\\",\\n    \\\"description\\\": \\\"Story Config Before Pipeline Launch: A story-config.json (or equivalent) capturing all user inputs must be written and confirmed before the autonomous pipeline launches.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 52-55\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\", \\\"SD-002\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify story-config.json exists before any pipeline phase begins. Check it contains all required fields (story idea at minimum) and any optional inputs provided.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-049\\\",\\n    \\\"description\\\": \\\"Series-First Design: System must be designed for series production from day one, even if first invocation is standalone. All generated knowledge organized to enable seamless sequel creation.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 224-225\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-010\\\", \\\"SD-013\\\", \\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify series directory structure exists even for standalone stories. Confirm book-summary agent promotes canonical facts to series KB on completion regardless of standalone/series setting.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-050\\\",\\n    \\\"description\\\": \\\"Minimum Viable Input: The system must produce a complete story from just a story idea (premise). All other inputs (style samples, mood, character sketches, world fragments, constraints) are optional enrichment.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 44\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\", \\\"SD-002\\\"],\\n    \\\"verificationStrategy\\\": \\\"Test system with only a one-line story idea and no optional inputs. Verify it produces a complete output with sensible defaults filled in for all unspecified parameters.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-051\\\",\\n    \\\"description\\\": \\\"Append-Mostly Series Knowledge Base: Facts established in prior books cannot be silently contradicted in sequels. Retcons must be narratively justified (unreliable narrator revealed, new information discovered) and explicitly documented.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 358-359\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-012\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels, diff series KB before and after book completion. Flag any modifications to previously established facts. Verify any changes include narrative justification documentation.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-052\\\",\\n    \\\"description\\\": \\\"Critical Findings Block Phase Completion: Adversarial auditor critical findings MUST block phase completion. The phase's specialist must address all criticals before the coordinator marks the phase done.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"domain-brief.md, lines 67-68\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-003\\\", \\\"SD-004\\\", \\\"SD-005\\\", \\\"SD-006\\\", \\\"SD-007\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify no phase transitions from 'in-progress' to 'complete' while critical findings remain unresolved. Check auditor report criticals are all marked resolved before phase completion.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-053\\\",\\n    \\\"description\\\": \\\"Five Independent Beta Reader Lenses: Beta reading must operate as 5 independent reviewer perspectives — Romance Reader, Fantasy Reader, Craft Reader, Sensitivity Reader, and Originality Reader — each producing structured severity-rated findings.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 178-215\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify 5 separate beta feedback artifacts exist (one per lens). Confirm each uses the structured severity rating system (critical/major/minor/suggestion). Verify findings are independent (no cross-contamination).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-054\\\",\\n    \\\"description\\\": \\\"All Critical and Major Beta Findings Must Be Addressed: Beta reading findings rated critical or major MUST be addressed in a revision pass before the chapter is considered complete.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"domain-brief.md, line 215\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference beta-feedback synthesis (critical + major items) against revision log. Verify every critical/major finding has a corresponding resolution entry. Block 'final' status while unresolved.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-055\\\",\\n    \\\"description\\\": \\\"Subcategory Decomposition Threshold: Artifacts with more than ~3 distinct topics MUST be split into subcategory files within a typed directory. A single monolithic file covering multiple domains is too coarse.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 328-329\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Audit output artifacts for monolithic files covering multiple distinct topics. Flag any artifact file addressing more than 3 separate topics that should be split into subdirectory files.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-056\\\",\\n    \\\"description\\\": \\\"Magic System Expansion Not Contradiction: For sequels, the magic system can be expanded but not contradicted. New abilities must be compatible with established rules.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 361\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels, diff magic system files before and after. Verify new rules are additive. Check new abilities don't violate existing cost/limitation constraints established in prior books.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-057\\\",\\n    \\\"description\\\": \\\"Character Voice Carries Across Books: Character voice guides carry across books. A character's voice in later books must be recognizably the same person, with natural evolution (trauma, growth, age) documented.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 360\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-007\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels, compare character voice analysis against prior-book voice guide. Flag significant drift not explained by documented character evolution (trauma, growth, age changes).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-058\\\",\\n    \\\"description\\\": \\\"Naming Collision Prevention: The naming convention guide must prevent naming collisions across books (two characters with similar names) and ensure consistent use of titles, honorifics, and place names.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, line 362\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\", \\\"SD-013\\\", \\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Check naming-conventions.md for uniqueness of all character and place names. Flag names that are too similar (e.g., same first syllable, rhyming). Verify title/honorific consistency.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-059\\\",\\n    \\\"description\\\": \\\"Sequel Must Address Unresolved Threads: In sequel concept phase, system MUST decide which unresolved threads from prior books this book resolves, advances, or deliberately leaves open. No thread may be silently forgotten.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 340-341\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-005\\\", \\\"SD-012\\\", \\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels, verify concept phase artifact addresses every thread in unresolved-threads.md — each marked as 'resolves', 'advances', or 'defers with rationale'. Flag any unaddressed threads.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-060\\\",\\n    \\\"description\\\": \\\"Publication-Ready Prose Quality: Output prose must be publication-ready romantic fantasy — lush but not purple, emotionally resonant, genre-appropriate. Characters must feel like real people, not archetypes.\\\",\\n    \\\"classification\\\": \\\"quality\\\",\\n    \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, lines 401-409\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\", \\\"SD-008\\\", \\\"SD-009\\\", \\\"SD-010\\\"],\\n    \\\"verificationStrategy\\\": \\\"Craft reader lens evaluates prose against publication-quality benchmark. Flag purple prose, flat characterization, genre-inappropriate tone. Verify emotional resonance through beta reader feedback.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-061\\\",\\n    \\\"description\\\": \\\"One Story At A Time: The system processes one story at a time. It does not need to handle multiple simultaneous stories.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, line 414\\\",\\n    \\\"affectedSubdomains\\\": ALL_SDS[:],\\n    \\\"verificationStrategy\\\": \\\"Verify system architecture assumes single-story execution context. No concurrent story state management needed. Pipeline processes one book sequentially.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-062\\\",\\n    \\\"description\\\": \\\"Kill Your Darlings Adversarial Mandate: Every adversarial auditor must explicitly hunt for 'darlings' — passages, world details, character traits, or plot elements that are beautiful/clever but don't serve the story. Darlings must be moved to killed-darlings file, not deleted.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"domain-brief.md, lines 70\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\", \\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify each adversarial audit report includes a 'darlings' section. Check killed-darlings.md accumulates removed elements. Confirm flagged darlings were actually excised from output.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-063\\\",\\n    \\\"description\\\": \\\"Story Craft Profile Required Artifact: During Concept and Plotting, system must produce a Story Craft Profile listing selected tools with rationale, tools not selected with reason, and per-tool adjustments for the story.\\\",\\n    \\\"classification\\\": \\\"workflow\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 366-372\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\", \\\"SD-005\\\", \\\"SD-016\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify craft-profile.md exists in concept directory. Check it lists selected tools (5-8) with rationale, excluded tools with reason, and any per-tool adjustments.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-064\\\",\\n    \\\"description\\\": \\\"Self-Contained Subcategory Files: Each subcategory file must be self-contained enough to be loaded independently. An agent checking magic rules should not need to load geography.\\\",\\n    \\\"classification\\\": \\\"structural\\\",\\n    \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 330-331\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\", \\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Review subcategory files for self-containment. Verify an agent can load a single subcategory file and get complete information on that topic without requiring sibling files.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# Update model\\n# ============================================================\\n\\nmodel[\\\"invariants\\\"] = invariants\\nmodel[\\\"lastUpdated\\\"] = datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\n\\nwith open('.fractal-factory/domain-model.json', 'w') as f:\\n    json.dump(model, f, indent=2)\\n\\n# Count by classification\\nclass_counts = {}\\nconf_bands = {\\\"high (0.9-1.0)\\\": 0, \\\"medium (0.7-0.8)\\\": 0, \\\"low (<0.7)\\\": 0}\\nfor inv in invariants:\\n    c = inv[\\\"classification\\\"]\\n    class_counts[c] = class_counts.get(c, 0) + 1\\n    if inv[\\\"confidence\\\"] >= 0.9:\\n        conf_bands[\\\"high (0.9-1.0)\\\"] += 1\\n    elif inv[\\\"confidence\\\"] >= 0.7:\\n        conf_bands[\\\"medium (0.7-0.8)\\\"] += 1\\n    else:\\n        conf_bands[\\\"low (<0.7)\\\"] += 1\\n\\nprint(f\\\"Total invariants: {len(invariants)}\\\")\\nprint(f\\\"By classification: {json.dumps(class_counts, indent=2)}\\\")\\nprint(f\\\"By confidence band: {json.dumps(conf_bands, indent=2)}\\\")\\nprint(\\\"Domain model updated successfully.\\\")\\n\\nPYEOF\", \"description\": \"Build and write invariants to domain model\", \"initial_wait\": 30}"
