        `RESULT_TEXT=$(echo "$INPUT" | jq -r '.toolResult.textResultForLlm // ""')\n` +
        '\n' +
        '# Write full untruncated tool output to a separate readable log.\n' +
        '\n' +
        '==> /home/jakubs/repositories/ralph-orchestrator/shared/hooks/log-pre-tool.sh <==\n' +
        '#!/bin/bash\n' +
        '# Ralph audit logger — Pre-Tool Use\n' +
        '# Logs every tool invocation to pre-tool.log and audit.jsonl.\n' +
        '#\n' +
        '# Performance: optimized for the hot path (~200-500 calls/task).\n' +
        '# - Single jq call to extract input fields\n' +
        '# - Single jq call to build JSONL + bash string replacement for audit\n' +
        'set -e\n' +
        'INPUT=$(cat)\n' +
        '\n' +
        'LOG_DIR="/workspace/.ralph/logs"\n' +
        'SESSION_ID=$(cat "$LOG_DIR/.current-session-id" 2>/dev/null || echo "unknown")\n' +
        '\n' +
        '# Timestamp and toolName are tab-separated on one line; toolArgs extracted separately\n' +
        '# because it can contain tabs/newlines.\n' +
        `read -r TIMESTAMP TOOL_NAME <<< "$(echo "$INPUT" | jq -r '[.timestamp, (.toolName // "unknown")] | @tsv')"\n` +
        `TOOL_ARGS=$(echo "$INPUT" | jq -r '.toolArgs // "{}"')\n` +
        '\n' +
        '# Build JSONL once, write to both log files.\n' +
        '# pre-tool.log uses "ts" key; audit.jsonl uses "timestamp" key.\n' +
        '\n' +
        '==> /home/jakubs/repositories/ralph-orchestrator/shared/hooks/log-prompt.sh <==\n' +
        '#!/bin/bash\n' +
        '# Ralph audit logger — User Prompt Submitted\n' +
