        '5. \n' +
        '6. set -euo pipefail\n' +
        '7. \n' +
        '8. ROOT="${1:-.}"\n' +
        '9. ARTIFACT_DIR="$ROOT/.fractal-factory"\n' +
        '10. \n' +
        '11. if [ -d "$ARTIFACT_DIR" ]; then\n' +
        '12.   echo "Artifact directory already exists at $ARTIFACT_DIR"\n' +
        '13.   echo "Delete it first if you want a fresh start."\n' +
        '14.   exit 1\n' +
        '15. fi\n' +
        '16. \n' +
        '17. echo "Creating Fractal Factory artifact directory structure..."\n' +
        '18. \n' +
        '19. # Core directories\n' +
        '20. mkdir -p "$ARTIFACT_DIR/agents"\n' +
        '21. mkdir -p "$ARTIFACT_DIR/produced-output/agents"\n' +
        '22. mkdir -p "$ARTIFACT_DIR/produced-output/schemas"\n' +
        '23. mkdir -p "$ARTIFACT_DIR/produced-output/skills"\n' +
        '24. mkdir -p "$ARTIFACT_DIR/produced-output/tests"\n' +
        '25. mkdir -p "$ARTIFACT_DIR/produced-output/docs"\n' +
        '26. \n' +
        '27. # Seed: progress.json\n' +
        `28. cat > "$ARTIFACT_DIR/progress.json" << 'EOF'\n` +
        '29. {\n' +
