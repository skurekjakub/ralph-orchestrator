        '# Performance: optimized for the hot path.\n' +
        '# - Single jq call for field extraction\n' +
        '# - Truncation via bash substring\n' +
        '# - Single jq call for audit JSONL\n' +
        'set -e\n' +
        'INPUT=$(cat)\n' +
        '\n' +
        'LOG_DIR="/workspace/.ralph/logs"\n' +
        'SESSION_ID=$(cat "$LOG_DIR/.current-session-id" 2>/dev/null || echo "unknown")\n' +
        '\n' +
        '# Single jq call: extract all scalar fields at once (was 5 separate jq forks).\n' +
        `read -r TIMESTAMP TOOL_NAME RESULT_TYPE <<< "$(echo "$INPUT" | jq -r '[.timestamp, (.toolName // "unknown"), (.toolResult.resultType // "unknown")] | @tsv')"\n` +
