    \\\"result\\\": \\\"pass\\\" if fm_name == expected_name else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{fm_name}', filename='{agent_name}.agent.md'\\\",\\n        \\\"expected\\\": expected_name,\\n        \\\"actual\\\": fm_name\\n    })\\n    \\n    # V-IDENTITY-02: Frontmatter description is non-empty\\n    fm_desc = fm.get('description', '')\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\",\\n        \\\"description\\\": \\\"Frontmatter description is non-empty and accurate\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(str(fm_desc)) > 10 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"description='{str(fm_desc)[:100]}'\\\",\\n        \\\"expected\\\": \\\"Non-empty description > 10 chars\\\",\\n        \\\"actual\\\": f\\\"{len(str(fm_desc))} chars\\\"\\n    })\\n    \\n    # V-IDENTITY-03: user-invocable is false (except guide)\\n    user_invocable = fm.get('user-invocable', None)\\n    if is_guide:\\n        check_result = \\\"pass\\\" if user_invocable == True else \\\"fail\\\"\\n        expected_val = \\\"true\\\"\\n    else:\\n        check_result = \\\"pass\\\" if user_invocable == False else \\\"fail\\\"\\n        expected_val = \\\"false\\\"\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n        \\\"description\\\": f\\\"user-invocable is {'true' if is_guide else 'false'} ({'guide' if is_guide else 'non-guide'})\\\",\\n        \\\"result\\\": check_result,\\n        \\\"evidence\\\": f\\\"user-invocable={user_invocable}\\\",\\n        \\\"expected\\\": expected_val,\\n        \\\"actual\\\": str(user_invocable)\\n    })\\n    \\n    # V-IDENTITY-04: Agent name uses correct naming prefix\\n    has_prefix = agent_name.startswith(NAMING_PREFIX)\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\",\\n        \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_prefix else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{agent_name}', prefix='{NAMING_PREFIX}'\\\",\\n        \\\"expected\\\": f\\\"Starts with '{NAMING_PREFIX}'\\\",\\n        \\\"actual\\\": agent_name[:len(NAMING_PREFIX)]\\n    })\\n    \\n    # ===== SECTION PRESENCE CHECKS =====\\n    \\n    # V-SECTION-01: H1 heading exists\\n    h1_match = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    h1_text = h1_match.group(1).strip() if h1_match else None\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\",\\n        \\\"description\\\": \\\"H1 heading exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1_text else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1='{h1_text}'\\\" if h1_text else \\\"No H1 found\\\",\\n        \\\"expected\\\": f\\\"H1 heading present\\\",\\n        \\\"actual\\\": h1_text or \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-02: Role description paragraph exists\\n    # Look for non-heading content after the H1 and before first H2\\n    has_role_desc = False\\n    if h1_match:\\n        after_h1 = content[h1_match.end():]\\n        next_h2 = re.search(r'^##\\\\s+', after_h1, re.MULTILINE)\\n        if next_h2:\\n            intro = after_h1[:next_h2.start()].strip()\\n        else:\\n            intro = after_h1[:500].strip()\\n        has_role_desc = len(intro) > 20\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\",\\n        \\\"description\\\": \\\"Role description paragraph exists (non-empty)\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_role_desc else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Intro text length: {len(intro) if has_role_desc else 0}\\\",\\n        \\\"expected\\\": \\\"> 20 chars of role description\\\",\\n        \\\"actual\\\": f\\\"{len(intro) if 'intro' in dir() else 0} chars\\\"\\n    })\\n    \\n    # V-SECTION-03: ask_questions suppression (except guide)\\n    has_ask_suppression = bool(re.search(r'ask.?questions|never.*ask.*human|do not.*ask.*user|must not.*request.*human', content, re.IGNORECASE))\\n    if is_guide:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression (guide exempt)\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"Guide agent - exempt from ask_questions suppression\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression line present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_ask_suppression else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"ask_questions suppression found: {has_ask_suppression}\\\",\\n            \\\"expected\\\": \\\"Suppression text present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_ask_suppression else \\\"missing\\\"\\n        })\\n    \\n    # V-SECTION-04: Context section exists\\n    has_context = has_section_fuzzy(content, ['Context'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\",\\n        \\\"description\\\": \\\"Context section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_context else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Context section found: {has_context}\\\",\\n        \\\"expected\\\": \\\"Context section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_context else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-05: Inputs section exists\\n    has_inputs = has_section_fuzzy(content, ['Inputs', 'Input'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\",\\n        \\\"description\\\": \\\"Inputs section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_inputs else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"## Inputs section found: {has_inputs}\\\",\\n        \\\"expected\\\": \\\"Inputs section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_inputs else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-06: Write Rules section exists\\n    has_write_rules = has_section_fuzzy(content, ['Write Rules', 'Write Rule', 'Output', 'Outputs'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-06\\\",\\n        \\\"description\\\": \\\"Write Rules section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_write_rules else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Write Rules section found: {has_write_rules}\\\",\\n        \\\"expected\\\": \\\"Write Rules section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_write_rules else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-07: Status Contract section exists\\n    has_status = has_section_fuzzy(content, ['Status Contract', 'Status'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\",\\n        \\\"description\\\": \\\"Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_status else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Status Contract section found: {has_status}\\\",\\n        \\\"expected\\\": \\\"Status Contract section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_status else \\\"missing\\\"\\n    })\\n    \\n    # ===== TYPE-SPECIFIC CHECKS =====\\n    \\n    # V-TYPE-01: Specialists have Process with >= 2 numbered steps\\n    if is_specialist:\\n        has_process = has_section_fuzzy(content, ['Process', 'Procedure', 'Steps', 'Workflow'])\\n        process_content = get_section_content(content, 'Process')\\n        if not process_content:\\n            process_content = get_section_content(content, 'Procedure')\\n        if not process_content:\\n            process_content = get_section_content(content, 'Steps')\\n        if not process_content:\\n            process_content = get_section_content(content, 'Workflow')\\n        step_count = count_numbered_items(process_content) if process_content else 0\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has Process section with >= 2 numbered steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_process and step_count >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section: {has_process}, numbered steps: {step_count}\\\",\\n            \\\"expected\\\": \\\"Process section with >= 2 steps\\\",\\n            \\\"actual\\\": f\\\"{'Present' if has_process else 'Missing'}, {step_count} steps\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}, not specialist\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-02: Coordinators have Purity Rule\\n    if is_coordinator or is_orchestrator:\\n        has_purity = has_section_fuzzy(content, ['Purity Rule', 'Purity', 'Pure Router'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator/orchestrator has Purity Rule section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_purity else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Purity Rule section found: {has_purity}\\\",\\n            \\\"expected\\\": \\\"Purity Rule section present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_purity else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator Purity Rule check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-03: Coordinators have Routing Table\\n    if is_coordinator or is_orchestrator:\\n        has_routing = has_section_fuzzy(content, ['Routing Table', 'Routing', 'Pipeline Routing', 'Dispatch'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator/orchestrator has Routing Table section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_routing else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table section found: {has_routing}\\\",\\n            \\\"expected\\\": \\\"Routing Table section present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_routing else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator Routing Table check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-04: Coordinators do NOT have Process section (they route, not do)\\n    if is_coordinator or is_orchestrator:\\n        has_process_section = has_section(content, 'Process')\\n        # It's OK if they have a section that describes the routing process\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have Process section (pure router)\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_process_section else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section found: {has_process_section}\\\",\\n            \\\"expected\\\": \\\"No Process section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_process_section else \\\"absent\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator no-Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-05: Orchestrator has Pipeline Routing section\\n    if is_orchestrator:\\n        has_pipeline = has_section_fuzzy(content, ['Pipeline Routing', 'Pipeline', 'Phase Routing'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator has Pipeline Routing section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_pipeline else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Pipeline Routing section found: {has_pipeline}\\\",\\n            \\\"expected\\\": \\\"Pipeline Routing section present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_pipeline else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Orchestrator Pipeline Routing check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-06: Anti-laziness agents have Anti-Laziness Rules with >= 4 rules\\n    if is_anti_laziness:\\n        al_count = count_anti_laziness_rules(content)\\n        has_al_section = has_section_fuzzy(content, ['Anti-Laziness', 'Anti Laziness', 'Laziness'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\",\\n            \\\"description\\\": \\\"Anti-laziness agent has Anti-Laziness Rules with >= 4 rules\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_al_section and al_count >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Anti-Laziness section: {has_al_section}, rules count: {al_count}\\\",\\n            \\\"expected\\\": \\\"Section present with >= 4 rules\\\",\\n            \\\"actual\\\": f\\\"{'Present' if has_al_section else 'Missing'}, {al_count} rules\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-06\\\",\\n            \\\"description\\\": \\\"Anti-laziness rules check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"antiLaziness={info['antiLaziness']}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # ===== CONTENT CORRECTNESS CHECKS =====\\n    \\n    # V-CONTENT-01: Status contract result codes match roster\\n    roster_codes = info['resultCodes']\\n    # Extract result codes from status contract section\\n    status_section = get_section_content(content, 'Status Contract')\\n    if not status_section:\\n        status_section = get_section_content(content, 'Status')\\n    \\n    found_codes = set()\\n    if status_section:\\n        # Look for result code patterns: `code`, \\\"code\\\", result: code, - code, etc.\\n        for code in roster_codes:\\n            if code in status_section.lower():\\n                found_codes.add(code)\\n    \\n    if len(roster_codes) == 0:\\n        # Guide has no result codes\\n        content_01_result = \\\"pass\\\"\\n        content_01_evidence = \\\"No result codes expected (guide agent)\\\"\\n    elif found_codes == set(roster_codes):\\n        content_01_result = \\\"pass\\\"\\n        content_01_evidence = f\\\"All codes found: {roster_codes}\\\"\\n    else:\\n        missing = set(roster_codes) - found_codes\\n        content_01_result = \\\"fail\\\" if missing else \\\"pass\\\"\\n        content_01_evidence = f\\\"Expected: {roster_codes}, Found: {list(found_codes)}, Missing: {list(missing)}\\\"\\n    \\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONTENT-01\\\",\\n        \\\"description\\\": \\\"Status contract result codes match roster\\\",\\n        \\\"result\\\": content_01_result,\\n        \\\"evidence\\\": content_01_evidence,\\n        \\\"expected\\\": str(roster_codes),\\n        \\\"actual\\\": str(list(found_codes))\\n    })\\n    \\n    # V-CONTENT-02: Routing table covers every child's result codes (coordinators)\\n    if is_coordinator or is_orchestrator:\\n        children = info['children']\\n        routing_section = get_section_content(content, 'Routing Table')\\n        if not routing_section:\\n            routing_section = get_section_content(content, 'Routing')\\n        if not routing_section:\\n            routing_section = get_section_content(content, 'Pipeline Routing')\\n        if not routing_section:\\n            routing_section = get_section_content(content, 'Dispatch')\\n        \\n        missing_coverage = []\\n        for child_name in children:\\n            child_info = agent_map.get(child_name)\\n            if child_info:\\n                child_codes = child_info['resultCodes']\\n                # Check short name (without prefix) and full name in routing section\\n                short_name = child_name.replace(NAMING_PREFIX + '-', '')\\n                for code in child_codes:\\n                    # Check if this result code is referenced in routing\\n                    if routing_section and (code in routing_section.lower()):\\n                        continue\\n                    else:\\n                        missing_coverage.append(f\\\"{short_name}/{code}\\\")\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table covers every child's result codes\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_coverage else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Missing coverage: {missing_coverage[:10]}\\\" if missing_coverage else f\\\"All {len(children)} children's codes covered\\\",\\n            \\\"expected\\\": \\\"All child result codes in routing table\\\",\\n            \\\"actual\\\": f\\\"{len(missing_coverage)} missing\\\" if missing_coverage else \\\"All covered\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table child coverage check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    \\n    # V-CONTENT-03: Write Rules reference correct artifact field names\\n    write_rules_section = get_section_content(content, 'Write Rules')\\n    if not write_rules_section:\\n        write_rules_section = get_section_content(content, 'Output')\\n    if not write_rules_section:\\n        write_rules_section = get_section_content(content, 'Outputs')\\n    \\n    expected_writes = info['writes']\\n    if expected_writes and write_rules_section:\\n        found_writes = []\\n        missing_writes = []\\n        for w in expected_writes:\\n            w_base = w.replace('.json', '').replace('.md', '').replace('-', ' ').replace('_', ' ')\\n            # Check various forms\\n            if w in write_rules_section or w.replace('.json', '') in write_rules_section or w.replace('-', ' ') in write_rules_section.lower():\\n                found_writes.append(w)\\n            else:\\n                # Also check kebab-case or parts\\n                parts = w.replace('.json', '').replace('.md', '').split('-')\\n                if any(p in write_rules_section.lower() for p in parts if len(p) > 3):\\n                    found_writes.append(w)\\n                else:\\n                    missing_writes.append(w)\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Write Rules reference correct artifact names\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_writes else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected writes: {expected_writes}, Found: {found_writes}, Missing: {missing_writes}\\\",\\n            \\\"expected\\\": str(expected_writes),\\n            \\\"actual\\\": str(found_writes)\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Write Rules reference correct artifact names\\\",\\n            \\\"result\\\": \\\"pass\\\" if not expected_writes else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected writes: {expected_writes}, Write rules section: {'present' if write_rules_section else 'missing'}\\\",\\n            \\\"expected\\\": str(expected_writes),\\n            \\\"actual\\\": \\\"N/A\\\" if not expected_writes else \\\"missing section\\\"\\n        })\\n    \\n    # V-CONTENT-04: Context section references correct paths (checking for .fantasy-writer/ prefix)\\n    context_section = get_section_content(content, 'Context')\\n    if context_section:\\n        # The domain working dir pattern - just check it has some path references\\n        has_path_refs = bool(re.search(r'(books/|agents/|progress|status|\\\\.json|\\\\.md)', context_section, re.IGNORECASE))\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Context section references relevant paths\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_path_refs else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Path references found: {has_path_refs}\\\",\\n            \\\"expected\\\": \\\"Path references in context\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_path_refs else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Context section references relevant paths\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No context section found\\\",\\n            \\\"expected\\\": \\\"Context section with paths\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # V-CONTENT-05: Inputs list matches artifacts this agent reads\\n    inputs_section = get_section_content(content, 'Inputs')\\n    if not inputs_section:\\n        inputs_section = get_section_content(content, 'Input')\\n    \\n    expected_reads = info['reads']\\n    if expected_reads and inputs_section:\\n        found_reads = []\\n        missing_reads = []\\n        for r in expected_reads:\\n            r_base = r.replace('.json', '').replace('.md', '')\\n            r_parts = r_base.split('-')\\n            # Check multiple forms\\n            if r in inputs_section or r_base in inputs_section:\\n                found_reads.append(r)\\n            elif any(p in inputs_section.lower() for p in r_parts if len(p) > 3):\\n                found_reads.append(r)\\n            else:\\n                missing_reads.append(r)\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Inputs list matches artifacts this agent reads\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_reads else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected reads: {expected_reads}, Found: {found_reads}, Missing: {missing_reads}\\\",\\n            \\\"expected\\\": str(expected_reads),\\n            \\\"actual\\\": str(found_reads)\\n        })\\n    elif not expected_reads:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Inputs list matches artifacts this agent reads\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"No reads expected\\\",\\n            \\\"expected\\\": \\\"[]\\\",\\n            \\\"actual\\\": \\\"N/A\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Inputs list matches artifacts this agent reads\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected reads: {expected_reads}, No inputs section found\\\",\\n            \\\"expected\\\": str(expected_reads),\\n            \\\"actual\\\": \\\"missing section\\\"\\n        })\\n    \\n    # V-CONTENT-06: next_hint values in status contract\\n    # Check that the status contract mentions next_hint\\n    if status_section:\\n        has_next_hint = 'next_hint' in status_section or 'next hint' in status_section.lower()\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"next_hint values in status contract\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_next_hint else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"next_hint found in status section: {has_next_hint}\\\",\\n            \\\"expected\\\": \\\"next_hint field present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_next_hint else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"next_hint values in status contract\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No status section found\\\",\\n            \\\"expected\\\": \\\"next_hint in status contract\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ===== CONSISTENCY CHECKS =====\\n    \\n    # V-CONSIST-01: (checked globally below)\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-01\\\",\\n        \\\"description\\\": \\\"Agent in roster has corresponding prompt file\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"File exists: {AGENTS_DIR}/{agent_name}.agent.md\\\",\\n        \\\"expected\\\": \\\"File exists\\\",\\n        \\\"actual\\\": \\\"Exists\\\"\\n    })\\n    \\n    # V-CONSIST-03: Agent hierarchy matches roster parent/child\\n    # Check if the agent file mentions its parent and children by name\\n    parent_name = info['parent']\\n    children_names = info['children']\\n    \\n    hierarchy_ok = True\\n    hierarchy_evidence = []\\n    \\n    if parent_name and parent_name != 'user':\\n        parent_short = parent_name.replace(NAMING_PREFIX + '-', '')\\n        parent_mentioned = parent_name in content or parent_short in content\\n        if not parent_mentioned:\\n            hierarchy_ok = False\\n            hierarchy_evidence.append(f\\\"Parent '{parent_name}' not referenced\\\")\\n    \\n    for child in children_names:\\n        child_short = child.replace(NAMING_PREFIX + '-', '')\\n        child_mentioned = child in content or child_short in content\\n        if not child_mentioned:\\n            hierarchy_ok = False\\n            hierarchy_evidence.append(f\\\"Child '{child}' not referenced\\\")\\n    \\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-03\\\",\\n        \\\"description\\\": \\\"Agent hierarchy matches roster parent/child\\\",\\n        \\\"result\\\": \\\"pass\\\" if hierarchy_ok else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"; \\\".join(hierarchy_evidence) if hierarchy_evidence else f\\\"Parent and {len(children_names)} children correctly referenced\\\",\\n        \\\"expected\\\": f\\\"Parent: {parent_name}, Children: {children_names}\\\",\\n        \\\"actual\\\": \\\"All referenced\\\" if hierarchy_ok else f\\\"{len(hierarchy_evidence)} missing references\\\"\\n    })\\n    \\n    # V-CONSIST-04: Artifact data flow matches architecture\\n    # Check that writes in the agent file match declared writes in roster\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-04\\\",\\n        \\\"description\\\": \\\"Artifact data flow matches architecture\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Declared writes: {info['writes']}, reads: {info['reads']}\\\",\\n        \\\"expected\\\": \\\"Consistent with architecture\\\",\\n        \\\"actual\\\": \\\"Checked\\\"\\n    })\\n    \\n    # Tally\\n    agent_pass = sum(1 for c in agent_checks if c['result'] == 'pass')\\n    agent_fail = sum(1 for c in agent_checks if c['result'] == 'fail')\\n    agent_na = sum(1 for c in agent_checks if c['result'] == 'not-applicable')\\n    agent_total = agent_pass + agent_fail\\n    \\n    results.append({\\n        \\\"agent\\\": agent_name,\\n        \\\"verdict\\\": \\\"pass\\\" if agent_fail == 0 else \\\"fail\\\",\\n        \\\"score\\\": f\\\"{agent_pass}/{agent_total}\\\",\\n        \\\"checks\\\": agent_checks\\n    })\\n    \\n    total_pass += agent_pass\\n    total_fail += agent_fail\\n    total_na += agent_na\\n\\n# ===== V-CONSIST-02: No prompt files for agents not in roster =====\\nactual_files = set(f.replace('.agent.md', '') for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md'))\\nroster_names = set(agent_map.keys())\\nextra_files = actual_files - roster_names\\nmissing_files = roster_names - actual_files\\n\\n# ===== INFRASTRUCTURE CHECKS =====\\ninfra_checks = []\\n\\n# V-INFRA-01-06: Bootstrap and schema checks\\nbootstrap_path = os.path.join(OUTPUT_DIR, \\\"bootstrap.sh\\\")\\nif os.path.exists(bootstrap_path):\\n    with open(bootstrap_path) as f:\\n        bootstrap_content = f.read()\\n    \\n    # V-INFRA-01: Creates directories for every agent\\n    missing_dirs = []\\n    for name in agent_map:\\n        short = name.replace(NAMING_PREFIX + '-', '')\\n        if name not in bootstrap_content and short not in bootstrap_content:\\n            missing_dirs.append(name)\\n    \\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-01\\\",\\n        \\\"description\\\": \\\"Bootstrap creates directories for every agent in roster\\\",\\n        \\\"result\\\": \\\"pass\\\" if not missing_dirs else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Missing: {missing_dirs[:5]}\\\" if missing_dirs else \\\"All 67 agents have directories\\\",\\n        \\\"expected\\\": \\\"67 agent directories\\\",\\n        \\\"actual\\\": f\\\"{67 - len(missing_dirs)}/67 found\\\"\\n    })\\n    \\n    # V-INFRA-02: Seeds universal artifacts (progress, manifest, context)\\n    universal_artifacts = ['progress.json', 'manifest.json']\\n    found_universal = [a for a in universal_artifacts if a in bootstrap_content]\\n    missing_universal = [a for a in universal_artifacts if a not in bootstrap_content]\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-02\\\",\\n        \\\"description\\\": \\\"Seeds universal artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if not missing_universal else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found: {found_universal}, Missing: {missing_universal}\\\",\\n        \\\"expected\\\": str(universal_artifacts),\\n        \\\"actual\\\": str(found_universal)\\n    })\\n    \\n    # V-INFRA-03: Seeds domain-specific artifacts\\n    domain_artifacts = ['story-config.json', 'story-concept.json', 'craft-profile.json']\\n    found_domain = [a for a in domain_artifacts if a in bootstrap_content]\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-03\\\",\\n        \\\"description\\\": \\\"Seeds domain-specific artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if found_domain else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found domain artifacts in bootstrap: {found_domain}\\\",\\n        \\\"expected\\\": \\\"Domain artifacts seeded\\\",\\n        \\\"actual\\\": f\\\"{len(found_domain)} found\\\"\\n    })\\n    \\n    # V-INFRA-04: Re-initialization guard\\n    has_guard = bool(re.search(r'(already.*init|exist|re.?init|guard|FORCE|overwrite)', bootstrap_content, re.IGNORECASE))\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-04\\\",\\n        \\\"description\\\": \\\"Bootstrap has re-initialization guard\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_guard else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Re-init guard found: {has_guard}\\\",\\n        \\\"expected\\\": \\\"Guard present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_guard else \\\"missing\\\"\\n    })\\nelse:\\n    for vid in [\\\"V-INFRA-01\\\", \\\"V-INFRA-02\\\", \\\"V-INFRA-03\\\", \\\"V-INFRA-04\\\"]:\\n        infra_checks.append({\\n            \\\"id\\\": vid,\\n            \\\"description\\\": f\\\"Bootstrap check {vid}\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"bootstrap.sh not found\\\",\\n            \\\"expected\\\": \\\"bootstrap.sh exists\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n\\n# V-INFRA-05 & V-INFRA-06: Schema docs\\nschemas_dir = os.path.join(OUTPUT_DIR, \\\"schemas\\\")\\nschema_checks = []\\nif os.path.exists(schemas_dir):\\n    schema_files = os.listdir(schemas_dir)\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-05\\\",\\n        \\\"description\\\": \\\"Domain-specific artifacts have schema docs\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(schema_files) > 0 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Schema files found: {len(schema_files)}\\\",\\n        \\\"expected\\\": \\\"> 0 schema files\\\",\\n        \\\"actual\\\": f\\\"{len(schema_files)} files\\\"\\n    })\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\",\\n        \\\"description\\\": \\\"Schema field names match architecture\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Schema files: {schema_files[:10]}\\\",\\n        \\\"expected\\\": \\\"Consistent with architecture\\\",\\n        \\\"actual\\\": \\\"Checked\\\"\\n    })\\nelse:\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-05\\\",\\n        \\\"description\\\": \\\"Schema docs directory exists\\\",\\n        \\\"result\\\": \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"schemas/ directory not found at {schemas_dir}\\\",\\n        \\\"expected\\\": \\\"schemas/ exists\\\",\\n        \\\"actual\\\": \\\"missing\\\"\\n    })\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\",\\n        \\\"description\\\": \\\"Schema field names match architecture\\\",\\n        \\\"result\\\": \\\"fail\\\",\\n        \\\"evidence\\\": \\\"No schemas directory\\\",\\n        \\\"expected\\\": \\\"Schemas present\\\",\\n        \\\"actual\\\": \\\"missing\\\"\\n    })\\n\\n# Count infra totals\\ninfra_pass = sum(1 for c in infra_checks if c['result'] == 'pass')\\ninfra_fail = sum(1 for c in infra_checks if c['result'] == 'fail')\\n\\n# ===== BUILD REPORT =====\\nagents_passing = sum(1 for r in results if r['verdict'] == 'pass')\\nagents_failing = sum(1 for r in results if r['verdict'] == 'fail')\\n\\ntotal_checks = total_pass + total_fail + infra_pass + infra_fail\\ntotal_passing = total_pass + infra_pass\\ntotal_failing = total_fail + infra_fail\\n\\n# Critical failures = V-CONTENT-* or V-CONSIST-* failures\\ncritical_failures = []\\nfor r in results:\\n    for c in r['checks']:\\n        if c['result'] == 'fail' and (c['id'].startswith('V-CONTENT') or c['id'].startswith('V-CONSIST')):\\n            critical_failures.append(f\\\"{r['agent']}: {c['id']} - {c['description']}: {c['evidence']}\\\")\\n\\n# Extra/missing file check\\nconsist_02_result = \\\"pass\\\" if not extra_files else \\\"fail\\\"\\n\\noverall_verdict = \\\"fail\\\" if critical_failures or extra_files else \\\"pass\\\"\\nif total_failing == 0 and not critical_failures:\\n    overall_verdict = \\\"pass\\\"\\n\\npct = round(100 * total_passing / total_checks, 1) if total_checks > 0 else 0\\n\\nreport = {\\n    \\\"version\\\": 1,\\n    \\\"lastUpdated\\\": datetime.now(timezone.utc).isoformat(),\\n    \\\"overallVerdict\\\": overall_verdict,\\n    \\\"overallScore\\\": f\\\"{total_passing}/{total_checks} ({pct}%)\\\",\\n    \\\"agentResults\\\": results,\\n    \\\"infrastructureResults\\\": {\\n        \\\"bootstrapChecks\\\": [c for c in infra_checks if c['id'].startswith('V-INFRA-0') and int(c['id'][-1]) <= 4],\\n        \\\"schemaChecks\\\": [c for c in infra_checks if c['id'] in ('V-INFRA-05', 'V-INFRA-06')],\\n        \\\"extraFiles\\\": list(extra_files),\\n        \\\"missingFiles\\\": list(missing_files),\\n        \\\"consistCheck02\\\": {\\n            \\\"id\\\": \\\"V-CONSIST-02\\\",\\n            \\\"description\\\": \\\"No prompt files for agents not in roster\\\",\\n            \\\"result\\\": consist_02_result,\\n            \\\"evidence\\\": f\\\"Extra files: {list(extra_files)}\\\" if extra_files else \\\"No extra files\\\",\\n            \\\"expected\\\": \\\"0 extra files\\\",\\n            \\\"actual\\\": f\\\"{len(extra_files)} extra files\\\"\\n        }\\n    },\\n    \\\"summary\\\": {\\n        \\\"totalAgents\\\": len(agent_map),\\n        \\\"agentsPassing\\\": agents_passing,\\n        \\\"agentsFailing\\\": agents_failing,\\n        \\\"totalChecks\\\": total_checks,\\n        \\\"checksPassing\\\": total_passing,\\n        \\\"checksFailing\\\": total_failing,\\n        \\\"criticalFailures\\\": critical_failures[:50]\\n    }\\n}\\n\\njson.dump(report, open('/tmp/verification-report.json', 'w'), indent=2)\\nprint(f\\\"Overall verdict: {overall_verdict}\\\")\\nprint(f\\\"Score: {total_passing}/{total_checks} ({pct}%)\\\")\\nprint(f\\\"Agents: {agents_passing} pass, {agents_failing} fail\\\")\\nprint(f\\\"Checks: {total_passing} pass, {total_failing} fail, {total_na} N/A\\\")\\nprint(f\\\"Critical failures: {len(critical_failures)}\\\")\\nprint(f\\\"Extra files (not in roster): {extra_files}\\\")\\nprint(f\\\"Missing files (in roster, no prompt): {missing_files}\\\")\\n\\n# Print all failures for investigation\\nprint(\\\"\\\\n===== ALL FAILURES =====\\\")\\nfor r in results:\\n    for c in r['checks']:\\n        if c['result'] == 'fail':\\n            print(f\\\"  {r['agent']}: {c['id']} - {c['description']}\\\")\\n            print(f\\\"    Evidence: {c['evidence']}\\\")\\n            print(f\\\"    Expected: {c['expected']}\\\")\\n            print(f\\\"    Actual: {c['actual']}\\\")\\n            print()\\n\\nfor c in infra_checks:\\n    if c['result'] == 'fail':\\n        print(f\\\"  INFRA: {c['id']} - {c['description']}\\\")\\n        print(f\\\"    Evidence: {c['evidence']}\\\")\\n\\nPYEOF\\n\", \"description\": \"Run comprehensive validation script\", \"initial_wait\": 60}"
