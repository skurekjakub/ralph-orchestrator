              "arguments": "{\"command\": \"# Create a structured summary for my review - checking the edge cases\\ncd .fractal-factory/output/romantic-fantasy-writer/agents/\\n\\n# Verify: guide has ask_questions suppression (should be exempt)\\necho \\\"=== GUIDE ask_questions ===\\\"\\ngrep -n \\\"ask_questions\\\\|request human\\\" romantic-fantasy-writer-guide.agent.md\\n\\necho \\\"\\\"\\necho \\\"=== Agents below 400 words ===\\\"\\nfor f in romantic-fantasy-writer-tension-mapper.agent.md romantic-fantasy-writer-political-structure-builder.agent.md romantic-fantasy-writer-dual-arc-builder.agent.md romantic-fantasy-writer-style-analyzer.agent.md; do\\n  echo \\\"  $(basename $f .agent.md): $(wc -w < $f) words, $(grep -c \\\"^### Step\\\" $f) steps\\\"\\ndone\\n\\necho \\\"\\\"\\necho \\\"=== Agents with anti-laziness rules ===\\\"\\ngrep -l \\\"Anti-Laziness\\\" *.agent.md | while read f; do\\n  count=$(grep -c \\\"^[0-9]\\\\.\\\" \\\"$f\\\" 2>/dev/null || echo \\\"0\\\")\\n  echo \\\"  $(basename $f .agent.md): $count numbered rules\\\"\\ndone\\n\\necho \\\"\\\"\\necho \\\"=== Agents with Pass/Fail checklists ===\\\"\\ngrep -l \\\"Pass/Fail Gate\\\" *.agent.md | while read f; do\\n  echo \\\"  $(basename $f .agent.md)\\\"\\ndone\\n\\necho \\\"\\\"\\necho \\\"=== Beta readers with Reading Lens Protocol ===\\\"\\ngrep -l \\\"Reading Lens Protocol\\\" *.agent.md | while read f; do\\n  echo \\\"  $(basename $f .agent.md)\\\"\\ndone\", \"description\": \"Final verification of edge cases\", \"initial_wait\": 10}"
