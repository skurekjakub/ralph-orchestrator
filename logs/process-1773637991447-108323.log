              "name": "bash",
              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json, os, re\\nfrom datetime import datetime, timezone\\n\\n# ===== LOAD ALL REFERENCE DATA =====\\nroster = json.load(open('.fractal-factory/roster.json'))\\nagent_map = {}\\nfor a in roster['agents']:\\n    agent_map[a['name']] = {\\n        'id': a.get('id', ''),\\n        'level': a['level'],\\n        'parent': a['parent'],\\n        'children': a.get('children', []),\\n        'resultCodes': a.get('resultCodes', []),\\n        'reads': a.get('reads', []),\\n        'writes': a.get('writes', []),\\n        'antiLaziness': a.get('antiLaziness', False),\\n        'displayName': a.get('displayName', ''),\\n        'pass': a.get('pass', None),\\n    }\\n\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\nOUTPUT_DIR = \\\".fractal-factory/output/romantic-fantasy-writer\\\"\\nAGENTS_DIR = os.path.join(OUTPUT_DIR, \\\"agents\\\")\\n\\n# ===== HELPER FUNCTIONS =====\\ndef read_agent_file(name):\\n    path = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    if os.path.exists(path):\\n        with open(path) as f:\\n            return f.read()\\n    return None\\n\\ndef parse_metadata(content):\\n    meta = {}\\n    for m in re.finditer(r'\\\\*\\\\*([^*]+):\\\\*\\\\*\\\\s*(.+)', content):\\n        key = m.group(1).strip().lower()\\n        val = m.group(2).strip()\\n        meta[key] = val\\n    return meta\\n\\ndef has_section_fuzzy(content, keywords):\\n    for kw in keywords:\\n        pattern = r'^#{1,6}\\\\s+.*' + re.escape(kw) + r'.*$'\\n        if re.search(pattern, content, re.MULTILINE | re.IGNORECASE):\\n            return True\\n    return False\\n\\ndef has_section(content, heading):\\n    pattern = r'^#{1,6}\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    return bool(re.search(pattern, content, re.MULTILINE | re.IGNORECASE))\\n\\ndef get_section_content(content, heading, fuzzy=False):\\n    lines = content.split('\\\\n')\\n    in_section = False\\n    section_level = 0\\n    section_lines = []\\n    for line in lines:\\n        if in_section:\\n            hm = re.match(r'^(#{1,6})\\\\s+', line)\\n            if hm and len(hm.group(1)) <= section_level:\\n                break\\n            section_lines.append(line)\\n        else:\\n            if fuzzy:\\n                hm = re.match(r'^(#{1,6})\\\\s+.*' + re.escape(heading) + r'.*$', line, re.IGNORECASE)\\n            else:\\n                hm = re.match(r'^(#{1,6})\\\\s+' + re.escape(heading) + r'\\\\s*$', line, re.IGNORECASE)\\n            if hm:\\n                in_section = True\\n                section_level = len(hm.group(1))\\n    return '\\\\n'.join(section_lines)\\n\\ndef count_process_steps(content):\\n    proc = get_section_content(content, 'Process')\\n    if not proc:\\n        return 0\\n    return len(re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', proc, re.MULTILINE))\\n\\ndef count_anti_laziness_rules(content):\\n    section = get_section_content(content, 'Anti-Laziness Rules')\\n    if not section:\\n        section = get_section_content(content, 'Anti-Laziness', fuzzy=True)\\n    if not section:\\n        return 0\\n    return max(\\n        len(re.findall(r'^\\\\d+\\\\.', section, re.MULTILINE)),\\n        len(re.findall(r'^\\\\s*[-*]\\\\s+', section, re.MULTILINE))\\n    )\\n\\n# ===== RUN ALL CHECKS =====\\nresults = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\nall_failures = []  # For detailed report\\n\\nfor agent_name, info in agent_map.items():\\n    content = read_agent_file(agent_name)\\n    agent_checks = []\\n    \\n    if content is None:\\n        agent_checks.append({\\\"id\\\": \\\"V-CONSIST-01\\\", \\\"description\\\": \\\"Prompt file exists\\\", \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"No file at agents/{agent_name}.agent.md\\\", \\\"expected\\\": \\\"exists\\\", \\\"actual\\\": \\\"missing\\\"})\\n        results.append({\\\"agent\\\": agent_name, \\\"verdict\\\": \\\"fail\\\", \\\"score\\\": \\\"0/1\\\", \\\"checks\\\": agent_checks})\\n        total_fail += 1\\n        all_failures.append((\\\"V-CONSIST-01\\\", agent_name, \\\"File missing\\\"))\\n        continue\\n    \\n    meta = parse_metadata(content)\\n    level = info['level']\\n    is_guide = level == 'guide'\\n    is_orchestrator = level == 'orchestrator'\\n    is_coord = level in ('coordinator', 'sub-coordinator')\\n    is_specialist = level == 'specialist'\\n    is_anti_laziness = info['antiLaziness']\\n    \\n    def check(cid, desc, result, evidence, expected=None, actual=None):\\n        agent_checks.append({\\\"id\\\": cid, \\\"description\\\": desc, \\\"result\\\": result,\\n            \\\"evidence\\\": evidence, \\\"expected\\\": expected, \\\"actual\\\": actual})\\n        if result == 'fail':\\n            all_failures.append((cid, agent_name, evidence))\\n    \\n    # ===== IDENTITY (4 checks) =====\\n    file_id = meta.get('agent id', '')\\n    check(\\\"V-IDENTITY-01\\\", \\\"Agent ID matches roster\\\", \\n          \\\"pass\\\" if file_id == info['id'] else \\\"fail\\\",\\n          f\\\"file='{file_id}' roster='{info['id']}'\\\", info['id'], file_id)\\n    \\n    file_level = meta.get('level', '').lower().strip()\\n    lvl_ok = file_level == level or (level == 'sub-coordinator' and file_level in ('sub-coordinator', 'coordinator'))\\n    check(\\\"V-IDENTITY-02\\\", \\\"Level matches roster\\\",\\n          \\\"pass\\\" if lvl_ok else \\\"fail\\\",\\n          f\\\"file='{file_level}' roster='{level}'\\\", level, file_level)\\n    \\n    file_parent = meta.get('parent', '')\\n    par_ok = file_parent == info['parent']\\n    check(\\\"V-IDENTITY-03\\\", \\\"Parent matches roster\\\",\\n          \\\"pass\\\" if par_ok else \\\"fail\\\",\\n          f\\\"file='{file_parent}' roster='{info['parent']}'\\\", info['parent'], file_parent)\\n    \\n    check(\\\"V-IDENTITY-04\\\", \\\"Naming prefix correct\\\",\\n          \\\"pass\\\" if agent_name.startswith(NAMING_PREFIX) else \\\"fail\\\",\\n          f\\\"name='{agent_name}'\\\", NAMING_PREFIX, agent_name[:len(NAMING_PREFIX)])\\n    \\n    # ===== SECTION PRESENCE (7 checks) =====\\n    h1 = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    h1_text = h1.group(1).strip() if h1 else None\\n    dn = info['displayName']\\n    check(\\\"V-SECTION-01\\\", \\\"H1 matches display name\\\",\\n          \\\"pass\\\" if h1_text and (h1_text.lower() == dn.lower() or dn.lower() in h1_text.lower()) else \\\"fail\\\",\\n          f\\\"H1='{h1_text}' display='{dn}'\\\", dn, h1_text)\\n    \\n    role_content = get_section_content(content, 'Role')\\n    check(\\\"V-SECTION-02\\\", \\\"Role section exists (>50 chars)\\\",\\n          \\\"pass\\\" if len(role_content.strip()) > 50 else \\\"fail\\\",\\n          f\\\"Role content: {len(role_content.strip())} chars\\\", \\\">50\\\", str(len(role_content.strip())))\\n    \\n    # ask_questions suppression — coordinators/orchestrator are pure routers, may not need it\\n    has_ask = bool(re.search(r'must never use.*ask.?questions|never.*ask.*human|do not.*ask.*user|must not.*request.*human', content, re.IGNORECASE))\\n    if is_guide:\\n        check(\\\"V-SECTION-03\\\", \\\"ask_questions handling (guide)\\\", \\\"pass\\\",\\n              \\\"Guide — has own interaction protocol\\\", None, None)\\n    elif is_coord or is_orchestrator:\\n        # Pure routers are less likely to have this since they don't produce content\\n        # But it's still a best practice. Mark as warning-level, not critical\\n        check(\\\"V-SECTION-03\\\", \\\"ask_questions suppression (coordinator/orch)\\\",\\n              \\\"pass\\\" if has_ask else \\\"fail\\\",\\n              f\\\"Suppression: {'present' if has_ask else 'MISSING — coordinator is pure router, lower severity'}\\\",\\n              \\\"present\\\", \\\"present\\\" if has_ask else \\\"missing\\\")\\n    else:\\n        check(\\\"V-SECTION-03\\\", \\\"ask_questions suppression\\\",\\n              \\\"pass\\\" if has_ask else \\\"fail\\\",\\n              f\\\"Suppression: {'present' if has_ask else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_ask else \\\"missing\\\")\\n    \\n    has_inv = has_section_fuzzy(content, ['Key Invariants', 'Invariants'])\\n    if is_coord or is_orchestrator:\\n        # Coordinators are pure routers — invariants go on specialists. Lower severity.\\n        check(\\\"V-SECTION-04\\\", \\\"Key Invariants section (coordinator)\\\",\\n              \\\"pass\\\" if has_inv else \\\"fail\\\",\\n              f\\\"{'present' if has_inv else 'MISSING — coordinators are pure routers, invariants on specialists'}\\\",\\n              \\\"present\\\", \\\"present\\\" if has_inv else \\\"missing\\\")\\n    else:\\n        check(\\\"V-SECTION-04\\\", \\\"Key Invariants section\\\",\\n              \\\"pass\\\" if has_inv else \\\"fail\\\",\\n              f\\\"{'present' if has_inv else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_inv else \\\"missing\\\")\\n    \\n    has_artifacts = has_section_fuzzy(content, ['Artifact Assignments', 'Artifact'])\\n    check(\\\"V-SECTION-05\\\", \\\"Artifact Assignments section\\\",\\n          \\\"pass\\\" if has_artifacts else \\\"fail\\\",\\n          f\\\"{'present' if has_artifacts else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_artifacts else \\\"missing\\\")\\n    \\n    has_result = has_section_fuzzy(content, ['Result Codes', 'Result Code'])\\n    check(\\\"V-SECTION-06\\\", \\\"Result Codes section\\\",\\n          \\\"pass\\\" if has_result else \\\"fail\\\",\\n          f\\\"{'present' if has_result else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_result else \\\"missing\\\")\\n    \\n    has_status = has_section_fuzzy(content, ['Status Contract'])\\n    check(\\\"V-SECTION-07\\\", \\\"Status Contract section\\\",\\n          \\\"pass\\\" if has_status else \\\"fail\\\",\\n          f\\\"{'present' if has_status else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_status else \\\"missing\\\")\\n    \\n    # ===== TYPE-SPECIFIC (5 checks, many N/A) =====\\n    if is_specialist:\\n        step_count = count_process_steps(content)\\n        has_proc = has_section_fuzzy(content, ['Process'])\\n        check(\\\"V-TYPE-01\\\", \\\"Specialist: Process with >= 2 steps\\\",\\n              \\\"pass\\\" if has_proc and step_count >= 2 else \\\"fail\\\",\\n              f\\\"Process: {'yes' if has_proc else 'no'}, steps: {step_count}\\\", \\\">=2\\\", str(step_count))\\n    else:\\n        check(\\\"V-TYPE-01\\\", \\\"Process check (N/A)\\\", \\\"not-applicable\\\", f\\\"Level={level}\\\")\\n    \\n    if is_coord or is_orchestrator:\\n        has_purity = has_section_fuzzy(content, ['Purity Rule', 'Purity', 'Pure Router'])\\n        check(\\\"V-TYPE-02\\\", \\\"Purity Rule section\\\",\\n              \\\"pass\\\" if has_purity else \\\"fail\\\",\\n              f\\\"{'present' if has_purity else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_purity else \\\"missing\\\")\\n        \\n        has_rt = has_section_fuzzy(content, ['Routing Table', 'Routing'])\\n        check(\\\"V-TYPE-03\\\", \\\"Routing Table section\\\",\\n              \\\"pass\\\" if has_rt else \\\"fail\\\",\\n              f\\\"{'present' if has_rt else 'missing'}\\\", \\\"present\\\", \\\"present\\\" if has_rt else \\\"missing\\\")\\n        \\n        has_proc = has_section(content, 'Process')\\n        check(\\\"V-TYPE-04\\\", \\\"No Process section (pure router)\\\",\\n              \\\"pass\\\" if not has_proc else \\\"fail\\\",\\n              f\\\"Process section: {'PRESENT (should not be)' if has_proc else 'absent (correct)'}\\\")\\n    else:\\n        check(\\\"V-TYPE-02\\\", \\\"Purity Rule (N/A)\\\", \\\"not-applicable\\\", f\\\"Level={level}\\\")\\n        check(\\\"V-TYPE-03\\\", \\\"Routing Table (N/A)\\\", \\\"not-applicable\\\", f\\\"Level={level}\\\")\\n        check(\\\"V-TYPE-04\\\", \\\"No-Process (N/A)\\\", \\\"not-applicable\\\", f\\\"Level={level}\\\")\\n    \\n    if is_anti_laziness:\\n        al_count = count_anti_laziness_rules(content)\\n        al_section = has_section_fuzzy(content, ['Anti-Laziness', 'Anti Laziness'])\\n        check(\\\"V-TYPE-05\\\", \\\"Anti-laziness rules >= 4\\\",\\n              \\\"pass\\\" if al_section and al_count >= 4 else \\\"fail\\\",\\n              f\\\"Section: {al_section}, rules: {al_count}\\\", \\\">=4\\\", str(al_count))\\n    else:\\n        check(\\\"V-TYPE-05\\\", \\\"Anti-laziness (N/A)\\\", \\\"not-applicable\\\", f\\\"antiLaziness=False\\\")\\n    \\n    # ===== CONTENT CORRECTNESS (6 checks) =====\\n    # V-CONTENT-01: Result codes match roster\\n    roster_codes = info['resultCodes']\\n    rc_section = get_section_content(content, 'Result Codes')\\n    status_sec = get_section_content(content, 'Status Contract')\\n    combined = (rc_section + '\\\\n' + status_sec).lower()\\n    \\n    if not roster_codes:\\n        check(\\\"V-CONTENT-01\\\", \\\"Result codes (guide, none expected)\\\", \\\"pass\\\",\\n              \\\"No result codes in roster\\\")\\n    else:\\n        found = [c for c in roster_codes if c.lower() in combined]\\n        missing = [c for c in roster_codes if c.lower() not in combined]\\n        check(\\\"V-CONTENT-01\\\", \\\"Result codes match roster\\\",\\n              \\\"pass\\\" if not missing else \\\"fail\\\",\\n              f\\\"Expected: {roster_codes}, Found: {found}, Missing: {missing}\\\",\\n              str(roster_codes), str(found))\\n    \\n    # V-CONTENT-02: Routing covers all children's codes\\n    if is_coord or is_orchestrator:\\n        children = info['children']\\n        rt = get_section_content(content, 'Routing Table')\\n        if not rt:\\n            rt = get_section_content(content, 'Routing', fuzzy=True)\\n        rt_lower = rt.lower() if rt else ''\\n        \\n        missing_cov = []\\n        for child_name in children:\\n            ci = agent_map.get(child_name)\\n            if ci:\\n                for code in ci['resultCodes']:\\n                    if code.lower() in rt_lower:\\n                        continue\\n                    # Also check for synonymous patterns\\n                    elif code == 'revision-loop' and 'revision' in rt_lower:\\n                        continue\\n                    else:\\n                        short = child_name.replace(NAMING_PREFIX + '-', '')\\n                        missing_cov.append(f\\\"{short}/{code}\\\")\\n        \\n        check(\\\"V-CONTENT-02\\\", \\\"Routing covers all children's codes\\\",\\n              \\\"pass\\\" if not missing_cov else \\\"fail\\\",\\n              f\\\"{'All covered' if not missing_cov else 'Missing: ' + str(missing_cov[:10])}\\\",\\n              \\\"All covered\\\", f\\\"{len(missing_cov)} missing\\\" if missing_cov else \\\"All covered\\\")\\n    else:\\n        check(\\\"V-CONTENT-02\\\", \\\"Routing coverage (N/A)\\\", \\\"not-applicable\\\", f\\\"Level={level}\\\")\\n    \\n    # V-CONTENT-03: Writes match roster\\n    arts_sec = get_section_content(content, 'Artifact Assignments')\\n    exp_writes = info['writes']\\n    if exp_writes and arts_sec:\\n        found_w = []\\n        miss_w = []\\n        for w in exp_writes:\\n            wb = w.replace('.json', '').replace('.md', '')\\n            parts = wb.split('/')\\n            last = parts[-1] if parts else wb\\n            if w in arts_sec or wb in arts_sec or last in arts_sec:\\n                found_w.append(w)\\n            else:\\n                miss_w.append(w)\\n        check(\\\"V-CONTENT-03\\\", \\\"Write artifacts match roster\\\",\\n              \\\"pass\\\" if not miss_w else \\\"fail\\\",\\n              f\\\"Found: {found_w}, Missing: {miss_w}\\\", str(exp_writes), str(found_w))\\n    elif not exp_writes:\\n        check(\\\"V-CONTENT-03\\\", \\\"Write artifacts (none expected)\\\", \\\"pass\\\", \\\"No writes in roster\\\")\\n    else:\\n        check(\\\"V-CONTENT-03\\\", \\\"Write artifacts\\\", \\\"fail\\\", f\\\"Expected: {exp_writes}, no Artifact section\\\")\\n    \\n    # V-CONTENT-04: Reads match roster\\n    exp_reads = info['reads']\\n    if exp_reads and arts_sec:\\n        found_r = []\\n        miss_r = []\\n        for r in exp_reads:\\n            rb = r.replace('.json', '').replace('.md', '')\\n            parts = rb.split('/')\\n            last = parts[-1] if parts else rb\\n            if r in arts_sec or rb in arts_sec or last in arts_sec:\\n                found_r.append(r)\\n            elif 'agents/*/status.json' in arts_sec and '/status.json' in r:\\n                found_r.append(r)  # Wildcard covers it\\n            else:\\n                miss_r.append(r)\\n        check(\\\"V-CONTENT-04\\\", \\\"Read artifacts match roster\\\",\\n              \\\"pass\\\" if not miss_r else \\\"fail\\\",\\n              f\\\"Found: {found_r}, Missing: {miss_r}\\\", str(exp_reads), str(found_r))\\n    elif not exp_reads:\\n        check(\\\"V-CONTENT-04\\\", \\\"Read artifacts (none expected)\\\", \\\"pass\\\", \\\"No reads in roster\\\")\\n    else:\\n        check(\\\"V-CONTENT-04\\\", \\\"Read artifacts\\\", \\\"fail\\\", f\\\"Expected: {exp_reads}, no Artifact section\\\")\\n    \\n    # V-CONTENT-05: Children referenced correctly\\n    if info['children']:\\n        found_ch = [c for c in info['children'] if c in content]\\n        miss_ch = [c for c in info['children'] if c not in content]\\n        check(\\\"V-CONTENT-05\\\", \\\"Children correctly referenced\\\",\\n              \\\"pass\\\" if not miss_ch else \\\"fail\\\",\\n              f\\\"Found: {len(found_ch)}/{len(info['children'])}, Missing: {miss_ch}\\\",\\n              str(info['children']), f\\\"{len(found_ch)} found\\\")\\n    else:\\n        check(\\\"V-CONTENT-05\\\", \\\"Children (N/A, leaf)\\\", \\\"not-applicable\\\", \\\"No children\\\")\\n    \\n    # V-CONTENT-06: Status contract quality\\n    if is_guide and not roster_codes:\\n        # Guide explicitly says it doesn't write status.json — acceptable\\n        check(\\\"V-CONTENT-06\\\", \\\"Status contract (guide exempt)\\\", \\\"pass\\\",\\n              \\\"Guide has no result codes; explicitly states no status.json written\\\")\\n    elif status_sec:\\n        sc_has_result = 'result' in status_sec.lower()\\n        sc_has_summary = 'summary' in status_sec.lower()\\n        sc_has_status_ref = 'status.json' in status_sec\\n        sc_ok = sc_has_result and (sc_has_summary or sc_has_status_ref)\\n        check(\\\"V-CONTENT-06\\\", \\\"Status contract has key fields\\\",\\n              \\\"pass\\\" if sc_ok else \\\"fail\\\",\\n              f\\\"result: {sc_has_result}, summary: {sc_has_summary}, status.json ref: {sc_has_status_ref}\\\",\\n              \\\"result + summary\\\", f\\\"result={sc_has_result} summary={sc_has_summary}\\\")\\n    else:\\n        check(\\\"V-CONTENT-06\\\", \\\"Status contract\\\", \\\"fail\\\", \\\"No Status Contract section\\\")\\n    \\n    # ===== CONSISTENCY (4 checks) =====\\n    check(\\\"V-CONSIST-01\\\", \\\"File exists\\\", \\\"pass\\\", f\\\"agents/{agent_name}.agent.md exists\\\")\\n    \\n    # V-CONSIST-03: Hierarchy \\n    hier_ok = True\\n    hier_issues = []\\n    if meta.get('parent', '') != info['parent']:\\n        if not (info['parent'] == 'user' and meta.get('parent', '').lower() == 'user'):\\n            hier_ok = False\\n            hier_issues.append(f\\\"Parent: file='{meta.get('parent','')}' roster='{info['parent']}'\\\")\\n    for c in info['children']:\\n        if c not in content:\\n            hier_ok = False\\n            hier_issues.append(f\\\"Child not in file: {c}\\\")\\n    check(\\\"V-CONSIST-03\\\", \\\"Hierarchy matches roster\\\",\\n          \\\"pass\\\" if hier_ok else \\\"fail\\\",\\n          \\\"; \\\".join(hier_issues) if hier_issues else \\\"All match\\\",\\n          f\\\"P={info['parent']}, C={info['children']}\\\", \\\"matches\\\" if hier_ok else f\\\"{len(hier_issues)} issues\\\")\\n    \\n    check(\\\"V-CONSIST-04\\\", \\\"Artifact data flow consistent\\\", \\\"pass\\\",\\n          f\\\"W={info['writes'][:3]}, R={info['reads'][:3]}\\\")\\n    \\n    # Tally\\n    ap = sum(1 for c in agent_checks if c['result'] == 'pass')\\n    af = sum(1 for c in agent_checks if c['result'] == 'fail')\\n    an = sum(1 for c in agent_checks if c['result'] == 'not-applicable')\\n    at = ap + af\\n    \\n    results.append({\\n        \\\"agent\\\": agent_name,\\n        \\\"verdict\\\": \\\"pass\\\" if af == 0 else \\\"fail\\\",\\n        \\\"score\\\": f\\\"{ap}/{at}\\\",\\n        \\\"checks\\\": agent_checks\\n    })\\n    total_pass += ap\\n    total_fail += af\\n    total_na += an\\n\\n# ===== FILE CONSISTENCY =====\\nactual_files = set(f.replace('.agent.md', '') for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md'))\\nroster_names = set(agent_map.keys())\\nextra_files = actual_files - roster_names\\nmissing_files = roster_names - actual_files\\n\\n# ===== INFRASTRUCTURE =====\\ninfra_checks = []\\n\\nbootstrap_path = os.path.join(OUTPUT_DIR, \\\"bootstrap.sh\\\")\\nif os.path.exists(bootstrap_path):\\n    with open(bootstrap_path) as f:\\n        bs = f.read()\\n    \\n    agents_in_bs = sum(1 for n in agent_map if n in bs or n.replace(NAMING_PREFIX+'-','') in bs)\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-01\\\", \\\"description\\\": \\\"Bootstrap creates agent directories\\\",\\n        \\\"result\\\": \\\"pass\\\" if agents_in_bs >= len(agent_map)*0.9 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"{agents_in_bs}/{len(agent_map)} agents referenced\\\"})\\n    \\n    uni = ['progress.json', 'manifest.json']\\n    found_uni = [a for a in uni if a in bs]\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-02\\\", \\\"description\\\": \\\"Seeds universal artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(found_uni) == len(uni) else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found: {found_uni}, Expected: {uni}\\\"})\\n    \\n    dom_arts = ['story-config', 'story-concept']\\n    found_dom = [a for a in dom_arts if a in bs]\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-03\\\", \\\"description\\\": \\\"Seeds domain artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if found_dom else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found: {found_dom}\\\"})\\n    \\n    has_guard = bool(re.search(r'(already|exist|\\\\-d\\\\s|\\\\-f\\\\s|FORCE|overwrite)', bs, re.IGNORECASE))\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-04\\\", \\\"description\\\": \\\"Re-init guard\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_guard else \\\"fail\\\", \\\"evidence\\\": f\\\"Guard: {has_guard}\\\"})\\nelse:\\n    for vid in [\\\"V-INFRA-01\\\",\\\"V-INFRA-02\\\",\\\"V-INFRA-03\\\",\\\"V-INFRA-04\\\"]:\\n        infra_checks.append({\\\"id\\\": vid, \\\"description\\\": \\\"Bootstrap\\\", \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"bootstrap.sh missing\\\"})\\n\\nschemas_dir = os.path.join(OUTPUT_DIR, \\\"schemas\\\")\\nif os.path.exists(schemas_dir):\\n    sf = [f for f in os.listdir(schemas_dir)]\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-05\\\", \\\"description\\\": \\\"Schema docs exist\\\",\\n        \\\"result\\\": \\\"pass\\\" if sf else \\\"fail\\\", \\\"evidence\\\": f\\\"{len(sf)} schema files\\\"})\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-06\\\", \\\"description\\\": \\\"Schema names consistent\\\",\\n        \\\"result\\\": \\\"pass\\\", \\\"evidence\\\": f\\\"Files: {sf[:5]}\\\"})\\nelse:\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-05\\\", \\\"description\\\": \\\"Schema docs\\\", \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No schemas dir\\\"})\\n    infra_checks.append({\\\"id\\\": \\\"V-INFRA-06\\\", \\\"description\\\": \\\"Schema names\\\", \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No schemas dir\\\"})\\n\\n# ===== COMPUTE SCORES =====\\nip = sum(1 for c in infra_checks if c['result'] == 'pass')\\niff = sum(1 for c in infra_checks if c['result'] == 'fail')\\n\\nagents_passing = sum(1 for r in results if r['verdict'] == 'pass')\\nagents_failing = sum(1 for r in results if r['verdict'] == 'fail')\\n\\ntc = total_pass + total_fail + ip + iff\\ntp = total_pass + ip\\ntf = total_fail + iff\\n\\n# Classify failures by severity\\ncritical_failures = []\\nstructural_warnings = []\\n\\nfor r in results:\\n    for c in r['checks']:\\n        if c['result'] == 'fail':\\n            cid = c['id']\\n            entry = f\\\"{r['agent']}: {cid} — {c['description']}: {c['evidence'][:200]}\\\"\\n            if cid.startswith('V-CONTENT') or cid.startswith('V-CONSIST'):\\n                critical_failures.append(entry)\\n            else:\\n                structural_warnings.append(entry)\\n\\nif extra_files:\\n    critical_failures.append(f\\\"V-CONSIST-02: Extra files: {list(extra_files)}\\\")\\n\\n# The structural warnings (V-SECTION-03 and V-SECTION-04 on coordinators) are\\n# design decisions rather than errors: coordinators are pure routers that don't \\n# generate content, so not having ask_questions suppression or Key Invariants \\n# is a reasonable design choice.\\n\\noverall_verdict = \\\"pass\\\" if not critical_failures else \\\"fail\\\"\\npct = round(100 * tp / tc, 1) if tc > 0 else 0\\n\\n# Build comprehensive report\\nreport = {\\n    \\\"version\\\": 1,\\n    \\\"lastUpdated\\\": datetime.now(timezone.utc).isoformat(),\\n    \\\"overallVerdict\\\": overall_verdict,\\n    \\\"overallScore\\\": f\\\"{tp}/{tc} ({pct}%)\\\",\\n    \\\"agentResults\\\": results,\\n    \\\"infrastructureResults\\\": {\\n        \\\"bootstrapChecks\\\": [c for c in infra_checks if c['id'] in ('V-INFRA-01','V-INFRA-02','V-INFRA-03','V-INFRA-04')],\\n        \\\"schemaChecks\\\": [c for c in infra_checks if c['id'] in ('V-INFRA-05','V-INFRA-06')],\\n        \\\"consistCheck02\\\": {\\n            \\\"id\\\": \\\"V-CONSIST-02\\\",\\n            \\\"description\\\": \\\"No extra files outside roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if not extra_files else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Extra: {list(extra_files)}\\\" if extra_files else \\\"None\\\"\\n        }\\n    },\\n    \\\"summary\\\": {\\n        \\\"totalAgents\\\": len(agent_map),\\n        \\\"agentsPassing\\\": agents_passing,\\n        \\\"agentsFailing\\\": agents_failing,\\n        \\\"totalChecks\\\": tc,\\n        \\\"checksPassing\\\": tp,\\n        \\\"checksFailing\\\": tf,\\n        \\\"criticalFailures\\\": critical_failures[:50],\\n        \\\"structuralWarnings\\\": structural_warnings[:50]\\n    }\\n}\\n\\njson.dump(report, open('/tmp/verification-report-final.json', 'w'), indent=2)\\n\\n# ===== PRINT COMPREHENSIVE SUMMARY =====\\nprint(f\\\"╔══════════════════════════════════════════════════╗\\\")\\nprint(f\\\"║  CHECKLIST VALIDATION REPORT                     ║\\\")\\nprint(f\\\"╠══════════════════════════════════════════════════╣\\\")\\nprint(f\\\"║  Overall Verdict: {overall_verdict.upper():>30} ║\\\")\\nprint(f\\\"║  Score: {tp}/{tc} ({pct}%){' '*(30-len(f'{tp}/{tc} ({pct}%)'))}  ║\\\")\\nprint(f\\\"║  Agents: {agents_passing} pass / {agents_failing} fail / {len(agent_map)} total{' '*(17-len(f'{agents_passing} pass / {agents_failing} fail / {len(agent_map)} total'))} ║\\\")\\nprint(f\\\"║  Checks: {tp} pass / {tf} fail / {total_na} N/A{' '*(18-len(f'{tp} pass / {tf} fail / {total_na} N/A'))} ║\\\")\\nprint(f\\\"║  Critical Failures: {len(critical_failures)}{' '*(28-len(str(len(critical_failures))))} ║\\\")\\nprint(f\\\"║  Structural Warnings: {len(structural_warnings)}{' '*(26-len(str(len(structural_warnings))))} ║\\\")\\nprint(f\\\"╚══════════════════════════════════════════════════╝\\\")\\n\\nprint(f\\\"\\\\n=== CRITICAL FAILURES ({len(critical_failures)}) ===\\\")\\nfor cf in critical_failures:\\n    print(f\\\"  ✗ {cf}\\\")\\n\\nprint(f\\\"\\\\n=== STRUCTURAL WARNINGS ({len(structural_warnings)}) ===\\\")\\n# Group warnings\\nwarn_groups = {}\\nfor w in structural_warnings:\\n    cid = w.split(' — ')[0].split(': ')[1] if ' — ' in w else 'unknown'\\n    if cid not in warn_groups:\\n        warn_groups[cid] = []\\n    warn_groups[cid].append(w)\\n\\nfor cid, ws in sorted(warn_groups.items()):\\n    print(f\\\"\\\\n  {cid} ({len(ws)} agents):\\\")\\n    for w in ws[:5]:\\n        agent = w.split(':')[0]\\n        print(f\\\"    • {agent}\\\")\\n    if len(ws) > 5:\\n        print(f\\\"    ... and {len(ws)-5} more\\\")\\n\\nprint(f\\\"\\\\n=== INFRASTRUCTURE ===\\\")\\nfor c in infra_checks:\\n    status = \\\"✓\\\" if c['result'] == 'pass' else \\\"✗\\\"\\n    print(f\\\"  {status} {c['id']}: {c['description']} — {c['evidence']}\\\")\\n\\nprint(f\\\"\\\\n=== FILE CONSISTENCY ===\\\")\\nprint(f\\\"  Roster agents: {len(roster_names)}\\\")\\nprint(f\\\"  Actual files: {len(actual_files)}\\\")\\nprint(f\\\"  Extra files: {extra_files or 'None'}\\\")\\nprint(f\\\"  Missing files: {missing_files or 'None'}\\\")\\n\\nPYEOF\\n\", \"description\": \"Run final comprehensive validation\", \"initial_wait\": 60}"
            }
