              "arguments": "{\"command\": \"python3 -c \\\"\\nimport json\\n\\nwith open('/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/routing.json') as f:\\n    routing = json.load(f)\\n\\nwith open('/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/roster.json') as f:\\n    roster = json.load(f)\\n\\nagents_by_name = {a['name']: a for a in roster['agents']}\\n\\n# For each agent with routing, check if all children's result codes are handled\\nall_ok = True\\nfor agent_name, routing_spec in routing['agents'].items():\\n    rt = routing_spec.get('routingTable', [])\\n    if not rt:\\n        continue\\n    \\n    # Find this agent in roster\\n    roster_agent = agents_by_name.get(agent_name)\\n    if not roster_agent:\\n        print(f'WARNING: {agent_name} in routing but not in roster')\\n        continue\\n    \\n    children = roster_agent.get('children', [])\\n    if not children:\\n        continue\\n    \\n    # Get all handled result codes per child\\n    handled = {}\\n    for r in rt:\\n        read_field = r.get('read', '')\\n        cond = r.get('condition', '')\\n        # Extract agent names from read field\\n        for child_name in children:\\n            short = child_name.replace('romantic-fantasy-writer-', '')\\n            if short in read_field:\\n                if child_name not in handled:\\n                    handled[child_name] = set()\\n                # Extract result codes from condition\\n                if 'blocked' in cond.lower():\\n                    handled[child_name].add('blocked')\\n                if 'complete' in cond.lower():\\n                    handled[child_name].add('complete')\\n                if 'passed' in cond.lower():\\n                    handled[child_name].add('passed')\\n                if 'failed' in cond.lower():\\n                    handled[child_name].add('failed')\\n                if 'revision-loop' in cond.lower():\\n                    handled[child_name].add('revision-loop')\\n\\n    # Check each child's declared result codes\\n    for child_name in children:\\n        child_spec = agents_by_name.get(child_name)\\n        if not child_spec:\\n            continue\\n        declared_codes = set()\\n        for c in child_spec.get('resultCodes', []):\\n            if isinstance(c, dict):\\n                declared_codes.add(c.get('code', c.get('name', '')))\\n            else:\\n                declared_codes.add(c)\\n        \\n        handled_codes = handled.get(child_name, set())\\n        \\n        # Normalize: 'completed' maps to 'complete' in some patterns\\n        normalized_declared = set()\\n        for c in declared_codes:\\n            if c == 'completed':\\n                normalized_declared.add('complete')\\n            else:\\n                normalized_declared.add(c)\\n        \\n        missing = normalized_declared - handled_codes\\n        if missing:\\n            all_ok = False\\n            short_parent = agent_name.replace('romantic-fantasy-writer-', '') if 'romantic-fantasy-writer-' in agent_name else agent_name\\n            short_child = child_name.replace('romantic-fantasy-writer-', '')\\n            print(f'UNHANDLED in {short_parent}: child {short_child} missing handlers for: {missing} (declared: {declared_codes})')\\n\\nif all_ok:\\n    print('ALL RESULT CODES HANDLED: Every child result code for every coordinator/orchestrator has a routing handler.')\\n\\\" 2>&1\", \"description\": \"Deep audit all coordinator routes\"}"
            }
          }
        ],
