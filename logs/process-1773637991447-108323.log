              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json, datetime\\n\\n# Read all three specialist outputs\\nwith open('.fractal-factory/agents/fractal-factory-coverage-hunter/output.json') as f:\\n    coverage = json.load(f)\\nwith open('.fractal-factory/agents/fractal-factory-artifact-hunter/output.json') as f:\\n    artifact = json.load(f)\\nwith open('.fractal-factory/agents/fractal-factory-infrastructure-hunter/output.json') as f:\\n    infra = json.load(f)\\n\\n# Merge categories (IDs 1-9)\\nall_categories = coverage['categories'] + artifact['categories'] + infra['categories']\\n# Sort by id\\nall_categories.sort(key=lambda c: c['id'])\\n\\n# Compute summary fields\\ntotal_categories = 9\\ncategories_clean = 0\\ncategories_dirty = 0\\ntotal_gaps = 0\\ncritical_gaps = 0\\nwarning_gaps = 0\\nre_entry_targets = set()\\n\\nfor cat in all_categories:\\n    gap_count = len(cat.get('gaps', []))\\n    if gap_count == 0:\\n        categories_clean += 1\\n    else:\\n        categories_dirty += 1\\n    for gap in cat.get('gaps', []):\\n        total_gaps += 1\\n        sev = gap.get('severity', 'warning')\\n        if sev == 'critical':\\n            critical_gaps += 1\\n        else:\\n            warning_gaps += 1\\n        ret = gap.get('reEntryTarget')\\n        if ret:\\n            re_entry_targets.add(ret)\\n\\n# Determine suggested re-entry pass (earliest in pipeline order)\\npass_order = ['discovery', 'analysis', 'planning', 'execution', 'verification']\\nsuggested_re_entry = None\\nfor p in pass_order:\\n    if p in re_entry_targets:\\n        suggested_re_entry = p\\n        break\\n\\n# Determine verdict\\nif total_gaps == 0:\\n    verdict = 'converged'\\nelse:\\n    verdict = 'gaps-found'\\n\\ntimestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()\\n\\n# Build gap-report.json\\ngap_report = {\\n    \\\"version\\\": 1,\\n    \\\"timestamp\\\": timestamp,\\n    \\\"cycle\\\": 1,\\n    \\\"maxCycles\\\": 10,\\n    \\\"verdict\\\": verdict,\\n    \\\"summary\\\": {\\n        \\\"totalCategories\\\": total_categories,\\n        \\\"categoriesClean\\\": categories_clean,\\n        \\\"categoriesDirty\\\": categories_dirty,\\n        \\\"totalGaps\\\": total_gaps,\\n        \\\"criticalGaps\\\": critical_gaps,\\n        \\\"warningGaps\\\": warning_gaps,\\n        \\\"suggestedReEntryPass\\\": suggested_re_entry\\n    },\\n    \\\"specialists\\\": [\\n        {\\n            \\\"agent\\\": \\\"fractal-factory-coverage-hunter\\\",\\n            \\\"result\\\": \\\"dirty\\\",\\n            \\\"categories\\\": [1, 2, 3],\\n            \\\"gapsFound\\\": sum(len(c.get('gaps',[])) for c in coverage['categories'])\\n        },\\n        {\\n            \\\"agent\\\": \\\"fractal-factory-artifact-hunter\\\",\\n            \\\"result\\\": \\\"dirty\\\",\\n            \\\"categories\\\": [4, 5, 6],\\n            \\\"gapsFound\\\": sum(len(c.get('gaps',[])) for c in artifact['categories'])\\n        },\\n        {\\n            \\\"agent\\\": \\\"fractal-factory-infrastructure-hunter\\\",\\n            \\\"result\\\": \\\"dirty\\\",\\n            \\\"categories\\\": [7, 8, 9],\\n            \\\"gapsFound\\\": sum(len(c.get('gaps',[])) for c in infra['categories'])\\n        }\\n    ],\\n    \\\"categories\\\": all_categories\\n}\\n\\nwith open('.fractal-factory/gap-report.json', 'w') as f:\\n    json.dump(gap_report, f, indent=2)\\n\\n# Build coordinator status.json\\nstatus = {\\n    \\\"agent\\\": \\\"fractal-factory-gap-hunting-coordinator\\\",\\n    \\\"task_id\\\": \\\"pass6/coordination\\\",\\n    \\\"status\\\": \\\"completed\\\",\\n    \\\"result\\\": verdict,\\n    \\\"summary\\\": f\\\"Gap hunting pass complete (cycle 1). 3 specialist hunters dispatched. Aggregated 9 categories. Found {total_gaps} gaps ({critical_gaps} critical, {warning_gaps} warning). {categories_clean}/9 categories clean, {categories_dirty}/9 dirty. Suggested re-entry: {suggested_re_entry}.\\\",\\n    \\\"artifacts\\\": [\\\"gap-report.json\\\", \\\"agents/fractal-factory-gap-hunting-coordinator/status.json\\\"],\\n    \\\"next_hint\\\": None,\\n    \\\"iteration\\\": 1\\n}\\n\\nwith open('.fractal-factory/agents/fractal-factory-gap-hunting-coordinator/status.json', 'w') as f:\\n    json.dump(status, f, indent=2)\\n\\n# Prepend to manifest.json\\nwith open('.fractal-factory/manifest.json') as f:\\n    manifest = json.load(f)\\n\\nmanifest_entry = {\\n    \\\"timestamp\\\": timestamp,\\n    \\\"agent\\\": \\\"fractal-factory-gap-hunting-coordinator\\\",\\n    \\\"task_id\\\": \\\"pass6/coordination\\\",\\n    \\\"artifacts\\\": [\\n        \\\"gap-report.json\\\",\\n        \\\"agents/fractal-factory-gap-hunting-coordinator/status.json\\\"\\n    ],\\n    \\\"status\\\": \\\"completed\\\",\\n    \\\"result\\\": verdict,\\n    \\\"iteration\\\": 1,\\n    \\\"summary\\\": status[\\\"summary\\\"]\\n}\\n\\nmanifest.insert(0, manifest_entry)\\n\\nwith open('.fractal-factory/manifest.json', 'w') as f:\\n    json.dump(manifest, f, indent=2)\\n\\nprint(f\\\"✅ gap-report.json: {verdict}\\\")\\nprint(f\\\"   Categories: {categories_clean} clean, {categories_dirty} dirty (of {total_categories})\\\")\\nprint(f\\\"   Gaps: {total_gaps} total ({critical_gaps} critical, {warning_gaps} warning)\\\")\\nprint(f\\\"   Re-entry: {suggested_re_entry}\\\")\\nprint(f\\\"✅ status.json written: result={verdict}\\\")\\nprint(f\\\"✅ manifest.json prepended\\\")\\nPYEOF\", \"description\": \"Aggregate and write gap report\", \"shellId\": \"coord-main\"}"
