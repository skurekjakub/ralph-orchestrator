 'developmental-editor',\\n                      'romance-beta-reader', 'fantasy-beta-reader', 'craft-beta-reader',\\n                      'craft-auditor', 'concept-developer (for sequels)', 'worldbuilder',\\n                      'character-developer']\\n            if r in generic:\\n                continue\\n            full_name = f\\\"romantic-fantasy-writer-{r}\\\" if not r.startswith('romantic-') else r\\n            if r not in roster_names and full_name not in roster_names:\\n                print(f\\\"  GHOST READER: '{r}' for artifact '{name}'\\\")\\n\\nprint(f\\\"\\\\n=== TOTAL GHOST AGENTS IN ARCHITECTURE: {len(ghost_agents)} ===\\\")\\nfor g in sorted(ghost_agents):\\n    print(f\\\"  {g}\\\")\\nPYEOF\\n\", \"description\": \"Check architecture ghost agents\", \"initial_wait\": 10}"
