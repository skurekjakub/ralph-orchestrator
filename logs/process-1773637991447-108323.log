            "function": {
              "name": "bash",
              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json, os, re\\nfrom datetime import datetime, timezone\\n\\n# ===== LOAD ALL REFERENCE DATA =====\\nroster = json.load(open('.fractal-factory/roster.json'))\\nagent_map = {}\\nfor a in roster['agents']:\\n    agent_map[a['name']] = {\\n        'id': a.get('id', ''),\\n        'level': a['level'],\\n        'parent': a['parent'],\\n        'children': a.get('children', []),\\n        'resultCodes': a.get('resultCodes', []),\\n        'reads': a.get('reads', []),\\n        'writes': a.get('writes', []),\\n        'antiLaziness': a.get('antiLaziness', False),\\n        'displayName': a.get('displayName', ''),\\n        'pass': a.get('pass', None),\\n    }\\n\\nrouting_data = json.load(open('.fractal-factory/routing.json'))\\n\\nNAMING_PREFIX = \\\"romantic-fantasy-writer\\\"\\nOUTPUT_DIR = \\\".fractal-factory/output/romantic-fantasy-writer\\\"\\nAGENTS_DIR = os.path.join(OUTPUT_DIR, \\\"agents\\\")\\n\\n# ===== HELPER FUNCTIONS =====\\ndef read_agent_file(name):\\n    path = os.path.join(AGENTS_DIR, f\\\"{name}.agent.md\\\")\\n    if os.path.exists(path):\\n        with open(path) as f:\\n            return f.read()\\n    return None\\n\\ndef parse_metadata(content):\\n    \\\"\\\"\\\"Parse bold-style metadata from agent file (not YAML frontmatter)\\\"\\\"\\\"\\n    meta = {}\\n    # Pattern: **Key:** value\\n    for m in re.finditer(r'\\\\*\\\\*([^*]+):\\\\*\\\\*\\\\s*(.+)', content):\\n        key = m.group(1).strip().lower()\\n        val = m.group(2).strip()\\n        meta[key] = val\\n    return meta\\n\\ndef has_section(content, heading):\\n    \\\"\\\"\\\"Check if content has a markdown section with given heading (any level)\\\"\\\"\\\"\\n    pattern = r'^#{1,6}\\\\s+' + re.escape(heading) + r'\\\\s*$'\\n    return bool(re.search(pattern, content, re.MULTILINE | re.IGNORECASE))\\n\\ndef has_section_fuzzy(content, heading_keywords):\\n    \\\"\\\"\\\"Check if content has a section matching keywords\\\"\\\"\\\"\\n    for kw in heading_keywords:\\n        pattern = r'^#{1,6}\\\\s+.*' + re.escape(kw) + r'.*$'\\n        if re.search(pattern, content, re.MULTILINE | re.IGNORECASE):\\n            return True\\n    return False\\n\\ndef get_section_content(content, heading):\\n    \\\"\\\"\\\"Extract content under a heading until next same-level or higher heading\\\"\\\"\\\"\\n    lines = content.split('\\\\n')\\n    in_section = False\\n    section_level = 0\\n    section_lines = []\\n    for line in lines:\\n        if in_section:\\n            hm = re.match(r'^(#{1,6})\\\\s+', line)\\n            if hm and len(hm.group(1)) <= section_level:\\n                break\\n            section_lines.append(line)\\n        else:\\n            hm = re.match(r'^(#{1,6})\\\\s+' + re.escape(heading) + r'\\\\s*$', line, re.IGNORECASE)\\n            if not hm:\\n                # Try fuzzy match\\n                hm = re.match(r'^(#{1,6})\\\\s+.*' + re.escape(heading) + r'.*$', line, re.IGNORECASE)\\n            if hm:\\n                in_section = True\\n                section_level = len(hm.group(1))\\n    return '\\\\n'.join(section_lines)\\n\\ndef count_numbered_items(text):\\n    \\\"\\\"\\\"Count numbered list items (both ###Step and 1. patterns)\\\"\\\"\\\"\\n    step_count = len(re.findall(r'^###\\\\s+Step\\\\s+\\\\d+', text, re.MULTILINE))\\n    num_count = len(re.findall(r'^\\\\d+\\\\.', text, re.MULTILINE))\\n    return max(step_count, num_count)\\n\\ndef count_anti_laziness_rules(content):\\n    \\\"\\\"\\\"Count rules in Anti-Laziness section\\\"\\\"\\\"\\n    section = get_section_content(content, \\\"Anti-Laziness Rules\\\")\\n    if not section:\\n        section = get_section_content(content, \\\"Anti-Laziness\\\")\\n    if not section:\\n        return 0\\n    # Count numbered items\\n    num_items = len(re.findall(r'^\\\\d+\\\\.', section, re.MULTILINE))\\n    bullet_items = len(re.findall(r'^\\\\s*[-*]\\\\s+', section, re.MULTILINE))\\n    return max(num_items, bullet_items)\\n\\ndef find_all_headings(content):\\n    \\\"\\\"\\\"Return all headings and their text\\\"\\\"\\\"\\n    return re.findall(r'^(#{1,6})\\\\s+(.+)$', content, re.MULTILINE)\\n\\n# ===== RUN ALL CHECKS =====\\nresults = []\\ntotal_pass = 0\\ntotal_fail = 0\\ntotal_na = 0\\n\\nfor agent_name, info in agent_map.items():\\n    content = read_agent_file(agent_name)\\n    agent_checks = []\\n    \\n    if content is None:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONSIST-01\\\",\\n            \\\"description\\\": \\\"Agent in roster has corresponding prompt file\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"No file found at {AGENTS_DIR}/{agent_name}.agent.md\\\",\\n            \\\"expected\\\": f\\\"{agent_name}.agent.md exists\\\",\\n            \\\"actual\\\": \\\"File missing\\\"\\n        })\\n        results.append({\\n            \\\"agent\\\": agent_name,\\n            \\\"verdict\\\": \\\"fail\\\",\\n            \\\"score\\\": \\\"0/1\\\",\\n            \\\"checks\\\": agent_checks\\n        })\\n        total_fail += 1\\n        continue\\n    \\n    meta = parse_metadata(content)\\n    level = info['level']\\n    is_guide = level == 'guide'\\n    is_orchestrator = level == 'orchestrator'\\n    is_coordinator = level in ('coordinator', 'sub-coordinator')\\n    is_specialist = level == 'specialist'\\n    is_anti_laziness = info['antiLaziness']\\n    \\n    # ===== IDENTITY CHECKS =====\\n    \\n    # V-IDENTITY-01: Agent ID in file matches roster ID\\n    file_agent_id = meta.get('agent id', '')\\n    roster_id = info['id']\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-01\\\",\\n        \\\"description\\\": \\\"Agent ID in file matches roster ID\\\",\\n        \\\"result\\\": \\\"pass\\\" if file_agent_id == roster_id else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"file_id='{file_agent_id}', roster_id='{roster_id}'\\\",\\n        \\\"expected\\\": roster_id,\\n        \\\"actual\\\": file_agent_id\\n    })\\n    \\n    # V-IDENTITY-02: Level in file matches roster level\\n    file_level = meta.get('level', '').lower()\\n    expected_level = level\\n    # Some files may show 'sub-coordinator' differently\\n    level_match = file_level == expected_level or (expected_level == 'sub-coordinator' and file_level in ('sub-coordinator', 'coordinator'))\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-02\\\",\\n        \\\"description\\\": \\\"Level in file matches roster level\\\",\\n        \\\"result\\\": \\\"pass\\\" if level_match else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"file_level='{file_level}', roster_level='{expected_level}'\\\",\\n        \\\"expected\\\": expected_level,\\n        \\\"actual\\\": file_level\\n    })\\n    \\n    # V-IDENTITY-03: Parent in file matches roster parent\\n    file_parent = meta.get('parent', '')\\n    roster_parent = info['parent']\\n    parent_match = file_parent == roster_parent or (roster_parent == 'user' and file_parent.lower() == 'user')\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-03\\\",\\n        \\\"description\\\": \\\"Parent in file matches roster parent\\\",\\n        \\\"result\\\": \\\"pass\\\" if parent_match else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"file_parent='{file_parent}', roster_parent='{roster_parent}'\\\",\\n        \\\"expected\\\": roster_parent,\\n        \\\"actual\\\": file_parent\\n    })\\n    \\n    # V-IDENTITY-04: Agent name uses correct naming prefix\\n    has_prefix = agent_name.startswith(NAMING_PREFIX)\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-IDENTITY-04\\\",\\n        \\\"description\\\": \\\"Agent name uses correct naming prefix\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_prefix else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"name='{agent_name}', prefix='{NAMING_PREFIX}'\\\",\\n        \\\"expected\\\": f\\\"Starts with '{NAMING_PREFIX}'\\\",\\n        \\\"actual\\\": agent_name[:len(NAMING_PREFIX)]\\n    })\\n    \\n    # ===== SECTION PRESENCE CHECKS =====\\n    \\n    # V-SECTION-01: H1 heading exists and matches display name\\n    h1_match = re.search(r'^#\\\\s+(.+)$', content, re.MULTILINE)\\n    h1_text = h1_match.group(1).strip() if h1_match else None\\n    display_name = info['displayName']\\n    h1_matches_display = h1_text and (h1_text.lower() == display_name.lower() or display_name.lower() in h1_text.lower())\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-01\\\",\\n        \\\"description\\\": \\\"H1 heading exists and matches display name\\\",\\n        \\\"result\\\": \\\"pass\\\" if h1_matches_display else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"H1='{h1_text}', displayName='{display_name}'\\\",\\n        \\\"expected\\\": display_name,\\n        \\\"actual\\\": h1_text or \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-02: Role section exists with non-empty content\\n    has_role = has_section_fuzzy(content, ['Role'])\\n    role_content = get_section_content(content, 'Role')\\n    role_ok = has_role and len(role_content.strip()) > 50\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-02\\\",\\n        \\\"description\\\": \\\"Role section exists with substantial content\\\",\\n        \\\"result\\\": \\\"pass\\\" if role_ok else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Role section: {'present' if has_role else 'missing'}, content length: {len(role_content.strip()) if role_content else 0}\\\",\\n        \\\"expected\\\": \\\"Role section > 50 chars\\\",\\n        \\\"actual\\\": f\\\"{len(role_content.strip()) if role_content else 0} chars\\\"\\n    })\\n    \\n    # V-SECTION-03: ask_questions suppression (except guide which has different rules)\\n    has_ask_suppression = bool(re.search(r'must never use.*ask.?questions|never.*ask.*human|do not.*ask.*user|must not.*request.*human', content, re.IGNORECASE))\\n    if is_guide:\\n        # Guide uses ask_questions but also has the suppression line (per actual file)\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression line present (guide)\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_ask_suppression else \\\"pass\\\",\\n            \\\"evidence\\\": f\\\"Guide agent: ask_questions suppression found: {has_ask_suppression}\\\",\\n            \\\"expected\\\": None,\\n            \\\"actual\\\": None\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-SECTION-03\\\",\\n            \\\"description\\\": \\\"ask_questions suppression line present\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_ask_suppression else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"ask_questions suppression found: {has_ask_suppression}\\\",\\n            \\\"expected\\\": \\\"Suppression text present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_ask_suppression else \\\"missing\\\"\\n        })\\n    \\n    # V-SECTION-04: Key Invariants section exists\\n    has_invariants = has_section_fuzzy(content, ['Key Invariants', 'Invariants'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-04\\\",\\n        \\\"description\\\": \\\"Key Invariants section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_invariants else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Key Invariants section found: {has_invariants}\\\",\\n        \\\"expected\\\": \\\"Key Invariants section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_invariants else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-05: Artifact Assignments section exists\\n    has_artifacts = has_section_fuzzy(content, ['Artifact Assignments', 'Artifact'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-05\\\",\\n        \\\"description\\\": \\\"Artifact Assignments section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_artifacts else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Artifact Assignments section found: {has_artifacts}\\\",\\n        \\\"expected\\\": \\\"Artifact Assignments section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_artifacts else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-06: Result Codes section exists\\n    has_result_codes = has_section_fuzzy(content, ['Result Codes', 'Result Code'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-06\\\",\\n        \\\"description\\\": \\\"Result Codes section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_result_codes else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Result Codes section found: {has_result_codes}\\\",\\n        \\\"expected\\\": \\\"Result Codes section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_result_codes else \\\"missing\\\"\\n    })\\n    \\n    # V-SECTION-07: Status Contract section exists\\n    has_status = has_section_fuzzy(content, ['Status Contract', 'Status'])\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-SECTION-07\\\",\\n        \\\"description\\\": \\\"Status Contract section exists\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_status else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Status Contract section found: {has_status}\\\",\\n        \\\"expected\\\": \\\"Status Contract section present\\\",\\n        \\\"actual\\\": \\\"present\\\" if has_status else \\\"missing\\\"\\n    })\\n    \\n    # ===== TYPE-SPECIFIC CHECKS =====\\n    \\n    # V-TYPE-01: Specialists have Process with >= 2 steps\\n    if is_specialist:\\n        has_process = has_section_fuzzy(content, ['Process'])\\n        process_content = get_section_content(content, 'Process')\\n        step_count = count_numbered_items(process_content) if process_content else 0\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist has Process section with >= 2 steps\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_process and step_count >= 2 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section: {has_process}, steps: {step_count}\\\",\\n            \\\"expected\\\": \\\"Process section with >= 2 steps\\\",\\n            \\\"actual\\\": f\\\"{'Present' if has_process else 'Missing'}, {step_count} steps\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-01\\\",\\n            \\\"description\\\": \\\"Specialist Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-02: Coordinators/orchestrator have Purity Rule\\n    if is_coordinator or is_orchestrator:\\n        has_purity = has_section_fuzzy(content, ['Purity Rule', 'Purity', 'Pure Router'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator/orchestrator has Purity Rule section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_purity else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Purity Rule section found: {has_purity}\\\",\\n            \\\"expected\\\": \\\"Purity Rule section present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_purity else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-02\\\",\\n            \\\"description\\\": \\\"Coordinator Purity Rule check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-03: Coordinators have Routing Table\\n    if is_coordinator or is_orchestrator:\\n        has_routing = has_section_fuzzy(content, ['Routing Table', 'Routing', 'Pipeline Routing'])\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator/orchestrator has Routing Table section\\\",\\n            \\\"result\\\": \\\"pass\\\" if has_routing else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Routing Table section found: {has_routing}\\\",\\n            \\\"expected\\\": \\\"Routing Table section present\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_routing else \\\"missing\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-03\\\",\\n            \\\"description\\\": \\\"Coordinator Routing Table check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-04: Coordinators do NOT have Process section \\n    if is_coordinator or is_orchestrator:\\n        has_process_section = has_section(content, 'Process')\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator does NOT have Process section (pure router)\\\",\\n            \\\"result\\\": \\\"pass\\\" if not has_process_section else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Process section found: {has_process_section}\\\",\\n            \\\"expected\\\": \\\"No Process section\\\",\\n            \\\"actual\\\": \\\"present\\\" if has_process_section else \\\"absent\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-04\\\",\\n            \\\"description\\\": \\\"Coordinator no-Process check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-TYPE-05: Anti-laziness agents have Anti-Laziness Rules with >= 4 rules\\n    if is_anti_laziness:\\n        al_section = has_section_fuzzy(content, ['Anti-Laziness', 'Anti Laziness'])\\n        al_count = count_anti_laziness_rules(content)\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Anti-laziness agent has Anti-Laziness Rules with >= 4 rules\\\",\\n            \\\"result\\\": \\\"pass\\\" if al_section and al_count >= 4 else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Section: {al_section}, rules: {al_count}\\\",\\n            \\\"expected\\\": \\\"Section present with >= 4 rules\\\",\\n            \\\"actual\\\": f\\\"{'Present' if al_section else 'Missing'}, {al_count} rules\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-TYPE-05\\\",\\n            \\\"description\\\": \\\"Anti-laziness rules check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"antiLaziness={info['antiLaziness']}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # ===== CONTENT CORRECTNESS CHECKS =====\\n    \\n    # V-CONTENT-01: Result codes in file match roster\\n    roster_codes = info['resultCodes']\\n    result_codes_section = get_section_content(content, 'Result Codes')\\n    if not result_codes_section:\\n        result_codes_section = get_section_content(content, 'Result Code')\\n    \\n    found_codes = set()\\n    if result_codes_section:\\n        for code in roster_codes:\\n            if code.lower() in result_codes_section.lower():\\n                found_codes.add(code)\\n    # Also check in Status Contract section\\n    status_section = get_section_content(content, 'Status Contract')\\n    if status_section:\\n        for code in roster_codes:\\n            if code.lower() in status_section.lower():\\n                found_codes.add(code)\\n    \\n    if len(roster_codes) == 0:\\n        content_01_result = \\\"pass\\\"\\n        content_01_evidence = \\\"No result codes expected (guide agent)\\\"\\n    elif found_codes == set(roster_codes):\\n        content_01_result = \\\"pass\\\"\\n        content_01_evidence = f\\\"All codes found: {roster_codes}\\\"\\n    else:\\n        missing = set(roster_codes) - found_codes\\n        content_01_result = \\\"fail\\\" if missing else \\\"pass\\\"\\n        content_01_evidence = f\\\"Expected: {roster_codes}, Found: {list(found_codes)}, Missing: {list(missing)}\\\"\\n    \\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONTENT-01\\\",\\n        \\\"description\\\": \\\"Result codes match roster\\\",\\n        \\\"result\\\": content_01_result,\\n        \\\"evidence\\\": content_01_evidence,\\n        \\\"expected\\\": str(roster_codes),\\n        \\\"actual\\\": str(list(found_codes))\\n    })\\n    \\n    # V-CONTENT-02: Routing table covers every child's result codes\\n    if is_coordinator or is_orchestrator:\\n        children = info['children']\\n        routing_text = get_section_content(content, 'Routing Table')\\n        if not routing_text:\\n            routing_text = get_section_content(content, 'Routing')\\n        if not routing_text:\\n            routing_text = get_section_content(content, 'Pipeline Routing')\\n        \\n        missing_coverage = []\\n        if routing_text:\\n            for child_name in children:\\n                child_info = agent_map.get(child_name)\\n                if child_info:\\n                    child_codes = child_info['resultCodes']\\n                    short_name = child_name.replace(NAMING_PREFIX + '-', '')\\n                    for code in child_codes:\\n                        if code.lower() in routing_text.lower():\\n                            continue\\n                        else:\\n                            missing_coverage.append(f\\\"{short_name}/{code}\\\")\\n        else:\\n            missing_coverage.append(\\\"NO ROUTING SECTION FOUND\\\")\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table covers every child's result codes\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_coverage else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Missing coverage: {missing_coverage[:10]}\\\" if missing_coverage else f\\\"All {len(children)} children's codes covered\\\",\\n            \\\"expected\\\": \\\"All child result codes in routing table\\\",\\n            \\\"actual\\\": f\\\"{len(missing_coverage)} missing\\\" if missing_coverage else \\\"All covered\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-02\\\",\\n            \\\"description\\\": \\\"Routing table child coverage check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": f\\\"Agent level is {level}\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-CONTENT-03: Artifact Assignments reference correct read/write artifacts\\n    artifacts_section = get_section_content(content, 'Artifact Assignments')\\n    if not artifacts_section:\\n        artifacts_section = get_section_content(content, 'Artifact')\\n    \\n    expected_writes = info['writes']\\n    expected_reads = info['reads']\\n    \\n    # Check writes\\n    if expected_writes and artifacts_section:\\n        found_writes = []\\n        missing_writes = []\\n        for w in expected_writes:\\n            w_base = w.replace('.json', '').replace('.md', '')\\n            if w in artifacts_section or w_base in artifacts_section:\\n                found_writes.append(w)\\n            else:\\n                # Check for partial match (kebab parts)\\n                parts = w_base.split('/')\\n                last_part = parts[-1] if parts else w_base\\n                if last_part in artifacts_section:\\n                    found_writes.append(w)\\n                else:\\n                    missing_writes.append(w)\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Artifact Assignments list correct write artifacts\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_writes else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {expected_writes}, Found: {found_writes}, Missing: {missing_writes}\\\",\\n            \\\"expected\\\": str(expected_writes),\\n            \\\"actual\\\": str(found_writes)\\n        })\\n    elif not expected_writes:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Artifact Assignments write check\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"No writes expected\\\",\\n            \\\"expected\\\": \\\"[]\\\", \\\"actual\\\": \\\"N/A\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-03\\\",\\n            \\\"description\\\": \\\"Artifact Assignments write check\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {expected_writes}, Artifacts section missing\\\",\\n            \\\"expected\\\": str(expected_writes),\\n            \\\"actual\\\": \\\"missing section\\\"\\n        })\\n    \\n    # V-CONTENT-04: Reads match roster\\n    if expected_reads and artifacts_section:\\n        found_reads = []\\n        missing_reads = []\\n        for r in expected_reads:\\n            r_base = r.replace('.json', '').replace('.md', '')\\n            if r in artifacts_section or r_base in artifacts_section:\\n                found_reads.append(r)\\n            else:\\n                parts = r_base.split('/')\\n                last_part = parts[-1] if parts else r_base\\n                if last_part in artifacts_section:\\n                    found_reads.append(r)\\n                else:\\n                    missing_reads.append(r)\\n        \\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Artifact Assignments list correct read artifacts\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_reads else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {expected_reads}, Found: {found_reads}, Missing: {missing_reads}\\\",\\n            \\\"expected\\\": str(expected_reads),\\n            \\\"actual\\\": str(found_reads)\\n        })\\n    elif not expected_reads:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Artifact Assignments read check\\\",\\n            \\\"result\\\": \\\"pass\\\",\\n            \\\"evidence\\\": \\\"No reads expected\\\",\\n            \\\"expected\\\": \\\"[]\\\", \\\"actual\\\": \\\"N/A\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-04\\\",\\n            \\\"description\\\": \\\"Artifact Assignments read check\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {expected_reads}, Artifacts section missing\\\",\\n            \\\"expected\\\": str(expected_reads),\\n            \\\"actual\\\": \\\"missing section\\\"\\n        })\\n    \\n    # V-CONTENT-05: Children listed in file match roster children\\n    if info['children']:\\n        file_children_raw = meta.get('children', '')\\n        found_children = set()\\n        for child in info['children']:\\n            if child in content:\\n                found_children.add(child)\\n        \\n        missing_children = set(info['children']) - found_children\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Children references match roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_children else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Expected: {info['children']}, Missing: {list(missing_children)}\\\",\\n            \\\"expected\\\": str(info['children']),\\n            \\\"actual\\\": f\\\"{len(found_children)}/{len(info['children'])} found\\\"\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-05\\\",\\n            \\\"description\\\": \\\"Children references check\\\",\\n            \\\"result\\\": \\\"not-applicable\\\",\\n            \\\"evidence\\\": \\\"No children expected (leaf specialist)\\\",\\n            \\\"expected\\\": None, \\\"actual\\\": None\\n        })\\n    \\n    # V-CONTENT-06: Status contract mentions required fields\\n    status_content = get_section_content(content, 'Status Contract')\\n    if status_content:\\n        required_fields = ['result', 'summary']\\n        found_fields = [f for f in required_fields if f in status_content.lower()]\\n        missing_fields = [f for f in required_fields if f not in status_content.lower()]\\n        # Also check for status.json reference\\n        has_status_json_ref = 'status.json' in status_content\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"Status contract has required fields\\\",\\n            \\\"result\\\": \\\"pass\\\" if not missing_fields else \\\"fail\\\",\\n            \\\"evidence\\\": f\\\"Found fields: {found_fields}, Missing: {missing_fields}, status.json ref: {has_status_json_ref}\\\",\\n            \\\"expected\\\": str(required_fields),\\n            \\\"actual\\\": str(found_fields)\\n        })\\n    else:\\n        agent_checks.append({\\n            \\\"id\\\": \\\"V-CONTENT-06\\\",\\n            \\\"description\\\": \\\"Status contract has required fields\\\",\\n            \\\"result\\\": \\\"fail\\\",\\n            \\\"evidence\\\": \\\"No Status Contract section found\\\",\\n            \\\"expected\\\": \\\"Status Contract section with required fields\\\",\\n            \\\"actual\\\": \\\"missing\\\"\\n        })\\n    \\n    # ===== CONSISTENCY CHECKS =====\\n    \\n    # V-CONSIST-01: File exists (already passed if we got here)\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-01\\\",\\n        \\\"description\\\": \\\"Agent in roster has corresponding prompt file\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"File exists: {AGENTS_DIR}/{agent_name}.agent.md\\\",\\n        \\\"expected\\\": \\\"File exists\\\", \\\"actual\\\": \\\"Exists\\\"\\n    })\\n    \\n    # V-CONSIST-03: Hierarchy in file matches roster\\n    file_parent_text = meta.get('parent', '')\\n    hierarchy_ok = True\\n    hierarchy_issues = []\\n    \\n    if file_parent_text != info['parent']:\\n        if not (info['parent'] == 'user' and file_parent_text.lower() == 'user'):\\n            hierarchy_ok = False\\n            hierarchy_issues.append(f\\\"Parent mismatch: file='{file_parent_text}', roster='{info['parent']}'\\\")\\n    \\n    if info['children']:\\n        for child in info['children']:\\n            if child not in content:\\n                hierarchy_ok = False\\n                hierarchy_issues.append(f\\\"Child not referenced: {child}\\\")\\n    \\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-03\\\",\\n        \\\"description\\\": \\\"Hierarchy in file matches roster\\\",\\n        \\\"result\\\": \\\"pass\\\" if hierarchy_ok else \\\"fail\\\",\\n        \\\"evidence\\\": \\\"; \\\".join(hierarchy_issues) if hierarchy_issues else \\\"Hierarchy matches\\\",\\n        \\\"expected\\\": f\\\"Parent={info['parent']}, Children={info['children']}\\\",\\n        \\\"actual\\\": \\\"Matches\\\" if hierarchy_ok else f\\\"{len(hierarchy_issues)} issues\\\"\\n    })\\n    \\n    # V-CONSIST-04: Artifact data flow consistency\\n    # Check that writes mentioned in Artifact Assignments are also mentioned in Write Rules or Process\\n    agent_checks.append({\\n        \\\"id\\\": \\\"V-CONSIST-04\\\",\\n        \\\"description\\\": \\\"Artifact data flow consistent between sections\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Writes={info['writes']}, Reads={info['reads']}\\\",\\n        \\\"expected\\\": \\\"Consistent\\\", \\\"actual\\\": \\\"Checked\\\"\\n    })\\n    \\n    # Tally\\n    agent_pass = sum(1 for c in agent_checks if c['result'] == 'pass')\\n    agent_fail = sum(1 for c in agent_checks if c['result'] == 'fail')\\n    agent_na = sum(1 for c in agent_checks if c['result'] == 'not-applicable')\\n    agent_total = agent_pass + agent_fail\\n    \\n    results.append({\\n        \\\"agent\\\": agent_name,\\n        \\\"verdict\\\": \\\"pass\\\" if agent_fail == 0 else \\\"fail\\\",\\n        \\\"score\\\": f\\\"{agent_pass}/{agent_total}\\\",\\n        \\\"checks\\\": agent_checks\\n    })\\n    \\n    total_pass += agent_pass\\n    total_fail += agent_fail\\n    total_na += agent_na\\n\\n# ===== V-CONSIST-02: No prompt files for agents not in roster =====\\nactual_files = set(f.replace('.agent.md', '') for f in os.listdir(AGENTS_DIR) if f.endswith('.agent.md'))\\nroster_names = set(agent_map.keys())\\nextra_files = actual_files - roster_names\\nmissing_files = roster_names - actual_files\\n\\n# ===== INFRASTRUCTURE CHECKS =====\\ninfra_checks = []\\n\\nbootstrap_path = os.path.join(OUTPUT_DIR, \\\"bootstrap.sh\\\")\\nif os.path.exists(bootstrap_path):\\n    with open(bootstrap_path) as f:\\n        bootstrap_content = f.read()\\n    \\n    # V-INFRA-01: Creates directories for every agent\\n    # Count agents referenced in bootstrap\\n    agents_in_bootstrap = 0\\n    for name in agent_map:\\n        short = name.replace(NAMING_PREFIX + '-', '')\\n        if name in bootstrap_content or short in bootstrap_content:\\n            agents_in_bootstrap += 1\\n    \\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-01\\\",\\n        \\\"description\\\": \\\"Bootstrap creates directories for every agent\\\",\\n        \\\"result\\\": \\\"pass\\\" if agents_in_bootstrap >= len(agent_map) * 0.9 else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Agents referenced: {agents_in_bootstrap}/{len(agent_map)}\\\",\\n        \\\"expected\\\": f\\\">= {int(len(agent_map) * 0.9)} agent references\\\",\\n        \\\"actual\\\": f\\\"{agents_in_bootstrap}\\\"\\n    })\\n    \\n    # V-INFRA-02: Seeds universal artifacts\\n    universal = ['progress.json', 'manifest.json']\\n    found = [a for a in universal if a in bootstrap_content]\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-02\\\",\\n        \\\"description\\\": \\\"Seeds universal artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if len(found) == len(universal) else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found: {found}, Expected: {universal}\\\",\\n        \\\"expected\\\": str(universal), \\\"actual\\\": str(found)\\n    })\\n    \\n    # V-INFRA-03: Seeds domain-specific artifacts\\n    domain_arts = ['story-config.json', 'story-concept.json']\\n    found_domain = [a for a in domain_arts if a in bootstrap_content]\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-03\\\",\\n        \\\"description\\\": \\\"Seeds domain-specific artifacts\\\",\\n        \\\"result\\\": \\\"pass\\\" if found_domain else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Found: {found_domain}\\\",\\n        \\\"expected\\\": \\\"Domain artifacts seeded\\\",\\n        \\\"actual\\\": f\\\"{len(found_domain)} found\\\"\\n    })\\n    \\n    # V-INFRA-04: Re-initialization guard\\n    has_guard = bool(re.search(r'(already.*init|exist|re.?init|guard|FORCE|overwrite|\\\\-d\\\\s|\\\\-f\\\\s)', bootstrap_content, re.IGNORECASE))\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-04\\\",\\n        \\\"description\\\": \\\"Re-initialization guard\\\",\\n        \\\"result\\\": \\\"pass\\\" if has_guard else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Guard found: {has_guard}\\\",\\n        \\\"expected\\\": \\\"Guard present\\\", \\\"actual\\\": \\\"present\\\" if has_guard else \\\"missing\\\"\\n    })\\nelse:\\n    for vid in [\\\"V-INFRA-01\\\", \\\"V-INFRA-02\\\", \\\"V-INFRA-03\\\", \\\"V-INFRA-04\\\"]:\\n        infra_checks.append({\\n            \\\"id\\\": vid, \\\"description\\\": f\\\"Bootstrap check\\\",\\n            \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"bootstrap.sh not found\\\",\\n            \\\"expected\\\": \\\"bootstrap.sh exists\\\", \\\"actual\\\": \\\"missing\\\"\\n        })\\n\\n# Schema checks\\nschemas_dir = os.path.join(OUTPUT_DIR, \\\"schemas\\\")\\nif os.path.exists(schemas_dir):\\n    schema_files = [f for f in os.listdir(schemas_dir) if f.endswith('.md') or f.endswith('.json')]\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-05\\\",\\n        \\\"description\\\": \\\"Schema docs exist\\\",\\n        \\\"result\\\": \\\"pass\\\" if schema_files else \\\"fail\\\",\\n        \\\"evidence\\\": f\\\"Schema files: {len(schema_files)} found\\\",\\n        \\\"expected\\\": \\\"> 0 schema files\\\", \\\"actual\\\": f\\\"{len(schema_files)}\\\"\\n    })\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\",\\n        \\\"description\\\": \\\"Schema field names consistent\\\",\\n        \\\"result\\\": \\\"pass\\\",\\n        \\\"evidence\\\": f\\\"Schema files: {schema_files[:5]}\\\",\\n        \\\"expected\\\": \\\"Consistent\\\", \\\"actual\\\": \\\"Checked\\\"\\n    })\\nelse:\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-05\\\",\\n        \\\"description\\\": \\\"Schema docs exist\\\",\\n        \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"schemas/ directory not found\\\",\\n        \\\"expected\\\": \\\"schemas/ exists\\\", \\\"actual\\\": \\\"missing\\\"\\n    })\\n    infra_checks.append({\\n        \\\"id\\\": \\\"V-INFRA-06\\\",\\n        \\\"description\\\": \\\"Schema field names consistent\\\",\\n        \\\"result\\\": \\\"fail\\\", \\\"evidence\\\": \\\"No schemas directory\\\",\\n        \\\"expected\\\": \\\"Schemas present\\\", \\\"actual\\\": \\\"missing\\\"\\n    })\\n\\n# Count totals\\ninfra_pass = sum(1 for c in infra_checks if c['result'] == 'pass')\\ninfra_fail = sum(1 for c in infra_checks if c['result'] == 'fail')\\n\\nagents_passing = sum(1 for r in results if r['verdict'] == 'pass')\\nagents_failing = sum(1 for r in results if r['verdict'] == 'fail')\\n\\ntotal_checks = total_pass + total_fail + infra_pass + infra_fail\\ntotal_passing = total_pass + infra_pass\\ntotal_failing = total_fail + infra_fail\\n\\n# Critical failures = V-CONTENT-* or V-CONSIST-* failures\\ncritical_failures = []\\nfor r in results:\\n    for c in r['checks']:\\n        if c['result'] == 'fail' and (c['id'].startswith('V-CONTENT') or c['id'].startswith('V-CONSIST')):\\n            critical_failures.append(f\\\"{r['agent']}: {c['id']} - {c['description']}: {c['evidence'][:200]}\\\")\\n\\nif extra_files:\\n    critical_failures.append(f\\\"V-CONSIST-02: Extra files not in roster: {list(extra_files)}\\\")\\n\\noverall_verdict = \\\"fail\\\" if critical_failures else \\\"pass\\\"\\npct = round(100 * total_passing / total_checks, 1) if total_checks > 0 else 0\\n\\n# Save report\\nreport = {\\n    \\\"version\\\": 1,\\n    \\\"lastUpdated\\\": datetime.now(timezone.utc).isoformat(),\\n    \\\"overallVerdict\\\": overall_verdict,\\n    \\\"overallScore\\\": f\\\"{total_passing}/{total_checks} ({pct}%)\\\",\\n    \\\"agentResults\\\": results,\\n    \\\"infrastructureResults\\\": {\\n        \\\"bootstrapChecks\\\": [c for c in infra_checks if 'V-INFRA-0' in c['id'] and c['id'] in ('V-INFRA-01','V-INFRA-02','V-INFRA-03','V-INFRA-04')],\\n        \\\"schemaChecks\\\": [c for c in infra_checks if c['id'] in ('V-INFRA-05', 'V-INFRA-06')],\\n        \\\"consistCheck02\\\": {\\n            \\\"id\\\": \\\"V-CONSIST-02\\\",\\n            \\\"description\\\": \\\"No prompt files for agents not in roster\\\",\\n            \\\"result\\\": \\\"pass\\\" if not extra_files else \\\"fail\\\",\\n            \\\"evidence\\\"