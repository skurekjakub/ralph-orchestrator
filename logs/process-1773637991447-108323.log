s = {a['name'] for a in agents}\\n\\n# Check all full-prefix writer names resolve to roster agents\\nprefixed_writers = [w for w in all_writers if w.startswith('romantic-fantasy-writer')]\\nmissing = [w for w in prefixed_writers if w not in roster_names]\\nif missing:\\n    print(f\\\"   WARNING: Writers with prefix not in roster: {missing}\\\")\\nelse:\\n    print(f\\\"   PASS: All {len(prefixed_writers)} prefixed writer names exist in roster\\\")\\n\\n# 5. AC-001 fix\\nfor artifact in arch['artifacts']['domainSpecific']:\\n    if artifact['name'] == 'chapter-summaries/{N}.json':\\n        w = artifact['writers']\\n        if w == ['romantic-fantasy-writer-summary-generator']:\\n            print(\\\"   PASS: AC-001 — chapter-summaries writer = summary-generator\\\")\\n        else:\\n            print(f\\\"   FAIL: AC-001 — chapter-summaries writer = {w}\\\")\\n\\n# 6. AC-002 fix\\nfor artifact in arch['artifacts']['domainSpecific']:\\n    if artifact['name'] == 'craft-profile.json':\\n        w = artifact['writers']\\n        p = artifact['writeProtocol']\\n        if w == ['romantic-fantasy-writer-craft-profile-selector'] and p == 'create-once':\\n            print(\\\"   PASS: AC-002 — craft-profile single writer + create-once\\\")\\n        else:\\n            print(f\\\"   FAIL: AC-002 — craft-profile writers={w}, protocol={p}\\\")\\n\\n# 7. BC-W01 fix\\nfor artifact in arch['artifacts']['domainSpecific']:\\n    if artifact['name'] == 'series-kb/index.json':\\n        if artifact.get('pathNote'):\\n            print(\\\"   PASS: BC-W01 — series-kb/index.json has pathNote\\\")\\n        else:\\n            print(\\\"   FAIL: BC-W01 — missing pathNote\\\")\\n\\n# 8. RC-001/RC-002\\nfor agent in agents:\\n    if agent['name'] == 'romantic-fantasy-writer-craft-tracker':\\n        if 'blocked' in agent['resultCodes']:\\n            print(\\\"   PASS: RC-001 — craft-tracker has 'blocked'\\\")\\n        else:\\n            print(f\\\"   FAIL: RC-001 — craft-tracker 