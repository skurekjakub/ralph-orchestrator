              "name": "bash",
              "arguments": "{\"command\": \"python3 << 'PYEOF'\\nimport json, os\\n\\n# Category 5: Test Coverage Analysis\\nwith open('.fractal-factory/test-plan.json') as f:\\n    tp = json.load(f)\\nwith open('.fractal-factory/roster.json') as f:\\n    roster = json.load(f)\\n\\nscenarios = tp['scenarios']\\ncategories = {}\\nfor s in scenarios:\\n    cat = s['category']\\n    categories.setdefault(cat, []).append(s)\\n\\nprint(\\\"=== TEST CATEGORIES ===\\\")\\nfor cat, tests in sorted(categories.items()):\\n    print(f\\\"  {cat}: {len(tests)} tests\\\")\\n    for t in tests:\\n        print(f\\\"    {t['id']} [{t['priority']}] {t['name']}\\\")\\n\\n# Check coverage requirements\\nprint(\\\"\\\\n=== COVERAGE CHECK ===\\\")\\n\\n# 1. Agent types: every level has at least one test\\nlevels = set(a['level'] for a in roster['agents'])\\nprint(f\\\"\\\\nAgent levels in roster: {sorted(levels)}\\\")\\n\\n# Check which levels appear in test scenarios\\nprint(\\\"\\\\nChecking agent level coverage in tests...\\\")\\n# Read test descriptions for mentions of agent types\\nfor s in scenarios:\\n    desc = s.get('description', '') + ' ' + s.get('name', '') + ' ' + str(s.get('trigger', ''))\\n    desc = desc.lower()\\n\\n# 2. Pipeline passes\\nphases = set()\\nfor a in roster['agents']:\\n    p = a.get('pass')\\n    if p:\\n        phases.add(p)\\n    \\nprint(f\\\"\\\\nPipeline passes in roster: {sorted(phases)}\\\")\\n\\n# Check which passes are explicitly tested\\nphase_tested = {}\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    for phase in ['concept', 'worldbuilding', 'character', 'plotting', 'style', 'drafting', 'revision', 'beta-reading', 'beta_reading', 'polish']:\\n        if phase in desc:\\n            phase_tested.setdefault(phase.replace('_', '-'), []).append(s['id'])\\n\\nprint(\\\"\\\\nPhases covered by tests:\\\")\\nfor phase in sorted(phases):\\n    tests = phase_tested.get(phase, [])\\n    status = \\\"COVERED\\\" if tests else \\\"UNCOVERED\\\"\\n    print(f\\\"  {phase}: {status} ({tests})\\\")\\n\\n# 3. Error paths\\nprint(\\\"\\\\nError path coverage:\\\")\\nerror_categories = ['blocked', 'failed', 'convergence']\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    for err in error_categories:\\n        if err in desc:\\n            print(f\\\"  {err}: {s['id']} {s['name']}\\\")\\n\\n# 4. Re-entry\\nprint(\\\"\\\\nRe-entry tests:\\\")\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    if 'reentry' in desc or 're-entry' in desc or 're_entry' in desc:\\n        print(f\\\"  {s['id']} {s['name']}\\\")\\n\\n# 5. Convergence\\nprint(\\\"\\\\nConvergence tests:\\\")\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    if 'convergence' in desc or 'exhaustion' in desc or 'forced' in desc:\\n        print(f\\\"  {s['id']} {s['name']}\\\")\\n\\n# 6. Forced delivery\\nprint(\\\"\\\\nForced delivery tests:\\\")\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    if 'forced' in desc or 'delivered-with-gaps' in desc or 'force' in desc:\\n        print(f\\\"  {s['id']} {s['name']}\\\")\\n\\n# 7. Check if guide agent is tested\\nprint(\\\"\\\\nGuide agent tests:\\\")\\nfor s in scenarios:\\n    desc = json.dumps(s).lower()\\n    if 'guide' in desc:\\n        print(f\\\"  {s['id']} {s['name']}\\\")\\n\\nPYEOF\\n\", \"description\": \"Category 5 test coverage analysis\", \"initial_wait\": 10}"
