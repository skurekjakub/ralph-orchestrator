er_names:\\n                    print(f\\\"  MISSING IN ROSTER: '{a}' in parallelGroups of '{agent_name}'\\\")\\n\\n# Check 2: All roster agents have prompt files\\nprint(\\\"\\\\n=== CHECK 2: Roster agents vs prompt files ===\\\")\\noutput_dir = '.fractal-factory/output/romantic-fantasy-writer/agents/'\\nprompt_files = set()\\nfor f in os.listdir(output_dir):\\n    if f.endswith('.agent.md'):\\n        name = f.replace('.agent.md', '')\\n        prompt_files.add(name)\\n\\nfor a in roster['agents']:\\n    name = a['name']\\n    if name not in prompt_files:\\n        print(f\\\"  MISSING PROMPT: '{name}' in roster but no .agent.md file\\\")\\n\\n# Check 3: Prompt files not in roster\\nprint(\\\"\\\\n=== CHECK 3: Orphan prompt files (not in roster) ===\\\")\\nfor pf in sorted(prompt_files):\\n    if pf not in roster_names:\\n        print(f\\\"  ORPHAN PROMPT: '{pf}' has .agent.md but not in roster\\\")\\n\\n# Check 4: All roster agents with routing tables have routing entries\\nprint(\\\"\\\\n=== CHECK 4: Roster routingTable field vs routing.json ===\\\")\\nfor a in roster['agents']:\\n    name = a['name']\\n    has_routing_field = a.get('routingTable') is not None\\n    has_routing_entry = name in routing.get('agents', {})\\n    level = a['level']\\n    \\n    # Coordinators and orchestrators should have routing tables\\n    if level in ['orchestrator', 'coordinator', 'sub-coordinator']:\\n        if not has_routing_entry:\\n            print(f\\\"  MISSING ROUTING: '{name}' (level={level}) has no routing.json entry\\\")\\n\\n# Check 5: Result codes in routing match roster\\nprint(\\\"\\\\n=== CHECK 5: Result codes in routing vs roster ===\\\")\\nfor agent_name, table in routing.get('agents', {}).items():\\n    rt = table.get('routingTable', [])\\n    if not rt:\\n        continue\\n    for entry in rt:\\n        condition = entry.get('condition', '')\\n        # Extract result codes from conditions like \\\"result == 'completed'\\\"\\n        if \\\"result ==\\\" in condition:\\n            code = condition.split(\\\"'\\\")[1] if \\\"'\\\" in condition else condition.split('\\\"')[1] if '\\\"' in condition else None\\n            if code:\\n                # Find which agent this condition refers to\\n                read_path = entry.get('read', '')\\n                # Extract agent short name from path like \\\"agents/concept-developer/status.json\\\"\\n                if read_path.startswith('agents/') and '/status.json' in read_path:\\n                    short_name = read_path.split('/')[1]\\n                    full_name = f\\\"romantic-fantasy-writer-{short_name}\\\"\\n                    if full_name in roster_by_name:\\n                        valid_codes = roster_by_name[full_name].get('resultCodes', [])\\n                        if code not in valid_codes:\\n                            print(f\\\"  INVALID CODE: '{code}' for '{full_name}' in routing of '{agent_name}' (valid: {valid_codes})\\\")\\n\\n# Check 6: Roster children match routing dispatch\\nprint(\\\"\\\\n=== CHECK 6: Roster children vs routing dispatchOrder ===\\\")\\nfor a in roster['agents']:\\n    name = a['name']\\n    children = set(a.get('children', []))\\n    if name in routing.get('agents', {}):\\n        dispatch = set(routing['agents'][name].get('dispatchOrder', []))\\n        \\n        missing_in_dispatch = children - dispatch\\n        extra_in_dispatch = dispatch - children\\n        \\n        if missing_in_dispatch:\\n            print(f\\\"  ROSTER CHILD NOT IN DISPATCH: {name} -> {missing_in_dispatch}\\\")\\n        if extra_in_dispatch:\\n            print(f\\\"  DISPATCH NOT IN ROSTER CHILDREN: {name} -> {extra_in_dispatch}\\\")\\n\\nPYEOF\\n\", \"description\": \"Category 6 cross-reference integrity\", \"initial_wait\": 15}"
