              "arguments": "{\"command\": \"python3 << 'PYEOF'\\nimport json\\n\\n# Load all data\\nwith open('.fractal-factory/architecture.json') as f:\\n    arch = json.load(f)\\nwith open('.fractal-factory/roster.json') as f:\\n    roster = json.load(f)\\n\\n# Build roster maps\\nroster_names = set(a['name'] for a in roster['agents'])\\nroster_writes = {}  # artifact -> [agent names]\\nroster_reads = {}   # artifact -> [agent names]\\nfor a in roster['agents']:\\n    for w in a.get('writes', []):\\n        roster_writes.setdefault(w, []).append(a['name'])\\n    for r in a.get('reads', []):\\n        roster_reads.setdefault(r, []).append(a['name'])\\n\\n# Print unique artifacts from roster\\nprint(\\\"=== UNIQUE ARTIFACTS WRITTEN BY ROSTER AGENTS ===\\\")\\nfor art in sorted(roster_writes.keys()):\\n    print(f\\\"  WRITE: {art} <-- {roster_writes[art]}\\\")\\n\\nprint(\\\"\\\\n=== UNIQUE ARTIFACTS READ BY ROSTER AGENTS ===\\\")\\nfor art in sorted(roster_reads.keys()):\\n    print(f\\\"  READ: {art} <-- {', '.join(roster_reads[art][:3])}\\\")\\n\\n# Now check each architecture artifact\\nprint(\\\"\\\\n=== ARCHITECTURE ARTIFACT COVERAGE CHECK ===\\\")\\nall_arch_artifacts = []\\nfor category in ['universal', 'domainSpecific', 'crossCutting']:\\n    items = arch['artifacts'].get(category, [])\\n    for item in items:\\n        name = item['name']\\n        all_arch_artifacts.append(name)\\n        \\n        # Check if artifact has a roster writer\\n        has_writer = name in roster_writes\\n        # For pattern-based names, check patterns\\n        if not has_writer and '{' in name:\\n            base = name.split('{')[0].rstrip('/')\\n            has_writer = any(w.startswith(base) or w == name for w in roster_writes)\\n            if not has_writer:\\n                # Check exact match with template\\n                has_writer = name in roster_writes\\n        \\n        has_reader = name in roster_reads\\n        if not has_reader and '{' in name:\\n            base = name.split('{')[0].rstrip('/')\\n            has_reader = any(r.startswith(base) or r == name for r in roster_reads)\\n            if not has_reader:\\n                has_reader = name in roster_reads\\n        \\n        status = \\\"OK\\\" if (has_writer and has_reader) else \\\"ISSUE\\\"\\n        if not has_writer:\\n            status += \\\" NO-WRITER-IN-ROSTER\\\"\\n        if not has_reader:\\n            status += \\\" NO-READER-IN-ROSTER\\\"\\n        \\n        if status != \\\"OK\\\":\\n            arch_writers = item.get('writers', [])\\n            print(f\\\"  [{status}] {name}\\\")\\n            print(f\\\"    Arch writers: {arch_writers}\\\")\\n            print(f\\\"    Roster writers: {roster_writes.get(name, 'NONE')}\\\")\\n            print(f\\\"    Roster readers: {roster_reads.get(name, 'NONE')}\\\")\\n\\n# Check for roster artifacts not in architecture\\nprint(\\\"\\\\n=== ROSTER ARTIFACTS NOT IN ARCHITECTURE ===\\\")\\narch_artifact_set = set(all_arch_artifacts)\\nall_roster_artifacts = set(roster_writes.keys()) | set(roster_reads.keys())\\nfor art in sorted(all_roster_artifacts):\\n    if art not in arch_artifact_set and not art.startswith('agents/'):\\n        # Check if it matches a pattern in architecture\\n        matched = False\\n        for arch_art in arch_artifact_set:\\n            if '{' in arch_art:\\n                # Simple pattern match\\n                parts = arch_art.split('{')\\n                prefix = parts[0]\\n                if art.startswith(prefix):\\n                    matched = True\\n                    break\\n        if not matched:\\n            print(f\\\"  ORPHAN: {art}\\\")\\nPYEOF\\n\", \"description\": \"Category 4 artifact coverage analysis\", \"initial_wait\": 15}"
