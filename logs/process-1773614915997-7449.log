:\\n        print(f\\"  ⚠ Entry count mismatch: routing.json has {len(rt)}, prompt has {len(table_rows)}\\")\\n    else:\\n        print(f\\"  ✅ Entry count matches: {len(rt)}\\")\\n    \\n    # Check result codes from roster\\n    roster_data = roster_map.get(agent_name, {})\\n    roster_codes = roster_data.get('resultCodes', [])\\n    missing_codes = [c for c in roster_codes if c not in content]\\n    if missing_codes:\\n        print(f\\"  ❌ MISSING result codes: {missing_codes}\\")\\n    else:\\n        print(f\\"  ✅ All result codes present: {roster_codes}\\")\\n    \\n    # Check children from roster vs routing\\n    roster_children = roster_data.get('children', [])\\n    route_children_from_dispatch = dispatch_order\\n    \\n    roster_set = set(roster_children)\\n    route_set = set(route_children_from_dispatch)\\n    \\n    if roster_set != route_set:\\n        only_in_roster = roster_set - route_set\\n        only_in_routing = route_set - roster_set\\n        if only_in_roster:\\n            print(f\\"  ⚠ Children in roster but not dispatch: {only_in_roster}\\")\\n        if only_in_routing:\\n            print(f\\"  ⚠ Children in dispatch but not roster: {only_in_routing}\\")\\n    else:\\n        print(f\\"  ✅ Children match between roster and routing\\")\\nPYEOF","description":"Cross-ref routing tables","initial_wait":30}`,
