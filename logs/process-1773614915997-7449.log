              "arguments": "{\"command\": \"cat > /tmp/build_routing.py << 'PYEOF'\\nimport json\\nfrom datetime import datetime, timezone\\n\\nnow = datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\n\\nrouting = {\\n    \\\"version\\\": 1,\\n    \\\"lastUpdated\\\": now,\\n    \\\"designNotes\\\": \\\"Routing tables for the romantic-fantasy-writer produced agent system. Covers 1 orchestrator, 9 coordinators, and 10 sub-coordinators. All paths are relative to the per-book output directory.\\\",\\n    \\\"globalBounds\\\": {\\n        \\\"maxAuditorRetries\\\": 3,\\n        \\\"maxRevisionBetaCycles\\\": 2,\\n        \\\"maxChaptersBeforeCheckpoint\\\": 5,\\n        \\\"notes\\\": \\\"maxAuditorRetries bounds writer→auditor loops at coordinator level. maxRevisionBetaCycles bounds the revision↔beta-reading feedback loop at orchestrator level.\\\"\\n    },\\n    \\\"agents\\\": {}\\n}\\n\\n# ─────────────────────────────────────────────────\\n# ORCHESTRATOR\\n# ─────────────────────────────────────────────────\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer\\\"] = {\\n    \\\"id\\\": \\\"A-002\\\",\\n    \\\"displayName\\\": \\\"Session Orchestrator\\\",\\n    \\\"level\\\": \\\"orchestrator\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-concept-coordinator\\\",\\n        \\\"romantic-fantasy-writer-worldbuilding-coordinator\\\",\\n        \\\"romantic-fantasy-writer-character-coordinator\\\",\\n        \\\"romantic-fantasy-writer-plotting-coordinator\\\",\\n        \\\"romantic-fantasy-writer-style-coordinator\\\",\\n        \\\"romantic-fantasy-writer-craft-tracker\\\",\\n        \\\"romantic-fantasy-writer-drafting-coordinator\\\",\\n        \\\"romantic-fantasy-writer-continuity-tracker\\\",\\n        \\\"romantic-fantasy-writer-revision-coordinator\\\",\\n        \\\"romantic-fantasy-writer-beta-reading-coordinator\\\",\\n        \\\"romantic-fantasy-writer-polish-coordinator\\\",\\n        \\\"romantic-fantasy-writer-series-kb-manager\\\"\\n    ],\\n    \\\"phaseMap\\\": {\\n        \\\"concept\\\": \\\"romantic-fantasy-writer-concept-coordinator\\\",\\n        \\\"worldbuilding\\\": \\\"romantic-fantasy-writer-worldbuilding-coordinator\\\",\\n        \\\"character\\\": \\\"romantic-fantasy-writer-character-coordinator\\\",\\n        \\\"plotting\\\": \\\"romantic-fantasy-writer-plotting-coordinator\\\",\\n        \\\"style\\\": \\\"romantic-fantasy-writer-style-coordinator\\\",\\n        \\\"drafting\\\": \\\"romantic-fantasy-writer-drafting-coordinator\\\",\\n        \\\"revision\\\": \\\"romantic-fantasy-writer-revision-coordinator\\\",\\n        \\\"beta-reading\\\": \\\"romantic-fantasy-writer-beta-reading-coordinator\\\",\\n        \\\"polish\\\": \\\"romantic-fantasy-writer-polish-coordinator\\\"\\n    },\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"progress.json\\\",\\n            \\\"condition\\\": \\\"phaseStatuses.concept.status == 'pending'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-concept-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/concept-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"update progress.json concept→complete; dispatch romantic-fantasy-writer-worldbuilding-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/concept-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: failed; summary: 'Concept phase blocked'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/worldbuilding-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"update progress.json worldbuilding→complete; dispatch romantic-fantasy-writer-character-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\