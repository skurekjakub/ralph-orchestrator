ils, the coordinator reports blocked.\\\"\\n    },\\n    \\\"resultCodeMapping\\\": {\\n        \\\"complete\\\": \\\"All chapters polished, summaries generated, delivery report assembled\\\",\\n        \\\"blocked\\\": \\\"Polish or delivery assembly failed\\\"\\n    }\\n}\\n\\n# ─────────────────────────────────────────────────\\n# SUB-COORDINATORS\\n# ─────────────────────────────────────────────────\\n\\n# Physical World Sub-Coordinator (sequential: geography → culture → history)\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer-physical-world-coordinator\\\"] = {\\n    \\\"id\\\": \\\"A-012\\\",\\n    \\\"displayName\\\": \\\"Physical World Sub-Coordinator\\\",\\n    \\\"level\\\": \\\"sub-coordinator\\\",\\n    \\\"pass\\\": \\\"worldbuilding\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-geography-builder\\\",\\n        \\\"romantic-fantasy-writer-culture-builder\\\",\\n        \\\"romantic-fantasy-writer-history-builder\\\"\\n    ],\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"agents/geography-builder/status.json\\\",\\n            \\\"condition\\\": \\\"missing\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-geography-builder\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/geography-builder/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-culture-builder\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/geography-builder/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/culture-builder/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-history-builder\\\"\\n        },\\n        {\\n         