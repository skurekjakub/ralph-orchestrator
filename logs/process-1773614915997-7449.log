pt/plotting and enforced by adversarial auditors.\\"\\n6.   },\\n7.   \\"target\\": {\\n8.     \\"outputDirectory\\": \\".fractal-factory/output/romantic-fantasy-writer\\",\\n9.     \\"namingPrefix\\": \\"romantic-fantasy-writer\\"\\n10.   },\\n11.   \\"inputs\\": {\\n12.     \\"domainBrief\\": \\".fractal-factory/domain-brief.md\\",\\n13.     \\"domainDocs\\": null,\\n14.     \\"exemplars\\": \\".fractals/fractal-factory/agents\\",\\n15.     \\"invariants\\": \\".fractal-factory/invariants.md\\",\\n16.     \\"constraints\\": null\\n17.   },\\n18.   \\"options\\": {\\n19.     \\"maxDepth\\": 3,\\n20.     \\"maxAgents\\": 80,\\n21.     \\"maxGapCycles\\": 10,\\n22.     \\"maxWriterReviewerRetries\\": 10,\\n23.     \\"pipelinePasses\\": [\\"discovery\\", \\"analysis\\", \\"planning\\", \\"execution\\", \\"verification\\", \\"gapHunting\\", \\"delivery\\"],\\n24.     \\"metaKnowledge\\": {\\n25.       \\"enabled\\": true,\\n26.       \\"domainSignalName\\": \\"craft\\"\\n27.     }\\n28.   }\\n29. }\\n30. "}]},{"role":"tool","parts":[{"type":"tool_call_response","id":"toolu_01HVCrZHJPagVhUhc2YaKRku","response":"fractal-factory-analysis-coordinator.agent.md\\nfractal-factory-artifact-designer.agent.md\\nfractal-factory-artifact-hunter.agent.md\\nfractal-factory-asset-auditor.agent.md\\nfractal-factory-audit-oracle.agent.md\\nfractal-factory-checklist-validator.agent.md\\nfractal-factory-context-signal-analyzer.agent.md\\nfractal-factory-coverage-hunter.agent.md\\nfractal-factory-delivery-coordinator.agent.md\\nfractal-factory-depth-analyzer.agent.md\\nfractal-factory-discovery-coordinator.agent.md\\nfractal-factory-documentation-writer.agent.md\\nfractal-factory-domain-scanner.agent.md\\nfractal-factory-execution-coordinator.agent.md\\nfractal-factory-exemplar-analyzer.agent.md\\nfractal-factory-factory-signal-analyzer.agent.md\\nfractal-factory-gap-hunting-coordinator.agent.md\\nfractal-factory-guide.agent.md\\nfractal-factory-infra-writer.agent.md\\nfractal-factory-inf