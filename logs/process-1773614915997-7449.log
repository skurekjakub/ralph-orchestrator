      'gen_ai.tool.type': 'function',
      'gen_ai.provider.name': 'github',
      'gen_ai.tool.call.arguments': `{"command":"cat > /tmp/rewrite_agents.py << 'EOFILE'\\n#!/usr/bin/env python3\\n\\"\\"\\"\\nGenerate specific agent prompts for the romantic-fantasy-writer system.\\nUses domain-model.json, roster.json, and architecture.json to create detailed prompts.\\n\\"\\"\\"\\nimport json\\nimport sys\\n\\n# Load reference files\\nwith open('/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/domain-model.json') as f:\\n    domain_model = json.load(f)\\n\\nwith open('/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/roster.json') as f:\\n    roster = json.load(f)\\n\\nwith open('/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/architecture.json') as f:\\n    architecture = json.load(f)\\n\\n# Map INV IDs to their text for easy reference\\ninvariants_by_id = {inv['id']: inv for inv in domain_model['invariants']}\\n\\n# Agent-specific configurations\\nagent_configs = {\\n    'romantic-fantasy-writer-guide': {\\n        'role': 'User-facing guide agent that gathers story idea, optional style samples, mood/tone, character sketches, world fragments, and constraints; validates inputs, writes story-config.json, confirms with user, and launches the autonomous pipeline.',\\n        'process_steps': [\\n            '1. Welcome the user and explain the romantic fantasy writing pipeline',\\n            '2. Ask for the core story idea (required per INV-067 \\"Minimum Viable Input is Story Idea Only\\")',\\n            '3. Optionally gather mood/tone keywords, character sketches, world details, style sample file paths',\\n            '4. Optionally gather heat level, series information (standalone vs sequel), constraints/content warnings',\\n            '5. Validate all inputs: required fields are non-empty, optional fields are well-formed',\\n            '6. Build story-config.json with all inputs and explicit defaults for missing optional fields',\\n            '7. Display the config to the user and ask for confirmation (\\"confirmedByUser\\": true required per INV-080)',\\n            '8. On confirmation, invoke the romantic-fantasy-writer orchestrator with story-config.json',\\n            '9. After pipeline completes, read delivery-report.json and present final results to user',\\n            '10. Ask if user wants to run another story or if session is complete'\\n        ],\\n        'invariants': ['INV-067', 'INV-026', 'INV-080'],\\n        'artifact_reads': ['delivery-report.json'],\\n        'artifact_writes': ['story-config.json'],\\n        'result_codes': [],\\n    },\\n    \\n    'romantic-fantasy-writer-concept-developer': {\\n        'role': 'Distill raw story inputs into a crystallized story concept with refined premise, thematic pillars, genre balance (fantasy vs romance), comp titles, and high-level arc shapes.',\\n        'process_steps': [\\n            '1. Read story-config.json — extract storyId, storyIdea, mood, constraints',\\n            '2. Synthesize a one-paragraph refined premise that sharpens the core idea',\\n            '3. Identify 2-3 thematic pillars: for each, document the theme, the central question, and the argument the story makes (per INV-063/T25)',\\n            '4. Assess genre balance: what percentage is fantasy plot vs romance plot (must sum ~1, neither zero per INV-001)',\\n            '5. Select 2-4 comp titles (published comparable works) explaining why each resonates',\\n            '6. Identify target audience (reader demographic, heat level preferences)',\\n            '7. Define the tone contract (primary tone, secondary tone, tones to avoid per INV-043/T5)',\\n            '8. Estimate chapter count based on target word count (typically 4500-5500 words/chapter)',\\n            '9. Write story-concept.json with refined premise, thematic pillars, genre balance, comp titles, tone contract, estimated chapter count',\\n            '10. Do NOT assign craft tools yet — that is the craft-profile-selector\\\\'s role'\\n        ],\\n        'invariants': ['INV-001', 'INV-063', 'INV-043', 'INV-036'],\\n        'artifact_reads': ['story-config.json'],\\n        'artifact_writes': ['story-concept.json'],\\n        'result_codes': ['completed', 'blocked'],\\n    },\\n\\n    'romantic-fantasy-writer-craft-profile-selector': {\\n        'role': 'Select which of the 26 craft toolbox items (T1–T26) apply to this specific story. Once selected, tools become binding for the rest of production (INV-079). Minimum 5-8 tools per INV-078.',\\n        'process_steps': [\\n            '1. Read story-concept.json and craft-profile.json (if exists from prior iteration)',\\n            '2. Review all 26 craft tools (T1–T26) in domain-model.json invariants (lines with \\"[Craft Tool Tn]\\")',\\n            '3. For each tool, assess fit: does this story\\\\'s tone, structure, genre, and thematic goals align with this tool?',\\n            '4. Select 5-8 tools that best serve this story (per INV-078 \\"Craft Toolbox Selection Minimum\\")',\\n            '5. For each selected tool, document why it suits this story',\\n            '6. For each tool with conditions (\\"When selected: ...\\"), plan how to enforce it during later phases',\\n            '7. Create craft-profile.json with selectedTools array, toolCount, selectionRationale',\\n            '8. Tag craft-profile as bindingFrom=\\"concept\\" (may add more tools during plotting per INV-069)',\\n            '9. Document which phases will enforce each tool (e.g., T1 \\"Scene-Sequel Structure\\" enforced during plotting and drafting)',\\n            '10. Ensure tool count is documented for consistency checks'\\n        ],\\n        'invariants': ['INV-078', 'INV-079', 'INV-069'],\\n        'artifact_reads': ['story-concept.json'],\\n        'artifact_writes': ['craft-profile.json'],\\n        'result_codes': ['completed', 'blocked'],\\n    },\\n\\n    'romantic-fantasy-writer-geography-builder': {\\n        'role': 'Design geography and settings: major locations, climate z