      'gen_ai.tool.type': 'function',
      'gen_ai.provider.name': 'github',
      'gen_ai.tool.call.arguments': `{"command":"cat << 'PYEOF' > /tmp/build_invariants.py\\nimport json\\nfrom datetime import datetime, timezone\\n\\n# Load existing domain model\\nwith open(\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/domain-model.json\\") as f:\\n    model = json.load(f)\\n\\nALL_SD = [\\"SD-001\\",\\"SD-002\\",\\"SD-003\\",\\"SD-004\\",\\"SD-005\\",\\"SD-006\\",\\"SD-007\\",\\"SD-008\\",\\"SD-009\\",\\"SD-010\\",\\"SD-011\\",\\"SD-012\\",\\"SD-013\\",\\"SD-014\\"]\\nALL_CREATIVE = [\\"SD-002\\",\\"SD-003\\",\\"SD-004\\",\\"SD-005\\",\\"SD-006\\",\\"SD-007\\",\\"SD-008\\",\\"SD-009\\",\\"SD-010\\",\\"SD-011\\",\\"SD-012\\",\\"SD-013\\",\\"SD-014\\"]\\n\\ninvariants = []\\n\\n# ============================================================\\n# PART 1: EXPLICIT INVARIANTS FROM invariants.md (conf 0.95-1.0)\\n# ============================================================\\n\\n# --- Narrative Invariants ---\\ninvariants.append({\\n    \\"id\\": \\"INV-001\\", \\"description\\": \\"Genre Promise: Every story MUST be romantic fantasy — fantasy plot arc primary, romance arc as emotional spine. Neither arc may be absent. Romance must reach at minimum a 'happy for now' (HFN) resolution.\\",\\n    \\"classification\\": \\"behavioral\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I1, line 17\\",\\n    \\"affectedSubdomains\\": ALL_SD,\\n    \\"verificationStrategy\\": \\"Verify outline contains both fantasy and romance arc beats. Verify final chapter delivers HFN/HEA. Beta romance reader confirms romance arc present and satisfying.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-002\\", \\"description\\": \\"Internal Consistency: All worldbuilding details (magic rules, geography, political structures, cultural norms, character knowledge) MUST remain internally consistent across every artifact and chapter. Contradictions are system failures. For sequels, consistency extends across books via series knowledge base.\\",\\n    \\"classification\\": \\"behavioral\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I2, line 19\\",\\n    \\"affectedSubdomains\\": [\\"SD-003\\",\\"SD-007\\",\\"SD-008\\",\\"SD-009\\",\\"SD-011\\",\\"SD-012\\",\\"SD-013\\"],\\n    \\"verificationStrategy\\": \\"Cross-reference every factual claim in manuscript against continuity tracker and world bible. Adversarial auditors challenge internal consistency per phase. Series KB consistency check for sequels.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-003\\", \\"description\\": \\"Character Voice Distinctness: Each POV character MUST have a recognizably distinct internal voice — vocabulary, sentence rhythm, emotional register, and thought patterns. Indistinguishable POV voices are a failure.\\",\\n    \\"classification\\": \\"quality\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I3, line 23\\",\\n    \\"affectedSubdomains\\": [\\"SD-004\\",\\"SD-006\\",\\"SD-007\\",\\"SD-008\\",\\"SD-009\\"],\\n    \\"verificationStrategy\\": \\"Strip character names from POV passages and verify distinctness. Compare voice parameters (sentence length, vocabulary register, metaphor type) across POV characters. Beta craft reader checks voice consistency.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-004\\", \\"description\\": \\"Earned Emotional Beats: Every major emotional beat (first kiss, betrayal, sacrifice, reconciliation) MUST be preceded by sufficient buildup. No emotional payoff without prior investment.\\",\\n    \\"classification\\": \\"quality\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I4, line 26\\",\\n    \\"affectedSubdomains\\": [\\"SD-005\\",\\"SD-007\\",\\"SD-008\\",\\"SD-009\\"],\\n    \\"verificationStrategy\\": \\"For each major emotional beat, trace backward through preceding chapters to verify buildup exists. Beta reader simulation flags unearned beats.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-005\\", \\"description\\": \\"Show Don't Tell (for emotions): Character emotions MUST be conveyed primarily through action, dialogue, physical sensation, and internal reaction — not narrator declarations. Telling acceptable only for background summary or time-skips, never for key emotional moments.\\",\\n    \\"classification\\": \\"quality\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I5, line 28\\",\\n    \\"affectedSubdomains\\": [\\"SD-007\\",\\"SD-008\\",\\"SD-009\\"],\\n    \\"verificationStrategy\\": \\"Line edit pass flags every instance of told emotion in key scenes. Count 'she felt/he was' narrator declarations and verify they don't appear in key emotional moments.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-006\\", \\"description\\": \\"Chekhov's Gun: Every significant element introduced (magical artifact, character secret, prophecy, weapon, relationship tension) MUST either pay off or be explicitly acknowledged as unresolved for series setup. Dangling threads without purpose are failures.\\",\\n    \\"classification\\": \\"behavioral\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I6, line 31\\",\\n    \\"affectedSubdomains\\": [\\"SD-005\\",\\"SD-007\\",\\"SD-013\\",\\"SD-014\\"],\\n    \\"verificationStrategy\\": \\"Cross-reference continuity tracker's promises ledger — every planted element must have a corresponding payoff or be tagged as 'series setup' in unresolved-threads.md.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-007\\", \\"description\\": \\"No Info-Dumping: Worldbuilding exposition MUST be woven into action, dialogue, and character experience. No paragraphs of raw encyclopedic information. One-page rule: no more than one paragraph of pure exposition before returning to scene.\\",\\n    \\"classification\\": \\"quality\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I7, line 34\\",\\n    \\"affectedSubdomains\\": [\\"SD-007\\",\\"SD-008\\"],\\n    \\"verificationStrategy\\": \\"Line edit pass flags consecutive exposition paragraphs. Measure longest unbroken exposition stretch per chapter and verify it stays under one paragraph.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-008\\", \\"description\\": \\"Character Agency: Both romantic leads MUST have agency — they make active choices that drive the story forward. Neither lead may be a passive recipient of the plot, repeatedly rescued without contributing, or reduced to only reacting.\\",\\n    \\"classification\\": \\"behavioral\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I8, line 38\\",\\n    \\"affectedSubdomains\\": [\\"SD-004\\",\\"SD-005\\",\\"SD-007\\",\\"SD-009\\"],\\n    \\"verificationStrategy\\": \\"For each lead, count the number of active choices vs. passive reactions per chapter. Verify each lead initiates at least some plot-driving actions. Beta reader romance lens checks both leads are equally developed.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-009\\", \\"description\\": \\"No Deus Ex Machina: If a magic rule or ability has not been established before it's needed, it MUST NOT be used to resolve conflict. New abilities introduced solely to solve an immediate problem are a critical failure. Applies to non-magical resolutions too — no cavalry-from-nowhere without prior setup.\\",\\n    \\"classification\\": \\"behavioral\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I9, line 41\\",\\n    \\"affectedSubdomains\\": [\\"SD-003\\",\\"SD-005\\",\\"SD-007\\",\\"SD-011\\"],\\n    \\"verificationStrategy\\": \\"For every conflict resolution, verify the capability/resource used was established in a prior chapter. Cross-reference magic system rules and continuity tracker.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\n\\n# --- Structural Invariants ---\\ninvariants.append({\\n    \\"id\\": \\"INV-010\\", \\"description\\": \\"Outline Before Draft: No chapter may be drafted until a chapter-level outline exists specifying POV, scene goal, conflict, emotional arc, and which romance/fantasy beats the chapter hits.\\",\\n    \\"classification\\": \\"workflow\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I10, line 45\\",\\n    \\"affectedSubdomains\\": [\\"SD-005\\",\\"SD-007\\"],\\n    \\"verificationStrategy\\": \\"Verify every chapter draft has a corresponding chapter outline file that predates it. Check outline contains required fields: POV, goal, conflict, emotional arc, beats.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-011\\", \\"description\\": \\"Continuity Tracking: A continuity document MUST be updated after every chapter draft. It tracks: character locations, timeline, what each character knows, promises made to the reader, and open plot threads. For sequels, extends series-level tracker.\\",\\n    \\"classification\\": \\"workflow\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I11, line 48\\",\\n    \\"affectedSubdomains\\": [\\"SD-007\\",\\"SD-013\\"],\\n    \\"verificationStrategy\\": \\"After each chapter draft, verify continuity tracker was updated. Check it contains entries for character positions, timeline, character knowledge, reader promises.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": \\"INV-012\\", \\"description\\": \\"Sequential Chapter Production: Chapters MUST be produced in sequence. Chapter N+1 cannot be drafted until chapter N is complete and its continuity implications are recorded.\\",\\n    \\"classification\\": \\"workflow\\", \\"confidence\\": 1.0,\\n    \\"source\\": \\"invariants.md, I12, line 52\\",\\n    \\"affectedSubdomains\\": [\\"SD-007\\"],\\n    \\"verificationStrategy\\": \\"Verify chapter file timestamps and continuity tracker updates show strict sequential ordering. No chapter N+1 exists without completed chapter N.\\",\\n    \\"discoveredBy\\": \\"fractal-factory-invariant-extractor\\"\\n})\\ninvariants.append({\\n    \\"id\\": `... 51783 more characters,
