            "function": {
              "name": "edit",
              "arguments": "{\"path\": \"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/domain-model.json\", \"old_str\": \"{\\n  \\\"version\\\": 1,\\n  \\\"lastUpdated\\\": null,\\n  \\\"subdomains\\\": [],\\n  \\\"invariants\\\": [],\\n  \\\"existingAssets\\\": [],\\n  \\\"exemplarPatterns\\\": []\\n}\", \"new_str\": \"{\\n  \\\"version\\\": 1,\\n  \\\"lastUpdated\\\": \\\"2026-03-15T23:02:00Z\\\",\\n  \\\"subdomains\\\": [\\n    {\\n      \\\"id\\\": \\\"SD-001\\\",\\n      \\\"name\\\": \\\"user-guide-and-input\\\",\\n      \\\"description\\\": \\\"User-facing guide agent that gathers story idea, optional style samples, mood/tone, character sketches, world fragments, and constraints; validates inputs, writes story-config.json, confirms with user, and launches the autonomous pipeline.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"low\\\",\\n      \\\"estimatedAgentCount\\\": 1,\\n      \\\"crossCuttingConcerns\\\": [\\\"input-validation\\\", \\\"pipeline-orchestration\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-002\\\",\\n      \\\"name\\\": \\\"concept-development\\\",\\n      \\\"description\\\": \\\"Phase 1 of the creative pipeline: distill raw inputs into a crystallized story concept including thematic pillars, refined premise, comp titles, and a Story Craft Profile that selects which craft toolbox items apply to this specific story.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"medium\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"craft-toolbox-selection\\\", \\\"adversarial-consistency\\\", \\\"series-knowledge-management\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-003\\\",\\n      \\\"name\\\": \\\"worldbuilding\\\",\\n      \\\"description\\\": \\\"Phase 2: construct a deeply subcategorized world bible covering geography/settings, magic system design (Sanderson's Laws), political/social structures, history/lore, culture/daily life, and fauna/flora. Output is split into individual subcategory files loadable independently.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 3,\\n      \\\"crossCuttingConcerns\\\": [\\\"adversarial-consistency\\\", \\\"series-knowledge-management\\\", \\\"continuity-tracking\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-004\\\",\\n      \\\"name\\\": \\\"character-development\\\",\\n      \\\"description\\\": \\\"Phase 3: build full protagonist profiles with psychological wounds and desires, design the romance arc dynamic between leads, develop supporting cast and antagonist with mini-arcs, create per-character voice guides with measurable parameters, and map the relationship web.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 3,\\n      \\\"crossCuttingConcerns\\\": [\\\"adversarial-consistency\\\", \\\"series-knowledge-management\\\", \\\"multi-pov-craft\\\", \\\"emotional-resonance\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-005\\\",\\n      \\\"name\\\": \\\"plotting-and-outlining\\\",\\n      \\\"description\\\": \\\"Phase 4: select and apply a structural framework (three-act, Save the Cat, Hero's Journey, etc.), produce per-chapter outlines with POV/goal/conflict/beats, map tension rise-and-fall, track subplots, interleave dual fantasy-romance arcs, build foreshadowing ledger, and architect chapter hooks and page-turners.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 4,\\n      \\\"crossCuttingConcerns\\\": [\\\"adversarial-consistency\\\", \\\"craft-knowledge-systems\\\", \\\"continuity-tracking\\\", \\\"reader-experience-design\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-006\\\",\\n      \\\"name\\\": \\\"prose-style-calibration\\\",\\n      \\\"description\\\": \\\"Phase 5: analyze reference fiction for abstract stylistic patterns (sentence rhythm, vocabulary register, metaphor density, dialogue ratio, paragraph cadence), produce a concrete style guide and tone palette by scene type, and define the voice calibration matrix for each POV character.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"medium\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"adversarial-consistency\\\", \\\"multi-pov-craft\\\", \\\"series-knowledge-management\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-007\\\",\\n      \\\"name\\\": \\\"chapter-drafting\\\",\\n      \\\"description\\\": \\\"Phase 6: write each chapter following the outline while maintaining character voice per POV, scene structure, prose style adherence, worldbuilding consistency, romance pacing, and chapter hooks/cliffhangers. Update the running continuity document after each chapter.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 3,\\n      \\\"crossCuttingConcerns\\\": [\\\"adversarial-consistency\\\", \\\"continuity-tracking\\\", \\\"craft-knowledge-systems\\\", \\\"multi-pov-craft\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-008\\\",\\n      \\\"name\\\": \\\"revision-and-editing\\\",\\n      \\\"description\\\": \\\"Phase 7: three distinct editing passes — developmental edit (plot holes, pacing, motivation, arc satisfaction, theme), line edit (prose quality, voice distinctness, cliché detection, show-vs-tell, repetition), and copy edit (grammar, naming consistency, timeline accuracy, factual accuracy within world rules).\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 4,\\n      \\\"crossCuttingConcerns\\\": [\\\"continuity-tracking\\\", \\\"craft-knowledge-systems\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-009\\\",\\n      \\\"name\\\": \\\"beta-reading-simulation\\\",\\n      \\\"description\\\": \\\"Phase 8: five independent reader lenses (romance reader, fantasy reader, craft reader, sensitivity reader, originality reader), each producing structured findings with severity levels. A synthesis step combines all findings and prioritizes by severity for revision.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 6,\\n      \\\"crossCuttingConcerns\\\": [\\\"continuity-tracking\\\", \\\"craft-knowledge-systems\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-010\\\",\\n      \\\"name\\\": \\\"polish-and-delivery\\\",\\n      \\\"description\\\": \\\"Phase 9: final proofread pass, per-chapter summary generation, series knowledge base promotion (merging per-book facts into series-level directories), and assembly of the complete delivery package with all artifacts organized and cross-referenced.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"medium\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"series-knowledge-management\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-011\\\",\\n      \\\"name\\\": \\\"adversarial-consistency\\\",\\n      \\\"description\\\": \\\"Cross-cutting auditor pattern applied as a sub-phase gate to every creative phase (1–6). Each auditor challenges internal consistency, cross-references all prior artifacts, produces severity-rated findings, blocks on criticals, and enforces the kill-your-darlings mandate. Phase-specific focus areas differ per phase.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"all-creative-phases\\\", \\\"craft-toolbox-enforcement\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-012\\\",\\n      \\\"name\\\": \\\"series-knowledge-management\\\",\\n      \\\"description\\\": \\\"Cross-cutting: manage the series-level knowledge base lifecycle — subcategorized artifact organization (world, characters, magic, timeline, unresolved threads, naming, style guide), knowledge promotion from per-book to series directories on completion, sequel input contract enforcement, and cross-book consistency rules (append-mostly, no silent retcons).\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"medium\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"all-creative-phases\\\", \\\"sequel-production\\\", \\\"artifact-organization\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-013\\\",\\n      \\\"name\\\": \\\"continuity-tracking\\\",\\n      \\\"description\\\": \\\"Cross-cutting: maintain the running continuity tracker (facts, character positions, timeline progression), character knowledge matrix (what each character knows at each chapter boundary), reader promises ledger (Chekhov's guns — planted/status), and information asymmetry maps between POV characters and reader.\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"medium\\\",\\n      \\\"estimatedAgentCount\\\": 2,\\n      \\\"crossCuttingConcerns\\\": [\\\"chapter-drafting\\\", \\\"beta-reading-simulation\\\", \\\"adversarial-consistency\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"SD-014\\\",\\n      \\\"name\\\": \\\"craft-knowledge-systems\\\",\\n      \\\"description\\\": \\\"Cross-cutting advanced craft dimensions integrated throughout the pipeline: foreshadowing/symbolism architecture (ledger, motif tracking, imagery callbacks, red herrings), emotional resonance engineering (throughline mapping, micro-tension, vulnerability escalation, sensory anchoring), dialogue craft (function tagging, subtext layering, speech differentiation, beat action), thematic architecture (argument structure, theme echo, escalation), and reader experience design (hook engineering, page-turner architecture, mystery box management, payoff spacing, re-readability seeding).\\\",\\n      \\\"sourceFiles\\\": [\\\".fractal-factory/domain-brief.md\\\"],\\n      \\\"complexity\\\": \\\"high\\\",\\n      \\\"estimatedAgentCount\\\": 3,\\n      \\\"crossCuttingConcerns\\\": [\\\"plotting-and-outlining\\\", \\\"chapter-drafting\\\", \\\"revision-and-editing\\\", \\\"beta-reading-simulation\\\"],\\n      \\\"discoveredBy\\\": \\\"fractal-factory-domain-scanner\\\"\\n    }\\n  ],\\n  \\\"invariants\\\": [],\\n  \\\"existingAssets\\\": [],\\n  \\\"exemplarPatterns\\\": []\\n}\"}"
