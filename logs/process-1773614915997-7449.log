ns 'blocked'\\\"\\n    },\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"blocked\\\",\\n        \\\"reason\\\": \\\"Insufficient input to generate acceptable concept\\\"\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Coordinator blocked after 3 retries\\\",\\n        \\\"Audit report shows progressively better but still insufficient concepts\\\",\\n        \\\"Orchestrator receives 'blocked', halts concept phase\\\",\\n        \\\"Error messaging indicates input quality issue\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-001\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-014\\\",\\n    \\\"name\\\": \\\"Edge case — no style references\\\",\\n    \\\"category\\\": \\\"edge-case\\\",\\n    \\\"priority\\\": \\\"P2\\\",\\n    \\\"description\\\": \\\"Style-coordinator handles case with no reference texts provided\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-014\\\",\\n            \\\"styleReferences\\\": []\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-014/concept.json\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-style-coordinator\\\",\\n        \\\"action\\\": \\\"invoke\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"style-analyzer finds no reference texts\\\",\\n        \\\"Uses fallback: analyze concept genre tags, default romantic fantasy style\\\",\\n        \\\"style-guide-writer creates generic romantic fantasy guide\\\",\\n        \\\"style-auditor passes (generic guide is valid, just not customized)\\\",\\n        \\\"Coordinator returns 'complete'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"complete\\\",\\n        \\\"styleGuideType\\\": \\\"generic-romantic-fantasy\\\"\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Style-coordinator completed without blocking\\\",\\n        \\\"style-guide.json exists with default/generic style parameters\\\",\\n        \\\"No auditor rejections (generic is acceptable)\\\",\\n        \\\"Subsequent drafting uses generic style guide\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-003\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-015\\\",\\n    \\\"name\\\": \\\"Edge case — missing chapter outline\\\",\\n    \\\"category\\\": \\\"edge-case\\\",\\n    \\\"priority\\\": \\\"P1\\\",\\n    \\\"description\\\": \\\"Drafting-coordinator handles missing chapter outline file\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-015\\\",\\n            \\\"targetChapters\\\": 2\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-015/plot/chapter-outlines/chapter-001.json\\\"\\n            # chapter-002.json is MISSING\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-drafting-coordinator\\\",\\n        \\\"action\\\": \\\"invoke for chapters 1-2\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Chapter 1: drafts successfully using outline\\\",\\n        \\\"Chapter 2: creative-writing-coordinator reads plot/chapter-outlines/chapter-002.json → file not found\\\",\\n        \\\"creative-writing-coordinator returns 'blocked' with error: 'Missing chapter outline'\\\",\\n        \\\"Drafting-coordinator propagates 'blocked'\\\",\\n        \\\"Drafting-coordinator returns 'blocked'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"blocked\\\",\\n        \\\"chaptersCompleted\\\": 1,\\n        \\\"chapterBlocked\\\": 2,\\n        \\\"reason\\\": \\\"Missing chapter outline file\\\"\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Chapter 1 draft exists\\\",\\n        \\\"Chapter 2 draft does not exist\\\",\\n        \\\"Drafting-coordinator blocked with clear error message\\\",\\n        \\\"Error indicates file path and missing artifact\\\",\\n        \\\"Orchestrator receives 'blocked', halts drafting phase\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-007\\\"]\\n})\\n\\n# CATEGORY 8: SPECIALIST BEHAVIOR\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-016\\\",\\n    \\\"name\\\": \\\"Specialist — geography-builder creates world map\\\",\\n    \\\"category\\\": \\\"specialist-behavior\\\",\\n    \\\"priority\\\": \\\"P2\\\",\\n    \\\"description\\\": \\\"Geography-builder specialist produces valid geography artifact\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-016\\\"\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-016/concept.json (setting: coastal kingdom with mountain barrier)\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-geography-builder\\\",\\n        \\\"action\\\": \\\"invoke\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"geography-builder reads concept setting details\\\",\\n        \\\"Creates geography.json with: regions, landmarks, climate, distances\\\",\\n        \\\"Includes coastal kingdom, mountain range, interior regions\\\",\\n        \\\"Returns 'completed'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"completed\\\",\\n        \\\"artifactsWritten\\\": [\\\"books/test-book-016/world/geography.json\\\"]\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"geography.json exists and is valid JSON\\\",\\n        \\\"Contains required fields: regions[], landmarks[], climate{}\\\",\\n        \\\"Matches setting described in concept.json\\\",\\n        \\\"geography-builder status == 'completed'\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-002\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-017\\\",\\n    \\\"name\\\": \\\"Specialist — romance-arc-designer dual arc\\\",\\n    \\\"category\\\": \\\"specialist-behavior\\\",\\n    \\\"priority\\\": \\\"P2\\\",\\n    \\\"description\\\": \\\"Romance-arc-designer creates dual protagonist romance arc\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-017\\\"\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-017/characters/protagonist-a.json\\\",\\n            \\\"books/test-book-017/characters/protagonist-b.json\\\",\\n            \\\"books/test-book-017/concept.json (romance: enemies-to-lovers)\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-romance-arc-designer\\\",\\n        \\\"action\\\": \\\"invoke\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"romance-arc-designer reads both protagonist files\\\",\\n        \\\"Identifies conflict points, attraction points, resolution arc\\\",\\n        \\\"Creates romance-arc.json with: meetCute, risingAttraction, darkMoment, resolution\\\",\\n        \\\"Returns 'completed'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"completed\\\",\\n        \\\"artifactsWritten\\\": [\\\"books/test-book-017/characters/romance-arc.json\\\"]\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"romance-arc.json exists with enemies-to-lovers structure\\\",\\n        \\\"Arc includes all required beats (meet, attract, dark, resolve)\\\",\\n        \\\"Both protagonists referenced in arc\\\",\\n        \\\"romance-arc-designer status == 'completed'\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-001\\\", \\\"INV-004\\\"]\\n})\\n\\n# CATEGORY 9: COORDINATOR ROUTING\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-018\\\",\\n    \\\"name\\\": \\\"Coordinator routing — worldbuilding sub-coordinators\\\",\\n    \\\"category\\\": \\\"coordinator-routing\\\",\\n    \\\"priority\\\": \\\"P1\\\",\\n    \\\"description\\\": \\\"Worldbuilding-coordinator dispatches physical-world and systems-world sub-coordinators\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-018\\\"\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-018/concept.json\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-worldbuilding-coordinator\\\",\\n        \\\"action\\\": \\\"invoke\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Worldbuilding-coordinator dispatches physical-world-coordinator\\\",\\n        \\\"physical-world-coordinator dispatches: geography-builder, culture-builder, history-builder\\\",\\n        \\\"All 3 specialists return 'completed'\\\",\\n        \\\"physical-world-coordinator returns 'complete'\\\",\\n        \\\"Worldbuilding-coordinator dispatches systems-world-coordinator\\\",\\n        \\\"systems-world-coordinator dispatches: magic-system-designer, political-structure-builder\\\",\\n        \\\"Both specialists return 'completed'\\\",\\n        \\\"systems-world-coordinator returns 'complete'\\\",\\n        \\\"Worldbuilding-coordinator dispatches worldbuilding-auditor\\\",\\n        \\\"worldbuilding-auditor returns 'passed'\\\",\\n        \\\"Worldbuilding-coordinator returns 'complete'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"complete\\\",\\n        \\\"subCoordinatorsRan\\\": 2,\\n        \\\"specialistsRan\\\": 5\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"All 5 worldbuilding artifacts exist (geography, culture, history, magic, politics)\\\",\\n        \\\"Both sub-coordinators completed successfully\\\",\\n        \\\"Worldbuilding-auditor passed on first try\\\",\\n        \\\"Worldbuilding-coordinator status == 'complete'\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-002\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-019\\\",\\n    \\\"name\\\": \\\"Coordinator routing — drafting creative-writing sub-flow\\\",\\n    \\\"category\\\": \\\"coordinator-routing\\\",\\n    \\\"priority\\\": \\\"P1\\\",\\n    \\\"description\\\": \\\"Drafting-coordinator dispatches creative-writing-coordinator for chapter\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-019\\\",\\n            \\\"currentChapter\\\": 1\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-019/plot/chapter-outlines/chapter-001.json\\\",\\n            \\\"books/test-book-019/style-guide.json\\\",\\n            \\\"books/test-book-019/craft-profile.json\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-drafting-coordinator\\\",\\n        \\\"action\\\": \\\"invoke for chapter 1\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Drafting-coordinator dispatches creative-writing-coordinator (ch1)\\\",\\n        \\\"creative-writing-coordinator dispatches: chapter-drafter, pov-voice-maintainer, continuity-integrator\\\",\\n        \\\"chapter-drafter writes prose, returns 'completed'\\\",\\n        \\\"pov-voice-maintainer adjusts voice, returns 'completed'\\\",\\n        \\\"continuity-integrator checks local continuity, returns 'completed'\\\",\\n        \\\"creative-writing-coordinator returns 'complete'\\\",\\n        \\\"Drafting-coordinator dispatches quality-integration-coordinator\\\",\\n        \\\"quality-integration-coordinator dispatches craft-enforcer\\\",\\n        \\\"craft-enforcer applies craft checks, returns 'completed'\\\",\\n        \\\"quality-integration-coordinator returns 'complete'\\\",\\n        \\\"Drafting-coordinator dispatches drafting-auditor\\\",\\n        \\\"drafting-auditor returns 'passed'\\\",\\n        \\\"Drafting-coordinator returns 'complete'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"complete\\\",\\n        \\\"subCoordinatorsRan\\\": 2,\\n        \\\"specialistsRan\\\": 4\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Chapter 1 draft exists\\\",\\n        \\\"All 4 drafting specialists ran (drafter, pov, continuity, craft-enforcer)\\\",\\n        \\\"Both sub-coordinators completed successfully\\\",\\n        \\\"Drafting-auditor passed\\\",\\n        \\\"Drafting-coordinator status == 'complete'\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-003\\\", \\\"INV-005\\\"]\\n})\\n\\n# CATEGORY 10: REVISION-BETA LOOP\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-020\\\",\\n    \\\"name\\\": \\\"Revision-beta loop — one cycle\\\",\\n    \\\"category\\\": \\\"revision-beta-loop\\\",\\n    \\\"priority\\\": \\\"P0\\\",\\n    \\\"description\\\": \\\"Beta-reading returns revision-required, orchestrator loops back to revision once\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-020\\\",\\n            \\\"targetChapters\\\": 1,\\n            \\\"revisionBetaCycles\\\": 0\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-020/chapters/chapter-001-revised.md\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer\\\",\\n        \\\"action\\\": \\\"orchestrator dispatches beta-reading-coordinator\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Beta-reading-coordinator runs 5 beta lenses + synthesizer\\\",\\n        \\\"beta-synthesizer verdict: 'revision-required' for chapter 1\\\",\\n        \\\"Beta-reading-coordinator returns 'complete'\\\",\\n        \\\"Orchestrator increments revisionBetaCycles to 1\\\",\\n        \\\"Orchestrator resets revision + beta status to 'pending'\\\",\\n        \\\"Orchestrator re-dispatches revision-coordinator\\\",\\n        \\\"Revision-coordinator revises chapter 1 based on beta feedback\\\",\\n        \\\"Revision-coordinator returns 'complete'\\\",\\n        \\\"Orchestrator re-dispatches beta-reading-coordinator\\\",\\n        \\\"Beta-reading-coordinator runs again\\\",\\n        \\\"beta-synthesizer verdict: 'approved' for chapter 1\\\",\\n        \\\"Beta-reading-coordinator returns 'complete'\\\",\\n        \\\"Orchestrator proceeds to polish-coordinator\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"delivered\\\",\\n        \\\"revisionBetaCycles\\\": 1,\\n        \\\"chapterApproved\\\": true\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Revision-coordinator ran twice (initial + 1 loop)\\\",\\n        \\\"Beta-reading-coordinator ran twice (initial + 1 loop)\\\",\\n        \\\"Final beta verdict == 'approved'\\\",\\n        \\\"revisionBetaCycles counter == 1\\\",\\n        \\\"Orchestrator proceeded to polish and delivered\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-004\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-021\\\",\\n    \\\"name\\\": \\\"Revision-beta loop — no revision needed\\\",\\n    \\\"category\\\": \\\"revision-beta-loop\\\",\\n    \\\"priority\\\": \\\"P0\\\",\\n    \\\"description\\\": \\\"Beta-reading returns approved on first pass, no loop\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-021\\\",\\n            \\\"targetChapters\\\": 1,\\n            \\\"revisionBetaCycles\\\": 0\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-021/chapters/chapter-001-revised.md (high quality)\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer\\\",\\n        \\\"action\\\": \\\"orchestrator dispatches beta-reading-coordinator\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Beta-reading-coordinator runs 5 beta lenses + synthesizer\\\",\\n        \\\"beta-synthesizer verdict: 'approved' for chapter 1\\\",\\n        \\\"Beta-reading-coordinator returns 'complete'\\\",\\n        \\\"Orchestrator checks verdict: 'approved' → no revision needed\\\",\\n        \\\"revisionBetaCycles remains 0\\\",\\n        \\\"Orchestrator proceeds directly to polish-coordinator\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"delivered\\\",\\n        \\\"revisionBetaCycles\\\": 0,\\n        \\\"loopTriggered\\\": false\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Revision-coordinator ran exactly once (initial pass only)\\\",\\n        \\\"Beta-reading-coordinator ran exactly once\\\",\\n        \\\"revisionBetaCycles counter == 0\\\",\\n        \\\"Orchestrator proceeded directly to polish\\\",\\n        \\\"No re-entry into revision phase\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-004\\\"]\\n})\\n\\n# Add summary metadata\\ntest_plan[\\\"summary\\\"] = {\\n    \\\"totalScenarios\\\": len(test_plan[\\\"scenarios\\\"]),\\n    \\\"categoryCounts\\\": {\\n        \\\"happy-path\\\": 2,\\n        \\\"auditor-rejection\\\": 2,\\n        \\\"convergence-exhaustion\\\": 2,\\n        \\\"re-entry\\\": 1,\\n        \\\"per-chapter-iteration\\\": 2,\\n        \\\"cross-cutting-agents\\\": 3,\\n        \\\"edge-case\\\": 3,\\n        \\\"specialist-behavior\\\": 2,\\n        \\\"coordinator-routing\\\": 2,\\n        \\\"revision-beta-loop\\\": 2\\n    },\\n    \\\"priorityCounts\\\": {\\n        \\\"P0\\\": 7,\\n        \\\"P1\\\": 11,\\n        \\\"P2\\\": 3\\n    },\\n    \\\"coverageNotes\\\": [\\n        \\\"All 9 coordinators covered in happy-path or routing scenarios\\\",\\n        \\\"Auditor-gate pattern tested at multiple levels (coordinator loops)\\\",\\n        \\\"Per-chapter iteration tested for drafting, revision, beta-reading\\\",\\n        \\\"Convergence bounds tested at both coordinator and orchestrator levels\\\",\\n        \\\"Cross-cutting agents (craft-tracker, continuity-tracker, series-kb-manager) each tested\\\",\\n        \\\"Revision↔beta loop tested with 0, 1, and 2 cycles\\\",\\n        \\\"Edge cases cover missing inputs, missing artifacts, empty data\\\",\\n        \\\"Specialist behavior spot-checked for representative agents\\\",\\n        \\\"Sub-coordinator routing tested (worldbuilding, drafting hierarchies)\\\"\\n    ]\\n}\\n\\n# Write test plan\\nwith open('.fractal-factory/test-plan.json', 'w') as f:\\n    json.dump(test_plan, f, indent=2)\\n\\nprint(f\\\"✓ Created test-plan.json with {len(test_plan['scenarios'])} scenarios\\\")\\nprint(f\\\"  Priority: P0={test_plan['summary']['priorityCounts']['P0']}, P1={test_plan['summary']['priorityCounts']['P1']}, P2={test_plan['summary']['priorityCounts']['P2']}\\\")\\nprint(f\\\"  Categories: {len(test_plan['summary']['categoryCounts'])}\\\")\\n\\nEOFPYTHON\\n\", \"description\": \"Create test plan\", \"initial_wait\": 10}"
