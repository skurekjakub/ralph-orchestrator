              "name": "bash",
              "arguments": "{\"command\": \"cat << 'PYEOF' > /tmp/build_invariants.py\\nimport json\\nfrom datetime import datetime, timezone\\n\\n# Load existing domain model\\nwith open(\\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/domain-model.json\\\") as f:\\n    model = json.load(f)\\n\\nALL_SD = [\\\"SD-001\\\",\\\"SD-002\\\",\\\"SD-003\\\",\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-006\\\",\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\",\\\"SD-010\\\",\\\"SD-011\\\",\\\"SD-012\\\",\\\"SD-013\\\",\\\"SD-014\\\"]\\nALL_CREATIVE = [\\\"SD-002\\\",\\\"SD-003\\\",\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-006\\\",\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\",\\\"SD-010\\\",\\\"SD-011\\\",\\\"SD-012\\\",\\\"SD-013\\\",\\\"SD-014\\\"]\\n\\ninvariants = []\\n\\n# ============================================================\\n# PART 1: EXPLICIT INVARIANTS FROM invariants.md (conf 0.95-1.0)\\n# ============================================================\\n\\n# --- Narrative Invariants ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-001\\\", \\\"description\\\": \\\"Genre Promise: Every story MUST be romantic fantasy — fantasy plot arc primary, romance arc as emotional spine. Neither arc may be absent. Romance must reach at minimum a 'happy for now' (HFN) resolution.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I1, line 17\\\",\\n    \\\"affectedSubdomains\\\": ALL_SD,\\n    \\\"verificationStrategy\\\": \\\"Verify outline contains both fantasy and romance arc beats. Verify final chapter delivers HFN/HEA. Beta romance reader confirms romance arc present and satisfying.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-002\\\", \\\"description\\\": \\\"Internal Consistency: All worldbuilding details (magic rules, geography, political structures, cultural norms, character knowledge) MUST remain internally consistent across every artifact and chapter. Contradictions are system failures. For sequels, consistency extends across books via series knowledge base.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I2, line 19\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\",\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\",\\\"SD-011\\\",\\\"SD-012\\\",\\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference every factual claim in manuscript against continuity tracker and world bible. Adversarial auditors challenge internal consistency per phase. Series KB consistency check for sequels.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-003\\\", \\\"description\\\": \\\"Character Voice Distinctness: Each POV character MUST have a recognizably distinct internal voice — vocabulary, sentence rhythm, emotional register, and thought patterns. Indistinguishable POV voices are a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I3, line 23\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-006\\\",\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Strip character names from POV passages and verify distinctness. Compare voice parameters (sentence length, vocabulary register, metaphor type) across POV characters. Beta craft reader checks voice consistency.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-004\\\", \\\"description\\\": \\\"Earned Emotional Beats: Every major emotional beat (first kiss, betrayal, sacrifice, reconciliation) MUST be preceded by sufficient buildup. No emotional payoff without prior investment.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I4, line 26\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each major emotional beat, trace backward through preceding chapters to verify buildup exists. Beta reader simulation flags unearned beats.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-005\\\", \\\"description\\\": \\\"Show Don't Tell (for emotions): Character emotions MUST be conveyed primarily through action, dialogue, physical sensation, and internal reaction — not narrator declarations. Telling acceptable only for background summary or time-skips, never for key emotional moments.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I5, line 28\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Line edit pass flags every instance of told emotion in key scenes. Count 'she felt/he was' narrator declarations and verify they don't appear in key emotional moments.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-006\\\", \\\"description\\\": \\\"Chekhov's Gun: Every significant element introduced (magical artifact, character secret, prophecy, weapon, relationship tension) MUST either pay off or be explicitly acknowledged as unresolved for series setup. Dangling threads without purpose are failures.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I6, line 31\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-013\\\",\\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference continuity tracker's promises ledger — every planted element must have a corresponding payoff or be tagged as 'series setup' in unresolved-threads.md.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-007\\\", \\\"description\\\": \\\"No Info-Dumping: Worldbuilding exposition MUST be woven into action, dialogue, and character experience. No paragraphs of raw encyclopedic information. One-page rule: no more than one paragraph of pure exposition before returning to scene.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I7, line 34\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Line edit pass flags consecutive exposition paragraphs. Measure longest unbroken exposition stretch per chapter and verify it stays under one paragraph.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-008\\\", \\\"description\\\": \\\"Character Agency: Both romantic leads MUST have agency — they make active choices that drive the story forward. Neither lead may be a passive recipient of the plot, repeatedly rescued without contributing, or reduced to only reacting.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I8, line 38\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"For each lead, count the number of active choices vs. passive reactions per chapter. Verify each lead initiates at least some plot-driving actions. Beta reader romance lens checks both leads are equally developed.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-009\\\", \\\"description\\\": \\\"No Deus Ex Machina: If a magic rule or ability has not been established before it's needed, it MUST NOT be used to resolve conflict. New abilities introduced solely to solve an immediate problem are a critical failure. Applies to non-magical resolutions too — no cavalry-from-nowhere without prior setup.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I9, line 41\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\",\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"For every conflict resolution, verify the capability/resource used was established in a prior chapter. Cross-reference magic system rules and continuity tracker.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Structural Invariants ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-010\\\", \\\"description\\\": \\\"Outline Before Draft: No chapter may be drafted until a chapter-level outline exists specifying POV, scene goal, conflict, emotional arc, and which romance/fantasy beats the chapter hits.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I10, line 45\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify every chapter draft has a corresponding chapter outline file that predates it. Check outline contains required fields: POV, goal, conflict, emotional arc, beats.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-011\\\", \\\"description\\\": \\\"Continuity Tracking: A continuity document MUST be updated after every chapter draft. It tracks: character locations, timeline, what each character knows, promises made to the reader, and open plot threads. For sequels, extends series-level tracker.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I11, line 48\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"After each chapter draft, verify continuity tracker was updated. Check it contains entries for character positions, timeline, character knowledge, reader promises.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-012\\\", \\\"description\\\": \\\"Sequential Chapter Production: Chapters MUST be produced in sequence. Chapter N+1 cannot be drafted until chapter N is complete and its continuity implications are recorded.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I12, line 52\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify chapter file timestamps and continuity tracker updates show strict sequential ordering. No chapter N+1 exists without completed chapter N.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-013\\\", \\\"description\\\": \\\"Multi-Pass Review (Exhaustive): Every chapter MUST go through at minimum: developmental review, line edit, consistency check, AND multi-perspective beta read. All critical and major findings must be resolved before acceptance.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I13, line 54\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify every chapter has corresponding findings files for all four review passes. Verify all critical/major findings have corresponding revision entries in revision-log.md.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-014\\\", \\\"description\\\": \\\"Revision Traceability: Every revision must cite what feedback or finding prompted it. No changes without justification. The revision history must be auditable.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14, line 58\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify revision-log.md contains a finding reference for every revision. No log entry may lack a source citation.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-015\\\", \\\"description\\\": \\\"Voice Consistency Verification: At verification phase, every POV character's chapters must be compared against each other to ensure voice consistency. Measurable comparison of vocabulary, sentence patterns, emotional register, thought patterns. Drift must be flagged and corrected. For sequels, compare against prior-book voice guide.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14a, line 60\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-009\\\",\\\"SD-006\\\"],\\n    \\\"verificationStrategy\\\": \\\"Run voice fingerprint comparison across all chapters for each POV character. Quantify vocabulary overlap, sentence length distribution, and metaphor patterns. Flag statistical outliers.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-016\\\", \\\"description\\\": \\\"Continuity Verification (Exhaustive): The verification phase must cross-reference EVERY factual claim in the manuscript against the continuity tracker: character locations, timeline, character knowledge, physical descriptions, names, titles, world rules, magic system behavior, political status. For sequels, extends to series KB.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14b, line 63\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"Exhaustive cross-reference of every factual claim in manuscript against continuity tracker entries. Every discrepancy logged as a finding.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-017\\\", \\\"description\\\": \\\"Prose Quality Floor: No chapter passes verification if it contains: more than 2 instances of cliché fantasy prose, more than 3 told-not-shown emotions in key scenes, or more than 5 bland/generic sentences that could appear in any story.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I14c, line 67\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Count instances of cliché phrases (maintain a cliché list), told emotions in key scenes, and generic sentences per chapter. Fail any chapter exceeding thresholds (2/3/5).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Quality Invariants ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-018\\\", \\\"description\\\": \\\"No Anachronisms (within world rules): Characters must not reference concepts, technologies, or idioms that don't exist in their world unless worldbuilding explicitly includes them. Modern slang in medieval fantasy is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I15, line 72\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference dialogue and narration vocabulary against the world bible's technology/culture level. Flag modern idioms, slang, or technology references not present in world rules.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-019\\\", \\\"description\\\": \\\"Dialogue Naturalism: Dialogue must sound like speech, not prose. Characters should interrupt, trail off, use contractions, disagree, and talk past each other. Perfectly articulate philosophical monologues from every character is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I16, line 75\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Audit dialogue for naturalness markers: contractions present, interruptions, varied exchange lengths, character-specific speech patterns. Flag monologue-like exchanges.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-020\\\", \\\"description\\\": \\\"Pacing Variation: The story must alternate between high-tension and low-tension scenes. Three consecutive high-action chapters without recovery, or three consecutive slow chapters without rising tension, constitutes a pacing failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I17, line 78\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Map tension level per chapter. Flag any sequence of 3+ consecutive chapters with same tension level (all high or all low).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-021\\\", \\\"description\\\": \\\"Romance Arc Pacing: The romance must escalate through recognizable stages: awareness → attraction → tension → vulnerability → setback → deepening → commitment. Skipping stages is a failure.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I18, line 81\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Map romance arc progression against the stage checklist per chapter. Verify no stage is skipped and progression matches outline.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-022\\\", \\\"description\\\": \\\"Antagonist Motivation: The antagonist (person, system, or force) MUST have comprehensible motivations. 'Evil for evil's sake' is only acceptable if the story explicitly explores why. Cardboard villains are failures.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I19, line 84\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify antagonist character file contains motivation, methodology, and backstory. Beta fantasy reader checks antagonist feels three-dimensional.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Originality Invariants ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-023\\\", \\\"description\\\": \\\"No Plagiarism — Zero Tolerance: All prose, dialogue, character names, place names, magic system mechanics, and plot structures MUST be entirely original. Nothing may be directly quotable from or closely paraphraseable of any existing published work. Reference material is for stylistic analysis ONLY.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I20, line 88\\\",\\n    \\\"affectedSubdomains\\\": ALL_SD,\\n    \\\"verificationStrategy\\\": \\\"Originality reader lens in beta reading specifically flags passages resembling known works. All creative agents instructed to produce wholly original content.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-024\\\", \\\"description\\\": \\\"Transformative Influence Only: When style samples are provided, the system must extract abstract stylistic patterns and apply them to wholly original content. NEVER reproduce specific metaphors, turns of phrase, character archetypes with identifying details, plot beats in same sequence, or distinctive world elements from reference material.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I21, line 92\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-006\\\",\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify style guide contains only abstract parameters (sentence length, metaphor density, vocabulary register). Cross-check draft prose against reference samples for specific content reproduction.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-025\\\", \\\"description\\\": \\\"Originality Self-Audit: The beta reading phase MUST include an originality check that specifically flags any passage, character, plot element, or world detail that too closely resembles a known published work, citing the similarity and source.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I22, line 94\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify beta-feedback/originality-reader.md exists and contains structured findings. Each finding must cite the concerning similarity and what work it resembles.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Process Invariants ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-026\\\", \\\"description\\\": \\\"Parameterization: The system must accept rough book word count as an input parameter (e.g., 100k words) in addition to other optional parameters specified in the domain brief.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, Parameterization, lines 99-101\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify guide agent input schema includes word count parameter. Verify story-config.json captures word count target.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-027\\\", \\\"description\\\": \\\"Adversarial Phase Gates: Every creative phase (Concept, Worldbuilding, Character, Plotting, Style, Drafting) MUST include an adversarial consistency audit BEFORE the phase is considered complete. The auditor cross-references against ALL prior phase artifacts. Critical findings block phase completion. Non-negotiable.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I23, line 103\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-003\\\",\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-006\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify every creative phase has a corresponding audit findings artifact. Verify no phase was marked complete with unresolved critical findings.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-028\\\", \\\"description\\\": \\\"Input Consumption: When reference stories or style samples are provided, the style analysis agent MUST produce a concrete style guide derived from those inputs, citing specific abstract patterns observed. Ignoring provided inputs is a failure.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I24, line 107\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-006\\\"],\\n    \\\"verificationStrategy\\\": \\\"When style samples exist in story-config.json, verify style/reference-analysis.md exists and contains specific pattern observations. Verify style-guide.md references these patterns.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-029\\\", \\\"description\\\": \\\"Artifact Cross-References: Every artifact must reference its upstream dependencies. The outline references character and world bibles. The draft references the outline. Revision notes reference the draft and style guide. Orphan artifacts with no upstream references are failures.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I25, line 110\\\",\\n    \\\"affectedSubdomains\\\": ALL_CREATIVE,\\n    \\\"verificationStrategy\\\": \\\"For each artifact, verify it contains references to its upstream dependencies. Check for orphan artifacts with no cross-references.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-030\\\", \\\"description\\\": \\\"No Silent Failures: If an agent cannot complete its task (e.g., cannot maintain consistency, cannot find a satisfying resolution), it MUST surface the problem explicitly rather than producing low-quality output.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I26, line 112\\\",\\n    \\\"affectedSubdomains\\\": ALL_SD,\\n    \\\"verificationStrategy\\\": \\\"Agent error handling must produce explicit failure reports. Verify no agent silently degrades output quality without flagging the issue.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-031\\\", \\\"description\\\": \\\"Scope Fidelity: The system must produce what was specified in the concept phase. If the concept says 'standalone novel, 20 chapters, enemies-to-lovers, dark tone,' the output must match. Scope drift without explicit re-approval is a failure.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I27, line 116\\\",\\n    \\\"affectedSubdomains\\\": ALL_SD,\\n    \\\"verificationStrategy\\\": \\\"Compare final output against concept/constraints.md specifications: chapter count, trope adherence, tone consistency, standalone vs series.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-032\\\", \\\"description\\\": \\\"Series Artifact Isolation & Subcategory Decomposition: Every book's artifacts MUST be organized under book-level directory. Series KB at series root. Per-book artifacts MUST NOT directly reference another book's internal artifacts. Content MUST be decomposed into subcategory files within typed directories — not monolithic files.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I28, line 118\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-010\\\",\\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify directory structure follows book-N/ isolation. Check no cross-book direct references (only series/ references). Verify artifacts are split into subcategory files, not monoliths.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-033\\\", \\\"description\\\": \\\"Foreshadowing Resolution Completeness: Every foreshadowing plant MUST resolve by story's end. The foreshadowing ledger must show 1:1 plant-to-payoff mapping with zero unresolved entries at final delivery. Red herrings are exceptions ONLY when explicitly tagged as intentional and serve a narrative purpose.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I29, line 121\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-013\\\",\\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"Audit foreshadowing ledger for any unresolved plants at delivery. Verify every red herring is tagged as intentional with stated narrative purpose.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-034\\\", \\\"description\\\": \\\"POV Voice Distinctiveness (3-4 sentence test): In multi-POV stories, each POV character MUST be recognizable within the first 3-4 sentences of any section without being explicitly told. If a POV section could belong to a different character with only name changes, that is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I30, line 124\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-006\\\",\\\"SD-007\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Blind test: strip POV indicators from section openings and verify character identifiability from voice alone within 3-4 sentences.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-035\\\", \\\"description\\\": \\\"Micro-Tension Continuity: No prose passage longer than half a page may exist without at least one active source of tension — plot, interpersonal, internal, environmental, anticipatory, or dramatic irony. Tension-free stretches are dead pages. Revision MUST audit for tension voids.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I31, line 127\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"During revision, scan every half-page block for at least one identifiable tension source. Flag blocks with zero tension.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-036\\\", \\\"description\\\": \\\"Thematic Coherence: Every story must have 2-3 explicitly identified thematic pillars visible in worldbuilding design (magic as metaphor), character arc design (each lead embodies different relationship to theme), and plot structure (central conflict literalizes thematic argument). No discernible theme or accidentally contradictory themes = structural failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I32, line 130\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-003\\\",\\\"SD-004\\\",\\\"SD-005\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify concept/premise.md contains 2-3 thematic pillars. Trace each theme through worldbuilding, character arcs, and plot structure artifacts. Beta craft reader checks thematic visibility.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-037\\\", \\\"description\\\": \\\"Emotional State Variety: No major character may occupy the same dominant emotional state in two consecutive chapters. Emotional throughlines must show variety and escalation. Stagnant emotional states signal stagnant character development.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I33, line 133\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Chart dominant emotional state per character per chapter. Flag any consecutive chapters with the same dominant emotion for the same character.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-038\\\", \\\"description\\\": \\\"Dialogue Function Mandate: Every dialogue exchange of 3+ lines MUST serve at least one identifiable narrative function: advance plot, reveal character, build/strain relationship, create conflict, convey disguised exposition, or shift emotional register. Filler dialogue is a failure.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 1.0,\\n    \\\"source\\\": \\\"invariants.md, I34, line 136\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\"],\\n    \\\"verificationStrategy\\\": \\\"Tag every dialogue exchange with its narrative function during line edit. Flag exchanges with no identifiable function.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# PART 2: CRAFT TOOLBOX (conditionally binding once selected)\\n# confidence 0.9 — explicitly documented but conditional on selection\\n# ============================================================\\n\\n# --- Scene-Level Craft Tools ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-039\\\", \\\"description\\\": \\\"[Craft Tool T1] Scene-Sequel Structure (Swain): Scenes follow Goal→Conflict→Disaster; Sequels follow Reaction→Dilemma→Decision. Creates compulsive readability. Binding when selected in Story Craft Profile; may be loosened for introspective/lyrical passages.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T1, line 149\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify scene outlines tag Goal/Conflict/Disaster or Reaction/Dilemma/Decision structure. Auditors check drafted scenes follow the pattern where applicable.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-040\\\", \\\"description\\\": \\\"[Craft Tool T2] Scene Value Shifts (Story Grid): Every scene shifts at least one value from beginning to end — emotional, relational, informational, or situational. A scene where nothing has changed is a dead scene.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T2, line 152\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: for each scene, identify the value(s) that changed. Flag scenes with no identifiable shift.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-041\\\", \\\"description\\\": \\\"[Craft Tool T3] Five Commandments Per Scene (Story Grid): Every scene contains Inciting Incident, Turning Point Progressive Complication, Crisis, Climax, Resolution. May be loosened for quiet character moments or atmospheric interludes.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T3, line 156\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify scene outlines tag all five commandments. Auditors check drafted scenes contain them.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-042\\\", \\\"description\\\": \\\"[Craft Tool T4] Try-Fail Cycles: Characters fail before succeeding at significant challenges. Major problems require at minimum two failed approaches before a solution works. Each failure teaches something.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T4, line 158\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify major challenge resolutions in outline show at least two prior failed attempts. Auditors check drafted chapters follow this pattern.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-043\\\", \\\"description\\\": \\\"[Craft Tool T5] Tone Contract: The opening chapters establish a tonal promise the story must honor throughout. Tonal shifts must be gradual, motivated, and consistent with the story's identity.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T5, line 164\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: compare tone of later chapters against opening chapters' tonal identity. Flag abrupt or unmotivated tonal shifts.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-044\\\", \\\"description\\\": \\\"[Craft Tool T6] Stakes Escalation: Stakes escalate through each act — what characters risk in Act 3 is greater than Act 1, in both fantasy and romance arcs.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T6, line 167\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: map stakes level per act in both arcs. Verify monotonic increase from Act 1 through Act 3.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-045\\\", \\\"description\\\": \\\"[Craft Tool T7] The Black Moment: A devastating 'all is lost' point where the romance seems doomed and the fantasy plot appears lost. Must feel genuinely threatening. Genre convention for romance-forward stories.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T7, line 169\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify outline contains an explicitly identified Black Moment. Verify drafted Black Moment scene genuinely threatens both arcs.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-046\\\", \\\"description\\\": \\\"[Craft Tool T8] Internal Romantic Resistance: Obstacles between leads include internal resistance (fear, psychological wounds, conflicting beliefs, trust issues). At least half of major romantic obstacles should be internal/psychological.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T8, line 172\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: count internal vs external romantic obstacles in outline. Verify ≥50% are internal/psychological.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-047\\\", \\\"description\\\": \\\"[Craft Tool T9] Subtext in Dialogue: Characters rarely say exactly what they mean, especially in charged scenes. What's unsaid matters as much as spoken. Exception: climactic revelations where directness IS the payoff.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T9, line 176\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: audit charged dialogue scenes for subtext. Flag on-the-nose dialogue in romantic/political/confrontational exchanges.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-048\\\", \\\"description\\\": \\\"[Craft Tool T10] Sanderson's First Law (Magic Clarity): An author's ability to solve conflict with magic is directly proportional to how well the reader understands said magic. Hard magic needs clear rules; soft magic shouldn't solve problems.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T10, line 179\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-003\\\",\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: classify magic system as hard/soft. For hard: verify rules documented before magic solves conflicts. For soft: verify conflict resolutions come from character choices, not magic.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-049\\\", \\\"description\\\": \\\"[Craft Tool T11] Kill Your Darlings: Every revision pass actively hunts for 'darlings' — passages, details, or elements that are beautiful or clever but don't serve the story. Removed to killed-darlings file, not deleted.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T11, line 182\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify revision passes include darling-hunting. Verify killed-darlings.md exists and contains removed passages with reasoning.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Structural Craft Tools ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-050\\\", \\\"description\\\": \\\"[Craft Tool T12] Dual-Arc Interleave: The fantasy plot arc and romance arc are plotted in parallel with key beats from each reinforcing or complicating the other. A fantasy crisis should also be a romantic inflection point.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T12, line 187\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify outline maps both arc beats per chapter. Check key fantasy beats have corresponding romance implications and vice versa.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-051\\\", \\\"description\\\": \\\"[Craft Tool T13] Tension Mapping: A visual/textual pacing chart showing tension rise-and-fall across all chapters. Used during plotting to ensure proper rhythm and avoid flat stretches.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T13, line 190\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify outline/tension-map.md exists and covers all chapters. Check for flat stretches (3+ chapters at same tension level).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-052\\\", \\\"description\\\": \\\"[Craft Tool T14] Scene-Sequel MRU (Motivation-Reaction Units): At the sentence/paragraph level within scenes: external stimulus (Motivation) followed by character response (Reaction) in the order Feeling → Reflex → Rational Action.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T14, line 193\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: spot-check action sequences and high-tension scenes for MRU ordering. Flag reversed reaction order (rational before feeling).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# --- Advanced Craft Tools ---\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-053\\\", \\\"description\\\": \\\"[Craft Tool T15] Foreshadowing Plant-Payoff Ledger: Maintain an explicit register mapping every foreshadowing plant to its payoff — chapter planted, chapter resolved, perceived vs actual purpose. Every plant must resolve; every major payoff must have at least one plant.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T15, line 197\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-013\\\",\\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify foreshadowing ledger exists with plant-payoff mappings. Check for unresolved plants and payoffs without plants at delivery.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-054\\\", \\\"description\\\": \\\"[Craft Tool T16] Symbolic Motif Weaving: Assign 3-5 recurring symbols/motifs to thematic pillars. Track appearances per chapter to ensure consistent density without overuse. Motifs should escalate or transform alongside themes.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T16, line 201\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-014\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify motif assignment exists in concept artifacts. Track motif appearances per chapter and verify escalation/transformation.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-055\\\", \\\"description\\\": \\\"[Craft Tool T17] POV Voice Fingerprint Verification: For each POV character, define measurable voice parameters (sentence length distribution, vocabulary register, metaphor preference, emotional expression style, humor frequency, observation focus). Verify fingerprints in every POV section during review.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T17, line 203\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-006\\\",\\\"SD-009\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify voice fingerprint defined per POV character. Run quantitative comparison of voice parameters across all POV sections. Flag statistical drift.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-056\\\", \\\"description\\\": \\\"[Craft Tool T18] Information Asymmetry Mapping: Track what each character knows vs. what the reader knows vs. what other characters know. Map gaps per chapter. Manage reveals so asymmetries create tension, not confusion.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T18, line 206\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-013\\\",\\\"SD-005\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify knowledge-matrix.md tracks per-character and reader knowledge per chapter boundary. Check reveals are sequenced to maximize tension.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-057\\\", \\\"description\\\": \\\"[Craft Tool T19] Micro-Tension Audit: Every page must sustain at least one form of tension. During revision, flag any half-page stretch with zero tension source and inject at least one.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T19, line 209\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: during revision, scan every half-page block for tension sources. Flag and count tension voids.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-058\\\", \\\"description\\\": \\\"[Craft Tool T20] Emotional Throughline Charting: Chart each lead's specific emotional state (granular labels, not just happy/sad) per chapter. Verify variety (no emotion repeats in adjacent chapters for same character), escalation, and motivation.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T20, line 212\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: produce emotional throughline chart per lead. Verify no adjacent-chapter emotion repeats, general escalation toward climax, and scene-event motivation for every shift.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-059\\\", \\\"description\\\": \\\"[Craft Tool T21] Vulnerability Escalation Ladder: Map 5-8 escalating vulnerability moments per lead across the story. Each successive vulnerability requires more courage. Vulnerability met with tenderness deepens bond; exploited creates reversals.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T21, line 216\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify vulnerability ladder exists for each lead (5-8 moments). Check each moment requires more courage than the previous.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-060\\\", \\\"description\\\": \\\"[Craft Tool T22] Chapter Hook-and-Close Catalogue: Assign each chapter an opening hook type and closing technique. Ensure variety across consecutive chapters — no two adjacent chapters use same hook or close type.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T22, line 219\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify outline tags hook and close types per chapter. Check no two adjacent chapters share the same hook type or close type.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-061\\\", \\\"description\\\": \\\"[Craft Tool T23] Mystery Box Inventory: Track count of active unresolved questions the reader is holding. Maintain target range (typically 3-5). When a question is answered, open a new one within 1-2 chapters.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T23, line 222\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-013\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: maintain active question count per chapter. Verify count stays within 3-5 range. Flag chapters where count drops below 3 or exceeds 5.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-062\\\", \\\"description\\\": \\\"[Craft Tool T24] Dialogue Subtext Gap Analysis: For every significant conversation, document the gap between what each character says and what they mean. The wider the gap, the more tension. Climactic moments work because the gap finally closes.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T24, line 225\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify subtext gap documentation exists for key conversations in outline. Auditors check drafted dialogue carries intended subtext.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-063\\\", \\\"description\\\": \\\"[Craft Tool T25] Thematic Argument Scaffolding: Structure each theme as an argument — question, competing answers (embodied by characters/factions), resolution earned through protagonist experience. Act 1 introduces, Act 2 tests easy answers, Act 3 forces the hardest version.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T25, line 227\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify thematic argument structure documented in concept artifacts. Trace question/answer/resolution through acts.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-064\\\", \\\"description\\\": \\\"[Craft Tool T26] Sensory Signature Anchoring: Assign each major character a dominant sensory channel for emotional expression (hands, chest, auditory, etc.). Key emotional moments anchored in character-specific physical responses, not generic descriptions.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.9,\\n    \\\"source\\\": \\\"invariants.md, T26, line 230\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-004\\\",\\\"SD-007\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"When selected: verify sensory signature assigned per character in character files. Check key emotional scenes use character-specific physical responses.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# IMPLICIT INVARIANTS FROM DOMAIN BRIEF (conf 0.7-0.85)\\n# ============================================================\\n\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-065\\\", \\\"description\\\": \\\"Guide Agent as Sole User Interface: The guide agent is the ONLY agent that interacts with the user. All other agents in the pipeline are fully autonomous. No agent other than the guide may request user input.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.85,\\n    \\\"source\\\": \\\"domain-brief.md, lines 49-57\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify only the guide agent has user-interaction capabilities. All other agent prompts must be autonomous (no ask_questions or user prompts).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-066\\\", \\\"description\\\": \\\"Series-Ready Architecture From Day One: The system MUST be designed for series production even if the first invocation is a standalone. All artifacts organized to enable seamless sequel creation.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.85,\\n    \\\"source\\\": \\\"domain-brief.md, line 225\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-010\\\",\\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify artifact directory structure supports series/ and book-N/ layout even for standalone stories. Verify book-summary agent runs even for first book.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-067\\\", \\\"description\\\": \\\"Minimum Viable Input is Story Idea Only: The system must be able to generate a complete story from just a premise. All other inputs (style samples, mood, characters, world, constraints) are optional enrichment.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 44\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\",\\\"SD-002\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify guide agent can proceed with only a story idea. Verify all other input fields have sensible defaults or graceful handling when absent.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-068\\\", \\\"description\\\": \\\"Five Independent Beta Reader Lenses Required: Beta reading must operate as five independent reviewers: romance reader, fantasy reader, craft reader, sensitivity reader, and originality reader. Each produces structured findings with severity levels.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 180-215\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify five separate beta reader agents/passes exist. Verify each produces a structured findings file with severity levels (critical/major/minor/suggestion).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-069\\\", \\\"description\\\": \\\"Story Craft Profile Artifact Required: During Concept and Plotting, the system must produce a Story Craft Profile listing which craft toolbox items are selected, why, which are excluded and why, and any per-tool adjustments.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.85,\\n    \\\"source\\\": \\\"domain-brief.md, lines 366-372\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-005\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify concept/craft-profile.md exists and contains selected tools with rationale, excluded tools with reasoning, and per-tool adjustments.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-070\\\", \\\"description\\\": \\\"Series Knowledge Base Append-Mostly: Facts established in earlier books cannot be silently contradicted. Retcons must be narratively justified (unreliable narrator, new discovery) and explicitly documented in the series KB.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 358-359\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels: diff series KB before and after book completion. Verify no established fact was changed without a narrative justification entry.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-071\\\", \\\"description\\\": \\\"Sequel Must Address All Unresolved Threads: The sequel concept phase MUST decide which threads from unresolved-threads.md this book resolves, advances, or deliberately leaves open. No thread may be silently forgotten.\\\",\\n    \\\"classification\\\": \\\"behavioral\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 341\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-012\\\"],\\n    \\\"verificationStrategy\\\": \\\"For sequels: verify concept phase documents disposition of every entry in unresolved-threads.md (resolve/advance/leave-open).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-072\\\", \\\"description\\\": \\\"POV Transition Must Be Motivated: Every POV switch must be motivated — either by a cliffhanger/question in the departing POV that the new POV can illuminate, or by a time/space jump the narrative requires. No arbitrary switching.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, lines 427-428\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-005\\\",\\\"SD-007\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify each POV transition in the outline has a stated motivation. During review, check each POV switch connects logically to the preceding section.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-073\\\", \\\"description\\\": \\\"Publication-Ready Prose Quality: Output must be publication-ready romantic fantasy prose — lush but not purple, emotionally resonant, genre-appropriate. This is the overall quality bar.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, line 403\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-007\\\",\\\"SD-008\\\",\\\"SD-010\\\"],\\n    \\\"verificationStrategy\\\": \\\"Multi-pass review and beta reading collectively enforce this bar. Final proofread pass verifies publication readiness.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-074\\\", \\\"description\\\": \\\"Subcategory Files Must Be Independently Loadable: Each subcategory file should be self-contained enough to be loaded independently. An agent checking magic rules shouldn't need to load geography.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 329-331\\\",\\n    \\\"affectedSubdomains\\\": ALL_CREATIVE,\\n    \\\"verificationStrategy\\\": \\\"Verify each subcategory file can be understood without loading sibling files. Check for undefined references that require other subcategory files.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-075\\\", \\\"description\\\": \\\"Cross-References Use Relative File Paths: Cross-references between subcategories must use relative file paths (e.g., ../characters/leads/kael.md), never vague prose references like 'see the character bible'.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 331\\\",\\n    \\\"affectedSubdomains\\\": ALL_CREATIVE,\\n    \\\"verificationStrategy\\\": \\\"Scan all artifacts for cross-references. Verify they use relative file paths. Flag vague prose references.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-076\\\", \\\"description\\\": \\\"Severity-Gated Acceptance: All critical and major findings from beta reading MUST be addressed in a revision pass before any chapter is considered complete. Minor findings and suggestions are advisory.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, line 215\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-008\\\",\\\"SD-009\\\"],\\n    \\\"verificationStrategy\\\": \\\"Cross-reference beta-feedback/synthesis.md critical/major findings against revision-log.md entries. Verify every critical/major finding has a corresponding revision.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-077\\\", \\\"description\\\": \\\"One Story At A Time: The system handles one story at a time — no simultaneous story production.\\\",\\n    \\\"classification\\\": \\\"structural\\\", \\\"confidence\\\": 0.7,\\n    \\\"source\\\": \\\"domain-brief.md, line 474\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\"],\\n    \\\"verificationStrategy\\\": \\\"System architecture enforces single pipeline execution. No parallel story-writing capability required.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-078\\\", \\\"description\\\": \\\"Craft Toolbox Selection Minimum: The system SHOULD select at least 5-8 tools per story from the Craft Toolbox. Fewer than 5 is likely undercooked; using all rigidly is likely overengineered.\\\",\\n    \\\"classification\\\": \\\"quality\\\", \\\"confidence\\\": 0.85,\\n    \\\"source\\\": \\\"invariants.md, line 145\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-005\\\"],\\n    \\\"verificationStrategy\\\": \\\"Count selected tools in concept/craft-profile.md. Flag if fewer than 5 (with advisory) or if all 26 are selected without loosening notes.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-079\\\", \\\"description\\\": \\\"Selected Craft Tools Become Binding: Once a craft tool is selected for a story in the Story Craft Profile, it becomes binding for that story. Adversarial auditors verify against the selected toolset, not the full toolbox.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.95,\\n    \\\"source\\\": \\\"invariants.md, lines 143-145\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-002\\\",\\\"SD-005\\\",\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify auditors load concept/craft-profile.md and check compliance with selected tools only. Verify no auditor enforces unselected tools.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-080\\\", \\\"description\\\": \\\"Story-Config Artifact Before Pipeline Launch: A story-config.json (or equivalent) must be written and confirmed with the user before the autonomous pipeline begins. Captures all user inputs and defaults.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.8,\\n    \\\"source\\\": \\\"domain-brief.md, lines 53-54\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-001\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify guide agent produces story-config.json before invoking orchestrator. Verify config contains all input fields (required and optional with defaults).\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\ninvariants.append({\\n    \\\"id\\\": \\\"INV-081\\\", \\\"description\\\": \\\"Kill-Your-Darlings Mandatory in Every Adversarial Audit: Every adversarial auditor MUST explicitly look for 'darlings' — passages, details, or elements that are beautiful/clever but don't serve the story. Darlings moved to killed-darlings file, not deleted.\\\",\\n    \\\"classification\\\": \\\"workflow\\\", \\\"confidence\\\": 0.85,\\n    \\\"source\\\": \\\"domain-brief.md, line 70\\\",\\n    \\\"affectedSubdomains\\\": [\\\"SD-011\\\"],\\n    \\\"verificationStrategy\\\": \\\"Verify every adversarial auditor prompt includes kill-your-darlings check. Verify killed-darlings.md receives flagged items.\\\",\\n    \\\"discoveredBy\\\": \\\"fractal-factory-invariant-extractor\\\"\\n})\\n\\n# ============================================================\\n# UPDATE DOMAIN MODEL\\n# ============================================================\\n\\nmodel[\\\"invariants\\\"] = invariants\\nmodel[\\\"lastUpdated\\\"] = \\\"2026-03-15T23:15:00Z\\\"\\n\\nwith open(\\\"/home/jakubs/repositories/ralph-orchestrator/.fractal-factory/domain-model.json\\\", \\\"w\\\") as f:\\n    json.dump(model, f, indent=2)\\n\\n# Print summary stats\\nfrom collections import Counter\\nclassifications = Counter(inv[\\\"classification\\\"] for inv in invariants)\\nconf_bands = Counter()\\nfor inv in invariants:\\n    c = inv[\\\"confidence\\\"]\\n    if c >= 0.9:\\n        conf_bands[\\\"high (≥0.9)\\\"] += 1\\n    elif c >= 0.7:\\n        conf_bands[\\\"medium (0.7-0.89)\\\"] += 1\\n    else:\\n        conf_bands[\\\"low (<0.7)\\\"] += 1\\n\\nprint(f\\\"Total invariants: {len(invariants)}\\\")\\nprint(f\\\"\\\\nBy classification:\\\")\\nfor cls, count in sorted(classifications.items()):\\n    print(f\\\"  {cls}: {count}\\\")\\nprint(f\\\"\\\\nBy confidence band:\\\")\\nfor band, count in sorted(conf_bands.items()):\\n    print(f\\\"  {band}: {count}\\\")\\nprint(f\\\"\\\\nFrom Part 1 (explicit): INV-001 to INV-038 = 38\\\")\\nprint(f\\\"From Part 2 (craft toolbox): INV-039 to INV-064 = 26\\\")\\nprint(f\\\"From domain brief (implicit): INV-065 to INV-081 = 17\\\")\\n\\nPYEOF\\npython3 /tmp/build_invariants.py\", \"description\": \"Build and write all invariants to domain model\", \"initial_wait\": 30}"
