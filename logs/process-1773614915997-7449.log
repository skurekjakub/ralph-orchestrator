": \\"Optional rough character ideas from user\\"},\\n                    {\\"name\\": \\"worldFragments\\", \\"type\\": \\"array|null\\", \\"description\\": \\"Optional world details from user\\"},\\n                    {\\"name\\": \\"styleSamples\\", \\"type\\": \\"array|null\\", \\"description\\": \\"Optional reference fiction file paths for style extraction (INV-028)\\"},\\n                    {\\"name\\": \\"constraints\\", \\"type\\": \\"object|null\\", \\"description\\": \\"Optional constraints (heat level, content warnings, etc.)\\"},\\n                    {\\"name\\": \\"sequelOf\\", \\"type\\": \\"string|null\\", \\"description\\": \\"storyId of predecessor book if this is a sequel\\"},\\n                    {\\"name\\": \\"confirmedByUser\\", \\"type\\": \\"boolean\\", \\"description\\": \\"Must be true before pipeline launch (INV-080)\\"},\\n                    {\\"name\\": \\"createdAt\\", \\"type\\": \\"string\\", \\"description\\": \\"ISO-8601 timestamp\\"}\\n                ]\\n            },\\n            \\"writers\\": [\\"romantic-fantasy-writer-guide\\"],\\n            \\"readers\\": [\\"all agents\\"],\\n            \\"writeProtocol\\": \\"create-once\\"\\n        },\\n        {\\n            \\"name\\": \\"progress.json\\",\\n            \\"purpose\\": \\"Pipeline execution state tracking for the produced system's orchestrator. Tracks which creative phase is active, per-chapter progress, and gate statuses.\\",\\n            \\"schema\\": {\\n                \\"fields\\": [\\n                    {\\"name\\": \\"storyId\\", \\"type\\": \\"string\\", \\"description\\": \\"Active story identifier\\"},\\n                    {\\"name\\": \\"currentPhase\\", \\"type\\": \\"string\\", \\"description\\": \\"Active creative phase (concept|worldbuilding|character|plotting|style|drafting|revision|beta-reading|polish)\\"},\\n                    {\\"name\\": \\"phaseStatuses\\", \\"type\\": \\"object\\", \\"description\\": \\"Map of phase-name → {status, startedAt, completedAt, gateResult}\\"},\\n                    {\\"name\\": \\"chapterProgress\\", \\"type\\": \\"array\\", \\"description\\": \\"Per-chapter status: [{chapterNum, drafted, revised, betaRead, polished}]\\"},\\n                    {\\"name\\": \\"currentChapter\\", \\"type\\": \\"number|null\\", \\"description\\": \\"Chapter currently being processed (for sequential drafting per INV-012)\\"},\\n                    {\\"name\\": \\"gapCycles\\", \\"type\\": \\"number\\", \\"description\\": \\"Number of revision cycles completed\\"},\\n                    {\\"name\\": \\"lastUpdated\\", \\"type\\": \\"string\\", \\"description\\": \\"ISO-8601 timestamp\\"}\\n                ]\\n            },\\n            \\"writers\\": [\\"romantic-fantasy-writer-orchestrator\\"],\\n            \\"readers\\": [\\"romantic-fantasy-writer-orchestrator\\", \\"all coordinators\\"],\\n            \\"writeProtocol\\": \\"read-modify-write\\",\\n            \\"ownershipField\\": None\\n        },\\n        {\\n            \\"name\\": \\"manifest.json\\",\\n            \\"purpose\\": \\"Append-only audit trail of all agent actions. Every agent prepends an entry after completing work (newest first per PATTERN-010).\\",\\n            \\"schema\\": {\\n                \\"fields\\": [\\n                    {\\"name\\": \\"timestamp\\", \\"type\\": \\"string\\", \\"description\\": \\"ISO-8601 timestamp\\"},\\n                    {\\"name\\": \\"agent\\", \\"type\\": \\"string\\", \\"description\\": \\"Agent name that performed work\\"},\\n                    {\\"name\\": \\"task_id\\", \\"type\\": \\"string\\", \\"description\\": \\"Phase/task identifier\\"},\\n                    {\\"name\\": \\"artifacts\\", \\"type\\": \\"array\\", \\"description\\": \\"List of artifact paths written or modified\\"},\\n                    {\\"name\\": \\"status\\", \\"type\\": \\"string\\", \\"description\\": \\"completed|failed\\"},\\n                    {\\"name\\": \\"result\\", \\"type\\": \\"string\\", \\"description\\": \\"Agent-specific result code\\"},\\n                    {\\"name\\": \\"iteration\\", \\"type\\": \\"number\\", \\"description\\": \\"Iteration number (for multi-pass phases)\\"}\\n                ]\\n            },\\n            \\"writers\\": [\\"all agents\\"],\\n            \\"readers\\": [\\"romantic-fantasy-writer-orchestrator\\", \\"delivery agents\\"],\\n            \\"writeProtocol\\": \\"prepend-entry\\",\\n            \\"ownershipField\\": \\"agent\\"\\n        },\\n        {\\n            \\"name\\": \\"agents/*/status.json\\",\\n            \\"purpose\\": \\"Per-agent routing signal following PATTERN-003. The orchestrator/coordinators read these to make routing decisions. Each agent writes its own status on completion.\\",\\n            \\"schema\\": {\\n                \\"fields\\": [\\n                    {\\"name\\": \\"agent\\", \\"type\\": \\"string\\", \\"description\\": \\"Agent name\\"},\\n                    {\\"name\\": \\"task_id\\", \\"type\\": \\"string\\", \\"description\\": \\"Task identifier\\"},\\n                    {\\"name\\": \\"status\\", \\"type\\": \\"string\\", \\"description\\": \\"completed|failed|blocked\\"},\\n                    {\\"name\\": \\"result\\", \\"type\\": \\"string\\", \\"description\\": \\"Agent-specific result code used in routing tables\\"},\\n                    {\\"name\\": \\"summary\\", \\"type\\": \\"string\\", \\"description\\": \\"Human-readable summary of what was done\\"},\\n                    {\\"name\\": \\"artifacts\\", \\"type\\": \\"array\\", \\"description\\": \\"Paths to artifacts produced\\"},\\n                    {\\"name\\": \\"next_hint\\", \\"type\\": \\"string|null\\", \\"description\\": \\"Suggested next agent\\"},\\n                    {\\"name\\": \\"findings\\", \\"type\\": \\"object|null\\", \\"description\\": \\"For auditors: {critical: N, major: N, minor: N}\\"},\\n                    {\\"name\\": \\"iteration\\", \\"type\\": \\"number\\", \\"description\\": \\"Iteration counter\\"}\\n                ]\\n            },\\n            \\"writers\\": [\\"each agent (own status only)\\"],\\n            \\"readers\\": [\\"parent coordinator\\", \\"orchestrator\\"],\\n            \\"writeProtocol\\": \\"create-once-per-iteration\\"\\n        }\\n    ],\\n\\n    \\"domainSpecific\\": [\\n        # ============================================================\\n        # PHASE 1: CONCEPT DEVELOPMENT (SD-002)\\n        # ============================================================\\n        {\\n            \\"name\\": \\"story-concept.json\\",\\n            \\"purpose\\": \\"Crystallized story concept: refined premise, thematic pillars, genre balance, comp titles, target audience, and high-level arc shapes. The foundational document all downstream phases reference.\\",\\n            \\"schema\\": {\\n                \\"fields\\": [\\n                    {\\"name\\": \\"storyId\\", \\"type\\": \\"string\\", \\"description\\": \\"Story identifier from story-config.json\\"},\\n                    {\\"name\\": \\"refinedPremise\\", \\"type\\": \\"string\\", \\"description\\": \\"One-paragraph distilled premise\\"},\\n                    {\\"name\\": \\"thematicPillars\\", \\"type\\": \\"array\\", \\"description\\": \\"2-3 core themes [{id, theme, question, argument}] per INV-063/T25\\"},\\n                    {\\"name\\": \\"genreBalance\\", \\"type\\": \\"object\\", \\"description\\": \\"{fantasyWeight: 0-1, romanceWeight: 0-1} — must sum to ~1, neither zero per INV-001\\"},\\n                    {\\"name\\": \\"compTitles\\", \\"type\\": \\"array\\", \\"description\\": \\"2-4 comparable published titles with brief rationale\\"},\\n                    {\\"name\\": \\"targetAudience\\", \\"type\\": \\"string\\", \\"description\\": \\"Target reader profile\\"},\\n                    {\\"name\\": \\"heatLevel\\", \\"type\\": \\"string\\", \\"description\\": \\"Romance heat level (sweet|warm|steamy|explicit)\\"},\\n          