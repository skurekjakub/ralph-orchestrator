   \\\"condition\\\": \\\"result == 'completed' AND phaseStatuses.drafting.status == 'pending'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-drafting-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"update progress.json drafting→complete; dispatch romantic-fantasy-writer-continuity-tracker (full verification)\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: failed; summary: 'Drafting phase blocked'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/continuity-tracker/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed' AND phaseStatuses.revision.status == 'pending'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-revision-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"update progress.json revision→complete; dispatch romantic-fantasy-writer-beta-reading-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: failed; summary: 'Revision phase blocked'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"check beta-synthesis verdicts: if any chapter verdict=='revision-required' AND revisionBetaCycles < maxRevisionBetaCycles → reset revision+beta status, re-dispatch revision-coordinator; else update progress.json beta-reading→complete, dispatch romantic-fantasy-writer-polish-coordinator\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: failed; summary: 'Beta-reading phase blocked'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/polish-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete'\\\",\\n            \\\"action\\\": \\\"update progress.json polish→complete; dispatch romantic-fantasy-writer-series-kb-manager\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/polish-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: delivered-with-gaps; summary: 'Polish incomplete'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/series-kb-manager/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"write own status: delivered; summary: 'All phases complete, series KB updated'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/series-kb-manager/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: delivered-with-gaps; summary: 'Delivered but series KB update failed'\\\"\\n        }\\n    ],\\n    \\\"revisionBetaLoop\\\": {\\n        \\\"description\\\": \\\"After beta-reading completes, if any chapter has beta-synthesis verdict 'revision-required', the orchestrator re-dispatches the revision-coordinator for those chapters, then re-dispatches beta-reading. This forms a bounded loop.\\\",\\n        \\\"maxCycles\\\": 2,\\n        \\\"triggerCondition\\\": \\\"Any beta-synthesis/{N}.json has verdict == 'revision-required'\\\",\\n        \\