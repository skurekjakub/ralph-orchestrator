vision phases can read craft-tracking state\\\",\\n        \\\"Craft-tracker status == 'completed'\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-005\\\"]\\n})\\n\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-011\\\",\\n    \\\"name\\\": \\\"Cross-cutting — continuity-tracker full verification\\\",\\n    \\\"category\\\": \\\"cross-cutting-agents\\\",\\n    \\\"priority\\\": \\\"P1\\\",\\n    \\\"description\\\": \\\"Continuity-tracker verifies 3 chapters after drafting completes\\\",\\n    \\\"initialState\\\": {\\n        \\\"contextJson\\\": {\\n            \\\"bookId\\\": \\\"test-book-011\\\",\\n            \\\"targetChapters\\\": 3\\n        },\\n        \\\"existingArtifacts\\\": [\\n            \\\"books/test-book-011/chapters/chapter-001-draft.md\\\",\\n            \\\"books/test-book-011/chapters/chapter-002-draft.md\\\",\\n            \\\"books/test-book-011/chapters/chapter-003-draft.md\\\",\\n            \\\"books/test-book-011/world/geography.json\\\",\\n            \\\"books/test-book-011/characters/*.json\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-continuity-tracker\\\",\\n        \\\"action\\\": \\\"invoke after drafting-coordinator completes\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"Continuity-tracker reads all 3 chapter drafts\\\",\\n        \\\"Checks character names, locations, magic rules consistency\\\",\\n        \\\"Finds 1 minor inconsistency: character eye color changed ch1→ch3\\\",\\n        \\\"Writes continuity-log.json with findings\\\",\\n        \\\"Returns 'completed' (issues logged, not blocking)\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"completed\\\",\\n        \\\"artifactsWritten\\\": [\\n            \\\"books/test-book-011/continuity-log.json\\\"\\n        ],\\n        \\\"issuesFound\\\": 1,\\n        \\\"severity\\\": \\\"minor\\\"\\n    },\\n    \\\