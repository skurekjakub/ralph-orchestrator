'],\\n        'artifact_reads': ['story-concept.json'],\\n        'artifact_writes': ['characters/index.json', 'characters/{CHAR-NNN}.json'],\\n        'result_codes': ['completed', 'blocked'],\\n    },\\n\\n    'romantic-fantasy-writer-romance-arc-designer': {\\n        'role': 'Design the romance arc between leads: stages of attraction, key emotional moments, internal/external obstacles, the black moment, and HEA/HFN resolution. Includes vulnerability escalation ladder.',\\n        'process_steps': [\\n            '1. Read story-concept.json and characters/*.json to understand the leads\\\\' psychology and world constraints',\\n            '2. Define romance arc type: enemies-to-lovers, friends-to-lovers, forbidden love, etc.',\\n            '3. Map arc stages per INV-021: awareness → attraction → resistance → deepening → vulnerability → setback → commitment',\\n            '4. Identify internal resistance per INV-046/T8: at least 50% of obstacles should be internal (fears, wounds, conflicting beliefs)',\\n            '5. Design vulnerability escalation per INV-059/T21: 5-8 escalating vulnerability moments where character reveals deeper needs',\\n            '6. Design the black moment per INV-045/T7: a devastating point where the romance seems doomed',\\n            '7. Ensure resolution is HFN or HEA per INV-001',\\n            '8. Map chapters where each stage occurs based on target chapter count from story-concept.json',\\n            '9. Write romance-arc-design.json with leadA/leadB (CHAR-NNN), arc type, stages, internal resistance, vulnerability ladder, black moment, resolution',\\n            '10. Include upstream references to characters/*.json and story-concept.json (per INV-029)'\\n        ],\\n        'invariants': ['INV-001', 'INV-004', 'INV-021', 'INV-045', 'INV-046', 'INV-059'],\\n        'artifact_reads': ['story-concept.json', 'characters/index.json'],\\n        'artifact_writes': ['romance-arc-design.json'],\\n        'result_codes': ['completed'