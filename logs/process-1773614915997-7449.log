and cross-cutting concerns. Routes work through coordinators and manages overall progress.\\\"\\n    elif level == 'coordinator':\\n        return f\\\"Coordinator for {agent.get('pass', 'unknown')} phase. Dispatches specialists and manages work through this creative pass.\\\"\\n    elif level == 'sub-coordinator':\\n        pass_name = agent.get('pass', 'unknown')\\n        return f\\\"Sub-coordinator for {pass_name} phase. Organizes specialist work under the parent coordinator.\\\"\\n    else:\\n        return f\\\"Specialist agent for specific creative work.\\\"\\n\\n# Helper function to generate pure router section for coordinators\\ndef generate_pure_router_section(agent, routing_data):\\n    level = agent.get('level', '')\\n    if level not in ['orchestrator', 'coordinator', 'sub-coordinator']:\\n        return \\\"\\\"\\n    \\n    output = \\\"## Pure Router Purity Rule\\\\n\\\\n\\\"\\n    output += \\\"**Purity Constraint:** This agent is a pure router. It must not perform substantive creative work. Its role is to:\\\\n\\\"\\n    output += \\\"- Read progress/status files from children\\\\n\\\"\\n    output += \\\"- Evaluate routing conditions\\\\n\\\"\\n    output += \\\"- Dispatch specialist agents in sequence\\\\n\\\"\\n    output += \\\"- Update progress state\\\\n\\\"\\n    output += \\\"- Write own status.json when phase is complete or blocked\\\\n\\\\n\\\"\\n    \\n    # Get routing table for this agent\\n    routing_table = get_routing_table(agent['name'])\\n    if routing_table:\\n        output += \\\"## Routing Table\\\\n\\\\n\\\"\\n        output += \\\"| Read | Condition | Action |\\\\n\\\"\\n        output += \\\"|------|-----------|--------|\\\\n\\\"\\n        for route in routing_table:\\n            read = route.get('read', '')\\n            condition = route.get('condition', '')\\n            action = route.get('action', '')\\n            output += f\\\"| {read} | {condition} | {action} |\\\\n\\\"\\n        output += \\\"\\\\n\\\"\\n    \\n    return output\\n\\n# Helper function for specialist instructions\\ndef generate_specialist_instructions(agent, domain_model):\\n    \\\"\\\"\\\"Generate detailed work instructions for specialist agents.\\\"\\\"\\\"\\n    output = \\\"## Work Instructions\\\\n\\\\n\\\"\\n    \\n    level = agent.get('level', '')\\n    pass_phase = agent.get('pass', '')\\n    \\n    # Find relevant subdomain in domain model\\n    matching_subdomains = []\\n    if 'subdomains' in domain_model:\\n        for subdomain in domain_model['subdomains']:\\n            # Simple matching: if subdomain id contains the pass phase or is conceptually related\\n            if pass_phase and (pass_phase.lower() in str(subdomain).lower() or \\n                               subdomain.get('shortName', '').lower() == pass_phase.lower()):\\n                matching_subdomains.append(subdomain)\\n    \\n    if pass_phase:\\n        output += f\\\"**Phase:** {pass_phase}\\\\n\\\\n\\\"\\n    \\n    output += \\\"**Primary Responsibilities:**\\\\n\\\"\\n    output += \\\"1. Perform creative work specific to your role\\\\n\\\"\\n    output += \\\"2. Produce artifacts according to artifact assignments\\\\n\\\"\\n    output += \\\"3. Enforce relevant invariants from the domain model\\\\n\\\"\\n    output += \\\"4. Write status.json upon completion with appropriate result code\\\\n\\\\n\\\"\\n    \\n    output += \\\"**Key Invariants to Enforce:**\\\\n\\\"\\n    # Get relevant invariants\\n    if 'invariants' in domain_model:\\n        relevant_invariants = domain_model['invariants'][:3]  # Take first 3 as examples\\n        for inv in relevant_invariants:\\n            output += f\\\"- {inv.get('name', 'Unknown')}\\\\n\\\"\\n    \\n    output += \\\"\\\\n\\\"\\n    return output\\n\\n# Generate all agent prompt files\\noutput_dir = Path('.fractal-factory/output/romantic-fantasy-writer/agents')\\nagents_written = 0\\nerrors = []\\n\\nfor agent in roster['agents']:\\n    agent_name = agent['name']\\n    file_path = output_dir / f\\\"{agent_name}.agent.md\\\"\\n    \\n    try:\\n        # Start building the markdown file\\n        content = f\\\"# {agent.get('displayName', agent_name)}\\\\n\\\\n\\\"\\n        content += f\\\"**Agent ID:** {agent.get('id', 'unknown')}\\\\n\\\"\\n        content += f\\\"**Level:** {agent.get('level', 'unknown')}\\\\n\\\"\\n        content += f\\\"**Parent:** {agent.get('parent', 'none')}\\\\n\\\"\\n        \\n        if agent.get('children'):\\n            content += f\\\"**Children:** {', '.join(agent['children'])}\\\\n\\\"\\n        \\n        if agent.get('pass'):\\n            content += f\\\"**Pass/Phase:** {agent['pass']}\\\\n\\\"\\n        \\n        content += \\\"\\\\n\\\"\\n        \\n        # Role description\\n        content += \\\"## Role\\\\n\\\\n\\\"\\n        content += get_role_description(agent) + \\\"\\\\n\\\\n\\\"\\n        \\n        # Pure router section for coordinators/orchestrators\\n        if agent.get('level') in ['orchestrator', 'coordinator', 'sub-coordinator']:\\n            content += generate_pure_router_section(agent, routing)\\n        \\n        # Work instructions for specialists\\n        if agent.get('level') == 'specialist':\\n            content += generate_specialist_instructions(agent, domain_model)\\n        \\n        # Artifact assignments\\n        artifact_content = format_artifact_assignments(agent)\\n        if artifact_content:\\n            content += \\\"## Artifact Assignments\\\\n\\\\n\\\"\\n            content += artifact_content + \\\"\\\\n\\\\n\\\"\\n        \\n        # Result codes\\n        if agent.get('resultCodes'):\\n            content += \\\"## Result Codes\\\\n\\\\n\\\"\\n            content += format_result_codes(agent['resultCodes']) + \\\"\\\\n\\\\n\\\"\\n        \\n        # Status contract\\n        content += \\\"## Status Contract\\\\n\\\\n\\\"\\n        content += \\\"When work is complete, write `status.json` with:\\\\n\\\"\\n        content += \\\"- `result`: One of the result codes listed above\\\\n\\\"\\n        content += \\\"- `summary`: Brief description of work completed or reason for blocking\\\\n\\\"\\n        content += \\\"- `startTime`: ISO 8601 timestamp when work began\\\\n\\\"\\n        content += \\\"- `endTime`: ISO 8601 timestamp when work completed\\\\n\\\"\\n        content += \\\"- `artifactsProduced`: List of artifact files written\\\\n\\\"\\n        content += \\\"- `metadata`: Any domain-specific metadata (invariants enforced, etc.)\\\\n\\\"\\n        \\n        # Write the file\\n        with open(file_path, 'w') as f:\\n            f.write(content)\\n        \\n        agents_written += 1\\n        print(f\\\"✓ {agent_name}\\\")\\n        \\n    except Exception as e:\\n        errors.append(f\\\"{agent_name}: {str(e)}\\\")\\n        print(f\\\"✗ {agent_name}: {str(e)}\\\")\\n\\nprint(f\\\"\\\\n{'='*60}\\\")\\nprint(f\\\"Generated {agents_written} agent prompt files\\\")\\nif errors:\\n    print(f\\\"Errors: {len(errors)}\\\")\\n    for error in errors:\\n        print(f\\\"  - {error}\\\")\\nelse:\\n    print(\\\"No errors!\\\")\\n\\nEOFPYTHON\\n\", \"description\": \"Generate all 67 agent prompt files\"}"
