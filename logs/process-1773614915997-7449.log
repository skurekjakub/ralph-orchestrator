      'gen_ai.tool.call.result': 'FROM ubuntu:22.04\n' +
        '\n' +
        'ARG NODE_MAJOR=24\n' +
        'ARG RUBY_VERSION=3.3.8\n' +
        'ARG BUNDLER_VERSION=2.6.9\n' +
        'ARG DOTNET_VERSION=10.0\n' +
        'ARG PANDOC_VERSION=3.8.3\n' +
        'ARG HOST_UID=1000\n' +
        'ARG HOST_GID=1000\n' +
        '\n' +
        'ENV DEBIAN_FRONTEND=noninteractive\n' +
        '\n' +
        '# ============================================================\n' +
        '# 0. Create non-root user\n' +
        '# ============================================================\n' +
        'RUN groupadd --gid ${HOST_GID} vscode \\\n' +
        '    && useradd --uid ${HOST_UID} --gid ${HOST_GID} --create-home --shell /bin/bash vscode\n' +
        '\n' +
        '# ============================================================\n' +
        '# 1. Locale — Ruby defaults to US-ASCII without this, causing\n' +
        '#    "invalid byte sequence" errors on UTF-8 content files\n' +
        '# ============================================================\n' +
        'RUN apt-get update && apt-get install -y --no-install-recommends locales \\\n' +
        "    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \\\n" +
        '    && locale-gen en_US.UTF-8 \\\n' +
        '    && rm -rf /var/lib/apt/lists/*\n' +
        '\n' +
        'ENV LANG=en_US.UTF-8 \\\n' +
        '    LC_ALL=en_US.UTF-8\n' +
        '<exited with exit code 0>'
    },
