              "arguments": "{\"command\": \"cat << 'PYEOF' > /tmp/review_prompts.py\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"\\nComprehensive prompt reviewer for the Fractal Factory.\\nCross-references all 67 agent prompts against roster.json and routing.json.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport os\\nimport re\\nimport glob\\n\\nBASE = '/home/jakubs/repositories/ralph-orchestrator/.fractal-factory'\\nAGENTS_DIR = f'{BASE}/output/romantic-fantasy-writer/agents'\\n\\n# Load ground truth\\nwith open(f'{BASE}/roster.json') as f:\\n    roster = json.load(f)\\nwith open(f'{BASE}/routing.json') as f:\\n    routing = json.load(f)\\n\\n# Build lookups\\nroster_map = {a['name']: a for a in roster['agents']}\\nrouting_map = routing['agents']  # dict of agent_name -> routing data\\n\\n# Get all prompt files\\nprompt_files = sorted(glob.glob(f'{AGENTS_DIR}/*.agent.md'))\\nprompt_names = {os.path.basename(f).replace('.agent.md', '') for f in prompt_files}\\nroster_names = set(roster_map.keys())\\n\\n# Results storage\\nresults = {}\\n\\ndef extract_frontmatter(content):\\n    \\\"\\\"\\\"Extract YAML frontmatter if present.\\\"\\\"\\\"\\n    if content.startswith('---'):\\n        end = content.find('---', 3)\\n        if end > 0:\\n            return content[3:end].strip()\\n    return None\\n\\ndef extract_sections(content):\\n    \\\"\\\"\\\"Extract H2 sections from markdown.\\\"\\\"\\\"\\n    sections = {}\\n    current_heading = None\\n    current_content = []\\n    \\n    for line in content.split('\\\\n'):\\n        if line.startswith('## '):\\n            if current_heading:\\n                sections[current_heading] = '\\\\n'.join(current_content).strip()\\n            current_heading = line[3:].strip()\\n            current_content = []\\n        elif current_heading:\\n            current_content.append(line)\\n    \\n    if current_heading:\\n        sections[current_heading] = '\\\\n'.join(current_content).strip()\\n    \\n    return sections\\n\\ndef extract_h1(content):\\n    \\\"\\\"\\\"Extract the H1 heading.\\\"\\\"\\\"\\n    for line in content.split('\\\\n'):\\n        if line.startswith('# ') and not line.startswith('## '):\\n            return line[2:].strip()\\n    return None\\n\\ndef check_routing_table_in_prompt(content, agent_name, routing_data):\\n    \\\"\\\"\\\"Check if the prompt's routing table matches routing.json.\\\"\\\"\\\"\\n    findings = []\\n    \\n    rt_entries = routing_data.get('routingTable', [])\\n    dispatch_order = routing_data.get('dispatchOrder', [])\\n    \\n    # Check dispatch order is mentioned\\n    if dispatch_order:\\n        for child in dispatch_order:\\n            # Use short name for checking (without prefix)\\n            short = child.replace('romantic-fantasy-writer-', '')\\n            if short not in content and child not in content:\\n                findings.append({\\n                    'severity': 'block',\\n                    'check': 'routing-completeness',\\n                    'message': f'Child agent \\\"{child}\\\" from routing.json dispatchOrder not found in prompt',\\n                    'location': 'Routing Table section'\\n                })\\n    \\n    # Check routing entries are present\\n    if rt_entries:\\n        # Check that key conditions/actions appear\\n        for entry in rt_entries:\\n            condition = entry.get('condition', '')\\n            action = entry.get('action', '')\\n            # Extract result code from condition\\n            result_match = re.search(r\\\"result\\\\s*==\\\\s*'([^']+)'\\\", condition)\\n            if result_match:\\n                result_code = result_match.group(1)\\n                # Check if this result code appears in the prompt\\n                if result_code not in content:\\n                    # Extract which child this is about\\n                    read_file = entry.get('read', '')\\n                    findings.append({\\n                        'severity': 'warn',\\n                        'check': 'routing-entry',\\n                        'message': f'Routing entry for result code \\\"{result_code}\\\" (read: {read_file}) not clearly represented in prompt',\\n                        'location': 'Routing Table section'\\n                    })\\n    \\n    return findings\\n\\ndef check_result_codes(content, agent_data):\\n    \\\"\\\"\\\"Check if result codes from roster appear in the prompt.\\\"\\\"\\\"\\n    findings = []\\n    result_codes = agent_data.get('resultCodes', [])\\n    \\n    if not result_codes:\\n        return findings\\n    \\n    missing_codes = []\\n    for code in result_codes:\\n        if code not in content:\\n            missing_codes.append(code)\\n    \\n    if missing_codes:\\n        findings.append({\\n            'severity': 'block',\\n            'check': 'result-codes',\\n            'message': f'Result codes from roster.json not found in prompt: {missing_codes}',\\n            'location': 'Status Contract / Result Codes section'\\n        })\\n    \\n    return findings\\n\\ndef check_artifact_assignments(content, agent_data):\\n    \\\"\\\"\\\"Check if reads/writes from roster appear in prompt.\\\"\\\"\\\"\\n    findings = []\\n    \\n    reads = agent_data.get('reads', [])\\n    writes = agent_data.get('writes', [])\\n    \\n    # For reads, check that major artifacts are referenced\\n    missing_reads = []\\n    for r in reads:\\n        # Skip status files for this check\\n        if 'status.json' in r:\\n            continue\\n        # Use basename for matching\\n        basename = os.path.basename(r)\\n        if basename not in content and r not in content:\\n            missing_reads.append(r)\\n    \\n    if missing_reads:\\n        findings.append({\\n            'severity': 'warn',\\n            'check': 'artifact-reads',\\n            'message': f'Read artifacts from roster.json not referenced in prompt: {missing_reads}',\\n            'location': 'Inputs / Context section'\\n        })\\n    \\n    missing_writes = []\\n    for w in writes:\\n        if 'status.json' in w:\\n            continue\\n        basename = os.path.basename(w)\\n        if basename not in content and w not in content:\\n            missing_writes.append(w)\\n    \\n    if missing_writes:\\n        findings.append({\\n            'severity': 'warn',\\n            'check': 'artifact-writes',\\n            'message': f'Write artifacts from roster.json not referenced in prompt: {missing_writes}',\\n            'location': 'Outputs / Write Rules section'\\n        })\\n    \\n    return findings\\n\\ndef review_agent(agent_name, filepath):\\n    \\\"\\\"\\\"Review a single agent prompt file.\\\"\\\"\\\"\\n    with open(filepath) as f:\\n        content = f.read()\\n    \\n    agent_data = roster_map.get(agent_name, {})\\n    level = agent_data.get('level', 'unknown')\\n    is_routing = level in ('orchestrator', 'coordinator', 'sub-coordinator')\\n    is_guide = level == 'guide'\\n    has_anti_laziness = agent_data.get('antiLaziness', False)\\n    children = agent_data.get('children', [])\\n    \\n    findings = []\\n    structural_checks = 0\\n    structural_pass = 0\\n    content_checks = 0\\n    content_pass = 0\\n    \\n    # ============ STRUCTURAL CHECKS ============\\n    \\n    # 1. Has frontmatter\\n    structural_checks += 1\\n    fm = extract_frontmatter(content)\\n    if fm:\\n        structural_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'info',\\n            'check': 'frontmatter',\\n            'message': 'No YAML frontmatter found (not required but recommended)',\\n            'location': 'Top of file'\\n        })\\n        structural_pass += 1  # Not blocking\\n    \\n    # 2. Has H1 heading\\n    structural_checks += 1\\n    h1 = extract_h1(content)\\n    if h1:\\n        structural_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'block',\\n            'check': 'h1-heading',\\n            'message': 'No H1 heading found',\\n            'location': 'Top of file'\\n        })\\n    \\n    # 3. Has role/identity section\\n    sections = extract_sections(content)\\n    structural_checks += 1\\n    role_found = False\\n    # Role can be in opening paragraph or a section\\n    role_keywords = ['you are', 'your role', 'your job', 'you serve as', 'responsible for', 'pure-router', 'pure router', 'specialist']\\n    for kw in role_keywords:\\n        if kw.lower() in content.lower()[:2000]:  # Check first 2000 chars\\n            role_found = True\\n            break\\n    if role_found:\\n        structural_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'block',\\n            'check': 'role-description',\\n            'message': 'No clear role/identity description found in opening section',\\n            'location': 'Opening paragraph'\\n        })\\n    \\n    # 4. Purity rule for routing agents\\n    if is_routing:\\n        structural_checks += 1\\n        purity_keywords = ['purity rule', 'pure router', 'pure-router', 'never do substantive work', 'only dispatch', 'do not perform', 'must not do substantive']\\n        purity_found = any(kw.lower() in content.lower() for kw in purity_keywords)\\n        if purity_found:\\n            structural_pass += 1\\n        else:\\n            findings.append({\\n                'severity': 'block',\\n                'check': 'purity-rule',\\n                'message': f'Routing agent (level={level}) missing purity rule section',\\n                'location': 'Purity Rule section'\\n            })\\n    \\n    # 5. Routing table for routing agents\\n    if is_routing:\\n        structural_checks += 1\\n        routing_keywords = ['routing table', 'dispatch order', 'routing logic', '## Routing']\\n        routing_found = any(kw.lower() in content.lower() for kw in routing_keywords)\\n        if routing_found:\\n            structural_pass += 1\\n        else:\\n            findings.append({\\n                'severity': 'block',\\n                'check': 'routing-table-present',\\n                'message': f'Routing agent (level={level}) missing routing table section',\\n                'location': 'Routing Table section'\\n            })\\n    \\n    # 6. Has status contract\\n    structural_checks += 1\\n    status_keywords = ['status contract', 'status.json', 'result code', 'result_code']\\n    status_found = any(kw.lower() in content.lower() for kw in status_keywords)\\n    if status_found:\\n        structural_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'block',\\n            'check': 'status-contract',\\n            'message': 'No Status Contract section found',\\n            'location': 'Status Contract section'\\n        })\\n    \\n    # 7. Has inputs/outputs\\n    structural_checks += 1\\n    io_keywords = ['input', 'output', 'reads', 'writes', 'artifact']\\n    io_found = any(kw.lower() in content.lower() for kw in io_keywords)\\n    if io_found:\\n        structural_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'warn',\\n            'check': 'inputs-outputs',\\n            'message': 'No clear inputs/outputs section found',\\n            'location': 'Inputs/Outputs section'\\n        })\\n    \\n    # 8. Anti-laziness for auditors\\n    if has_anti_laziness or 'auditor' in agent_name:\\n        structural_checks += 1\\n        anti_lazy_keywords = ['anti-laziness', 'anti laziness', 'adversarial', 'must not skip', 'never skim', 'cover-to-cover']\\n        anti_lazy_found = any(kw.lower() in content.lower() for kw in anti_lazy_keywords)\\n        if anti_lazy_found:\\n            structural_pass += 1\\n        else:\\n            findings.append({\\n                'severity': 'warn',\\n                'check': 'anti-laziness',\\n                'message': 'Auditor/adversarial agent missing anti-laziness rules',\\n                'location': 'Anti-Laziness section'\\n            })\\n    \\n    # 9. ask_questions suppression (non-guide)\\n    if not is_guide:\\n        structural_checks += 1\\n        if 'ask_questions' in content.lower() or 'never ask' in content.lower() or 'do not ask' in content.lower() or 'must not ask' in content.lower() or 'never request human' in content.lower():\\n            structural_pass += 1\\n        else:\\n            findings.append({\\n                'severity': 'info',\\n                'check': 'ask-questions-suppression',\\n                'message': 'No explicit ask_questions suppression found (recommended for non-guide agents)',\\n                'location': 'Top-level instructions'\\n            })\\n            structural_pass += 1  # Not blocking\\n    \\n    # ============ CONTENT CHECKS ============\\n    \\n    # 1. Result codes match roster\\n    content_checks += 1\\n    rc_findings = check_result_codes(content, agent_data)\\n    if not any(f['severity'] == 'block' for f in rc_findings):\\n        content_pass += 1\\n    findings.extend(rc_findings)\\n    \\n    # 2. Artifact assignments\\n    content_checks += 1\\n    art_findings = check_artifact_assignments(content, agent_data)\\n    if not any(f['severity'] == 'block' for f in art_findings):\\n        content_pass += 1\\n    findings.extend(art_findings)\\n    \\n    # 3. Routing table completeness (routing agents only)\\n    if is_routing and agent_name in routing_map:\\n        content_checks += 1\\n        rt_findings = check_routing_table_in_prompt(content, agent_name, routing_map[agent_name])\\n        if not any(f['severity'] == 'block' for f in rt_findings):\\n            content_pass += 1\\n        findings.extend(rt_findings)\\n    \\n    # 4. Domain specificity check\\n    content_checks += 1\\n    domain_terms = ['fantasy', 'romance', 'romantic', 'magic', 'world', 'character', 'plot', 'chapter', 'scene', \\n                    'arc', 'draft', 'prose', 'voice', 'tension', 'beat', 'trope', 'protagonist', 'antagonist',\\n                    'love interest', 'worldbuilding', 'writing', 'story', 'narrative', 'manuscript']\\n    domain_hits = sum(1 for t in domain_terms if t.lower() in content.lower())\\n    if domain_hits >= 3:\\n        content_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'warn',\\n            'check': 'domain-specificity',\\n            'message': f'Low domain specificity: only {domain_hits} domain terms found. May be too generic.',\\n            'location': 'Overall content'\\n        })\\n    \\n    # 5. Content length / substance check\\n    content_checks += 1\\n    word_count = len(content.split())\\n    if is_routing:\\n        min_words = 300  # Routing agents can be shorter\\n    else:\\n        min_words = 400  # Specialists should be substantial\\n    \\n    if word_count >= min_words:\\n        content_pass += 1\\n    else:\\n        findings.append({\\n            'severity': 'warn',\\n            'check': 'content-substance',\\n            'message': f'Content appears thin: {word_count} words (expected >= {min_words} for {level})',\\n            'location': 'Overall content'\\n        })\\n    \\n    # 6. Specialist process steps\\n    if not is_routing and not is_guide:\\n        content_checks += 1\\n        process_keywords = ['step', 'process', '1.', '2.', 'first', 'then', 'next', 'finally', 'phase']\\n        process_found = sum(1 for kw in process_keywords if kw.lower() in content.lower())\\n        if process_found >= 2:\\n            content_pass += 1\\n        else:\\n            findings.append({\\n                'severity': 'warn',\\n                'check': 'process-steps',\\n                'message': 'Specialist agent may lack clear process/step instructions',\\n                'location': 'Process section'\\n            })\\n    \\n    # Determine verdict\\n    has_blockers = any(f['severity'] == 'block' for f in findings)\\n    verdict = 'rejected' if has_blockers else 'approved'\\n    \\n    return {\\n        'agent': agent_name,\\n        'level': level,\\n        'verdict': verdict,\\n        'structural': f'{structural_pass}/{structural_checks}',\\n        'content': f'{content_pass}/{content_checks}',\\n        'word_count': word_count,\\n        'findings': findings,\\n        'blocker_count': sum(1 for f in findings if f['severity'] == 'block'),\\n        'warn_count': sum(1 for f in findings if f['severity'] == 'warn'),\\n        'info_count': sum(1 for f in findings if f['severity'] == 'info'),\\n    }\\n\\n# ============ MAIN REVIEW ============\\nprint(\\\"=\\\" * 80)\\nprint(\\\"PROMPT REVIEW: romantic-fantasy-writer (67 agents)\\\")\\nprint(\\\"=\\\" * 80)\\n\\n# Check roster vs files\\nmissing_files = roster_names - prompt_names\\nextra_files = prompt_names - roster_names\\n\\nif missing_files:\\n    print(f\\\"\\\\n⚠ MISSING FILES (in roster but no prompt): {sorted(missing_files)}\\\")\\nif extra_files:\\n    print(f\\\"\\\\n⚠ EXTRA FILES (prompt exists but not in roster): {sorted(extra_files)}\\\")\\n\\n# Review each agent\\nall_results = []\\nfor filepath in prompt_files:\\n    agent_name = os.path.basename(filepath).replace('.agent.md', '')\\n    result = review_agent(agent_name, filepath)\\n    all_results.append(result)\\n\\n# Summary\\napproved = [r for r in all_results if r['verdict'] == 'approved']\\nrejected = [r for r in all_results if r['verdict'] == 'rejected']\\ntotal_blockers = sum(r['blocker_count'] for r in all_results)\\ntotal_warns = sum(r['warn_count'] for r in all_results)\\ntotal_infos = sum(r['info_count'] for r in all_results)\\n\\nprint(f\\\"\\\\n{'='*80}\\\")\\nprint(f\\\"SUMMARY: {len(approved)} approved, {len(rejected)} rejected out of {len(all_results)}\\\")\\nprint(f\\\"Findings: {total_blockers} blockers, {total_warns} warnings, {total_infos} info\\\")\\nprint(f\\\"{'='*80}\\\")\\n\\nif rejected:\\n    print(f\\\"\\\\nREJECTED AGENTS ({len(rejected)}):\\\")\\n    for r in rejected:\\n        print(f\\\"\\\\n  {r['agent']} ({r['level']})\\\")\\n        print(f\\\"    Structural: {r['structural']}, Content: {r['content']}\\\")\\n        for f in r['findings']:\\n            if f['severity'] == 'block':\\n                print(f\\\"    🔴 BLOCK: [{f['check']}] {f['message']}\\\")\\n\\nprint(f\\\"\\\\nAPPROVED AGENTS ({len(approved)}):\\\")\\nfor r in approved:\\n    warn_str = f\\\" ({r['warn_count']} warns)\\\" if r['warn_count'] > 0 else \\\"\\\"\\n    print(f\\\"  ✅ {r['agent']} ({r['level']}) S:{r['structural']} C:{r['content']} W:{r['word_count']}{warn_str}\\\")\\n\\n# Save detailed JSON results for later processing\\nwith open('/tmp/review_results.json', 'w') as f:\\n    json.dump({\\n        'approved': [r['agent'] for r in approved],\\n        'rejected': [r['agent'] for r in rejected],\\n        'all_results': all_results,\\n        'total_blockers': total_blockers,\\n        'total_warns': total_warns,\\n        'total_infos': total_infos,\\n        'missing_files': sorted(missing_files),\\n        'extra_files': sorted(extra_files),\\n    }, f, indent=2)\\n\\nprint(f\\\"\\\\nDetailed results saved to /tmp/review_results.json\\\")\\nPYEOF\\npython3 /tmp/review_prompts.py\", \"description\": \"Run comprehensive prompt review\", \"initial_wait\": 60}"
