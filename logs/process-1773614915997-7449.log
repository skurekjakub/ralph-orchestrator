      'gen_ai.provider.name': 'github',
      'gen_ai.tool.call.arguments': `{"command":"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'EOFLIST'\\nimport json\\n\\nwith open('.fractal-factory/roster.json', 'r') as f:\\n    roster = json.load(f)\\n\\nprint(\\"╔════════════════════════════════════════════════════════════════════════╗\\")\\nprint(\\"║                    GENERATED AGENT ROSTER                             ║\\")\\nprint(\\"║                 romantic-fantasy-writer System                         ║\\")\\nprint(\\"╚════════════════════════════════════════════════════════════════════════╝\\\\n\\")\\n\\n# Organize by level\\nguide_agents = [a for a in roster['agents'] if a['level'] == 'guide']\\norch_agents = [a for a in roster['agents'] if a['level'] == 'orchestrator']\\ncoord_agents = [a for a in roster['agents'] if a['level'] == 'coordinator']\\nsub_coord_agents = [a for a in roster['agents'] if a['level'] == 'sub-coordinator']\\nspecialist_agents = [a for a in roster['agents'] if a['level'] == 'specialist']\\n\\ndef print_agent(agent, prefix=\\"\\"):\\n    name = agent['displayName']\\n    level = agent['level']\\n    phase = agent.get('pass', '')\\n    codes = ', '.join(agent.get('resultCodes', []))\\n    \\n    print(f\\"{prefix}• {name}\\")\\n    if phase:\\n        print(f\\"{prefix}  Phase: {phase}\\")\\n    if codes:\\n        print(f\\"{prefix}  Codes: {codes}\\")\\n\\n# Print by level\\nprint(\\"GUIDE (1)\\")\\nprint(\\"─\\" * 70)\\nfor a in guide_agents:\\n    print_agent(a, \\"\\")\\nprint()\\n\\nprint(\\"ORCHESTRATOR (1)\\")\\nprint(\\"─\\" * 70)\\nfor a in orch_agents:\\n    print_agent(a, \\"\\")\\nprint()\\n\\nprint(\\"COORDINATORS (9)\\")\\nprint(\\"─\\" * 70)\\nfor a in coord_agents:\\n    print_agent(a, \\"\\")\\nprint()\\n\\nprint(\\"SUB-COORDINATORS (10)\\")\\nprint(\\"─\\" * 70)\\nfor a in sub_coord_agents:\\n    print_agent(a, \\"\\")\\nprint()\\n\\nprint(\\"SPECIALISTS (46)\\")\\nprint(\\"─\\" * 70)\\nprint(f\\"\\\\nTotal: {len(specialist_agents)} specialist agents\\")\\nprint(\\"\\\\nSpecialists by Phase:\\")\\n\\nphases = {}\\nfor a in specialist_agents:\\n    phase = a.get('pass', 'unknown')\\n    if phase not in phases:\\n        phases[phase] = []\\n    phases[phase].append(a)\\n\\nfor phase in sorted(phases.keys()):\\n    print(f\\"\\\\n  {phase.upper()} ({len(phases[phase])})\\")\\n    for a in phases[phase]:\\n        print(f\\"    • {a['displayName']}\\")\\n\\nprint(\\"\\\\n\\" + \\"=\\" * 70)\\nprint(f\\"TOTAL AGENTS: {len(roster['agents'])}/67 ✓\\")\\nprint(\\"=\\" * 70)\\n\\nEOFLIST\\n","description":"List all agents by type"}`,
