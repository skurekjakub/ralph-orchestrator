        '23.         "entryCondition": "knowledge-brief.json exists (Pass 0 complete). No other preconditions.",\n' +
        '24.         "exitCondition": "All four discovery specialists (domain-scanner, invariant-extractor, asset-auditor, exemplar-analyzer) report status=completed. domain-model.json contains subdomains, invariants, existingAssets, and exemplarPatterns arrays. Discovery coordinator confirms completeness.",\n' +
        '25.         "coordinatorHint": "fractal-factory-discovery-coordinator",\n' +
