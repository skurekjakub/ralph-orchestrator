ncludes 'show-dont-tell' technique)\\\",\\n            \\\"books/test-book-004/plot/chapter-outlines/chapter-001.json\\\"\\n        ],\\n        \\\"inputFiles\\\": []\\n    },\\n    \\\"trigger\\\": {\\n        \\\"agent\\\": \\\"romantic-fantasy-writer-drafting-coordinator\\\",\\n        \\\"action\\\": \\\"invoke for chapter 1\\\"\\n    },\\n    \\\"expectedBehavior\\\": [\\n        \\\"creative-writing-coordinator drafts chapter (lots of telling, not showing)\\\",\\n        \\\"quality-integration-coordinator integrates craft checks\\\",\\n        \\\"drafting-auditor returns 'failed': 'Violates show-dont-tell craft technique'\\\",\\n        \\\"Retry #1: creative-writing redrafts, still some telling\\\",\\n        \\\"drafting-auditor returns 'failed' again\\\",\\n        \\\"Retry #2: creative-writing redrafts with strong showing\\\",\\n        \\\"drafting-auditor returns 'passed'\\\",\\n        \\\"Coordinator returns 'complete'\\\"\\n    ],\\n    \\\"expectedOutput\\\": {\\n        \\\"resultCode\\\": \\\"complete\\\",\\n        \\\"auditorRetries\\\": 2,\\n        \\\"finalArtifact\\\": \\\"books/test-book-004/chapters/chapter-001-draft.md (passes auditor)\\\"\\n    },\\n    \\\"verificationCriteria\\\": [\\n        \\\"Drafting-coordinator completed after 2 retries\\\",\\n        \\\"audit-reports/drafting/chapter-001-gate.json shows 2 failures, 1 pass\\\",\\n        \\\"Final draft demonstrates show-dont-tell technique\\\",\\n        \\\"Retry count < maxAuditorRetries\\\"\\n    ],\\n    \\\"relatedInvariants\\\": [\\\"INV-005\\\"]\\n})\\n\\n# CATEGORY 3: CONVERGENCE EXHAUSTION\\ntest_plan[\\\"scenarios\\\"].append({\\n    \\\"id\\\": \\\"TEST-005\\\",\\n    \\\"name\\\": \\\"Convergence exhaustion — worldbuilding blocked\\\",\\n    \\\"category\\\": \\\"convergence-exhaustion\\\",\\n    \\\"priority\\\": \\\"P0\\\",\\n    \\\"description\\\": \\\"Worldbuilding-auditor rejects 3 times, hits maxAuditorRetries, escalates to blocked\\\",\\n    \\\"initialSt