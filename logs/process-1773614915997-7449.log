        "| agents/concept-developer/status.json | result == 'blocked' | write own status: blocked |\n" +
        "| agents/craft-profile-selector/status.json | result == 'completed' | dispatch romantic-fantasy-writer-concept-auditor |\n" +
        "| agents/craft-profile-selector/status.json | result == 'blocked' | write own status: blocked |\n" +
        "| agents/concept-auditor/status.json | result == 'passed' | write own status: complete |\n" +
