            "function": {
              "name": "bash",
              "arguments": "{\"command\": \"cd /home/jakubs/repositories/ralph-orchestrator && python3 << 'PYEOF'\\nimport json, datetime\\n\\n# Load the existing architecture\\nwith open('.fractal-factory/architecture.json') as f:\\n    arch = json.load(f)\\n\\n# Design the artifacts section\\nartifacts = {\\n    \\\"designNotes\\\": \\\"Artifacts for the PRODUCED romantic-fantasy-writer agent system. These schemas define how the ~80 agents in the produced novel-writing pipeline communicate. Organized by: (1) universal infrastructure artifacts, (2) domain-specific artifacts grouped by creative phase, (3) cross-cutting tracker artifacts. All paths are relative to the per-book output directory (e.g., books/book-1/).\\\",\\n\\n    \\\"universal\\\": [\\n        {\\n            \\\"name\\\": \\\"story-config.json\\\",\\n            \\\"purpose\\\": \\\"User-provided story parameters: idea, target word count, mood/tone, optional style samples, character sketches, world fragments, constraints. The single input contract for the entire pipeline.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique story identifier (e.g., 'book-1')\\\"},\\n                    {\\\"name\\\": \\\"seriesId\\\", \\\"type\\\": \\\"string|null\\\", \\\"description\\\": \\\"Series identifier if part of a series, null for standalone\\\"},\\n                    {\\\"name\\\": \\\"storyIdea\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Core story premise from the user (minimum viable input per INV-067)\\\"},\\n                    {\\\"name\\\": \\\"targetWordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Rough target word count (e.g., 100000) per INV-026\\\"},\\n                    {\\\"name\\\": \\\"mood\\\", \\\"type\\\": \\\"string|null\\\", \\\"description\\\": \\\"Desired mood/tone keywords\\\"},\\n                    {\\\"name\\\": \\\"characterSketches\\\", \\\"type\\\": \\\"array|null\\\", \\\"description\\\": \\\"Optional rough character ideas from user\\\"},\\n                    {\\\"name\\\": \\\"worldFragments\\\", \\\"type\\\": \\\"array|null\\\", \\\"description\\\": \\\"Optional world details from user\\\"},\\n                    {\\\"name\\\": \\\"styleSamples\\\", \\\"type\\\": \\\"array|null\\\", \\\"description\\\": \\\"Optional reference fiction file paths for style extraction (INV-028)\\\"},\\n                    {\\\"name\\\": \\\"constraints\\\", \\\"type\\\": \\\"object|null\\\", \\\"description\\\": \\\"Optional constraints (heat level, content warnings, etc.)\\\"},\\n                    {\\\"name\\\": \\\"sequelOf\\\", \\\"type\\\": \\\"string|null\\\", \\\"description\\\": \\\"storyId of predecessor book if this is a sequel\\\"},\\n                    {\\\"name\\\": \\\"confirmedByUser\\\", \\\"type\\\": \\\"boolean\\\", \\\"description\\\": \\\"Must be true before pipeline launch (INV-080)\\\"},\\n                    {\\\"name\\\": \\\"createdAt\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"ISO-8601 timestamp\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-guide\\\"],\\n            \\\"readers\\\": [\\\"all agents\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"progress.json\\\",\\n            \\\"purpose\\\": \\\"Pipeline execution state tracking for the produced system's orchestrator. Tracks which creative phase is active, per-chapter progress, and gate statuses.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Active story identifier\\\"},\\n                    {\\\"name\\\": \\\"currentPhase\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Active creative phase (concept|worldbuilding|character|plotting|style|drafting|revision|beta-reading|polish)\\\"},\\n                    {\\\"name\\\": \\\"phaseStatuses\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of phase-name → {status, startedAt, completedAt, gateResult}\\\"},\\n                    {\\\"name\\\": \\\"chapterProgress\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Per-chapter status: [{chapterNum, drafted, revised, betaRead, polished}]\\\"},\\n                    {\\\"name\\\": \\\"currentChapter\\\", \\\"type\\\": \\\"number|null\\\", \\\"description\\\": \\\"Chapter currently being processed (for sequential drafting per INV-012)\\\"},\\n                    {\\\"name\\\": \\\"gapCycles\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Number of revision cycles completed\\\"},\\n                    {\\\"name\\\": \\\"lastUpdated\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"ISO-8601 timestamp\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\", \\\"all coordinators\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"manifest.json\\\",\\n            \\\"purpose\\\": \\\"Append-only audit trail of all agent actions. Every agent prepends an entry after completing work (newest first per PATTERN-010).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"timestamp\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"ISO-8601 timestamp\\\"},\\n                    {\\\"name\\\": \\\"agent\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent name that performed work\\\"},\\n                    {\\\"name\\\": \\\"task_id\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Phase/task identifier\\\"},\\n                    {\\\"name\\\": \\\"artifacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"List of artifact paths written or modified\\\"},\\n                    {\\\"name\\\": \\\"status\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"completed|failed\\\"},\\n                    {\\\"name\\\": \\\"result\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent-specific result code\\\"},\\n                    {\\\"name\\\": \\\"iteration\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Iteration number (for multi-pass phases)\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"all agents\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-orchestrator\\\", \\\"delivery agents\\\"],\\n            \\\"writeProtocol\\\": \\\"prepend-entry\\\",\\n            \\\"ownershipField\\\": \\\"agent\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"agents/*/status.json\\\",\\n            \\\"purpose\\\": \\\"Per-agent routing signal following PATTERN-003. The orchestrator/coordinators read these to make routing decisions. Each agent writes its own status on completion.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"agent\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent name\\\"},\\n                    {\\\"name\\\": \\\"task_id\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Task identifier\\\"},\\n                    {\\\"name\\\": \\\"status\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"completed|failed|blocked\\\"},\\n                    {\\\"name\\\": \\\"result\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Agent-specific result code used in routing tables\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Human-readable summary of what was done\\\"},\\n                    {\\\"name\\\": \\\"artifacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Paths to artifacts produced\\\"},\\n                    {\\\"name\\\": \\\"next_hint\\\", \\\"type\\\": \\\"string|null\\\", \\\"description\\\": \\\"Suggested next agent\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"object|null\\\", \\\"description\\\": \\\"For auditors: {critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"iteration\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Iteration counter\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"each agent (own status only)\\\"],\\n            \\\"readers\\\": [\\\"parent coordinator\\\", \\\"orchestrator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once-per-iteration\\\"\\n        }\\n    ],\\n\\n    \\\"domainSpecific\\\": [\\n        # ============================================================\\n        # PHASE 1: CONCEPT DEVELOPMENT (SD-002)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"story-concept.json\\\",\\n            \\\"purpose\\\": \\\"Crystallized story concept: refined premise, thematic pillars, genre balance, comp titles, target audience, and high-level arc shapes. The foundational document all downstream phases reference.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier from story-config.json\\\"},\\n                    {\\\"name\\\": \\\"refinedPremise\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"One-paragraph distilled premise\\\"},\\n                    {\\\"name\\\": \\\"thematicPillars\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"2-3 core themes [{id, theme, question, argument}] per INV-063/T25\\\"},\\n                    {\\\"name\\\": \\\"genreBalance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{fantasyWeight: 0-1, romanceWeight: 0-1} — must sum to ~1, neither zero per INV-001\\\"},\\n                    {\\\"name\\\": \\\"compTitles\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"2-4 comparable published titles with brief rationale\\\"},\\n                    {\\\"name\\\": \\\"targetAudience\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Target reader profile\\\"},\\n                    {\\\"name\\\": \\\"heatLevel\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Romance heat level (sweet|warm|steamy|explicit)\\\"},\\n                    {\\\"name\\\": \\\"fantasySubgenre\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Fantasy subgenre (epic|urban|portal|etc)\\\"},\\n                    {\\\"name\\\": \\\"toneContract\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Tonal promise: {primary, secondary, forbiddenTones} per INV-043/T5\\\"},\\n                    {\\\"name\\\": \\\"romanceArcType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"High-level romance arc type (enemies-to-lovers, etc)\\\"},\\n                    {\\\"name\\\": \\\"estimatedChapterCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Estimated chapters based on targetWordCount\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-config.json (INV-029)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"N/A — singleton per story\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-concept-developer\\\"],\\n            \\\"readers\\\": [\\\"all downstream creative agents\\\", \\\"adversarial auditors\\\", \\\"series-kb-manager\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"ownershipField\\\": None\\n        },\\n        {\\n            \\\"name\\\": \\\"craft-profile.json\\\",\\n            \\\"purpose\\\": \\\"Story Craft Profile selecting which of the 26 craft tools (T1–T26) apply to this story. Once set, selected tools become binding invariants for the rest of production (INV-069, INV-079). Minimum 5-8 tools per INV-078.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"selectedTools\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{toolId: 'T1'–'T26', name, rationale, enforcementPhases: ['drafting','revision',...]}]\\\"},\\n                    {\\\"name\\\": \\\"toolCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Count of selected tools (must be ≥5 per INV-078)\\\"},\\n                    {\\\"name\\\": \\\"selectionRationale\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Why these tools suit this specific story\\\"},\\n                    {\\\"name\\\": \\\"bindingFrom\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Phase at which selection was finalized (concept or plotting)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json (INV-029)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"N/A — singleton per story\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-concept-developer\\\", \\\"romantic-fantasy-writer-plot-architect\\\"],\\n            \\\"readers\\\": [\\\"all creative agents\\\", \\\"all adversarial auditors\\\", \\\"craft-knowledge agents\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"bindingFrom\\\",\\n            \\\"multiWriterRules\\\": \\\"Concept-developer creates initial selection. Plot-architect may add tools during plotting phase. Once bindingFrom is set to 'plotting', no further modifications allowed (INV-079). Each writer preserves all existing selections and may only append.\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 2: WORLDBUILDING (SD-003) — Subcategorized per INV-032\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"world-bible/geography.json\\\",\\n            \\\"purpose\\\": \\\"Geography and settings: locations, maps, climate zones, key landmarks, travel distances/methods. Independently loadable subcategory file (INV-074).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"locations\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'LOC-NNN', name, type, description, climate, significance, connectedTo: ['LOC-NNN']}]\\\"},\\n                    {\\\"name\\\": \\\"travelRules\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"How characters move between locations, travel times\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"LOC-NNN\\\",\\n                \\\"itemSchema\\\": {\\\"id\\\": \\\"string\\\", \\\"name\\\": \\\"string\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"string\\\", \\\"climate\\\": \\\"string\\\", \\\"significance\\\": \\\"string\\\", \\\"connectedTo\\\": \\\"array\\\"}\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-worldbuilder\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"continuity-tracker\\\", \\\"adversarial-auditor\\\", \\\"series-kb-manager\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/magic-system.json\\\",\\n            \\\"purpose\\\": \\\"Magic system design following Sanderson's Laws (INV-048/T10): rules, costs, limitations, known practitioners, power levels. Hard magic requires clear rules before conflict resolution.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"systemName\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Name of the magic system\\\"},\\n                    {\\\"name\\\": \\\"hardnessLevel\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"hard|soft|hybrid — determines reader understanding requirements\\\"},\\n                    {\\\"name\\\": \\\"rules\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'MAG-NNN', rule, cost, limitation, knownBy: ['CHAR-NNN']}]\\\"},\\n                    {\\\"name\\\": \\\"powerLevels\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Tiered power levels from weakest to strongest\\\"},\\n                    {\\\"name\\\": \\\"forbiddenUses\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"What magic explicitly cannot do (prevents deus ex machina per INV-009)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"MAG-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-worldbuilder\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"continuity-tracker\\\", \\\"adversarial-auditor\\\", \\\"series-kb-manager\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/politics.json\\\",\\n            \\\"purpose\\\": \\\"Political and power structures: factions, governance systems, alliances, conflicts, power dynamics between groups.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"factions\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'FAC-NNN', name, type, goals, allies: [], enemies: [], leader}]\\\"},\\n                    {\\\"name\\\": \\\"governanceSystems\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Types of governance across the world\\\"},\\n                    {\\\"name\\\": \\\"powerDynamics\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Narrative description of political tension\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FAC-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-worldbuilder\\\"],\\n            \\\"readers\\\": [\\\"character-developer\\\", \\\"plot-architect\\\", \\\"chapter-drafter\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/culture.json\\\",\\n            \\\"purpose\\\": \\\"Cultural norms: customs, religions, social hierarchies, daily life, naming conventions, festivals, taboos. Prevents anachronisms per INV-018.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"cultures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'CUL-NNN', name, customs, socialStructure, religion, taboos, naming}]\\\"},\\n                    {\\\"name\\\": \\\"socialRules\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"What is/isn't acceptable behavior in this world\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CUL-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-worldbuilder\\\"],\\n            \\\"readers\\\": [\\\"character-developer\\\", \\\"chapter-drafter\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"world-bible/history.json\\\",\\n            \\\"purpose\\\": \\\"World history timeline: key events, legends, era boundaries, historical figures. Establishes what 'happened before' for foreshadowing and backstory.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"eras\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'ERA-NNN', name, startYear, endYear, keyEvents}]\\\"},\\n                    {\\\"name\\\": \\\"legends\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Myths and legends characters might reference\\\"},\\n                    {\\\"name\\\": \\\"historicalFigures\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Important figures from the past\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"ERA-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-worldbuilder\\\"],\\n            \\\"readers\\\": [\\\"character-developer\\\", \\\"plot-architect\\\", \\\"chapter-drafter\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 3: CHARACTER DEVELOPMENT (SD-004)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"characters/index.json\\\",\\n            \\\"purpose\\\": \\\"Character roster: all named characters with roles, relationships, and POV status. Master index cross-referencing per-character files.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"characters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'CHAR-NNN', name, role, isPOV, arcType, characterFile}]\\\"},\\n                    {\\\"name\\\": \\\"relationshipWeb\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{from: 'CHAR-NNN', to: 'CHAR-NNN', type, evolution}]\\\"},\\n                    {\\\"name\\\": \\\"povCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Number of POV characters\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to story-concept.json, world-bible/* (INV-029)\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CHAR-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-character-developer\\\"],\\n            \\\"readers\\\": [\\\"plot-architect\\\", \\\"style-calibrator\\\", \\\"chapter-drafter\\\", \\\"all auditors\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"characters/{CHAR-NNN}.json\\\",\\n            \\\"purpose\\\": \\\"Per-character profile: psychological wound, desire, arc, voice parameters, sensory signature. One file per named character (INV-074). Voice parameters enable INV-003/INV-034 verification.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"id\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Character ID (CHAR-NNN)\\\"},\\n                    {\\\"name\\\": \\\"name\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Character name\\\"},\\n                    {\\\"name\\\": \\\"role\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"lead-romantic|lead-fantasy|antagonist|supporting|mentor|etc\\\"},\\n                    {\\\"name\\\": \\\"isPOV\\\", \\\"type\\\": \\\"boolean\\\", \\\"description\\\": \\\"Whether this character has POV chapters\\\"},\\n                    {\\\"name\\\": \\\"psychologicalProfile\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{wound, desire, fear, lie, ghost, need}\\\"},\\n                    {\\\"name\\\": \\\"arc\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{type, startState, endState, turningPoints: []}\\\"},\\n                    {\\\"name\\\": \\\"voiceFingerprint\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{vocabularyLevel, sentenceLength, metaphorDensity, emotionalRegister, thoughtPatterns, dialectMarkers} per INV-055/T17\\\"},\\n                    {\\\"name\\\": \\\"sensorySig\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{dominantChannel, signature, emotionalTriggers} per INV-064/T26\\\"},\\n                    {\\\"name\\\": \\\"relationships\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{withCharId, type, dynamicArc}]\\\"},\\n                    {\\\"name\\\": \\\"physicalDescription\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Appearance details for continuity\\\"},\\n                    {\\\"name\\\": \\\"agency\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"How this character drives plot through active choices (INV-008)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to world-bible/*, story-concept.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CHAR-NNN\\\",\\n                \\\"itemSchema\\\": \\\"One file per character, filename matches ID\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-character-developer\\\"],\\n            \\\"readers\\\": [\\\"plot-architect\\\", \\\"style-calibrator\\\", \\\"chapter-drafter\\\", \\\"voice-verifier\\\", \\\"all auditors\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"romance-arc-design.json\\\",\\n            \\\"purpose\\\": \\\"Detailed romance arc between the leads: stages of attraction, key moments, obstacles (internal and external per INV-046/T8), the black moment (INV-045/T7), and resolution (minimum HFN per INV-001). Vulnerability escalation ladder per INV-059/T21.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"leadA\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CHAR-NNN of first lead\\\"},\\n                    {\\\"name\\\": \\\"leadB\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CHAR-NNN of second lead\\\"},\\n                    {\\\"name\\\": \\\"arcType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"enemies-to-lovers|friends-to-lovers|forbidden|etc\\\"},\\n                    {\\\"name\\\": \\\"stages\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{stage, description, targetChapters}] — awareness→attraction→resistance→surrender→commitment per INV-021\\\"},\\n                    {\\\"name\\\": \\\"internalResistance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{leadA: {fear, wound}, leadB: {fear, wound}} per INV-046/T8\\\"},\\n                    {\\\"name\\\": \\\"vulnerabilityLadder\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{step: 1-8, moment, character, emotionalCost}] per INV-059/T21\\\"},\\n                    {\\\"name\\\": \\\"blackMoment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{description, triggerEvent, emotionalNadir} per INV-045/T7\\\"},\\n                    {\\\"name\\\": \\\"resolution\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"HFN|HEA — resolution type (INV-001)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to characters/*, story-concept.json\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-character-developer\\\"],\\n            \\\"readers\\\": [\\\"plot-architect\\\", \\\"chapter-drafter\\\", \\\"romance-beta-reader\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 4: PLOTTING & OUTLINING (SD-005)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"plot-structure.json\\\",\\n            \\\"purpose\\\": \\\"Overall story structure: selected framework, act boundaries, key plot beats, subplot registry, stakes escalation (INV-044/T6). The architectural blueprint for chapter outlines.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"framework\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Structural framework (three-act|save-the-cat|heros-journey|custom)\\\"},\\n                    {\\\"name\\\": \\\"acts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{act: 1-3, startChapter, endChapter, thematicFocus, stakesLevel}]\\\"},\\n                    {\\\"name\\\": \\\"keyBeats\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'BEAT-NNN', name, chapter, type: 'fantasy'|'romance'|'both', description}]\\\"},\\n                    {\\\"name\\\": \\\"subplots\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'SUB-NNN', name, characters, startChapter, resolution, type}]\\\"},\\n                    {\\\"name\\\": \\\"tryFailCycles\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{challenge, attempts: [{chapter, outcome: 'fail'|'partial'|'succeed'}]}] per INV-042/T4\\\"},\\n                    {\\\"name\\\": \\\"stakesEscalation\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{act, whatIsAtRisk, comparedToLast}] per INV-044/T6\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to story-concept.json, characters/*, romance-arc-design.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BEAT-NNN, SUB-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-architect\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"continuity-tracker\\\", \\\"adversarial-auditor\\\", \\\"revision agents\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"dual-arc-timeline.json\\\",\\n            \\\"purpose\\\": \\\"Fantasy and romance arcs plotted in parallel (INV-050/T12). Maps where each arc's beats land per chapter, showing reinforcement and counterpoint patterns.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{chapter: N, fantasyBeat: 'BEAT-NNN'|null, romanceBeat: 'BEAT-NNN'|null, relationship: 'reinforce'|'counterpoint'|'independent'}]\\\"},\\n                    {\\\"name\\\": \\\"interleaveRatio\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{fantasyDominant: [chapters], romanceDominant: [chapters], balanced: [chapters]}\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to plot-structure.json, romance-arc-design.json\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-architect\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"adversarial-auditor\\\", \\\"pacing-reviewer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"chapter-outlines/{N}.json\\\",\\n            \\\"purpose\\\": \\\"Per-chapter outline: POV character, scene goals, conflict, emotional arc, beat assignments. Must exist before drafting begins (INV-010). One file per chapter.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"pov\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CHAR-NNN of the POV character for this chapter\\\"},\\n                    {\\\"name\\\": \\\"povTransitionMotivation\\\", \\\"type\\\": \\\"string|null\\\", \\\"description\\\": \\\"Why POV switches here (INV-072) — null if same POV as previous\\\"},\\n                    {\\\"name\\\": \\\"scenes\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'SCN-NNN', goal, conflict, disaster, valueShift, fiveCommandments}] per INV-039/T1, INV-040/T2, INV-041/T3\\\"},\\n                    {\\\"name\\\": \\\"emotionalArc\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{startState, endState, pivotMoment} for the POV character\\\"},\\n                    {\\\"name\\\": \\\"fantasyBeats\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Plot beats from dual-arc-timeline for this chapter\\\"},\\n                    {\\\"name\\\": \\\"romanceBeats\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Romance beats for this chapter\\\"},\\n                    {\\\"name\\\": \\\"hookType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Opening hook type per INV-060/T22\\\"},\\n                    {\\\"name\\\": \\\"closeType\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Closing technique per INV-060/T22\\\"},\\n                    {\\\"name\\\": \\\"targetWordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Target words for this chapter\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to plot-structure.json, characters/{pov}.json, dual-arc-timeline.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"SCN-NNN within each chapter\\\",\\n                \\\"itemSchema\\\": \\\"One file per chapter, filename matches chapter number\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-architect\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"continuity-tracker\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"tension-map.json\\\",\\n            \\\"purpose\\\": \\\"Tension rise-and-fall chart across all chapters (INV-051/T13). Used during plotting to ensure pacing variation (INV-020) and during revision/beta-reading for pacing verification.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"chapters\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{chapter: N, tensionLevel: 1-10, tensionType: 'action'|'emotional'|'mystery'|'romantic', pacingNote}]\\\"},\\n                    {\\\"name\\\": \\\"peaksAndValleys\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{chapter, type: 'peak'|'valley', significance}]\\\"},\\n                    {\\\"name\\\": \\\"consecutiveHighCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Max consecutive high-tension chapters (should not exceed 3 per INV-020)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to plot-structure.json\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-plot-architect\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"pacing-reviewer\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 5: PROSE STYLE CALIBRATION (SD-006)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"style-guide.json\\\",\\n            \\\"purpose\\\": \\\"Prose style specification: voice calibration per POV character, scene-type tone palettes, prose rules (metaphor density, sentence rhythm, dialogue ratio). Based on style sample analysis if provided (INV-028, INV-024).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"globalStyle\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{proseRegister, narrativeDistance, paragraphCadence, dialogueToNarrationRatio}\\\"},\\n                    {\\\"name\\\": \\\"perPOVCalibration\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{charId: 'CHAR-NNN', voiceFingerprint, specificRules, exampleSentences}] — calibrated from character voice fingerprints (INV-055/T17)\\\"},\\n                    {\\\"name\\\": \\\"sceneTypePalettes\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{action: {tempo, sentenceLength, ...}, romantic: {...}, introspective: {...}, dialogue: {...}}\\\"},\\n                    {\\\"name\\\": \\\"proseQualityFloor\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Measurable quality thresholds per INV-017 (max clichés, adverb limits, etc.)\\\"},\\n                    {\\\"name\\\": \\\"styleSampleAnalysis\\\", \\\"type\\\": \\\"object|null\\\", \\\"description\\\": \\\"If style samples were provided: extracted abstract patterns (INV-024 — transformative only, no copying)\\\"},\\n                    {\\\"name\\\": \\\"toneContract\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Expanded tone contract from story-concept (INV-043/T5)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to story-concept.json, characters/*, craft-profile.json\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-style-calibrator\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"line-editor\\\", \\\"voice-verifier\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 6: CHAPTER DRAFTING (SD-007) — Sequential per INV-012\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"chapters/{N}/draft.md\\\",\\n            \\\"purpose\\\": \\\"Chapter prose draft. Written sequentially (INV-012) — chapter N+1 cannot start until N is complete. Contains the actual fiction prose with scene breaks marked.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"content\\\", \\\"type\\\": \\\"markdown\\\", \\\"description\\\": \\\"Full chapter prose with scene break markers (----)\\\"},\\n                    {\\\"name\\\": \\\"frontmatter\\\", \\\"type\\\": \\\"yaml\\\", \\\"description\\\": \\\"YAML frontmatter: chapterNum, pov, wordCount, sceneCount, draftVersion\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"revision agents\\\", \\\"beta readers\\\", \\\"continuity-tracker\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"chapters/{N}/metadata.json\\\",\\n            \\\"purpose\\\": \\\"Per-chapter structured metadata: craft tool compliance, scene value shifts, MRU adherence, emotional state tracking. Machine-readable companion to the prose draft.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"pov\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"CHAR-NNN of POV character\\\"},\\n                    {\\\"name\\\": \\\"wordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Actual word count\\\"},\\n                    {\\\"name\\\": \\\"sceneBreakdown\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{sceneId: 'SCN-NNN', goal, conflict, disaster, valueShiftFrom, valueShiftTo, sequelReaction}] per INV-039/T1, INV-040/T2\\\"},\\n                    {\\\"name\\\": \\\"craftToolCompliance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Per selected tool from craft-profile: {toolId: {compliant: bool, evidence, notes}}\\\"},\\n                    {\\\"name\\\": \\\"foreshadowingPlants\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{plantId, description, targetPayoffChapter}] — new plants in this chapter\\\"},\\n                    {\\\"name\\\": \\\"emotionalState\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{povStart, povEnd, dominantEmotion} per INV-037, INV-058/T20\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapter-outlines/{N}.json, style-guide.json, continuity-tracker.json\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"revision agents\\\", \\\"continuity-tracker\\\", \\\"craft-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 7: REVISION & EDITING (SD-008) — Three passes per INV-013\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"revision-reports/{N}/developmental.json\\\",\\n            \\\"purpose\\\": \\\"Developmental edit findings for chapter N: plot holes, pacing issues, motivation gaps, arc satisfaction, thematic drift. First of three mandatory review passes (INV-013).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'DEV-NNN', severity: 'critical'|'major'|'minor', category, description, location, suggestedFix}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N, overallAssessment}\\\"},\\n                    {\\\"name\\\": \\\"darlingsIdentified\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Kill-your-darlings candidates per INV-049/T11, INV-081\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/draft.md, plot-structure.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"DEV-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-developmental-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-reviser\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"revision-reports/{N}/line-edit.json\\\",\\n            \\\"purpose\\\": \\\"Line edit findings for chapter N: prose quality, voice distinctness, cliché detection, show-vs-tell (INV-005), repetition, dialogue naturalism (INV-019). Second mandatory pass.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'LINE-NNN', severity, category: 'voice'|'prose'|'cliché'|'show-tell'|'repetition'|'dialogue', description, lineRef, suggestedFix}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"voiceConsistency\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{charId, deviations: [{where, expected, actual}]} per INV-015\\\"},\\n                    {\\\"name\\\": \\\"proseQualityMetrics\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{clichéCount, adverbCount, passiveVoicePercent, showTellRatio} checked against INV-017 floor\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/draft.md, style-guide.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"LINE-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-line-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-reviser\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"revision-reports/{N}/copy-edit.json\\\",\\n            \\\"purpose\\\": \\\"Copy edit findings for chapter N: grammar, naming consistency, timeline accuracy, factual accuracy within world rules (INV-018), formatting. Third mandatory pass.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'COPY-NNN', severity, category: 'grammar'|'naming'|'timeline'|'factual'|'formatting', description, lineRef, correction}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"continuityChecks\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Cross-reference results against continuity-tracker.json\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/draft.md, world-bible/*, continuity-tracker.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"COPY-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-copy-editor\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-reviser\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"chapters/{N}/revised.md\\\",\\n            \\\"purpose\\\": \\\"Revised chapter prose incorporating all three edit passes. Every change must cite which finding prompted it (INV-014). Replaces draft.md as the working version.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"content\\\", \\\"type\\\": \\\"markdown\\\", \\\"description\\\": \\\"Revised chapter prose\\\"},\\n                    {\\\"name\\\": \\\"frontmatter\\\", \\\"type\\\": \\\"yaml\\\", \\\"description\\\": \\\"YAML frontmatter: chapterNum, pov, wordCount, revisionVersion, findingsAddressed: [ids]\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-reviser\\\"],\\n            \\\"readers\\\": [\\\"beta readers\\\", \\\"polish agents\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\",\\n            \\\"notes\\\": \\\"May be overwritten if beta-reading triggers a revision cycle (INV-076). Each version increments revisionVersion.\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 8: BETA READING SIMULATION (SD-009) — 5 lenses per INV-068\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"beta-feedback/{N}/romance-lens.json\\\",\\n            \\\"purpose\\\": \\\"Romance reader lens: evaluates emotional satisfaction, chemistry, pacing of romantic beats, HFN/HEA delivery, heat level consistency, relationship believability.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"romance\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'ROM-NNN', severity, category, description, emotionalImpact}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N, emotionalSatisfaction: 1-10}\\\"},\\n                    {\\\"name\\\": \\\"arcProgressCheck\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Is romance arc on track for this chapter? {expected, actual, assessment}\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/revised.md, romance-arc-design.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"ROM-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-romance-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-feedback/{N}/fantasy-lens.json\\\",\\n            \\\"purpose\\\": \\\"Fantasy reader lens: evaluates worldbuilding immersion, magic system consistency, plot logic, action sequences, world rules adherence.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"fantasy\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'FAN-NNN', severity, category, description, worldRuleRef}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N, immersionScore: 1-10}\\\"},\\n                    {\\\"name\\\": \\\"magicConsistency\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Cross-reference magic use against magic-system.json rules\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/revised.md, world-bible/*\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FAN-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-fantasy-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-feedback/{N}/craft-lens.json\\\",\\n            \\\"purpose\\\": \\\"Craft reader lens: evaluates adherence to selected craft tools from craft-profile.json, scene structure, pacing, foreshadowing, craft technique execution.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"craft\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'CRF-NNN', severity, category, craftToolRef: 'T1-T26', description}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"craftToolCompliance\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Per-tool compliance assessment against craft-profile.json\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/revised.md, craft-profile.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"CRF-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-craft-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-feedback/{N}/sensitivity-lens.json\\\",\\n            \\\"purpose\\\": \\\"Sensitivity reader lens: evaluates representation, potential harmful stereotypes, cultural sensitivity, power dynamics in romance, consent portrayal.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"sensitivity\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'SEN-NNN', severity, category: 'representation'|'stereotype'|'consent'|'power-dynamic', description, suggestedAlternative}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/revised.md, characters/*\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"SEN-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-sensitivity-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-feedback/{N}/originality-lens.json\\\",\\n            \\\"purpose\\\": \\\"Originality reader lens: flags passages, characters, plot elements, or magic systems that too closely resemble specific published works (INV-023, INV-025). Zero-tolerance plagiarism check.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"lens\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"originality\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'ORIG-NNN', severity, category: 'prose-similarity'|'character-similarity'|'plot-similarity'|'magic-similarity', description, resemblesWork, suggestedDifferentiation}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"styleSampleCheck\\\", \\\"type\\\": \\\"object|null\\\", \\\"description\\\": \\\"If style samples were used: verify transformative-only usage (INV-024)\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to chapters/{N}/revised.md, story-config.json\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"ORIG-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-originality-beta-reader\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"beta-synthesis/{N}.json\\\",\\n            \\\"purpose\\\": \\\"Synthesized beta feedback for chapter N: aggregates all 5 lens findings, de-duplicates, prioritizes by severity. Critical and major findings must be addressed before chapter is accepted (INV-076).\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"aggregatedFindings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'BETA-NNN', originalIds: ['ROM-001','FAN-003'], severity, category, description, requiredAction}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N, totalAcrossLenses, deduplicated}\\\"},\\n                    {\\\"name\\\": \\\"verdict\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"accepted|revision-required — revision-required if any critical or major findings (INV-076)\\\"},\\n                    {\\\"name\\\": \\\"revisionPriorities\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Ordered list of findings to address, critical first\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to all 5 beta-feedback/{N}/*.json files\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"BETA-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-beta-synthesizer\\\"],\\n            \\\"readers\\\": [\\\"romantic-fantasy-writer-chapter-reviser\\\", \\\"orchestrator\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # PHASE 9: POLISH & DELIVERY (SD-010)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"chapters/{N}/final.md\\\",\\n            \\\"purpose\\\": \\\"Final polished chapter: proofread, formatted, ready for delivery. The terminal version of each chapter.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"content\\\", \\\"type\\\": \\\"markdown\\\", \\\"description\\\": \\\"Final chapter prose\\\"},\\n                    {\\\"name\\\": \\\"frontmatter\\\", \\\"type\\\": \\\"yaml\\\", \\\"description\\\": \\\"YAML frontmatter: chapterNum, pov, wordCount, finalVersion, passedAllGates: true\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polisher\\\"],\\n            \\\"readers\\\": [\\\"delivery-assembler\\\", \\\"series-kb-manager\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"chapter-summaries/{N}.json\\\",\\n            \\\"purpose\\\": \\\"Per-chapter summary for series KB promotion: key events, character development, world changes, unresolved threads, relationship progression.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"chapterNum\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number\\\"},\\n                    {\\\"name\\\": \\\"keyEvents\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Major plot events in this chapter\\\"},\\n                    {\\\"name\\\": \\\"characterDevelopment\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Per-character arc movement in this chapter\\\"},\\n                    {\\\"name\\\": \\\"worldChanges\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"New world facts established\\\"},\\n                    {\\\"name\\\": \\\"unresolvedThreads\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Threads opened or advanced but not resolved\\\"},\\n                    {\\\"name\\\": \\\"romanceProgression\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Where the romance arc moved\\\"},\\n                    {\\\"name\\\": \\\"upstreamRef\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Relative path to chapters/{N}/final.md\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-polisher\\\"],\\n            \\\"readers\\\": [\\\"series-kb-manager\\\", \\\"delivery-assembler\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"delivery-report.json\\\",\\n            \\\"purpose\\\": \\\"Final delivery summary: word counts, chapter roster, quality metrics, craft tool compliance summary, invariant adherence report, outstanding items.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"totalWordCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Sum of all chapter word counts\\\"},\\n                    {\\\"name\\\": \\\"chapterCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Total chapters delivered\\\"},\\n                    {\\\"name\\\": \\\"qualityMetrics\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{avgBetaScore, craftToolCompliance, invariantAdherence, revisionCycles}\\\"},\\n                    {\\\"name\\\": \\\"outstandingItems\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Minor findings deferred (only minor allowed per INV-076)\\\"},\\n                    {\\\"name\\\": \\\"seriesKBUpdated\\\", \\\"type\\\": \\\"boolean\\\", \\\"description\\\": \\\"Whether series KB was promoted\\\"},\\n                    {\\\"name\\\": \\\"artifactManifest\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Complete list of all delivered artifacts with paths\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-delivery-assembler\\\"],\\n            \\\"readers\\\": [\\\"user (via guide)\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once\\\"\\n        },\\n\\n        # ============================================================\\n        # CROSS-CUTTING: ADVERSARIAL CONSISTENCY (SD-011)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"audit-reports/{phase}/{gate-id}.json\\\",\\n            \\\"purpose\\\": \\\"Adversarial audit report per phase gate (INV-027). Every creative phase has a gate that challenges consistency, enforces craft tools, and applies kill-your-darlings (INV-081). Blocks progression on critical findings.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"gateId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Unique gate identifier: GATE-{phase}-NNN\\\"},\\n                    {\\\"name\\\": \\\"phase\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Creative phase being audited\\\"},\\n                    {\\\"name\\\": \\\"findings\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'AUD-NNN', severity: 'critical'|'major'|'minor', category: 'consistency'|'craft-compliance'|'darling'|'deus-ex-machina'|'continuity', description, artifactRef, suggestedFix}]\\\"},\\n                    {\\\"name\\\": \\\"summary\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"{critical: N, major: N, minor: N}\\\"},\\n                    {\\\"name\\\": \\\"verdict\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"pass|revise|block — block if any critical findings\\\"},\\n                    {\\\"name\\\": \\\"craftToolEnforcement\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Per selected tool: {toolId, enforced: bool, violations: []}\\\"},\\n                    {\\\"name\\\": \\\"darlingsIdentified\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Kill-your-darlings candidates per INV-081\\\"},\\n                    {\\\"name\\\": \\\"upstreamRefs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"Relative paths to all artifacts reviewed in this gate\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"AUD-NNN, GATE-{phase}-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-adversarial-auditor\\\"],\\n            \\\"readers\\\": [\\\"phase coordinator (for routing)\\\", \\\"revision agents\\\"],\\n            \\\"writeProtocol\\\": \\\"create-once-per-gate\\\"\\n        },\\n\\n        # ============================================================\\n        # CROSS-CUTTING: CONTINUITY TRACKING (SD-013) — R-M-W artifacts\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"continuity-tracker.json\\\",\\n            \\\"purpose\\\": \\\"Running continuity document updated after every chapter draft (INV-011). Tracks character locations, timeline, knowledge state, active promises, and naming consistency.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"timeline\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{event, chapter, inWorldTime, characters}] — chronological event log\\\"},\\n                    {\\\"name\\\": \\\"characterPositions\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → {lastKnownLocation, asOfChapter}\\\"},\\n                    {\\\"name\\\": \\\"characterKnowledge\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → [{fact, learnedInChapter}] — what each character knows (INV-056/T18 feeds this)\\\"},\\n                    {\\\"name\\\": \\\"activePromises\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'PROM-NNN', type: 'chekhov'|'foreshadow'|'subplot', description, plantedChapter, status: 'open'|'resolved', resolvedChapter}] per INV-006\\\"},\\n                    {\\\"name\\\": \\\"namingRegistry\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Canonical spellings of all names, places, terms\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter number of last update\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"PROM-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-continuity-tracker\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"adversarial-auditor\\\", \\\"copy-editor\\\", \\\"all beta readers\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Chapter-drafter updates characterPositions, timeline, and activePromises after each chapter. Continuity-tracker performs full consistency verification and may add corrections. Both preserve all existing entries. New entries are appended; existing entries may only have their 'status' field updated (open→resolved).\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"foreshadowing-ledger.json\\\",\\n            \\\"purpose\\\": \\\"Explicit register mapping every foreshadowing plant to its payoff (INV-053/T15). Tracks plant chapter, payoff chapter, red herrings, and completeness.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"entries\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'FS-NNN', plant: {description, chapter, lineRef}, payoff: {description, chapter, lineRef}|null, type: 'foreshadow'|'red-herring'|'callback', status: 'planted'|'paid-off'|'abandoned'}]\\\"},\\n                    {\\\"name\\\": \\\"completionRate\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Percentage of plants with payoffs (target: 100% excluding intentional red herrings)\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter of last update\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FS-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-craft-tracker\\\"],\\n            \\\"readers\\\": [\\\"plot-architect\\\", \\\"adversarial-auditor\\\", \\\"craft-beta-reader\\\", \\\"continuity-tracker\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Chapter-drafter adds new plant entries after each chapter. Craft-tracker updates payoff fields when payoffs are identified in later chapters. Existing entries are never deleted — status field transitions: planted→paid-off or planted→abandoned.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"information-asymmetry-map.json\\\",\\n            \\\"purpose\\\": \\\"Tracks what each character knows vs. what the reader knows vs. what other characters know (INV-056/T18). Critical for maintaining dramatic irony and avoiding info leaks.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"facts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'FACT-NNN', fact, revealedToReader: {chapter}|null, knownBy: [{charId, learnedChapter}], unknownBy: ['CHAR-NNN']}]\\\"},\\n                    {\\\"name\\\": \\\"dramaticIronyPoints\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{factId, readerKnows: true, characterDoesnt: 'CHAR-NNN', activeFromChapter, resolvedChapter}]\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter of last update\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"FACT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-continuity-tracker\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"adversarial-auditor\\\", \\\"fantasy-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Chapter-drafter registers new facts and character knowledge gains. Continuity-tracker verifies no character uses information they haven't learned. Entries are append-only for facts; knownBy arrays grow as characters learn things.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"mystery-box-inventory.json\\\",\\n            \\\"purpose\\\": \\\"Tracks active unresolved questions the reader holds (INV-061/T23). Maintains target range (typically 3-7 active boxes). Used for pacing and engagement control.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"boxes\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'MB-NNN', question, openedChapter, closedChapter: null|N, importance: 'major'|'minor', status: 'open'|'closed'}]\\\"},\\n                    {\\\"name\\\": \\\"activeCount\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Currently open boxes (target: 3-7)\\\"},\\n                    {\\\"name\\\": \\\"perChapterSnapshot\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{chapter, activeCount, opened: [], closed: []}] — trend data\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter of last update\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"MB-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-craft-tracker\\\", \\\"romantic-fantasy-writer-chapter-drafter\\\"],\\n            \\\"readers\\\": [\\\"plot-architect\\\", \\\"chapter-drafter\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Chapter-drafter opens new boxes and updates perChapterSnapshot. Craft-tracker closes boxes when answers are delivered and recomputes activeCount. Status transitions: open→closed only.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"emotional-throughline.json\\\",\\n            \\\"purpose\\\": \\\"Charts each lead's specific emotional state per chapter boundary (INV-058/T20). Enforces emotional variety (INV-037) — no character in same emotional state for 3+ consecutive chapters.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"characters\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → [{chapter, emotionalState: granular label, dominantEmotion, intensity: 1-10, trigger}]\\\"},\\n                    {\\\"name\\\": \\\"varietyCheck\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Map of CHAR-NNN → {maxConsecutiveSameState, violations: [{chapters, state}]}\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter of last update\\\"}\\n                ]\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-chapter-drafter\\\", \\\"romantic-fantasy-writer-craft-tracker\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"developmental-editor\\\", \\\"romance-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Chapter-drafter appends new chapter entries to each character's array. Craft-tracker recomputes varietyCheck after each update. Character arrays are append-only.\\\"\\n        },\\n        {\\n            \\\"name\\\": \\\"symbolic-motif-registry.json\\\",\\n            \\\"purpose\\\": \\\"Tracks 3-5 recurring symbols/motifs assigned to thematic pillars (INV-054/T16). Records appearances per chapter with imagery callbacks and evolution.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"storyId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Story identifier\\\"},\\n                    {\\\"name\\\": \\\"motifs\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'MOT-NNN', symbol, linkedTheme, appearances: [{chapter, context, evolution}], targetDensity}]\\\"},\\n                    {\\\"name\\\": \\\"lastUpdatedChapter\\\", \\\"type\\\": \\\"number\\\", \\\"description\\\": \\\"Chapter of last update\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"MOT-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-craft-tracker\\\"],\\n            \\\"readers\\\": [\\\"chapter-drafter\\\", \\\"adversarial-auditor\\\", \\\"craft-beta-reader\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdatedChapter\\\",\\n            \\\"multiWriterRules\\\": \\\"Single primary writer (craft-tracker). Initial motifs set during plotting; appearances appended per chapter.\\\"\\n        },\\n\\n        # ============================================================\\n        # CROSS-CUTTING: SERIES KNOWLEDGE MANAGEMENT (SD-012)\\n        # ============================================================\\n        {\\n            \\\"name\\\": \\\"series-kb/index.json\\\",\\n            \\\"purpose\\\": \\\"Series knowledge base master index. Lives at series level (not per-book). References all per-book KBs and tracks cross-book facts. Append-mostly per INV-070.\\\",\\n            \\\"schema\\\": {\\n                \\\"fields\\\": [\\n                    {\\\"name\\\": \\\"seriesId\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"Series identifier\\\"},\\n                    {\\\"name\\\": \\\"books\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{storyId, title, order, kbPath}]\\\"},\\n                    {\\\"name\\\": \\\"crossBookFacts\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'SKB-NNN', fact, establishedInBook, type: 'world'|'character'|'magic'|'timeline'|'naming'|'style'}]\\\"},\\n                    {\\\"name\\\": \\\"unresolvedThreads\\\", \\\"type\\\": \\\"array\\\", \\\"description\\\": \\\"[{id: 'UTH-NNN', thread, fromBook, disposition: 'continue'|'resolve'|'drop'|'pending'}] per INV-071\\\"},\\n                    {\\\"name\\\": \\\"namingConventions\\\", \\\"type\\\": \\\"object\\\", \\\"description\\\": \\\"Canonical names and spellings across the series\\\"},\\n                    {\\\"name\\\": \\\"lastUpdated\\\", \\\"type\\\": \\\"string\\\", \\\"description\\\": \\\"ISO-8601 timestamp\\\"}\\n                ],\\n                \\\"idScheme\\\": \\\"SKB-NNN, UTH-NNN\\\"\\n            },\\n            \\\"writers\\\": [\\\"romantic-fantasy-writer-series-kb-manager\\\"],\\n            \\\"readers\\\": [\\\"concept-developer (for sequels)\\\", \\\"worldbuilder\\\", \\\"character-developer\\\", \\\"adversarial-auditor\\\"],\\n            \\\"writeProtocol\\\": \\\"read-modify-write\\\",\\n            \\\"ownershipField\\\": \\\"lastUpdated\\\",\\n            \\\"multiWriterRules\\\": \\\"Single primary writer (series-kb-manager). Append-mostly: facts established in earlier books cannot be silently retconned (INV-070). New books append to books array and add crossBookFacts. unresolvedThreads dispositions updated during sequel concept phase.\\\"\\n        }\\n    ],\\n\\n    \\\"dataFlow\\\": [\\n        # === Phase-to-phase data flow ===\\n        {\\n            \\\"from\\\": \\\"input\\\",\\n            \\\"artifact\\\": \\\"story-config.json\\\",\\n            \\\"to\\\": \\\"concept\\\",\\n            \\\"purpose\\\": \\\"User inputs feed concept development — story idea, constraints, style samples\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"concept\\\",\\n            \\\"artifact\\\": \\\"story-concept.json\\\",\\n            \\\"to\\\": \\\"worldbuilding\\\",\\n            \\\"purpose\\\": \\\"Crystallized concept defines world parameters — genre, setting type, magic needs\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"concept\\\",\\n            \\\"artifact\\\": \\\"craft-profile.json\\\",\\n            \\\"to\\\": \\\"plotting\\\",\\n            \\\"purpose\\\": \\\"Selected craft tools become binding constraints for plot structure design\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"worldbuilding\\\",\\n            \\\"artifact\\\": \\\"world-bible/*\\\",\\n            \\\"to\\\": \\\"character\\\",\\n            \\\"purpose\\\": \\\"World rules constrain character abilities, cultural backgrounds, and social dynamics\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"character\\\",\\n            \\\"artifact\\\": \\\"characters/*.json\\\",\\n            \\\"to\\\": \\\"plotting\\\",\\n            \\\"purpose\\\": \\\"Character arcs, wounds, and relationships shape plot structure and beat placement\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"character\\\",\\n            \\\"artifact\\\": \\\"romance-arc-design.json\\\",\\n            \\\"to\\\": \\\"plotting\\\",\\n            \\\"purpose\\\": \\\"Romance arc stages and vulnerability ladder inform dual-arc interleave\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"plotting\\\",\\n            \\\"artifact\\\": \\\"chapter-outlines/{N}.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Per-chapter outlines are mandatory input for drafting (INV-010 Outline Before Draft)\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"plotting\\\",\\n            \\\"artifact\\\": \\\"plot-structure.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Act structure, beats, and subplot registry guide chapter-level execution\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"plotting\\\",\\n            \\\"artifact\\\": \\\"dual-arc-timeline.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Fantasy/romance beat assignments per chapter guide arc interleaving\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"plotting\\\",\\n            \\\"artifact\\\": \\\"tension-map.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Tension targets per chapter guide pacing in prose\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"style\\\",\\n            \\\"artifact\\\": \\\"style-guide.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Voice calibration and prose rules constrain how chapters are written\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"chapters/{N}/draft.md\\\",\\n            \\\"to\\\": \\\"revision\\\",\\n            \\\"purpose\\\": \\\"Chapter draft is the input for three-pass editing\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"chapters/{N}/metadata.json\\\",\\n            \\\"to\\\": \\\"revision\\\",\\n            \\\"purpose\\\": \\\"Structured metadata enables craft-aware developmental review\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"revision\\\",\\n            \\\"artifact\\\": \\\"revision-reports/{N}/*.json\\\",\\n            \\\"to\\\": \\\"revision\\\",\\n            \\\"purpose\\\": \\\"Three edit reports feed the chapter reviser (dev→line→copy→revise)\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"revision\\\",\\n            \\\"artifact\\\": \\\"chapters/{N}/revised.md\\\",\\n            \\\"to\\\": \\\"beta-reading\\\",\\n            \\\"purpose\\\": \\\"Revised chapter is the input for all five beta reader lenses\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"beta-reading\\\",\\n            \\\"artifact\\\": \\\"beta-feedback/{N}/*.json\\\",\\n            \\\"to\\\": \\\"beta-reading\\\",\\n            \\\"purpose\\\": \\\"Five lens reports feed the beta synthesizer\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"beta-reading\\\",\\n            \\\"artifact\\\": \\\"beta-synthesis/{N}.json\\\",\\n            \\\"to\\\": \\\"revision\\\",\\n            \\\"purpose\\\": \\\"Synthesized beta feedback may trigger revision cycle (INV-076 severity-gated)\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"revision\\\",\\n            \\\"artifact\\\": \\\"chapters/{N}/revised.md\\\",\\n            \\\"to\\\": \\\"polish\\\",\\n            \\\"purpose\\\": \\\"Accepted revised chapter feeds final polish\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"polish\\\",\\n            \\\"artifact\\\": \\\"chapters/{N}/final.md\\\",\\n            \\\"to\\\": \\\"delivery\\\",\\n            \\\"purpose\\\": \\\"Polished chapters assemble into the delivery package\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"polish\\\",\\n            \\\"artifact\\\": \\\"chapter-summaries/{N}.json\\\",\\n            \\\"to\\\": \\\"series-kb\\\",\\n            \\\"purpose\\\": \\\"Chapter summaries feed series KB promotion for sequel support\\\"\\n        },\\n        # === Cross-cutting data flows ===\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"continuity-tracker.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Updated after each chapter (INV-011); read before next chapter to maintain consistency\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"foreshadowing-ledger.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Tracks plant/payoff status across chapters; read to ensure planned payoffs\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"information-asymmetry-map.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Prevents character info leaks — checked before writing character actions\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"drafting\\\",\\n            \\\"artifact\\\": \\\"mystery-box-inventory.json\\\",\\n            \\\"to\\\": \\\"drafting\\\",\\n            \\\"purpose\\\": \\\"Maintains 3-7 active questions for reader engagement pacing\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"concept\\\",\\n            \\\"artifact\\\": \\\"story-concept.json\\\",\\n            \\\"to\\\": \\\"adversarial\\\",\\n            \\\"purpose\\\": \\\"Concept is the ground truth for all adversarial consistency checks\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"all-phases\\\",\\n            \\\"artifact\\\": \\\"audit-reports/{phase}/*.json\\\",\\n            \\\"to\\\": \\\"all-phases\\\",\\n            \\\"purpose\\\": \\\"Adversarial gates produce findings that may block phase progression\\\"\\n        },\\n        {\\n            \\\"from\\\": \\\"series-kb\\\",\\n            \\\"artifact\\\": \\\"series-kb/index.json\\\",\\n            \\\"to\\\": \\\"concept\\\",\\n            \\\"purpose\\\": \\\"For sequels: series KB provides established facts and unresolved threads (INV-071)\\\"\\n        }\\n    ]\\n}\\n\\n# Populate into architecture\\narch['artifacts'] = artifacts\\narch['lastUpdated'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')\\n\\n# Write back\\nwith open('.fractal-factory/architecture.json', 'w') as f:\\n    json.dump(arch, f, indent=2)\\n\\n# Count artifacts\\nuniversal_count = len(artifacts['universal'])\\ndomain_count = len(artifacts['domainSpecific'])\\nmulti_writer = [a for a in artifacts['domainSpecific'] if a.get('multiWriterRules')]\\nprint(f\\\"Written architecture.json with artifacts section:\\\")\\nprint(f\\\"  Universal artifacts: {universal_count}\\\")\\nprint(f\\\"  Domain-specific artifacts: {domain_count}\\\")\\nprint(f\\\"  Multi-writer artifacts: {len(multi_writer)}\\\")\\nprint(f\\\"  Data flow connections: {len(artifacts['dataFlow'])}\\\")\\nprint(f\\\"  Total: {universal_count + domain_count}\\\")\\nPYEOF\\n\", \"description\": \"Write complete artifact design to architecture.json\", \"initial_wait\": 30}"
