\"read\\\": \\\"agents/style-analyzer/status.json\\\",\\n            \\\"condition\\\": \\\"missing\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-style-analyzer\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-analyzer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-style-guide-writer\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-analyzer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-guide-writer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-style-auditor\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-guide-writer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed'\\\",\\n            \\\"action\\\": \\\"write own status: complete\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND retries < maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"delete agents/style-analyzer/status.json, agents/style-guide-writer/status.json, agents/style-auditor/status.json; increment retries; re-dispatch romantic-fantasy-writer-style-analyzer\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND retries >= maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Style failed auditor gate after max retries'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/style-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        }\\n    ],\\n    \\\"loopConfig\\\": {\\n        \\\"type\\\": \\\"auditor-gate\\\",\\n        \\\"writer\\\": \\\"style-analyzer + style-guide-writer\\\",\\n        \\\"reviewer\\\": \\\"style-auditor\\\",\\n        \\\"maxRetries\\\": 3,\\n        \\\"onMaxRetries\\\": \\\"escalate-blocked\\\",\\n        \\\"resetOnRetry\\\": [\\\"agents/style-analyzer/status.json\\\", \\\"agents/style-guide-writer/status.json\\\", \\\"agents/style-auditor/status.json\\\"],\\n        \\\"feedbackArtifact\\\": \\\"audit-reports/style/gate.json\\\"\\n    },\\n    \\\"convergenceBounds\\\": {\\n        \\\"maxAuditorRetries\\\": 3,\\n        \\\"expectedIterations\\\": 1\\n    },\\n    \\\"resultCodeMapping\\\": {\\n        \\\"complete\\\": \\\"Style guide written and passed auditor gate\\\",\\n        \\\"blocked\\\": \\\"Style calibration or audit failed/blocked\\\",\\n        \\\"revision-loop\\\": \\\"Currently in auditor retry loop (transient state)\\\"\\n    }\\n}\\n\\n# ─────────────────────────────────────────────────\\n# DRAFTING COORDINATOR (depth-3, per-chapter with auditor loop)\\n# ─────────────────────────────────────────────────\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer-drafting-coordinator\\\"] = {\\n    \\\"id\\\": \\\"A-008\\\",\\n    \\\"displayName\\\": \\\"Drafting Coordinator\\\",\\n    \\\"level\\\": \\\"coordinator\\\",\\n    \\\"depth\\\": 3,\\n    \\\"pass\\\": \\\"drafting\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-creative-writing-coordinator\\\",\\n        \\\"romantic-fantasy-writer-quality-integration-coordinator\\\",\\n        \\\"romantic-fantasy-writer-drafting-auditor\\\"\\n    ],\\n    \\\"perChapterLoop\\\": {\\n        \\\"description\\\": \\\"Chapters are drafted sequentially (INV-012). For each chapter N from 1 to estimatedChapterCount: dispatch creative-writing → quality-integration → drafting-auditor. Auditor loop applies per-chapter.\\\",\\n        \\\"iterationVariable\\\": \\\"N\\\",\\n        \\\"iterationSource\\\": \\\"story-concept.json.estimatedChapterCount\\\",\\n        \\\"sequentialEnforcement\\\": \\\"Chapter N+1 cannot begin until chapter N passes the drafting auditor gate (INV-012)\\\"\\n    },\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"progress.json\\\",\\n            \\\"condition\\\": \\\"currentChapter == null\\\",\\n            \\\"action\\\": \\\"set currentChapter=1; dispatch romantic-fantasy-writer-creative-writing-coordinator for chapter 1\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/creative-writing-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete' (for current chapter)\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-quality-integration-coordinator for current chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/creative-writing-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Creative writing blocked at chapter N'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/quality-integration-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'complete' (for current chapter)\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-drafting-auditor for current chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/quality-integration-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Quality integration blocked at chapter N'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND currentChapter < estimatedChapterCount\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].drafted=true; increment currentChapter; delete per-chapter sub-statuses; dispatch romantic-fantasy-writer-creative-writing-coordinator for next chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND currentChapter == estimatedChapterCount\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].drafted=true; write own status: complete; summary: 'All chapters drafted and passed auditor gates'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries < maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"read audit-reports/drafting/gate.json; delete per-chapter sub-statuses; increment chapterRetries; re-dispatch romantic-fantasy-writer-creative-writing-coordinator for same chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries >= maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Chapter N failed drafting auditor after max retries'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        }\\n    ],\\n    \\\"loopConfig\\\": {\\n        \\\"type\\\": \\\"per-chapter-auditor-gate\\\",\\n        \\\"writer\\\": \\\"creative-writing-coordinator + quality-integration-coordinator\\\",\\n        \\\"reviewer\\\": \\\"drafting-auditor\\\",\\n        \\\"maxRetries\\\": 3,\\n        \\\"onMaxRetries\\\": \\\"escalate-blocked\\\",\\n        \\\"resetOnRetry\\\": [\\n            \\\"agents/creative-writing-coordinator/status.json\\\",\\n            \\\"agents/quality-integration-coordinator/status.json\\\",\\n            \\\"agents/drafting-auditor/status.json\\\",\\n            \\\"agents/chapter-drafter/status.json\\\",\\n            \\\"agents/pov-voice-maintainer/status.json\\\",\\n            \\\"agents/continuity-integrator/status.json\\\",\\n            \\\"agents/craft-enforcer/status.json\\\"\\n        ],\\n        \\\"feedbackArtifact\\\": \\\"audit-reports/drafting/gate.json\\\",\\n        \\\"perChapter\\\": True,\\n        \\\"notes\\\": \\\"Retries counter resets per chapter. Each chapter gets up to maxRetries attempts independently.\\\"\\n    },\\n    \\\"convergenceBounds\\\": {\\n        \\\"maxAuditorRetries\\\": 3,\\n        \\\"expectedIterations\\\": 1,\\n        \\\"notes\\\": \\\"Per-chapter retry count. Total dispatches = chapters × (1 + retries). For a 20-chapter book with no retries, ~60 specialist dispatches.\\\"\\n    },\\n    \\\"resultCodeMapping\\\": {\\n        \\\"complete\\\": \\\"All chapters drafted, quality-integrated, and passed auditor gates\\\",\\n        \\\"blocked\\\": \\\"A chapter failed drafting or audit\\\",\\n        \\\"revision-loop\\\": \\\"Currently in per-chapter auditor retry loop (transient state)\\\"\\n    }\\n}\\n\\n# ─────────────────────────────────────────────────\\n# REVISION COORDINATOR (depth-2, per-chapter sequential editors)\\n# ─────────────────────────────────────────────────\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer-revision-coordinator\\\"] = {\\n    \\\"id\\\": \\\"A-009\\\",\\n    \\\"displayName\\\": \\\"Revision Coordinator\\\",\\n    \\\"level\\\": \\\"coordinator\\\",\\n    \\\"depth\\\": 2,\\n    \\\"pass\\\": \\\"revision\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-developmental-editor\\\",\\n        \\\"romantic-fantasy-writer-line-editor\\\",\\n        \\\"romantic-fantasy-writer-copy-editor\\\",\\n        \\\"romantic-fantasy-writer-chapter-reviser\\\",\\n        \\\"romantic-fantasy-writer-revision-auditor\\\"\\n    ],\\n    \\\"perChapterLoop\\\": {\\n        \\\"description\\\": \\\"For each chapter N: three editing passes (developmental → line → copy) run sequentially, then chapter-reviser applies all fixes, then revision-auditor gates quality. Chapters can be processed in any order since editing is independent.\\\",\\n        \\\"iterationVariable\\\": \\\"N\\\",\\n        \\\"iterationSource\\\": \\\"progress.json.chapterProgress (chapters where drafted==true)\\\",\\n        \\\"sequentialEnforcement\\\": \\\"The three editing passes within a chapter are sequential (each builds on the prior). Chapters themselves could be parallel but are routed sequentially for simplicity.\\\"\\n    },\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"agents/developmental-editor/status.json\\\",\\n            \\\"condition\\\": \\\"missing (for current chapter)\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-developmental-editor for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/developmental-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-line-editor for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/developmental-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/line-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-copy-editor for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/line-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/copy-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-chapter-reviser for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/copy-editor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/chapter-reviser/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-revision-auditor for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/chapter-reviser/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND more chapters remain\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].revised=true; advance to next chapter; delete per-chapter sub-statuses; dispatch developmental-editor for next chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND all chapters revised\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].revised=true; write own status: complete\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries < maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"read audit-reports/revision/gate.json; delete agents/chapter-reviser/status.json, agents/revision-auditor/status.json; increment chapterRetries; re-dispatch romantic-fantasy-writer-chapter-reviser for same chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries >= maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Chapter N failed revision auditor after max retries'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/revision-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        }\\n    ],\\n    \\\"loopConfig\\\": {\\n        \\\"type\\\": \\\"per-chapter-auditor-gate\\\",\\n        \\\"writer\\\": \\\"chapter-reviser\\\",\\n        \\\"reviewer\\\": \\\"revision-auditor\\\",\\n        \\\"maxRetries\\\": 3,\\n        \\\"onMaxRetries\\\": \\\"escalate-blocked\\\",\\n        \\\"resetOnRetry\\\": [\\\"agents/chapter-reviser/status.json\\\", \\\"agents/revision-auditor/status.json\\\"],\\n        \\\"feedbackArtifact\\\": \\\"audit-reports/revision/gate.json\\\",\\n        \\\"perChapter\\\": True,\\n        \\\"notes\\\": \\\"On retry, only the reviser re-runs (edit reports from dev/line/copy editors are preserved as they represent independent assessments).\\\"\\n    },\\n    \\\"convergenceBounds\\\": {\\n        \\\"maxAuditorRetries\\\": 3,\\n        \\\"expectedIterations\\\": 1\\n    },\\n    \\\"resultCodeMapping\\\": {\\n        \\\"complete\\\": \\\"All chapters revised through 3 edit passes and passed auditor gate\\\",\\n        \\\"blocked\\\": \\\"A chapter failed revision or audit\\\",\\n        \\\"revision-loop\\\": \\\"Currently in per-chapter auditor retry loop (transient state)\\\"\\n    }\\n}\\n\\n# ─────────────────────────────────────────────────\\n# BETA-READING COORDINATOR (depth-3, per-chapter, parallel lenses)\\n# ─────────────────────────────────────────────────\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer-beta-reading-coordinator\\\"] = {\\n    \\\"id\\\": \\\"A-010\\\",\\n    \\\"displayName\\\": \\\"Beta Reading Coordinator\\\",\\n    \\\"level\\\": \\\"coordinator\\\",\\n    \\\"depth\\\": 3,\\n    \\\"pass\\\": \\\"beta-reading\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-genre-lens-coordinator\\\",\\n        \\\"romantic-fantasy-writer-craft-lens-coordinator\\\",\\n        \\\"romantic-fantasy-writer-beta-synthesizer\\\",\\n        \\\"romantic-fantasy-writer-beta-reading-auditor\\\"\\n    ],\\n    \\\"parallelGroups\\\": [\\n        {\\n            \\\"group\\\": \\\"lens-fan-out\\\",\\n            \\\"agents\\\": [\\\"romantic-fantasy-writer-genre-lens-coordinator\\\", \\\"romantic-fantasy-writer-craft-lens-coordinator\\\"],\\n            \\\"notes\\\": \\\"Genre and craft lens coordinators can run in parallel — they read the same revised chapter independently\\\"\\n        }\\n    ],\\n    \\\"perChapterLoop\\\": {\\n        \\\"description\\\": \\\"For each chapter N: fan out to genre-lens-coordinator and craft-lens-coordinator in parallel, then synthesize, then audit. Chapters processed sequentially.\\\",\\n        \\\"iterationVariable\\\": \\\"N\\\",\\n        \\\"iterationSource\\\": \\\"progress.json.chapterProgress (chapters where revised==true)\\\",\\n        \\\"sequentialEnforcement\\\": \\\"Chapters are sequential; within each chapter, the two lens coordinators are parallel.\\\"\\n    },\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"agents/genre-lens-coordinator/status.json AND agents/craft-lens-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"both missing (for current chapter)\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-genre-lens-coordinator AND romantic-fantasy-writer-craft-lens-coordinator in parallel\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/genre-lens-coordinator/status.json AND agents/craft-lens-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"both result == 'complete'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-beta-synthesizer for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/genre-lens-coordinator/status.json OR agents/craft-lens-coordinator/status.json\\\",\\n            \\\"condition\\\": \\\"either result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-synthesizer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'completed'\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-beta-reading-auditor for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-synthesizer/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND more chapters remain\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].betaRead=true; advance to next chapter; delete per-chapter sub-statuses; dispatch lens coordinators for next chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'passed' AND all chapters beta-read\\\",\\n            \\\"action\\\": \\\"update progress.json chapterProgress[N].betaRead=true; write own status: complete\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries < maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"read audit-reports/beta-reading/gate.json; delete lens + synthesizer + auditor statuses; increment chapterRetries; re-dispatch lens coordinators for same chapter\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'failed' AND chapterRetries >= maxAuditorRetries\\\",\\n            \\\"action\\\": \\\"write own status: blocked; summary: 'Chapter N failed beta-reading auditor after max retries'\\\"\\n        },\\n        {\\n            \\\"read\\\": \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"condition\\\": \\\"result == 'blocked'\\\",\\n            \\\"action\\\": \\\"write own status: blocked\\\"\\n        }\\n    ],\\n    \\\"loopConfig\\\": {\\n        \\\"type\\\": \\\"per-chapter-auditor-gate\\\",\\n        \\\"writer\\\": \\\"genre-lens-coordinator + craft-lens-coordinator + beta-synthesizer\\\",\\n        \\\"reviewer\\\": \\\"beta-reading-auditor\\\",\\n        \\\"maxRetries\\\": 3,\\n        \\\"onMaxRetries\\\": \\\"escalate-blocked\\\",\\n        \\\"resetOnRetry\\\": [\\n            \\\"agents/genre-lens-coordinator/status.json\\\",\\n            \\\"agents/craft-lens-coordinator/status.json\\\",\\n            \\\"agents/beta-synthesizer/status.json\\\",\\n            \\\"agents/beta-reading-auditor/status.json\\\",\\n            \\\"agents/romance-beta-reader/status.json\\\",\\n            \\\"agents/fantasy-beta-reader/status.json\\\",\\n            \\\"agents/craft-beta-reader/status.json\\\",\\n            \\\"agents/sensitivity-beta-reader/status.json\\\",\\n            \\\"agents/originality-beta-reader/status.json\\\"\\n        ],\\n        \\\"feedbackArtifact\\\": \\\"audit-reports/beta-reading/gate.json\\\",\\n        \\\"perChapter\\\": True\\n    },\\n    \\\"convergenceBounds\\\": {\\n        \\\"maxAuditorRetries\\\": 3,\\n        \\\"expectedIterations\\\": 1\\n    },\\n    \\\"resultCodeMapping\\\": {\\n        \\\"complete\\\": \\\"All chapters beta-read across 5 lenses, synthesized, and passed auditor gate\\\",\\n        \\\"blocked\\\": \\\"A chapter failed beta-reading or audit\\\",\\n        \\\"revision-loop\\\": \\\"Currently in per-chapter auditor retry loop (transient state)\\\"\\n    }\\n}\\n\\n# ─────────────────────────────────────────────────\\n# POLISH COORDINATOR (depth-2, per-chapter, no auditor)\\n# ─────────────────────────────────────────────────\\nrouting[\\\"agents\\\"][\\\"romantic-fantasy-writer-polish-coordinator\\\"] = {\\n    \\\"id\\\": \\\"A-011\\\",\\n    \\\"displayName\\\": \\\"Polish Coordinator\\\",\\n    \\\"level\\\": \\\"coordinator\\\",\\n    \\\"depth\\\": 2,\\n    \\\"pass\\\": \\\"polish\\\",\\n    \\\"dispatchOrder\\\": [\\n        \\\"romantic-fantasy-writer-polisher\\\",\\n        \\\"romantic-fantasy-writer-summary-generator\\\",\\n        \\\"romantic-fantasy-writer-delivery-assembler\\\"\\n    ],\\n    \\\"perChapterLoop\\\": {\\n        \\\"description\\\": \\\"For each chapter N: polisher finalizes prose → summary-generator creates chapter summary. After all chapters: delivery-assembler produces the final report.\\\",\\n        \\\"iterationVariable\\\": \\\"N\\\",\\n        \\\"iterationSource\\\": \\\"progress.json.chapterProgress (chapters where betaRead==true OR revised==true)\\\",\\n        \\\"sequentialEnforcement\\\": \\\"Chapters can be polished in any order. Delivery assembler runs only after all chapters are polished.\\\"\\n    },\\n    \\\"routingTable\\\": [\\n        {\\n            \\\"read\\\": \\\"agents/polisher/status.json\\\",\\n            \\\"condition\\\": \\\"missing (for current chapter)\\\",\\n            \\\"action\\\": \\\"dispatch romantic-fantasy-writer-polisher for chapter N\\\"\\n        },\\n        {\\n            \\\"read\\