{
  "name": "ado",
  "description": "Azure DevOps MCP — pull request creation and review threads",
  "type": "custom",
  "command": "node",
  "args": ["dist/bundle.js"],
  "containerPath": "/opt/mcp/servers/ado",
  "sidecarPort": 9101,
  "requiredEnv": ["ADO_PAT"],
  "proxyDomains": [".dev.azure.com"],
  "allowedUrlPaths": {
    "dev.azure.com": ["/KenticoCustomerSuccess/"]
  },
  "tools": [
    "ado_create_pull_request",
    "ado_list_pull_requests",
    "ado_list_pull_request_threads",
    "ado_create_pull_request_thread",
    "ado_reply_to_comment"
  ]
}
