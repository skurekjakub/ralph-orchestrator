{
  "name": "playwright",
  "description": "Browser automation via Playwright — navigate, screenshot, interact with web pages",
  "type": "npm",
  "command": "playwright-mcp",
  "args": [],
  "sidecarPort": 9103,
  "tools": [
    "browser_navigate",
    "browser_navigate_back",
    "browser_take_screenshot",
    "browser_network_requests",
    "browser_click",
    "browser_fill_form",
    "browser_evaluate",
    "browser_press_key"
  ]
}
