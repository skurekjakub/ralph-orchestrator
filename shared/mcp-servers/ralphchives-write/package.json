{
  "name": "@ralph/ralphchives-write-mcp",
  "version": "1.0.0",
  "description": "Ralphchives Write Path MCP server — post task reports and observations",
  "main": "dist/bundle.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && esbuild src/index.ts --bundle --splitting --platform=node --format=esm --target=node24 --outdir=dist --entry-names=bundle",
    "start": "node dist/bundle.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
