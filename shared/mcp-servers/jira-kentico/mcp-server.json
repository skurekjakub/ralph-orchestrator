{
  "name": "jira-kentico",
  "description": "JIRA Cloud — add comments and attachments to issues",
  "type": "custom",
  "command": "node",
  "args": ["dist/bundle.js"],
  "containerPath": "/opt/mcp/servers/jira-kentico",
  "sidecarPort": 9100,
  "requiredEnv": ["JIRA_PAT", "JIRA_EMAIL"],
  "tools": [
    "jira_add_comment",
    "jira_add_attachment"
  ],
  "requiredConfig": ["JIRA_ISSUE_KEY"]
}
