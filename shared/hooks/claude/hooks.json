{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "/workspace/.ralph/hooks/log-session-start.sh --cli claude", "timeout": 5 }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-prompt.sh --cli claude", "timeout": 5 }]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-pre-tool.sh --cli claude", "timeout": 5 }]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-post-tool.sh --cli claude", "timeout": 5 }]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "/workspace/.ralph/hooks/log-post-tool.sh --cli claude",
          "timeout": 5
        }
      ]
    }
  ],
  "SubagentStart": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-subagent.sh --cli claude", "timeout": 5 }]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-subagent.sh --cli claude", "timeout": 5 }]
    }
  ],
  "PreCompact": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-compact.sh --cli claude", "timeout": 5 }]
    }
  ],
  "Stop": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/claude/result-gate.sh", "timeout": 10 }]
    }
  ],
  "StopFailure": [
    {
      "hooks": [{ "type": "command", "command": "/workspace/.ralph/hooks/log-error.sh --cli claude", "timeout": 5 }]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "/workspace/.ralph/hooks/log-session-end.sh --cli claude", "timeout": 5 }
      ]
    }
  ]
}
