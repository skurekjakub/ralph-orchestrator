            "type": "string",
            "description": "The ID of the shell session used to invoke the Bash command. Look back to the bash call to find the shellId."
          },
          "delay": {
            "type": "number",
            "description": "(Optional) The amount of time in seconds to wait before reading the output."
          }
        },
        "required": [
          "shellId",
          "delay"
        ]
      }
    }
  },
