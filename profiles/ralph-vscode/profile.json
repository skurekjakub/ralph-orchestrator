{
  "repo": "~/repositories/ralph-repositories/kentico-docs-autocomplete-vscode",
  "cli": "copilot",
  "timeoutMs": 7200000,
  "variants": [
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "Defect Found"],
        "commentTrigger": "@RalphAutocomplete",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "transitionId": "51" },
      "afterAgent": { "transitionId": "91" }
    },
    {
      "agent": "ralph.malph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["Ready for Review"],
        "commentTrigger": "@Malph"
      }
    }
  ]
}
