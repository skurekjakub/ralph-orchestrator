{
  "repo": "~/repositories/ralph-repositories/kentico-docs-autocomplete-vscode",
  "dataSource": "kentico-jira",
  "vcsProvider": "ado",
  "repoPat": "ADO_PAT",
  "cli": "copilot",
  "timeoutMs": 7200000,
  "mcpServers": [
    {
      "name": "jira-kentico",
      "env": {
        "JIRA_ISSUE_KEY": "$task.id"
      }
    },
    {
      "name": "ado",
      "env": {
        "ADO_PROJECT": "CustomerEducation",
        "ADO_REPO": "kentico-docs-autocomplete-vscode",
        "TASK_BRANCH": "$task.branch"
      }
    },
    {
      "name": "ralphchives-write",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    },
    {
      "name": "ralphchives-read",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    }
  ],
  "githubMcpTools": [
    "get_file_contents"
  ],
  "resources": {
    "mountBase": "./ralph/ralph-resources"
  },
  "variants": [
    {
      "match": {
        "projects": [
          "DOC"
        ],
        "statuses": [
          "To Do",
          "Defect Found"
        ],
        "commentTrigger": "@RalphAutocomplete",
        "revisionStatuses": [
          "Defect Found"
        ]
      },
      "beforeAgent": {
        "targetStatus": "In Progress"
      },
      "afterAgent": {
        "targetStatus": "Ready for Review"
      },
      "stages": [
        {
          "agent": "ralph.ralph",
          "role": "primary",
          "skills": [
            "ralph-ado-pr-workflow",
            "vscode-workflow-setup",
            "vscode-workflow-analyze",
            "vscode-workflow-implement-loop",
            "vscode-workflow-subagent-test",
            "vscode-workflow-package",
            "vscode-workflow-commit",
            "vscode-workflow-pr",
            "vscode-workflow-handoff",
            "vscode-workflow-archive",
            "vscode-workflow-revision-setup",
            "vscode-workflow-revision-commit",
            "vscode-workflow-revision-handoff"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.run-analyzer",
              "role": "analyzer",
              "mode": "local",
              "model": "claude-opus-4.6"
            },
            {
              "agent": "ralph.agent-improver",
              "role": "improver",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    },
    {
      "match": {
        "projects": [
          "DOC"
        ],
        "statuses": [
          "Ready for Review"
        ],
        "commentTrigger": "@MalphAutocomplete"
      },
      "stages": [
        {
          "agent": "ralph.malph",
          "role": "primary",
          "skills": [
            "ralph-ado-pr-workflow",
            "ralph-ralphchives",
            "malph-vscode-workflow-setup",
            "malph-vscode-workflow-scout",
            "malph-vscode-workflow-review-panel",
            "malph-vscode-workflow-aggregate",
            "malph-vscode-workflow-handoff",
            "malph-vscode-workflow-archive"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.run-analyzer",
              "role": "analyzer",
              "mode": "local",
              "model": "claude-opus-4.6"
            },
            {
              "agent": "ralph.agent-improver",
              "role": "improver",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    }
  ]
}
