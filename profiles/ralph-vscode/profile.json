{
  "repoUrl": "https://dev.azure.com/KenticoCustomerSuccess/CustomerEducation/_git/kentico-docs-autocomplete-vscode",
  "dataSource": "kentico-jira",
  "vcsProvider": "ado",
  "repoPat": "ADO_PAT",
  "cli": "copilot",
  "timeoutMs": 36000000,
  "allowlistDomains": [
    ".npmjs.org",
    "dev.azure.com",
    "pkgs.dev.azure.com",
    "vsblob.dev.azure.com",
    ".artifacts.visualstudio.com"
  ],
  "mcpServers": [
    {
      "name": "jira-kentico",
      "env": {
        "JIRA_ISSUE_KEY": "$task.id"
      }
    },
    {
      "name": "ado",
      "env": {
        "ADO_PROJECT": "CustomerEducation",
        "ADO_REPO": "kentico-docs-autocomplete-vscode",
        "TASK_BRANCH": "$task.branch",
        "SOURCE_BRANCH": "$trigger.source_branch",
        "TARGET_BRANCH": "$trigger.target_branch"
      }
    },
    {
      "name": "ralphchives-write",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    },
    {
      "name": "ralphchives-read",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    }
  ],
  "githubMcpTools": ["get_file_contents"],
  "resources": {
    "mountBase": "./ralph/ralph-resources"
  },
  "variants": [
    {
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "Defect Found"],
        "commentTrigger": "@RalphAutocomplete",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": {
        "targetStatus": "In Progress"
      },
      "afterAgent": {
        "targetStatus": "Ready for Review"
      },
      "stages": [
        {
          "agent": "ralph.ralph",
          "role": "primary",
          "skills": [
            "ralph-ado-pr-workflow",
            "ralph-ralphchives",
            "vscode-workflow",
            "test-behavior-testing",
            "test-mocking-strategy",
            "test-structure-patterns",
            "code-typescript-review",
            "code-typescript-bps",
            "vscode-grammar-and-scopes"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.scientist",
              "role": "scientist",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    },
    {
      "match": {
        "projects": ["DOC"],
        "statuses": ["Ready for Review"],
        "commentTrigger": "@MalphAutocomplete"
      },
      "stages": [
        {
          "agent": "ralph.malph",
          "role": "primary",
          "skills": [
            "ralph-ado-pr-workflow",
            "ralph-ralphchives",
            "malph-vscode-workflow-setup",
            "malph-vscode-workflow-scout",
            "malph-vscode-workflow-review-panel",
            "malph-vscode-workflow-aggregate",
            "malph-vscode-workflow-handoff",
            "malph-vscode-workflow-archive"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.scientist",
              "role": "scientist",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    }
  ]
}
