{
  "repo": "~/repositories/ralph-repositories/kentico-docs-autocomplete-vscode",
  "dataSource": "kentico-jira",
  "vcsProvider": "ado",
  "repoPat": "ADO_PAT",
  "cli": "copilot",
  "timeoutMs": 7200000,
  "mcpServers": [
    {
      "name": "jira-kentico",
      "env": {
        "JIRA_ISSUE_KEY": "$task.id"
      }
    },
    {
      "name": "ado",
      "env": {
        "ADO_PROJECT": "CustomerEducation",
        "ADO_REPO": "kentico-docs-autocomplete-vscode",
        "TASK_BRANCH": "$task.branch"
      }
    },
    {
      "name": "ralphchives-write",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    },
    {
      "name": "ralphchives-read",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-vscode"
      }
    }
  ],
  "githubMcpTools": [
    "get_file_contents"
  ],
  "resources": {
    "mountBase": "resources/ralph-resources"
  },
  "variants": [
    {
      "match": {
        "projects": [
          "DOC"
        ],
        "statuses": [
          "To Do",
          "Defect Found"
        ],
        "commentTrigger": "@RalphAutocomplete",
        "revisionStatuses": [
          "Defect Found"
        ]
      },
      "beforeAgent": {
        "targetStatus": "In Progress"
      },
      "afterAgent": {
        "targetStatus": "Ready for Review"
      },
      "stages": [
        {
          "agent": "ralph.ralph",
          "role": "primary"
        }
      ]
    },
    {
      "match": {
        "projects": [
          "DOC"
        ],
        "statuses": [
          "Ready for Review"
        ],
        "commentTrigger": "@MalphAutocomplete"
      },
      "stages": [
        {
          "agent": "ralph.malph",
          "role": "primary"
        }
      ]
    }
  ]
}
