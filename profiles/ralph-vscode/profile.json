{
  "repo": "~/repositories/ralph-repositories/kentico-docs-autocomplete-vscode",
  "cli": "copilot",
  "timeoutMs": 7200000,
  "mcpServers": [],
  "resources": {
    "mountBase": "resources/ralph-resources"
  },
  "variants": [
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "Defect Found"],
        "commentTrigger": "@RalphAutocomplete",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "targetStatus": "In Progress" },
      "afterAgent": { "targetStatus": "Ready for Review" }
    },
    {
      "agent": "ralph.malph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["Ready for Review"],
        "commentTrigger": "@MalphAutocomplete"
      }
    }
  ]
}
