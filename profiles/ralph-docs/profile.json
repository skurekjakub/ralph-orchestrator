{
  "repo": "~/repositories/ralph-repositories/kentico-docs-jekyll",
  "cli": "copilot",
  "timeoutMs": 7200000,
  "cleanPaths": ["/workspace/resources/chats"],
  "maxContinuations": 3,
  "mcpServers": [
    {
      "name": "jira-kentico",
      "env": {
        "JIRA_ISSUE_KEY": "$jira.key"
      }
    },
    {
      "name": "ado",
      "env": {
        "ADO_PROJECT": "CustomerEducation",
        "ADO_REPO": "kentico-docs-jekyll",
        "TASK_BRANCH": "$jira.branch"
      }
    },
    { "name": "web-fetch" },
    { "name": "microsoft-docs" },
    {
      "name": "ralphchives-write",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-docs"
      }
    },
    {
      "name": "ralphchives-read",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-docs"
      }
    }
  ],
  "githubMcpTools": ["get_file_contents"],
  "skills": [
    "ralph-code-samples",
    "ralph-ado-pr-workflow",
    "ralph-source-references",
    "ralph-ralphchives",
    "ralph-new-page-creation",
    "ralph-documentation-syntax",
    "ralph-style-guide-review",
    "ralph-codesamples-project",
    "ralph-screenshots",
    "ralph-training-modules",
    "ralph-write-release-notes"
  ],
  "resources": {
    "mountBase": "resources/ralph-resources"
  },
  "variants": [
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DF"],
        "statuses": ["New", "To Do", "Defect Found"],
        "commentTrigger": "@RalphDf",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "targetStatus": "In Progress" },
      "afterAgent": { "targetStatus": "Ready for Review" }
    },
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "Defect Found"],
        "commentTrigger": "@Ralph",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "targetStatus": "In Progress" },
      "afterAgent": { "targetStatus": "Ready for Review" }
    },
    {
      "agent": "ralph.malph",
      "match": {
        "projects": ["DF", "DOC"],
        "statuses": ["Ready for Review"],
        "commentTrigger": "@Malph"
      }
    },
    {
      "agent": "ralph.overralph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do"],
        "commentTrigger": "@OverRalph"
      }
    },
    {
      "agent": "ralph.mcp-probe",
      "model": "claude-sonnet-4",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "In Progress", "Ready for Review", "Defect Found"],
        "commentTrigger": "@McpProbe"
      }
    }
  ]
}
