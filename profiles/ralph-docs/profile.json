{
  "repo": "~/repositories/ralph-repositories/kentico-docs-jekyll",
  "dataSource": "kentico-jira",
  "vcsProvider": "ado",
  "cli": "copilot",
  "timeoutMs": 36000000,
  "cleanPaths": [
    "/workspace/.ralph/tasks"
  ],
  "maxContinuations": 3,
  "mcpServers": [
    {
      "name": "jira-kentico",
      "env": {
        "JIRA_ISSUE_KEY": "$task.id"
      }
    },
    {
      "name": "ado",
      "env": {
        "ADO_PROJECT": "CustomerEducation",
        "ADO_REPO": "kentico-docs-jekyll",
        "TASK_BRANCH": "$task.branch"
      }
    },
    {
      "name": "web-fetch"
    },
    {
      "name": "microsoft-docs"
    },
    {
      "name": "ralphchives-write",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-docs"
      }
    },
    {
      "name": "ralphchives-read",
      "env": {
        "NODEBB_API_TOKEN": "$variantEnv.NODEBB_TOKEN",
        "NODEBB_CATEGORY_NAME": "ralph-docs"
      }
    }
  ],
  "githubMcpTools": [
    "get_file_contents"
  ],
  "resources": {
    "mountBase": "./ralph/ralph-resources"
  },
  "variants": [
    {
      "match": {
        "projects": [
          "DOC",
          "DF"
        ],
        "statuses": [
          "To Do",
          "Defect Found"
        ],
        "commentTrigger": "@Ralph",
        "revisionStatuses": [
          "Defect Found"
        ]
      },
      "beforeAgent": {
        "targetStatus": "In Progress"
      },
      "afterAgent": {
        "targetStatus": "Ready for Review"
      },
      "mcpServers": [
        {
          "name": "codegraphcontext",
          "sidecarEnv": {
            "CGC_INDEX_PATH": "/workspace/resources/repositories/xperience"
          }
        }
      ],
      "stages": [
        {
          "agent": "ralph.ralph",
          "role": "primary",
          "skills": [
            "ralph-codegraph",
            "ralph-code-samples",
            "ralph-ado-pr-workflow",
            "ralph-source-references",
            "ralph-ralphchives",
            "ralph-new-page-creation",
            "ralph-page-removal",
            "ralph-documentation-syntax",
            "ralph-style-guide-review",
            "ralph-codesamples-project",
            "ralph-screenshots",
            "ralph-codesamples-verification",
            "ralph-training-modules",
            "ralph-write-release-notes",
            "ralph-research-guide",
            "ralph-workflow-setup",
            "ralph-workflow-research",
            "ralph-workflow-write",
            "ralph-workflow-review",
            "ralph-workflow-commit",
            "ralph-workflow-pr",
            "ralph-workflow-handoff",
            "ralph-workflow-revision-setup",
            "ralph-workflow-revision-fix",
            "ralph-workflow-revision-commit",
            "ralph-workflow-revision-handoff",
            "ralph-build-errors",
            "ralph-callout-selection",
            "ralph-cross-version-linking",
            "ralph-xperience-page-permissions"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.scientist",
              "role": "scientist",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    },
    {
      "match": {
        "projects": [
          "DF",
          "DOC"
        ],
        "statuses": [
          "Ready for Review"
        ],
        "commentTrigger": "@Malph"
      },
      "mcpServers": [
        {
          "name": "codegraphcontext",
          "sidecarEnv": {
            "CGC_INDEX_PATH": "/workspace/resources/repositories/xperience"
          }
        }
      ],
      "stages": [
        {
          "agent": "ralph.malph",
          "role": "primary",
          "skills": [
            "ralph-codegraph",
            "ralph-documentation-syntax",
            "ralph-style-guide-review",
            "ralph-build-errors",
            "ralph-callout-selection",
            "ralph-cross-version-linking",
            "ralph-ado-pr-workflow",
            "ralph-ralphchives",
            "ralph-source-references",
            "ralph-screenshots",
            "malph-workflow-descend",
            "malph-workflow-investigate",
            "malph-workflow-verify",
            "malph-workflow-review",
            "malph-workflow-deliver",
            "malph-workflow-handoff"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.scientist",
              "role": "scientist",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    },
    {
      "description": "Fullstack developer agent for documentation platform infrastructure — Ruby gems, Gulp pipeline, frontend JS, CSS, Jekyll templates.",
      "match": {
        "projects": [
          "DOC",
          "DF"
        ],
        "statuses": [
          "To Do",
          "Defect Found"
        ],
        "commentTrigger": "@RalphDev",
        "revisionStatuses": [
          "Defect Found"
        ]
      },
      "beforeAgent": {
        "targetStatus": "In Progress"
      },
      "afterAgent": {
        "targetStatus": "Ready for Review"
      },
      "stages": [
        {
          "agent": "ralph.stacky",
          "role": "primary",
          "skills": [
            "devralph-ruby-gems",
            "devralph-gulp-pipeline",
            "devralph-frontend",
            "devralph-jekyll-site",
            "devralph-build-verification",
            "devralph-workflow-setup",
            "devralph-workflow-research",
            "devralph-workflow-implement",
            "devralph-workflow-test",
            "devralph-workflow-e2e",
            "devralph-workflow-review",
            "devralph-workflow-commit",
            "devralph-workflow-pr",
            "devralph-workflow-handoff",
            "devralph-workflow-revision-setup",
            "devralph-workflow-revision-fix",
            "devralph-workflow-revision-commit",
            "devralph-workflow-revision-handoff",
            "ralph-ado-pr-workflow",
            "ralph-ralphchives"
          ]
        }
      ],
      "postTaskHooks": [
        {
          "name": "run-analysis",
          "stages": [
            {
              "agent": "ralph.scientist",
              "role": "scientist",
              "mode": "local",
              "model": "claude-opus-4.6"
            }
          ]
        }
      ]
    }
  ]
}
