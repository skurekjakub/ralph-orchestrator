{
  "repo": "~/repositories/ralph-repositories/kentico-docs-jekyll",
  "cli": "copilot",
  "timeoutMs": 3600000,
  "variants": [
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DF"],
        "statuses": ["New", "To Do", "Defect Found"],
        "commentTrigger": "@RalphDf",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "transitionId": "141" },
      "afterAgent": { "transitionId": "91" }
    },
    {
      "agent": "ralph.ralph",
      "match": {
        "projects": ["DOC"],
        "statuses": ["To Do", "Defect Found"],
        "commentTrigger": "@RalphDocs",
        "revisionStatuses": ["Defect Found"]
      },
      "beforeAgent": { "transitionId": "51" },
      "afterAgent": { "transitionId": "91" }
    },
    {
      "agent": "ralph.malph",
      "match": {
        "projects": ["DF", "DOC"],
        "statuses": ["Ready for Review"],
        "commentTrigger": "@Malph"
      }
    }
  ]
}
